@@ -0,0 +1,28 @@
+// Function expression consumed by Playwright MCP browser_run_code_unsafe.
+async (page) => {
+  await page.setViewportSize({ width: 1440, height: 1000 });
+  await page.goto(
+    'http://localhost:4187/network/?code=1111&lang=en&rotation=-90&turns=0+0%2C-15+15&gaps=0.08+0.08+%7E+%7E%2C0.18+0.18+%7E+%7E',
+  );
+  const gap = page.getByLabel('Link 1: Gap at the target reference', { exact: true });
+  await gap.fill('0.07');
+  await gap.hover();
+  const box = await gap.boundingBox();
+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 - 3);
+  if ((await gap.inputValue()) !== '0.08') throw new Error('Native spinner Up should move 0.07 to 0.08');
+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 + 3);
+  if ((await gap.inputValue()) !== '0.07') throw new Error('Native spinner Down should restore 0.07');
+  await gap.press('ArrowUp');
+  if ((await gap.inputValue()) !== '0.08') throw new Error('Keyboard Up should restore 0.08');
+  const result = {
+    date: new Date().toISOString(),
+    checks: [
+      'actual native spinner Up: 0.07→0.08',
+      'actual native spinner Down: 0.08→0.07',
+      'keyboard Up restores equal 0.08 gaps',
+    ],
+    url: await page.getByLabel('Link to this picture', { exact: true }).inputValue(),
+  };
+  await page.locator('.network__preview').scrollIntoViewIfNeeded();
+  return result;
+};
diff --git a/experiments/issue-27-measure.mjs b/experiments/issue-27-measure.mjs
new file mode 100644
index 0000000..9a75d9b
--- /dev/null
+++ b/experiments/issue-27-measure.mjs
@@ -0,0 +1,32 @@
+// Bounded geometric and solver probes; no stress inputs. Run before/after a fix.
+import { createServer } from 'vite';
+import { writeFile } from 'node:fs/promises';
+const server = await createServer({ server: { middlewareMode: true } });
+try {
+  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');
+  const { glyphCurves, paintedCurve } = await server.ssrLoadModule('/src/links/glyph.js');
+  const { solveCollisions } = await server.ssrLoadModule('/src/links/collisions.js');
+  const links = [
+    [1, 1],
+    [1, 1],
+  ];
+  const results = [];
+  for (const gap of [0, 0.01, 0.06, 0.07, 0.079999, 0.08, 0.080001, 0.09]) {
+    const style = normalizeStyle({ rotation: -90, turns: '0 0,-15 15', gaps: `0.08 ${gap} ~ ~,0.18 0.18 ~ ~` });
+    const shape = shapeOfStyle(style, 2);
+    const raw = glyphCurves(links, shape)[0];
+    const painted = paintedCurve(raw, shape);
+    const cap = style.strokeWidth / 2;
+    const extra = cap / Math.sin((style.endAngle * Math.PI) / 180);
+    const apex = painted.end.at.map((v, i) => v + extra * painted.end.dir[i]);
+    const source = Math.hypot(...raw.start.at.map((v, i) => v - raw.middle.at[i])) - cap;
+    const target = Math.hypot(...apex.map((v, i) => v - raw.middle.at[i]));
+    results.push({ gap, source, target, rawEnd: raw.end.at, paintedEnd: painted.end.at, apex });
+  }
+  const shape = shapeOfStyle(normalizeStyle({ rotation: -90 }), 2);
+  results.push({ solver: solveCollisions(links, shape, { adjustGaps: true }) });
+  console.log(JSON.stringify(results, null, 2));
