[2026-10-26T20:53:18.654Z] [STDOUT] {"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc 'cat src/links/issue-25.test.js && cat experiments/issue-25-reproduce.mjs && cat package.json'","aggregated_output":"import { expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { solveCollisions, overlapCost } from './collisions';\nimport { glyphParts, glyphCurves } from './glyph';\nimport { networkSvg } from './render';\nimport { normalizeStyle, shapeOfStyle, styleFromParams, styleToParams, withTurns } from './style';\nimport { withGaps } from './gaps';\n\nconst links = decode('22 22');\nconst fixture = (patch = {}) => normalizeStyle({ rotation: 90, ...patch });\nit('discovers separated reference gaps for 2222 without manual gaps', () => {\n  const style = fixture();\n  const shape = shapeOfStyle(style, 2);\n  const result = solveCollisions(links, shape, { adjustGaps: true });\n  expect(result.linkGaps[0][0]).toBeGreaterThan(0.08);\n  expect(result.linkGaps[0][1]).toBeGreaterThan(0.08);\n  expect(result.after).toBeLessThan(result.before);\n  const applied = withGaps(withTurns(style, result.turns), result.linkGaps);\n  expect(networkSvg(links, style, { extraTurns: result.delta, extraGaps: result.linkGaps })).toBe(\n    networkSvg(links, applied),\n  );\n  expect(overlapCost(links, shapeOfStyle(applied, 2))).toBeCloseTo(result.after, 8);\n});\nit('scores painted markers and user selected spacing, including near reference middles', () => {\n  const cost = (patch) => overlapCost(links, shapeOfStyle(fixture(patch), 2));\n  expect(cost({ start: 'none', end: 'none', middle: 'none' })).toBeLessThan(cost({}));\n  expect(cost({ clearance: 6 })).toBeGreaterThan(cost({ clearance: 0 }));\n  expect(cost({ strokeWidth: 5 })).toBeGreaterThan(cost({ strokeWidth: 0.5 }));\n});\nit('keeps acute arrow tips sharp independent of line corners, with balanced extent by default', () => {\n  for (const endAngle of [5, 15, 45]) {\n    const style = fixture({ turns: '15 -15', gaps: '0.18 0.18 ~ ~', endAngle, linejoin: 'round' });\n    const svg = networkSvg(links, style);\n    expect(svg).toMatch(/stroke-linejoin=\"miter\" stroke-miterlimit=\"[\\d.]+\"/);\n    const part = glyphParts(links, shapeOfStyle(style, 2))[0];\n    const numbers = (path) => path.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\n    const start = numbers(part.line).slice(0, 2);\n    const tip = numbers(part.end.d).slice(2, 4);\n    const raw = glyphParts(links, shapeOfStyle({ ...style, balanceArrows: false }, 2))[0];\n    const rawTip = numbers(raw.end.d).slice(2, 4);\n    expect(tip[1]).toBeLessThan(rawTip[1]);\n    const extension = style.strokeWidth / 2 / Math.sin((endAngle * Math.PI) / 180);\n    const curve = glyphCurves(links, shapeOfStyle(style, 2))[0];\n    expect(Math.abs(tip[1] + extension * curve.end.dir[1] - (start[1] + style.strokeWidth / 2))).toBeLessThan(0.03);\n  }\n});\nit('round trips rounded arrows, legacy lengths and spacing settings', () => {\n  const style = fixture({ arrowJoin: 'round', balanceArrows: false, clearance: 4.5 });\n  expect(styleFromParams(styleToParams(style))).toEqual(style);\n  expect(style.arrowJoin).toBe('round');\n  expect(style.balanceArrows).toBe(false);\n  expect(style.clearance).toBe(4.5);\n});\n// Run the issue regressions against the prepared branch's original source,\n// restoring current edits even when the expected failing test run returns 1.\nimport { execFileSync, spawnSync } from 'node:child_process';\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst files = execFileSync('git', ['diff', '--name-only'], { encoding: 'utf8' })\n  .trim()\n  .split('\\n')\n  .filter((p) => p.startsWith('src/'));\nconst edited = files.map((path) => [path, readFileSync(path)]);\ntry {\n  for (const [path] of edited) writeFileSync(path, execFileSync('git', ['show', `a80408d:${path}`]));\n  const result = spawnSync(\n    'npx',\n    ['vitest', 'run', 'src/links/issue-25.test.js', 'src/pages/network-25.test.jsx', '--maxWorkers=1'],\n    { encoding: 'utf8' },\n  );\n  writeFileSync('docs/case-studies/issue-25/logs/reproduce-tests.log', result.stdout + result.stderr);\n  console.log(`Original-source regression exit: ${result.status} (expected 1)`);\n  if (result.status !== 1) process.exitCode = 1;\n} finally {\n  for (const [path, content] of edited) writeFileSync(path, content);\n}\n{\n  \"name\": \"konard.github.io\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"@fontsource/chakra-petch\": \"^5.3.0\",\n    \"@fontsource/electrolize\": \"^5.3.0\",\n    \"@fontsource/orbitron\": \"^5.3.0\",\n    \"@fontsource/share-tech-mono\": \"^5.3.0\",\n    \"d3-force\": \"^3.0.0\",\n    \"react\": \"^19.0.0\",\n    \"react-dom\": \"^19.0.0\"\n  },\n  \"scripts\": {\n    \"start\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest\",\n    \"test:ci\": \"vitest run\",\n    \"test:network:browser\": \"node experiments/network-e2e.mjs\",\n    \"test:network:issue19\": \"node experiments/issue-19-browser.mjs\",\n    \"lint\": \"eslint . --max-warnings=0\",\n    \"format\": \"prettier --write .\",\n    \"format:check\": \"prettier --check .\",\n    \"check:file-size\": \"bash scripts/check-file-line-limits.sh\",\n    \"check\": \"npm run lint && npm run format:check && npm run check:file-size && npm run check:secrets\",\n    \"build:data\": \"node scripts/build-data.cjs\",\n    \"build:frames\": \"node scripts/build-frames-css.mjs\",\n    \"check:secrets\": \"[REDACTED]\\\"**/*\\\" --secretlintignore .pr…re\",\n    \"prepare\": \"husky\",\n    \"build:cv\": \"node scripts/build-cv-pdf.mjs\",\n    \"test:network:issue21\": \"node experiments/issue-21-browser.mjs\",\n    \"test:network:issue23\": \"node experiments/issue-23-browser.mjs\",\n    \"test:network:issue25\": \"node experiments/issue-25-browser.mjs\"\n  },\n  \"homepage\": \"https://konard.github.io\",\n  \"devDependencies\": {\n    \"@eslint/js\": \"^10.0.1\",\n    \"@secretlint/secretlint-rule-preset-recommend\": \"^13.0.7\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\",\n    \"@vitejs/plugin-react\": \"^6.1.2\",\n    \"eslint\": \"^10.13.0\",\n    \"eslint-plugin-react-hooks\": \"^7.1.1\",\n    \"eslint-plugin-react-refresh\": \"^0.5.7\",\n    \"globals\": \"^17.13.0\",\n    \"husky\": \"^9.1.7\",\n    \"js-yaml\": \"^4.3.2\",\n    \"jsdom\": \"^30.1.3\",\n    \"lint-staged\": \"^17.6.0\",\n    \"playwright\": \"1.63.0\",\n    \"prettier\": \"^3.9.10\",\n    \"secretlint\": \"^13.0.7\",\n    \"vite\": \"^8.3.4\",\n    \"vitest\": \"^5.0.5\"\n  },\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22\"\n  },\n  \"lint-staged\": {\n    \"*.{js,jsx,cjs,mjs}\": [\n      \"eslint --fix --max-warnings=0 --no-warn-ignored\",\n      \"prettier --write\"\n    ],\n    \"*.{css,md,html,json,yml,yaml}\": [\n      \"prettier --write\"\n    ]\n  }\n}\n","exit_code":0,"status":"completed"}}
