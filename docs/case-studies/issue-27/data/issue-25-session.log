[2026-10-26T20:54:31.058Z] [STDOUT] {"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"rg -n 'balanceArrows|arrowJoin|shapeOfStyle|applyLook|clearance|solveDebug' src/links/style.js && sed -n '1,260p' src/pages/NetworkEditor.jsx && sed -n '1,130p' src/links/render.js\"","aggregated_output":"283:        'clearance',\n296:      toggle('solveDebug', false, { en: 'Solver diagnostics in console', ru: 'Диагностика поиска в консоли' }),\n416:export function shapeOfStyle(style, n, extraTurns = null, extraGaps = null) {\n514:export function applyLook(style, id) {\n527:    clearance: style.clearance,\n528:    solveDebug: style.solveDebug,\nimport { useState } from 'react';\nimport NetworkGaps from './NetworkGaps';\nimport { canonical, decode, encode, mathNotation } from '../links/configurations';\nimport {\n  addLink,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  setReference,\n  signatureOf,\n  theoryNotation,\n} from '../links/edit';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from '../components/format';\n\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\", \"one of N networks\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst OF_NETWORKS = { en: ['network', 'networks'], ru: ['сети', 'сетей', 'сетей'] };\n// Finding the smallest renaming tries every order of the links: n! of them.\nconst CANONICAL_UP_TO = 7;\n\n/**\n * One editable notation. While it is typed in, the text stays as it is typed;\n * every valid text changes the network at once, and an invalid one shows why.\n * When the network is changed elsewhere, the field shows the new network.\n */\nfunction NotationField({ id, label, hint, value, parse, format, onLinks, multiline = false }) {\n  const { t } = useLang();\n  const [draft, setDraft] = useState(null);\n  // A draft belongs to the value it was typed against (or the value it produced).\n  const active = draft && draft.at === value;\n  const text = active ? draft.text : value;\n  const error = active ? draft.error : null;\n  const change = (event) => {\n    const next = event.target.value;\n    const result = parse(next);\n    if (result.links) {\n      setDraft({ text: next, at: format(result.links), error: null });\n      onLinks(result.links);\n    } else setDraft({ text: next, at: value, error: result.error });\n  };\n  const Input = multiline ? 'textarea' : 'input';\n  return (\n    <div className={`notation${error ? ' is-invalid' : ''}`}>\n      <label htmlFor={id}>{t(label)}</label>\n      <Input\n        id={id}\n        className=\"mono\"\n        value={text}\n        onChange={change}\n        onBlur={() => active && !error && setDraft(null)}\n        spellCheck=\"false\"\n        autoComplete=\"off\"\n        aria-invalid={error ? 'true' : undefined}\n        aria-describedby={`${id}-note`}\n        rows={multiline ? 2 : undefined}\n      />\n      <small\n        id={`${id}-note`}\n        className={error ? 'notation__error' : 'notation__hint'}\n        role={error ? 'alert' : undefined}\n      >\n        {error ? t(error) : t(hint)}\n      </small>\n    </div>\n  );\n}\n\n/** The four editable notations of the network (issue #17). */\nexport function Notations({ links, notation, onLinks }) {\n  const { lang, t } = useLang();\n  const n = links.length;\n  const count = countOf(n);\n  return (\n    <div className=\"notations\">\n      <p className=\"muted\">\n        {t({\n          en: `${n} ${plural(n, lang, LINKS)} after the zero link 0, in a doublet network ${signatureOf(notation)}: one of ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} of ${n} ${plural(n, lang, OF_LINKS)}, written with ${2 * n} digits in base ${n + 1}. Every notation below can be edited; the others follow.`,\n          ru: `${n} ${plural(n, lang, LINKS)} после нулевой связи 0 в дуплетной сети ${signatureOf(notation)}: одна из ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} из ${n} ${plural(n, lang, OF_LINKS)}, записанная ${2 * n} цифрами в системе с основанием ${n + 1}. Любую запись ниже можно изменить, остальные изменятся вслед за ней.`,\n        })}\n      </p>\n      <NotationField\n        id=\"notation-theory\"\n        label={{ en: 'Math notation (the links theory)', ru: 'Математическая нотация (теория связей)' }}\n        hint={{\n          en: 'The function of the network: link ↦ (source, target). The names may be left out.',\n          ru: 'Функция сети: связь ↦ (начало, конец). Имена связей можно не писать.',\n        }}\n        value={theoryNotation(links, notation)}\n        format={(l) => theoryNotation(l, notation)}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-pairs\"\n        label={{ en: 'Pairs with the base', ru: 'Пары с основанием' }}\n        hint={{\n          en: 'Source and target of each link as two digits (use (source,target) with a base for 10+ links), as under the symbols of the gallery.',\n          ru: 'Начало и конец каждой связи двумя цифрами (для 10+ связей — (начало,конец) с основанием), как под символами галереи.',\n        }}\n        value={mathNotation(encode(links))}\n        format={(l) => mathNotation(encode(l))}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-number\"\n        label={{ en: 'N-ary number', ru: 'N-ричное число' }}\n        hint={{\n          en: `The whole network as one number of ${2 * n} digits in base ${n + 1}; for 10+ links use space-separated digits in [brackets].`,\n          ru: `Вся сеть как одно число из ${2 * n} цифр в системе с основанием ${n + 1}; для 10+ связей разделяйте цифры пробелами в [скобках].`,\n        }}\n        value={numberNotation(links)}\n        format={numberNotation}\n        parse={parseNumber}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-decimal\"\n        label={{ en: 'The same number in decimal', ru: 'То же число в десятичной системе' }}\n        hint={{\n          en: `The position of the network among all networks of ${n} ${plural(n, lang, LINKS)}, from 0 to ${count - 1n}.`,\n          ru: `Номер сети среди всех сетей из ${n} ${plural(n, lang, OF_LINKS)}, от 0 до ${count - 1n}.`,\n        }}\n        value={decimalOf(links)}\n        format={decimalOf}\n        parse={(text) => parseIndex(text, n)}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-links\"\n        label={{ en: 'Links notation', ru: 'Нотация связей' }}\n        hint={{\n          en: '(index: source target) for each link; 0 is nothing.',\n          ru: '(индекс: начало конец) для каждой связи; 0 — это «ничего».',\n        }}\n        value={linksText(links)}\n        format={(l) => linksText(l)}\n        parse={parseLinks}\n        onLinks={onLinks}\n        multiline\n      />\n    </div>\n  );\n}\n\n/** A choice of the link that an end refers to: 0 (nothing), the link itself or another link. */\nfunction ReferenceSelect({ id, value, n, self, onChange, label }) {\n  const { t } = useLang();\n  // Avoid two n-option selects per row (quadratic DOM size) on large networks.\n  if (n > 50)\n    return (\n      <input\n        id={id}\n        type=\"number\"\n        min={0}\n        max={n}\n        step={1}\n        value={value}\n        aria-label={label}\n        onChange={(event) => {\n          const ref = Number(event.target.value);\n          if (event.target.value !== '' && Number.isInteger(ref) && ref >= 0 && ref <= n) onChange(ref);\n        }}\n      />\n    );\n  return (\n    <select id={id} value={value} onChange={(event) => onChange(Number(event.target.value))} aria-label={label}>\n      {Array.from({ length: n + 1 }, (_, ref) => (\n        <option key={ref} value={ref}>\n          {ref}\n          {ref === 0\n            ? ` — ${t({ en: 'nothing', ru: 'ничего' })}`\n            : ref === self\n              ? ` — ${t({ en: 'itself', ru: 'сама' })}`\n              : ''}\n        </option>\n      ))}\n    </select>\n  );\n}\n\n/**\n * The links one by one: what each refers to, its colour and the turns of its\n * ends, with buttons to add and remove links and to move through the networks.\n */\nexport function LinksTable({\n  links,\n  colors,\n  turns,\n  gaps,\n  style,\n  onGap,\n  onLinks,\n  onRemove,\n  onColor,\n  onTurn,\n  onStep,\n  onRandom,\n}) {\n  const { t } = useLang();\n  const n = links.length;\n  const start = t({ en: 'source', ru: 'начало' });\n  const end = t({ en: 'target', ru: 'конец' });\n  return (\n    <div className=\"links-table\">\n      <p className=\"network__lead\">\n        {t({\n          en: 'Each card contains all settings for one link. Empty gaps follow the global values shown in the fields. Reference gaps use layout units; middle cuts use 1/100 of the symbol.',\n          ru: 'В каждой карточке — все настройки одной связи. Пустые зазоры следуют общим значениям из подсказок. Зазоры ссылок — в единицах размещения, разрывы середины — в 1/100 символа.',\n        })}\n      </p>\n      <ul className=\"link-cards\" aria-label={t({ en: 'Link configurations', ru: 'Настройки связей' })}>\n        {links.map(([s, tg], i) => {\n          const name = `${t({ en: 'Link', ru: 'Связь' })} ${i + 1}`;\n          return (\n            <li className=\"link-card\" key={i}>\n              <div className=\"link-card__head\">\n                <h3>\n                  <span className=\"links-table__swatch\" style={{ background: colors[i] }} aria-hidden=\"true\" />\n                  {name}\n                </h3>\n                <button\n                  type=\"button\"\n                  className=\"button button--small\"\n                  disabled={n <= 1}\n                  onClick={() => onRemove(i + 1)}\n                  aria-label={`${t({ en: 'Remove', ru: 'Удалить' })}: ${name}`}\n                  title={t({\n                    en: 'References to this link become references to 0',\n                    ru: 'Ссылки на эту связь станут ссылками на 0',\n                  })}\n                >\n                  ✕\n                </button>\n              </div>\n              <div className=\"link-card__fields\">\n                {[\n                  [s, start, 'source'],\n                  [tg, end, 'target'],\n                ].map(([value, label, id], e) => (\n                  <label key={id} htmlFor={`link-${i + 1}-${id}`}>\n                    {t(e ? { en: 'Target', ru: 'Конец' } : { en: 'Source', ru: 'Начало' })}\n                    <ReferenceSelect\n                      id={`link-${i + 1}-${id}`}\n                      value={value}\n                      n={n}\n                      self={i + 1}\n                      label={`${name}: ${label}`}\n                      onChange={(ref) => onLinks(setReference(links, i, e, ref))}\n                    />\n                  </label>\n                ))}\n// The picture of a network as a standalone SVG document (issue #17): the\n// preview of the editor of /network/ and every image it exports (SVG, and\n// PNG, JPEG, WebP drawn from it) are this one string, so what is shared is\n// exactly what is seen. Every value comes through normalizeStyle, and the\n// caption is escaped, so a shared link cannot put markup into the picture.\nimport { mathNotation, encode } from './configurations';\nimport { linksText, numberNotation, decimalOf, theoryNotation } from './edit';\nimport { SIZE, glyphParts, arrowMiterLimit } from './glyph';\nimport { linkColors, normalizeStyle, shapeOfStyle } from './style';\n\nconst FONTS = {\n  mono: \"ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace\",\n  sans: \"system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif\",\n  serif: \"Georgia, 'Times New Roman', serif\",\n};\n// Average width of a character relative to the font size, to fit long captions.\nconst WIDTH = { mono: 0.6, sans: 0.55, serif: 0.52 };\n\nexport const escapeXml = (text) =>\n  String(text).replace(\n    /[&<>\"']/g,\n    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;' })[c],\n  );\n\nconst num = (x) => +x.toFixed(2);\n\n/** Dash pattern of the lines, relative to their width. Zero-length dots need round or square caps. */\nfunction dashArray(dash, width, cap) {\n  const dot = cap === 'butt' ? width : 0.01;\n  const pattern = {\n    dashed: [3, 2],\n    dotted: [dot / width, 2],\n    dashdot: [4, 1.6, dot / width, 1.6],\n    long: [8, 3],\n  }[dash];\n  return pattern ? pattern.map((k) => num(k * width)).join(' ') : null;\n}\n\n/** The caption of a network in the chosen notation. */\nexport function captionOf(links, style, notation = 'L') {\n  switch (style.caption) {\n    case 'theory':\n      return theoryNotation(links, notation);\n    case 'pairs':\n      return mathNotation(encode(links));\n    case 'number':\n      return `${numberNotation(links)} = ${decimalOf(links)}`;\n    case 'links':\n      return linksText(links);\n    case 'custom':\n      return style.captionText;\n    default:\n      return '';\n  }\n}\n\n/** The background and the card, in a viewBox of `w` × `h`. */\nfunction backdrop(style, w, h, defs) {\n  const parts = [];\n  if (style.background === 'solid') parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"${style.bgColor}\"/>`);\n  else if (style.background === 'linear') {\n    const a = (style.bgAngle * Math.PI) / 180;\n    const [dx, dy] = [Math.cos(a) / 2, Math.sin(a) / 2];\n    defs.push(\n      `<linearGradient id=\"bg\" x1=\"${num(0.5 - dx)}\" y1=\"${num(0.5 - dy)}\" x2=\"${num(0.5 + dx)}\" y2=\"${num(0.5 + dy)}\">` +\n        `<stop offset=\"0\" stop-color=\"${style.bgColor}\"/><stop offset=\"1\" stop-color=\"${style.bgColor2}\"/></linearGradient>`,\n    );\n    parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"url(#bg)\"/>`);\n  } else if (style.background === 'radial') {\n    defs.push(\n      `<radialGradient id=\"bg\" cx=\"0.5\" cy=\"0.5\" r=\"0.75\">` +\n        `<stop offset=\"0\" stop-color=\"${style.bgColor}\"/><stop offset=\"1\" stop-color=\"${style.bgColor2}\"/></radialGradient>`,\n    );\n    parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"url(#bg)\"/>`);\n  }\n  if (style.card) {\n    const inset = style.inset;\n    const [cw, ch] = [Math.max(w - 2 * inset, 1), Math.max(h - 2 * inset, 1)];\n    const r = Math.min(style.radius, cw / 2, ch / 2);\n    const rect = (d, extra) =>\n      `<rect x=\"${num(inset + d)}\" y=\"${num(inset + d)}\" width=\"${num(Math.max(cw - 2 * d, 0))}\" ` +\n      `height=\"${num(Math.max(ch - 2 * d, 0))}\" rx=\"${num(Math.max(r - d, 0))}\" ${extra}/>`;\n    parts.push(rect(0, `fill=\"${style.cardColor}\" fill-opacity=\"${style.cardOpacity}\"`));\n    if (style.borderStyle !== 'none') {\n      const b = style.border;\n      const stroke = `fill=\"none\" stroke=\"${style.borderColor}\" stroke-width=\"${num(b)}\"`;\n      const dash = {\n        dashed: ` stroke-dasharray=\"${num(b * 4)} ${num(b * 3)}\"`,\n        dotted: ` stroke-dasharray=\"0.01 ${num(b * 2.5)}\" stroke-linecap=\"round\"`,\n      }[style.borderStyle];\n      parts.push(rect(b / 2, stroke + (dash || '')));\n      if (style.borderStyle === 'double') parts.push(rect(b * 2.5, stroke));\n    }\n  }\n  return parts.join('');\n}\n\n/**\n * The SVG document of network `links` in `style` (any partial or untrusted\n * style; it is normalized). `notation` is 'L' or 'R' for the caption in math\n * notation, `extraTurns` the turns found by the solver of overlaps.\n */\nexport function networkSvg(\n  links,\n  rawStyle = {},\n  { notation = null, extraTurns = null, extraGaps = null, title = '' } = {},\n) {\n  const style = normalizeStyle(rawStyle);\n  const n = links.length;\n  const short = Math.min(style.width, style.height);\n  // The shorter side of the picture is SIZE units long, so the symbol keeps its size in any proportions.\n  const [w, h] = [(SIZE * style.width) / short, (SIZE * style.height) / short];\n  const defs = [];\n  const back = backdrop(style, w, h, defs);\n  const caption = captionOf(links, style, notation || style.notation);\n  const edge = style.card ? style.inset : 0;\n  const room = caption ? style.captionSize * 2.2 : 0;\n  const side = Math.max(SIZE - room - 2 * edge, 10);\n  const [x, y] = [(w - side) / 2, edge + (h - 2 * edge - room - side) / 2];\n\n  const colors = linkColors(style, n);\n  const parts = glyphParts(links, shapeOfStyle(style, n, extraTurns, extraGaps));\n  const dash = dashArray(style.dash, style.strokeWidth, style.linecap);\n  const lines = parts\n    .map(({ line, start, end, middle }, i) => {\n      const shapes = [start, end, middle]\n        .filter((m) => m.d)\n        .map((m) => {\n          const key = m === start ? 'start' : m === end ? 'end' : 'middle';\n          const arrow = ['arrow', 'triangle', 'tail'].includes(style[key]) && style.arrowJoin !== 'inherit';\n","exit_code":0,"status":"completed"}}
