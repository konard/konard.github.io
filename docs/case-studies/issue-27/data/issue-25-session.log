[2026-10-26T20:40:44.356Z] [STDOUT] {"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat src/pages/NetworkPage.jsx && cat src/pages/network-23.test.jsx && sed -n '1,130p' src/links/style-geometry.js && cat src/links/curve-tools.js\"","aggregated_output":"import { useEffect, useMemo, useState } from 'react';\nimport './settings.css';\nimport './network.css';\nimport Layout from '../components/Layout';\nimport { decode, encode, mathNotation } from '../links/configurations';\nimport { solveCollisions } from '../links/collisions';\nimport { linkGaps, withGaps } from '../links/gaps';\nimport { parseCode, removeLink, theoryNotation } from '../links/edit';\nimport { networkSvg } from '../links/render';\nimport {\n  linkColors,\n  linkTurns,\n  normalizeStyle,\n  shapeOfStyle,\n  styleFromParams,\n  styleToParams,\n  withColor,\n  withTurns,\n} from '../links/style';\nimport { LANGS, useLang } from '../i18n/prefs';\nimport { LinksTable, Notations, randomLinks, stepped } from './NetworkEditor';\nimport NetworkShare from './NetworkShare';\nimport NetworkGaps from './NetworkGaps';\nimport { Looks, StyleSections } from './NetworkStyle';\nimport { useNetworkHistory } from './useNetworkHistory';\n\n/** The network of the theory's example: two points and the link between them. */\nexport const DEFAULT_CODE = '11 22 12';\n\nconst SECTIONS = [\n  ['notations', { en: 'Notations', ru: 'Нотации' }],\n  ['links', { en: 'Links', ru: 'Связи' }],\n  ['style', { en: 'Style', ru: 'Оформление' }],\n  ['share', { en: 'Share', ru: 'Поделиться' }],\n];\n\n/** The network and the style of the picture in a query string (?code=112212&end=dot…). */\nexport function readNetwork(search) {\n  const params = new URLSearchParams(search);\n  const code = parseCode(params.get('code') || '') || DEFAULT_CODE;\n  return { links: decode(code), style: styleFromParams(params) };\n}\n\n/** \"?code=112212&…\": non-default image options and the explicit page language, if present. */\nexport function networkQuery(links, style, lang = null) {\n  const params = styleToParams(style);\n  if (LANGS.includes(lang)) params.set('lang', lang);\n  return `?code=${encode(links).replace(/ /g, '')}${params.size ? `&${params}` : ''}`;\n}\n\n/** The page of one network (issue #17): view it, edit it in every notation, style its picture and share it. */\nexport default function NetworkPage() {\n  const { t } = useLang();\n  const [initial] = useState(() => readNetwork(window.location.search));\n  const [links, setLinks] = useState(initial.links);\n  const [style, setStyleState] = useState(initial.style);\n  const notation = style.notation;\n  const setStyle = (next) => setStyleState(normalizeStyle(next));\n  const n = links.length;\n  const code = encode(links);\n  const query = networkQuery(links, style, new URLSearchParams(window.location.search).get('lang'));\n\n  useNetworkHistory(query);\n  // Existing links may open a section directly, such as /network/?code=…#share.\n  useEffect(() => {\n    const target = window.location.hash && document.getElementById(window.location.hash.slice(1));\n    target?.scrollIntoView?.();\n  }, []);\n\n  const shape = shapeOfStyle(style, n);\n  const solverOptions = {\n    range: style.solveRange,\n    step: style.solveStep,\n    adjustGaps: style.solveGaps,\n    gapRange: style.solveGapRange,\n    middleRange: style.solveMiddleRange,\n  };\n  const shapeKey = JSON.stringify([code, shape, solverOptions]);\n  // The experimental solver of overlaps; it runs only when it is switched on or asked for.\n  const solved = useMemo(\n    () => (style.solve ? solveCollisions(links, shape, solverOptions) : null),\n    // shapeKey stands for links, shape and the options of the solver.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n    [shapeKey, style.solve],\n  );\n  const svg = useMemo(\n    () => networkSvg(links, style, { notation, extraTurns: solved?.delta, extraGaps: solved?.linkGaps }),\n    [links, style, notation, solved],\n  );\n  const colors = linkColors(style, n);\n  const turns = linkTurns(style, n);\n  const gaps = linkGaps(style, n);\n\n  const changeLinks = (next) => setLinks(next);\n  const remove = (k) => {\n    const keep = (list) => list.filter((_, i) => i !== k - 1);\n    setLinks(removeLink(links, k));\n    let next = withTurns(style, keep(linkTurns(style, n)));\n    next = withGaps(next, keep(gaps));\n    if (style.palette === 'custom') next = { ...next, colors: keep(linkColors(style, n)).join(',') };\n    setStyle(next);\n  };\n  const turn = (i, end, value) =>\n    setStyle(\n      withTurns(\n        style,\n        turns.map((pair, k) => (k === i ? pair.map((a, e) => (e === end ? value : a)) : pair)),\n      ),\n    );\n  const applySolved = () => {\n    const found = solved || solveCollisions(links, shape, solverOptions);\n    setStyle({ ...withGaps(withTurns(style, found.turns), found.linkGaps), solve: false });\n  };\n\n  const url = `${window.location.origin}/network/${query}`;\n  const text = `${t({ en: 'Links network', ru: 'Сеть связей' })} ${mathNotation(code)}: ${theoryNotation(links, notation)}`;\n\n  return (\n    <Layout page=\"network\" sections={SECTIONS}>\n      <section className=\"section network\" id=\"top\">\n        <h1 className=\"section__title\">\n          {t({ en: 'Links network', ru: 'Сеть связей' })}{' '}\n          <span className=\"mono network__code\">{mathNotation(code)}</span>\n        </h1>\n        <p className=\"section__lead\">\n          {t({\n            en: 'One network of doublet links: change it in any notation or link by link, change every detail of its picture and save or share it. The address of the page keeps everything, so a link opens exactly this picture.',\n            ru: 'Одна сеть дуплетных связей: меняйте её в любой нотации или по одной связи, меняйте каждую деталь её картинки, сохраняйте и делитесь. Адрес страницы хранит всё, поэтому ссылка открывает ровно эту картинку.',\n          })}{' '}\n          <a href=\"/art/#symbols\">{t({ en: 'All networks of 1–4 links', ru: 'Все сети из 1–4 связей' })}</a>\n        </p>\n        <div className=\"network__layout\">\n          <figure className=\"network__view\">\n            <div\n              className={`network__preview${style.background === 'transparent' ? ' is-transparent' : ''}`}\n              style={{ aspectRatio: `${style.width} / ${style.height}` }}\n              // The SVG names itself (role img, aria-label). It is built from normalized\n              // options only and its caption is escaped (src/links/render.js).\n              dangerouslySetInnerHTML={{ __html: svg }}\n            />\n            <figcaption className=\"mono\">\n              {theoryNotation(links, notation)}\n              {solved && (\n                <span className=\"network__score\">\n                  {' · '}\n                  {t({ en: 'overlaps', ru: 'наложения' })} {solved.before.toFixed(1)} → {solved.after.toFixed(1)}\n                </span>\n              )}\n            </figcaption>\n          </figure>\n          <div className=\"network__panels\">\n            <section id=\"notations\" className=\"network__panel\" aria-labelledby=\"notations-title\">\n              <h2 id=\"notations-title\">{t({ en: 'Notations', ru: 'Нотации' })}</h2>\n              <Notations links={links} notation={notation} onLinks={changeLinks} />\n            </section>\n            <section id=\"links\" className=\"network__panel\" aria-labelledby=\"links-title\">\n              <h2 id=\"links-title\">{t({ en: 'Links', ru: 'Связи' })}</h2>\n              <LinksTable\n                links={links}\n                colors={colors}\n                turns={turns}\n                onLinks={changeLinks}\n                onRemove={remove}\n                onColor={(i, value) => setStyle(withColor(style, n, i, value))}\n                onTurn={turn}\n                onStep={(step) => setLinks(stepped(links, step))}\n                onRandom={() => setLinks(randomLinks(n))}\n              />\n              <NetworkGaps\n                gaps={gaps}\n                style={style}\n                onGap={(i, k, value) =>\n                  setStyle(\n                    withGaps(\n                      style,\n                      gaps.map((row, j) => (j === i ? row.map((v, column) => (column === k ? value : v)) : row)),\n                    ),\n                  )\n                }\n              />\n            </section>\n            <section className=\"network__panel\" id=\"style\" aria-labelledby=\"style-title\">\n              <h2 id=\"style-title\">{t({ en: 'Style of the picture', ru: 'Оформление картинки' })}</h2>\n              <p className=\"network__lead\">\n                {t({\n                  en: 'Start from a look and change any detail. A card like in the gallery, or no card at all and only the lines on a black or transparent background: both are here.',\n                  ru: 'Начните с готового оформления и меняйте любую деталь. Карточка как в галерее или без карточки, только линии на чёрном или прозрачном фоне: есть и то, и другое.',\n                })}\n              </p>\n              <Looks style={style} onStyle={setStyle} />\n              <div className=\"network__styles\">\n                <StyleSections links={links} style={style} onStyle={setStyle}>\n                  <div className=\"network__actions\">\n                    <button type=\"button\" className=\"button button--small\" onClick={applySolved}>\n                      {t({ en: 'Apply turns and gaps to links', ru: 'Применить повороты и зазоры связей' })}\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"button button--small\"\n                      disabled={!style.turns}\n                      onClick={() => setStyle({ ...style, turns: '' })}\n                    >\n                      {t({ en: 'Clear all turns', ru: 'Убрать все повороты' })}\n                    </button>\n                  </div>\n                </StyleSections>\n              </div>\n            </section>\n            <section id=\"share\" className=\"network__panel\" aria-labelledby=\"share-title\">\n              <h2 id=\"share-title\">{t({ en: 'Save and share', ru: 'Сохранить и поделиться' })}</h2>\n              <NetworkShare code={code} links={links} svg={svg} style={style} url={url} text={text} />\n            </section>\n          </div>\n        </div>\n      </section>\n    </Layout>\n  );\n}\nimport { act, fireEvent, render, screen, within } from '@testing-library/react';\nimport { afterEach, expect, it, vi } from 'vitest';\nimport NetworkPage from './NetworkPage';\nimport NetworkGallery from '../components/NetworkGallery';\n\nafterEach(() => {\n  vi.useRealTimers();\n  window.history.replaceState(null, '', '/');\n});\nit('offers one aligned navigation target per gallery card', () => {\n  render(<NetworkGallery initial={1} />);\n  const list = screen.getByRole('list', { name: 'Networks of 1 link' });\n  expect(within(list).getAllByRole('link')).toHaveLength(4);\n  expect(list.querySelector('.symbols__share')).toBeNull();\n});\nit('edits independent gaps, resets inheritance and preserves gaps when removing a link', () => {\n  vi.useFakeTimers();\n  window.history.replaceState(null, '', '/network/?code=1122');\n  render(<NetworkPage />);\n  const gap = (i, label) => screen.getByLabelText(`Link ${i}: ${label}`);\n  const first = gap(1, 'Gap at the source reference');\n  expect(first).toHaveValue(null);\n  expect(first).toHaveAttribute('placeholder', '0.08');\n  fireEvent.change(first, { target: { value: '0.25' } });\n  fireEvent.change(gap(2, 'Cut after the middle'), { target: { value: '4' } });\n  act(() => vi.advanceTimersByTime(450));\n  expect(new URLSearchParams(window.location.search).get('gaps')).toBe('0.25 ~ ~ ~,~ ~ ~ 4');\n  fireEvent.click(screen.getByRole('button', { name: 'Remove: Link 1' }));\n  expect(gap(1, 'Cut after the middle')).toHaveValue(4);\n  fireEvent.change(gap(1, 'Cut after the middle'), { target: { value: '' } });\n  act(() => vi.advanceTimersByTime(450));\n  expect(new URLSearchParams(window.location.search).has('gaps')).toBe(false);\n});\nimport { option, range, select, toggle } from '../settings/fields';\nimport { MARKERS, SHAPE } from './glyph';\n\nconst names = {\n  bar: ['Bar', 'Черта'],\n  arrow: ['Arrow', 'Стрелка'],\n  triangle: ['Triangle', 'Треугольник'],\n  tail: ['Tail (reversed arrow)', 'Хвост (обратная стрелка)'],\n  dot: ['Dot', 'Точка'],\n  circle: ['Ring', 'Кольцо'],\n  square: ['Square', 'Квадрат'],\n  diamond: ['Diamond', 'Ромб'],\n  none: ['None', 'Нет'],\n};\nexport const EDITOR_SHAPE = {\n  ...SHAPE,\n  bendMode: 'curve',\n  angles: 'fixed',\n  sourceAngle: 30,\n  targetAngle: 30,\n  tension: 0.4,\n  bulge: 0,\n  loopBend: 0,\n  startGap: 0.08,\n  endGap: 0.08,\n  startSize: 2.5,\n  startAngle: 70,\n  startOffset: 2.5,\n  endSize: 3.5,\n  endAngle: 45,\n  middle: 'dot',\n  middleSize: 2,\n  placement: 'auto',\n};\nconst field = (key, min, max, step, en, ru, extra = {}) =>\n  range(key, EDITOR_SHAPE[key], min, max, step, { en, ru }, extra);\nconst degrees = { unit: '°' };\n\nexport const GEOMETRY_SECTIONS = [\n  {\n    id: 'placement',\n    title: { en: 'Placement in space', ru: 'Размещение в пространстве' },\n    fields: [\n      select(\n        'placement',\n        'auto',\n        [\n          option('auto', 'Automatic (circle for 1–4, hexagonal after)', 'Авто (круг для 1–4, далее шестиугольники)'),\n          option('circle', 'Circle', 'Круг'),\n          option('square', 'Square grid', 'Квадратная сетка'),\n          option('hex', 'Hexagonal grid', 'Шестиугольная сетка'),\n          option('dice', 'Dice', 'Игральные кости'),\n          option('cards', 'Playing cards', 'Игральные карты'),\n          option('spiral', 'Sunflower spiral', 'Спираль подсолнуха'),\n          option('force', 'Physical forces', 'Физические силы'),\n        ],\n        { en: 'Placement', ru: 'Размещение' },\n      ),\n      field('layoutAspect', 0.3, 3, 0.05, 'Horizontal layout scale', 'Масштаб размещения по горизонтали'),\n      field('columns', 0, 30, 1, 'Grid columns (0 = automatic)', 'Столбцы сетки (0 = авто)', {\n        when: (s) => s.placement === 'square',\n      }),\n      ...[\n        ['forceDistance', 'Spring length', 'Длина пружины'],\n        ['forceCharge', 'Repulsion', 'Отталкивание'],\n        ['forceCollision', 'Space for links and loops', 'Пространство связей и петель'],\n      ].map(([key, en, ru]) =>\n        range(key, SHAPE[key], 0.2, 3, 0.05, { en, ru }, { when: (s) => s.placement === 'force' }),\n      ),\n    ],\n  },\n  {\n    id: 'shape',\n    title: { en: 'Shape of the links', ru: 'Форма связей' },\n    fields: [\n      select(\n        'bendMode',\n        EDITOR_SHAPE.bendMode,\n        [\n          option('curve', 'Bend the curve', 'Изгибать кривую'),\n          option('rotate', 'Legacy tangent rotation', 'Прежний поворот касательной'),\n        ],\n        { en: 'Bend behavior', ru: 'Поведение изгиба' },\n      ),\n      select(\n        'angles',\n        EDITOR_SHAPE.angles,\n        [\n          option('mirror', 'Mirror the middle (as in the gallery)', 'Отражение середины (как в галерее)'),\n          option('fixed', 'Fixed angles', 'Заданные углы'),\n        ],\n        { en: 'Angles of the ends', ru: 'Углы концов' },\n      ),\n      field('sourceAngle', -180, 180, 1, 'Leaving angle', 'Угол выхода', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      field('targetAngle', -180, 180, 1, 'Entering angle', 'Угол входа', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      toggle('lens', SHAPE.lens, {\n        en: 'Two references to one link make a lens',\n        ru: 'Две ссылки на одну связь образуют линзу',\n      }),\n      field('tension', 0, 2, 0.01, 'Curvature', 'Изгиб', { unit: '%' }),\n      field('bulge', -180, 180, 1, 'Bend', 'Изгиб кривой', {\n        ...degrees,\n        hint: {\n          en: 'Curve mode bends free ends and widens self loops with fixed endpoints. Use Rotation to turn the whole network.',\n          ru: 'Режим кривой изгибает свободные концы и расширяет собственные петли с неподвижными концами. Для поворота всей сети используйте «Поворот».',\n        },\n      }),\n      field('loopBend', -180, 180, 1, 'Loop bend', 'Изгиб петли', {\n        ...degrees,\n        hint: {\n          en: 'Widens or narrows self-reference loops independently of straight free ends. Zero keeps balanced loops.',\n          ru: 'Расширяет или сужает собственные петли независимо от прямых свободных концов. Ноль сохраняет сбалансированные петли.',\n        },\n        when: (s) => s.bendMode === 'curve',\n      }),\n      field('startGap', 0, 1, 0.01, 'Gap at the source reference', 'Зазор у начальной ссылки'),\n      field('endGap', 0, 1, 0.01, 'Gap at the target reference', 'Зазор у конечной ссылки'),\n      field('free', 0.05, 5, 0.05, 'Length of a free end', 'Длина свободного конца', { unit: '×' }),\n      field('loop', 0.05, 5, 0.05, 'Size of a loop', 'Размер петли', { unit: '×' }),\n      field('spread', 0.1, 5, 0.05, 'Distance between links', 'Расстояние между связями', { unit: '×' }),\n      field('rotation', -180, 359, 1, 'Rotation', 'Поворот', degrees),\n      field('padding', 0, 40, 1, 'Margin', 'Поля', { unit: '%' }),\n    ],\n  },\nconst mix = (a, b, t) => a.map((v, i) => v + (b[i] - v) * t);\nconst distance = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);\n\n/** Exact de Casteljau subdivision, preserving the cubic's endpoint tangents. */\nexport function splitCurve([a, b, c, d], t) {\n  const [ab, bc, cd] = [mix(a, b, t), mix(b, c, t), mix(c, d, t)];\n  const [abc, bcd] = [mix(ab, bc, t), mix(bc, cd, t)];\n  const at = mix(abc, bcd, t);\n  return [\n    [a, ab, abc, at],\n    [at, bcd, cd, d],\n  ];\n}\n\n/** Trim an arc length from one end; a fully consumed half is omitted. */\nexport function trimCurve(segment, amount, fromStart = false) {\n  if (amount <= 0) return segment;\n  const curve = fromStart ? segment : [...segment].reverse();\n  let previous = curve[0];\n  let travelled = 0;\n  for (let k = 1; k <= 128; k++) {\n    const point = splitCurve(curve, k / 128)[0][3];\n    const step = distance(previous, point);\n    if (travelled + step >= amount) {\n      const t = (k - 1 + (amount - travelled) / Math.max(step, 1e-12)) / 128;\n      const kept = splitCurve(curve, t)[1];\n      return fromStart ? kept : kept.reverse();\n    }\n    travelled += step;\n    previous = point;\n  }\n  return null;\n}\n\nconst evaluate = ([a, b, c, d], t) => {\n  const u = 1 - t;\n  return a.map((v, i) => u * u * u * v + 3 * u * u * t * b[i] + 3 * u * t * t * c[i] + t * t * t * d[i]);\n};\nconst tangent = ([a, b, c, d], t) => {\n  const u = 1 - t;\n  let dir = a.map((v, i) => 3 * u * u * (b[i] - v) + 6 * u * t * (c[i] - b[i]) + 3 * t * t * (d[i] - c[i]));\n  if (Math.hypot(...dir) < 1e-10) {\n    dir = evaluate([a, b, c, d], Math.min(1, t + 1e-5)).map(\n      (v, i) => v - evaluate([a, b, c, d], Math.max(0, t - 1e-5))[i],\n    );\n  }\n  const length = Math.hypot(...dir);\n  return length < 1e-12 ? [1, 0] : dir.map((v) => v / length);\n};\n\n/** Arc-length placement on a cubic chain; out-of-path offsets extend its end tangent.\n * A bounded 256-sample table per cubic gives sub-pixel accuracy in the 100-unit box.\n * Middle offsets start at the join, positive in the direction of the line.\n */\nexport function pointAlongCurve(segments, offset, origin = 'start') {\n  const table = [{ length: 0, segment: 0, t: 0 }];\n  let length = 0;\n  let middleLength = 0;\n  for (let i = 0; i < segments.length; i++) {\n    let previous = segments[i][0];\n    for (let k = 1; k <= 256; k++) {\n      const t = k / 256;\n      const point = evaluate(segments[i], t);\n      length += distance(previous, point);\n      table.push({ length, segment: i, t });\n      previous = point;\n    }\n    if (i === 0) middleLength = length;\n  }\n  const target = offset + (origin === 'end' ? length : origin === 'middle' ? middleLength : 0);\n  if (target <= 0 || target >= length) {\n    const first = target <= 0;\n    const segment = first ? segments[0] : segments.at(-1);\n    const at = first ? segment[0] : segment[3];\n    const dir = tangent(segment, first ? 0 : 1);\n    return { at: at.map((v, i) => v + dir[i] * (first ? target : target - length)), dir };\n  }\n  let lo = 1;\n  let hi = table.length - 1;\n  while (lo < hi) {\n    const mid = (lo + hi) >> 1;\n    if (table[mid].length < target) lo = mid + 1;\n    else hi = mid;\n  }\n  const right = table[lo];\n  const left = table[lo - 1];\n  const startT = left.segment === right.segment ? left.t : 0;\n  const t = startT + ((right.t - startT) * (target - left.length)) / Math.max(right.length - left.length, 1e-12);\n  return { at: evaluate(segments[right.segment], t), dir: tangent(segments[right.segment], t) };\n}\n","exit_code":0,"status":"completed"}}
