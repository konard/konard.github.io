[2026-10-26T21:21:05.476Z] [STDOUT] {"type":"item.completed","item":{"id":"item_243","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,110p' experiments/issue-25-pixels.mjs\nsed -n '1,125p' experiments/issue-25-solver.mjs\"","aggregated_output":"// Bounded native-pixel investigation: one SVG, two resolutions, endpoint rows.\n/* global document, Image */\nimport { readFile, writeFile } from 'node:fs/promises';\nimport { webkit } from 'playwright';\nconst { cases } = JSON.parse(await readFile('docs/case-studies/issue-25/data/webkit-browser.json', 'utf8'));\nconst browser = await webkit.launch();\nconst measurements = [];\ntry {\n  const page = await browser.newPage();\n  for (const size of [1000, 2000]) {\n    measurements.push(\n      await page.evaluate(\n        async ({ svg, size }) => {\n          const image = new Image();\n          image.src = `data:image/svg+xml,${encodeURIComponent(svg.replace('width=\"2048\" height=\"2048\"', `width=\"${size}\" height=\"${size}\"`))}`;\n          await image.decode();\n          const canvas = document.createElement('canvas');\n          canvas.width = canvas.height = size;\n          const ctx = canvas.getContext('2d');\n          ctx.drawImage(image, 0, 0, size, size);\n          const pixels = ctx.getImageData(0, 0, size, size).data;\n          const bottom = [-1, -1];\n          const rows = Array.from({ length: size * 0.02 }, (_, j) => {\n            const y = size * 0.63 + j;\n            const maxBlue = [0, 0];\n            for (let x = 0; x < size; x++) {\n              const i = (y * size + x) * 4;\n              if (pixels[i] < pixels[i + 2] * 0.3 && pixels[i + 1] > pixels[i + 2] * 0.7) {\n                const side = x < size / 2 ? 0 : 1;\n                maxBlue[side] = Math.max(maxBlue[side], pixels[i + 2]);\n                if (pixels[i + 2] > 5) bottom[side] = y;\n              }\n            }\n            return { y, maxBlue };\n          });\n          return { size, bottom, rows };\n        },\n        { svg: cases.acute.svg, size },\n      ),\n    );\n  }\n  await writeFile('docs/case-studies/issue-25/data/webkit-pixels.json', JSON.stringify(measurements, null, 2));\n  console.log(JSON.stringify(measurements));\n} finally {\n  await browser.close();\n}\n// Finite numerical fixtures: archive solver choices, exact scores and timings.\nimport { createServer } from 'vite';\nimport { writeFile } from 'node:fs/promises';\nconst server = await createServer({ server: { middlewareMode: true } });\ntry {\n  const { solveCollisions, overlapCost } = await server.ssrLoadModule('/src/links/collisions.js');\n  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');\n  const links = [\n    [2, 2],\n    [2, 2],\n  ];\n  const results = [];\n  for (const patch of [\n    {},\n    { gaps: '0.18 0.18 ~ ~' },\n    { turns: '15 -15', gaps: '0.18 0.18 ~ ~' },\n    { clearance: 0 },\n    { clearance: 4 },\n    { clearance: 6 },\n  ]) {\n    const style = normalizeStyle({ rotation: 90, ...patch });\n    const shape = shapeOfStyle(style, 2);\n    const start = performance.now();\n    const solved = solveCollisions(links, shape, { adjustGaps: true });\n    const result = { patch, ms: performance.now() - start, original: overlapCost(links, shape), ...solved };\n    console.log(JSON.stringify(result));\n    results.push(result);\n  }\n  await writeFile('docs/case-studies/issue-25/data/solver.json', JSON.stringify(results, null, 2));\n} finally {\n  await server.close();\n}\n","exit_code":0,"status":"completed"}}
