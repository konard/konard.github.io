[2026-10-26T20:40:21.092Z] [STDOUT] {"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat src/links/curve-tools.js src/links/gaps.js src/pages/network-23.test.jsx src/links/geometry-23.test.js && sed -n '80,240p' src/pages/network.css && rg -n 'links-table|link-gaps|summary|LinksTable' src/pages/*.test.jsx experiments/*network* experiments/issue-{19,21,23}*\"","aggregated_output":"const mix = (a, b, t) => a.map((v, i) => v + (b[i] - v) * t);\nconst distance = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);\n\n/** Exact de Casteljau subdivision, preserving the cubic's endpoint tangents. */\nexport function splitCurve([a, b, c, d], t) {\n  const [ab, bc, cd] = [mix(a, b, t), mix(b, c, t), mix(c, d, t)];\n  const [abc, bcd] = [mix(ab, bc, t), mix(bc, cd, t)];\n  const at = mix(abc, bcd, t);\n  return [\n    [a, ab, abc, at],\n    [at, bcd, cd, d],\n  ];\n}\n\n/** Trim an arc length from one end; a fully consumed half is omitted. */\nexport function trimCurve(segment, amount, fromStart = false) {\n  if (amount <= 0) return segment;\n  const curve = fromStart ? segment : [...segment].reverse();\n  let previous = curve[0];\n  let travelled = 0;\n  for (let k = 1; k <= 128; k++) {\n    const point = splitCurve(curve, k / 128)[0][3];\n    const step = distance(previous, point);\n    if (travelled + step >= amount) {\n      const t = (k - 1 + (amount - travelled) / Math.max(step, 1e-12)) / 128;\n      const kept = splitCurve(curve, t)[1];\n      return fromStart ? kept : kept.reverse();\n    }\n    travelled += step;\n    previous = point;\n  }\n  return null;\n}\n\nconst evaluate = ([a, b, c, d], t) => {\n  const u = 1 - t;\n  return a.map((v, i) => u * u * u * v + 3 * u * u * t * b[i] + 3 * u * t * t * c[i] + t * t * t * d[i]);\n};\nconst tangent = ([a, b, c, d], t) => {\n  const u = 1 - t;\n  let dir = a.map((v, i) => 3 * u * u * (b[i] - v) + 6 * u * t * (c[i] - b[i]) + 3 * t * t * (d[i] - c[i]));\n  if (Math.hypot(...dir) < 1e-10) {\n    dir = evaluate([a, b, c, d], Math.min(1, t + 1e-5)).map(\n      (v, i) => v - evaluate([a, b, c, d], Math.max(0, t - 1e-5))[i],\n    );\n  }\n  const length = Math.hypot(...dir);\n  return length < 1e-12 ? [1, 0] : dir.map((v) => v / length);\n};\n\n/** Arc-length placement on a cubic chain; out-of-path offsets extend its end tangent.\n * A bounded 256-sample table per cubic gives sub-pixel accuracy in the 100-unit box.\n * Middle offsets start at the join, positive in the direction of the line.\n */\nexport function pointAlongCurve(segments, offset, origin = 'start') {\n  const table = [{ length: 0, segment: 0, t: 0 }];\n  let length = 0;\n  let middleLength = 0;\n  for (let i = 0; i < segments.length; i++) {\n    let previous = segments[i][0];\n    for (let k = 1; k <= 256; k++) {\n      const t = k / 256;\n      const point = evaluate(segments[i], t);\n      length += distance(previous, point);\n      table.push({ length, segment: i, t });\n      previous = point;\n    }\n    if (i === 0) middleLength = length;\n  }\n  const target = offset + (origin === 'end' ? length : origin === 'middle' ? middleLength : 0);\n  if (target <= 0 || target >= length) {\n    const first = target <= 0;\n    const segment = first ? segments[0] : segments.at(-1);\n    const at = first ? segment[0] : segment[3];\n    const dir = tangent(segment, first ? 0 : 1);\n    return { at: at.map((v, i) => v + dir[i] * (first ? target : target - length)), dir };\n  }\n  let lo = 1;\n  let hi = table.length - 1;\n  while (lo < hi) {\n    const mid = (lo + hi) >> 1;\n    if (table[mid].length < target) lo = mid + 1;\n    else hi = mid;\n  }\n  const right = table[lo];\n  const left = table[lo - 1];\n  const startT = left.segment === right.segment ? left.t : 0;\n  const t = startT + ((right.t - startT) * (target - left.length)) / Math.max(right.length - left.length, 1e-12);\n  return { at: evaluate(segments[right.segment], t), dir: tangent(segments[right.segment], t) };\n}\n// Per-link overrides share the global units: reference gaps in layout units,\n// middle cuts in 1/100 of the symbol. Null inherits, including after global edits.\nexport const GAP_FIELDS = [\n  { key: 'startGap', max: 1, step: 0.01, label: { en: 'Gap at the source reference', ru: 'Зазор у начальной ссылки' } },\n  { key: 'endGap', max: 1, step: 0.01, label: { en: 'Gap at the target reference', ru: 'Зазор у конечной ссылки' } },\n  { key: 'middleGapStart', max: 30, step: 0.1, label: { en: 'Cut before the middle', ru: 'Разрыв перед серединой' } },\n  { key: 'middleGapEnd', max: 30, step: 0.1, label: { en: 'Cut after the middle', ru: 'Разрыв после середины' } },\n];\nexport function normalizeGaps(value) {\n  const rows = String(value ?? '')\n    .split(',')\n    .map((row) => {\n      const values = row.trim().split(/\\s+/);\n      return GAP_FIELDS.map(({ max }, i) => {\n        const raw = values[i];\n        const number = raw === undefined || raw === '~' || raw === '' ? NaN : Number(raw);\n        return Number.isFinite(number) ? Math.round(Math.min(max, Math.max(0, number)) * 1000) / 1000 : null;\n      });\n    });\n  while (rows.length && rows.at(-1).every((v) => v === null)) rows.pop();\n  return rows.map((row) => row.map((v) => (v === null ? '~' : v)).join(' ')).join(',');\n}\nexport function linkGaps(style, n) {\n  const rows = style.gaps\n    ? style.gaps.split(',').map((row) => row.split(' ').map((v) => (v === '~' ? null : Number(v))))\n    : [];\n  return Array.from({ length: n }, (_, i) => rows[i] || [null, null, null, null]);\n}\nexport const gapsText = (rows) => rows.map((row) => row.map((v) => (v == null ? '~' : v)).join(' ')).join(',');\nexport const withGaps = (style, rows) => ({ ...style, gaps: normalizeGaps(gapsText(rows)) });\nimport { act, fireEvent, render, screen, within } from '@testing-library/react';\nimport { afterEach, expect, it, vi } from 'vitest';\nimport NetworkPage from './NetworkPage';\nimport NetworkGallery from '../components/NetworkGallery';\n\nafterEach(() => {\n  vi.useRealTimers();\n  window.history.replaceState(null, '', '/');\n});\nit('offers one aligned navigation target per gallery card', () => {\n  render(<NetworkGallery initial={1} />);\n  const list = screen.getByRole('list', { name: 'Networks of 1 link' });\n  expect(within(list).getAllByRole('link')).toHaveLength(4);\n  expect(list.querySelector('.symbols__share')).toBeNull();\n});\nit('edits independent gaps, resets inheritance and preserves gaps when removing a link', () => {\n  vi.useFakeTimers();\n  window.history.replaceState(null, '', '/network/?code=1122');\n  render(<NetworkPage />);\n  const gap = (i, label) => screen.getByLabelText(`Link ${i}: ${label}`);\n  const first = gap(1, 'Gap at the source reference');\n  expect(first).toHaveValue(null);\n  expect(first).toHaveAttribute('placeholder', '0.08');\n  fireEvent.change(first, { target: { value: '0.25' } });\n  fireEvent.change(gap(2, 'Cut after the middle'), { target: { value: '4' } });\n  act(() => vi.advanceTimersByTime(450));\n  expect(new URLSearchParams(window.location.search).get('gaps')).toBe('0.25 ~ ~ ~,~ ~ ~ 4');\n  fireEvent.click(screen.getByRole('button', { name: 'Remove: Link 1' }));\n  expect(gap(1, 'Cut after the middle')).toHaveValue(4);\n  fireEvent.change(gap(1, 'Cut after the middle'), { target: { value: '' } });\n  act(() => vi.advanceTimersByTime(450));\n  expect(new URLSearchParams(window.location.search).has('gaps')).toBe(false);\n});\nimport { describe, expect, it } from 'vitest';\nimport { bezier, glyphCurves, glyphParts, layoutCurves } from './glyph';\nimport { STYLE_DEFAULTS, STYLE_FIELDS, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams } from './style';\n\nconst shape = (raw = {}, n = 1) => shapeOfStyle(normalizeStyle(raw), n);\nconst numbers = (path) => path.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\nconst sub = (a, b) => a.map((v, i) => v - b[i]);\nconst cross = (a, b) => a[0] * b[1] - a[1] * b[0];\n\ndescribe('issue 23 geometry regressions', () => {\n  it('defaults to straight free links with neutral bend and rotation', () => {\n    expect(STYLE_DEFAULTS.bulge).toBe(0);\n    expect(STYLE_DEFAULTS.rotation).toBe(0);\n    const [curve] = layoutCurves([[0, 0]], shape());\n    const axis = sub(curve.end.at, curve.start.at);\n    for (const segment of curve.segments)\n      for (let k = 0; k <= 20; k++)\n        expect(Math.abs(cross(sub(bezier(segment, k / 20), curve.start.at), axis))).toBeLessThan(1e-10);\n  });\n\n  it('accepts signed bends and endpoint angles over a full turn', () => {\n    for (const key of ['bulge', 'rotation', 'sourceAngle', 'targetAngle']) {\n      const field = STYLE_FIELDS.find((f) => f.key === key);\n      expect(field.min, key).toBeLessThanOrEqual(-180);\n      expect(field.max, key).toBeGreaterThanOrEqual(180);\n      expect(normalizeStyle({ [key]: -150 })[key]).toBe(-150);\n    }\n  });\n\n  it('adjusts self/partial loop width independently while leaving free links straight', () => {\n    const free = layoutCurves([[0, 0]], shape());\n    for (const loopBend of [-180, 0, 180]) {\n      expect(layoutCurves([[0, 0]], shape({ loopBend }))).toEqual(free);\n      for (const links of [[[1, 1]], [[0, 1]], [[1, 0]]]) {\n        const [base] = layoutCurves(links, shape());\n        const [curve] = layoutCurves(links, shape({ loopBend }));\n        expect(curve.start.at).toEqual(base.start.at);\n        expect(curve.end.at).toEqual(base.end.at);\n        if (loopBend !== 0) expect(curve.segments).not.toEqual(base.segments);\n        if (links[0][0] === 0) expect(curve.segments[0]).toEqual(base.segments[0]);\n        if (links[0][1] === 0) expect(curve.segments[1]).toEqual(base.segments[1]);\n      }\n    }\n  });\n\n  it('moves a source bar along its cubic and rotates it with the local tangent', () => {\n    const options = shape({ bulge: 90, startOffset: 12 });\n    const [curve] = glyphCurves([[0, 0]], options);\n    const [part] = glyphParts([[0, 0]], options);\n    const [x1, y1, x2, y2] = numbers(part.start.d);\n    const at = [(x1 + x2) / 2, (y1 + y2) / 2];\n    let best = { distance: Infinity };\n    for (let k = 0; k <= 10000; k++) {\n      const t = k / 10000;\n      const p = bezier(curve.segments[0], t);\n      const distance = Math.hypot(...sub(p, at));\n      if (distance < best.distance) best = { distance, t };\n    }\n    expect(best.distance).toBeLessThan(0.02);\n    const tangent = sub(bezier(curve.segments[0], best.t + 0.00001), bezier(curve.segments[0], best.t - 0.00001));\n    const bar = [x2 - x1, y2 - y1];\n    expect(\n      Math.abs((tangent[0] * bar[0] + tangent[1] * bar[1]) / Math.hypot(...tangent) / Math.hypot(...bar)),\n    ).toBeLessThan(0.005);\n  });\n\n  it('preserves independent per-link gaps through normalization and sharing', () => {\n    const style = normalizeStyle({ gaps: '0.2 0.3 4 5,~ 0 0 0' });\n    expect(style.gaps).toBe('0.2 0.3 4 5,~ 0 0 0');\n    expect(styleFromParams(styleToParams(style))).toEqual(style);\n    const links = [\n      [1, 1],\n      [2, 2],\n    ];\n    const curves = layoutCurves(links, shapeOfStyle(style, 2));\n    const distance = (a, b) => Math.hypot(...sub(a, b));\n    expect(distance(curves[0].start.at, curves[0].middle.at)).toBeCloseTo(0.2, 10);\n    expect(distance(curves[0].end.at, curves[0].middle.at)).toBeCloseTo(0.3, 10);\n    expect(distance(curves[1].start.at, curves[1].middle.at)).toBeCloseTo(STYLE_DEFAULTS.startGap, 10);\n    const parts = glyphParts(links, shapeOfStyle(style, 2));\n    expect(parts[0].line.match(/M/g)).toHaveLength(2);\n    expect(parts[1].line.match(/M/g)).toHaveLength(1);\n  });\n});\n.settings__head h3 {\n  margin: 0 0 0.6rem;\n  font-size: 1.15rem;\n}\n\n.settings__head h3 {\n  margin: 0;\n}\n\n.network__lead {\n  margin: 0;\n  color: var(--text-2);\n  font-size: 0.88rem;\n}\n\n.network__actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n  margin: 0.8rem 0 0;\n}\n\n/* ---------- Notations ---------- */\n\n.notations {\n  