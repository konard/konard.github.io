[2026-10-26T20:40:11.449Z] [STDOUT] {"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc 'cat src/pages/NetworkEditor.jsx src/pages/NetworkGaps.jsx && cat src/links/style.js'","aggregated_output":"import { useState } from 'react';\nimport { canonical, decode, encode, mathNotation } from '../links/configurations';\nimport {\n  addLink,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  setReference,\n  signatureOf,\n  theoryNotation,\n} from '../links/edit';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from '../components/format';\n\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\", \"one of N networks\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst OF_NETWORKS = { en: ['network', 'networks'], ru: ['сети', 'сетей', 'сетей'] };\n// Finding the smallest renaming tries every order of the links: n! of them.\nconst CANONICAL_UP_TO = 7;\n\n/**\n * One editable notation. While it is typed in, the text stays as it is typed;\n * every valid text changes the network at once, and an invalid one shows why.\n * When the network is changed elsewhere, the field shows the new network.\n */\nfunction NotationField({ id, label, hint, value, parse, format, onLinks, multiline = false }) {\n  const { t } = useLang();\n  const [draft, setDraft] = useState(null);\n  // A draft belongs to the value it was typed against (or the value it produced).\n  const active = draft && draft.at === value;\n  const text = active ? draft.text : value;\n  const error = active ? draft.error : null;\n  const change = (event) => {\n    const next = event.target.value;\n    const result = parse(next);\n    if (result.links) {\n      setDraft({ text: next, at: format(result.links), error: null });\n      onLinks(result.links);\n    } else setDraft({ text: next, at: value, error: result.error });\n  };\n  const Input = multiline ? 'textarea' : 'input';\n  return (\n    <div className={`notation${error ? ' is-invalid' : ''}`}>\n      <label htmlFor={id}>{t(label)}</label>\n      <Input\n        id={id}\n        className=\"mono\"\n        value={text}\n        onChange={change}\n        onBlur={() => active && !error && setDraft(null)}\n        spellCheck=\"false\"\n        autoComplete=\"off\"\n        aria-invalid={error ? 'true' : undefined}\n        aria-describedby={`${id}-note`}\n        rows={multiline ? 2 : undefined}\n      />\n      <small\n        id={`${id}-note`}\n        className={error ? 'notation__error' : 'notation__hint'}\n        role={error ? 'alert' : undefined}\n      >\n        {error ? t(error) : t(hint)}\n      </small>\n    </div>\n  );\n}\n\n/** The four editable notations of the network (issue #17). */\nexport function Notations({ links, notation, onLinks }) {\n  const { lang, t } = useLang();\n  const n = links.length;\n  const count = countOf(n);\n  return (\n    <div className=\"notations\">\n      <p className=\"muted\">\n        {t({\n          en: `${n} ${plural(n, lang, LINKS)} after the zero link 0, in a doublet network ${signatureOf(notation)}: one of ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} of ${n} ${plural(n, lang, OF_LINKS)}, written with ${2 * n} digits in base ${n + 1}. Every notation below can be edited; the others follow.`,\n          ru: `${n} ${plural(n, lang, LINKS)} после нулевой связи 0 в дуплетной сети ${signatureOf(notation)}: одна из ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} из ${n} ${plural(n, lang, OF_LINKS)}, записанная ${2 * n} цифрами в системе с основанием ${n + 1}. Любую запись ниже можно изменить, остальные изменятся вслед за ней.`,\n        })}\n      </p>\n      <NotationField\n        id=\"notation-theory\"\n        label={{ en: 'Math notation (the links theory)', ru: 'Математическая нотация (теория связей)' }}\n        hint={{\n          en: 'The function of the network: link ↦ (source, target). The names may be left out.',\n          ru: 'Функция сети: связь ↦ (начало, конец). Имена связей можно не писать.',\n        }}\n        value={theoryNotation(links, notation)}\n        format={(l) => theoryNotation(l, notation)}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-pairs\"\n        label={{ en: 'Pairs with the base', ru: 'Пары с основанием' }}\n        hint={{\n          en: 'Source and target of each link as two digits (use (source,target) with a base for 10+ links), as under the symbols of the gallery.',\n          ru: 'Начало и конец каждой связи двумя цифрами (для 10+ связей — (начало,конец) с основанием), как под символами галереи.',\n        }}\n        value={mathNotation(encode(links))}\n        format={(l) => mathNotation(encode(l))}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-number\"\n        label={{ en: 'N-ary number', ru: 'N-ричное число' }}\n        hint={{\n          en: `The whole network as one number of ${2 * n} digits in base ${n + 1}; for 10+ links use space-separated digits in [brackets].`,\n          ru: `Вся сеть как одно число из ${2 * n} цифр в системе с основанием ${n + 1}; для 10+ связей разделяйте цифры пробелами в [скобках].`,\n        }}\n        value={numberNotation(links)}\n        format={numberNotation}\n        parse={parseNumber}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-decimal\"\n        label={{ en: 'The same number in decimal', ru: 'То же число в десятичной системе' }}\n        hint={{\n          en: `The position of the network among all networks of ${n} ${plural(n, lang, LINKS)}, from 0 to ${count - 1n}.`,\n          ru: `Номер сети среди всех сетей из ${n} ${plural(n, lang, OF_LINKS)}, от 0 до ${count - 1n}.`,\n        }}\n        value={decimalOf(links)}\n        format={decimalOf}\n        parse={(text) => parseIndex(text, n)}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-links\"\n        label={{ en: 'Links notation', ru: 'Нотация связей' }}\n        hint={{\n          en: '(index: source target) for each link; 0 is nothing.',\n          ru: '(индекс: начало конец) для каждой связи; 0 — это «ничего».',\n        }}\n        value={linksText(links)}\n        format={(l) => linksText(l)}\n        parse={parseLinks}\n        onLinks={onLinks}\n        multiline\n      />\n    </div>\n  );\n}\n\n/** A choice of the link that an end refers to: 0 (nothing), the link itself or another link. */\nfunction ReferenceSelect({ id, value, n, self, onChange, label }) {\n  const { t } = useLang();\n  // Avoid two n-option selects per row (quadratic DOM size) on large networks.\n  if (n > 50)\n    return (\n      <input\n        id={id}\n        type=\"number\"\n        min={0}\n        max={n}\n        step={1}\n        value={value}\n        aria-label={label}\n        onChange={(event) => {\n          const ref = Number(event.target.value);\n          if (event.target.value !== '' && Number.isInteger(ref) && ref >= 0 && ref <= n) onChange(ref);\n        }}\n      />\n    );\n  return (\n    <select id={id} value={value} onChange={(event) => onChange(Number(event.target.value))} aria-label={label}>\n      {Array.from({ length: n + 1 }, (_, ref) => (\n        <option key={ref} value={ref}>\n          {ref}\n          {ref === 0\n            ? ` — ${t({ en: 'nothing', ru: 'ничего' })}`\n            : ref === self\n              ? ` — ${t({ en: 'itself', ru: 'сама' })}`\n              : ''}\n        </option>\n      ))}\n    </select>\n  );\n}\n\n/**\n * The links one by one: what each refers to, its colour and the turns of its\n * ends, with buttons to add and remove links and to move through the networks.\n */\nexport function LinksTable({ links, colors, turns, onLinks, onRemove, onColor, onTurn, onStep, onRandom }) {\n  const { t } = useLang();\n  const n = links.length;\n  const start = t({ en: 'source', ru: 'начало' });\n  const end = t({ en: 'target', ru: 'конец' });\n  return (\n    <div className=\"links-table\">\n      <div className=\"links-table__scroll\">\n        <table>\n          <thead>\n            <tr>\n              <th scope=\"col\">{t({ en: 'Link', ru: 'Связь' })}</th>\n              <th scope=\"col\">{t({ en: 'Source', ru: 'Начало' })}</th>\n              <th scope=\"col\">{t({ en: 'Target', ru: 'Конец' })}</th>\n              <th scope=\"col\">{t({ en: 'Colour', ru: 'Цвет' })}</th>\n              <th scope=\"col\">{t({ en: 'Turn of the source', ru: 'Поворот начала' })}</th>\n              <th scope=\"col\">{t({ en: 'Turn of the target', ru: 'Поворот конца' })}</th>\n              <th scope=\"col\">\n                <span className=\"visually-hidden\">{t({ en: 'Remove', ru: 'Удалить' })}</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            {links.map(([s, tg], i) => {\n              const name = `${t({ en: 'Link', ru: 'Связь' })} ${i + 1}`;\n              return (\n                <tr key={i}>\n                  <th scope=\"row\" className=\"mono\">\n                    <span className=\"links-table__swatch\" style={{ background: colors[i] }} aria-hidden=\"true\" />\n                    {i + 1}\n                  </th>\n                  <td>\n                    <ReferenceSelect\n                      id={`link-${i + 1}-source`}\n                      value={s}\n                      n={n}\n                      self={i + 1}\n                      label={`${name}: ${start}`}\n                      onChange={(ref) => onLinks(setReference(links, i, 0, ref))}\n                    />\n                  </td>\n                  <td>\n                    <ReferenceSelect\n                      id={`link-${i + 1}-target`}\n                      value={tg}\n                      n={n}\n                      self={i + 1}\n                      label={`${name}: ${end}`}\n                      onChange={(ref) => onLinks(setReference(links, i, 1, ref))}\n                    />\n                  </td>\n                  <td>\n                    <input\n                      type=\"color\"\n                      value={colors[i]}\n                      aria-label={`${name}: ${t({ en: 'colour', ru: 'цвет' })}`}\n                      onChange={(event) => onColor(i, event.target.value)}\n                    />\n                  </td>\n                  {[0, 1].map((e) => (\n                    <td key={e}>\n                      <input\n                        type=\"number\"\n                        className=\"mono\"\n                        min={-180}\n                        max={180}\n                        step={5}\n                        value={turns[i][e]}\n                        aria-label={`${name}: ${t({ en: 'turn of the', ru: 'поворот' })} ${e ? end : start}, °`}\n                        onChange={(event) => onTurn(i, e, Number(event.target.value) || 0)}\n                      />\n                      °\n                    </td>\n                  ))}\n                  <td>\n                    <button\n                      type=\"button\"\n                      className=\"button button--small\"\n                      disabled={n <= 1}\n                      onClick={() => onRemove(i + 1)}\n                      aria-label={`${t({ en: 'Remove', ru: 'Удалить' })}: ${name}`}\n                      title={t({\n                        en: 'References to this link become references to 0',\n                        ru: 'Ссылки на эту связь станут ссылками на 0',\n                      })}\n                    >\n                      ✕\n                    </button>\n                  </td>\n                </tr>\n              );\n            })}\n          </tbody>\n        </table>\n      </div>\n      <div className=\"network__actions\">\n        <button type=\"button\" className=\"button\" onClick={() => onLinks(addLink(links))}>\n          + {t({ en: 'Add a link', ru: 'Добавить связь' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(-1)}>\n          ← {t({ en: 'Previous network', ru: 'Предыдущая сеть' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(1)}>\n          {t({ en: 'Next network', ru: 'Следующая сеть' })} →\n        </button>\n        <button type=\"button\" className=\"button\" onClick={onRandom}>\n          {t({ en: 'Random network', ru: 'Случайная сеть' })}\n        </button>\n        <button\n          type=\"button\"\n          className=\"button\"\n          disabled={n > CANONICAL_UP_TO}\n          onClick={() => onLinks(decode(canonical(links)))}\n          title={t({\n            en: 'The same network with the links renamed so that its code is the smallest',\n            ru: 'Та же сеть, связи которой переименованы так, чтобы её код был наименьшим',\n          })}\n        >\n          {t({ en: 'Smallest renaming', ru: 'Наименьшее переименование' })}\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/** The network `step` positions after `links` among the networks of the same size (wrapping around). */\nexport function stepped(links, step) {\n  const n = links.length;\n  const count = countOf(n);\n  const index = (((BigInt(decimalOf(links)) + BigInt(step)) % count) + count) % count;\n  return parseIndex(index.toString(), n).links;\n}\n\n/** A random network of `n` links. */\nexport function randomLinks(n, random = Math.random) {\n  return Array.from({ length: n }, () => [Math.floor(random() * (n + 1)), Math.floor(random() * (n + 1))]);\n}\nimport { GAP_FIELDS } from '../links/gaps';\nimport { useLang } from '../i18n/prefs';\n\nexport default function NetworkGaps({ gaps, style, onGap }) {\n  const { t } = useLang();\n  return (\n    <details className=\"link-gaps\">\n      <summary>{t({ en: 'Gaps for each link', ru: 'Зазоры каждой связи' })}</summary>\n      <p className=\"network__lead\">\n        {t({\n          en: 'Leave a field empty to follow the global value shown as its placeholder. Reference gaps use layout units; middle cuts use 1/100 of the symbol.',\n          ru: 'Пустое поле следует общему значению из подсказки. Зазоры ссылок — в единицах размещения; разрывы середины — в 1/100 символа.',\n        })}\n      </p>\n      {gaps.map((row, i) => (\n        <fieldset key={i}>\n          <legend>\n            {t({ en: 'Link', ru: 'Связь' })} {i + 1}\n          </legend>\n          {GAP_FIELDS.map((field, k) => (\n            <label key={field.key}>\n              {t(field.label)}\n              <input\n                type=\"number\"\n                min={0}\n                max={field.max}\n                step={field.step}\n                aria-label={`${t({ en: 'Link', ru: 'Связь' })} ${i + 1}: ${t(field.label)}`}\n                value={row[k] ?? ''}\n                placeholder={String(style[field.key])}\n                onChange={(event) => onGap(i, k, event.target.value === '' ? null : Number(event.target.value))}\n              />\n            </label>\n          ))}\n        </fieldset>\n      ))}\n    </details>\n  );\n}\n// Every option of the picture of a network in the editor of /network/\n// (issue #17): the shape of the links (the angle at which a link leaves its\n// source and enters its target, its start, end and middle), the lines, the\n// colours, the background, the card around the symbol, a caption, the size of\n// the exported image and the experimental solver of overlaps.\n//\n// The fields reuse the helpers of the settings page (src/settings/fields.js).\n// A style is a flat object; `normalizeStyle` checks every value (it may come\n// from a shared link), and `styleToParams` / `styleFromParams` keep only the\n// values that differ from the defaults in the query string, so a shared link\n// opens exactly the picture that was shared.\nimport { color, option, range, select, toggle } from '../settings/fields';\nimport { COLORS, SHAPE } from './glyph';\nimport { GEOMETRY_SECTIONS } from './style-geometry';\nimport { linkGaps, normalizeGaps } from './gaps';\n\n/** Link colours: the site's, and a few more sets of nine. */\nexport const PALETTES = {\n  site: COLORS,\n  neon: ['#00f0ff', '#ff00e6', '#faff00', '#00ff85', '#ff6b00', '#8a5cff', '#ff2d55', '#00b3ff', '#c6ff00'],\n  pastel: ['#93c5fd', '#c4b5fd', '#f9a8d4', '#fde68a', '#a7f3d0', '#fed7aa', '#bae6fd', '#fecaca', '#d9f99d'],\n  warm: ['#f97316', '#ef4444', '#eab308', '#f43f5e', '#fb923c', '#facc15', '#dc2626', '#fbbf24', '#e11d48'],\n  cold: ['#06b6d4', '#3b82f6', '#8b5cf6', '#14b8a6', '#0ea5e9', '#6366f1', '#22d3ee', '#a78bfa', '#2dd4bf'],\n  // The light-theme link colours of src/index.css, for light backgrounds.\n  print: ['#0e7490', '#9333ea', '#db2777', '#b45309', '#047857', '#c2410c', '#1d4ed8', '#b91c1c', '#4d7c0f'],\n};\n\n/** Sections of the editor; each field is one option of the style. */\nexport const STYLE_SECTIONS = [\n  ...GEOMETRY_SECTIONS,\n  {\n    id: 'lines',\n    title: { en: 'Lines and colours', ru: 'Линии и цвета' },\n    fields: [\n      range('strokeWidth', 1.3, 0.5, 10, 0.1, { en: 'Line width', ru: 'Толщина линий' }),\n      select(\n        'dash',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('dashdot', 'Dash and dot', 'Штрих-пунктир'),\n          option('long', 'Long dashes', 'Длинные штрихи'),\n        ],\n        { en: 'Line style', ru: 'Стиль линий' },\n      ),\n      select(\n        'linecap',\n        'round',\n        [\n          option('round', 'Round', 'Круглые'),\n          option('butt', 'Flat', 'Плоские'),\n          option('square', 'Square', 'Квадратные'),\n        ],\n        { en: 'Line ends', ru: 'Концы линий' },\n      ),\n      select(\n        'linejoin',\n        'miter',\n        [\n          option('round', 'Round', 'Скруглённые'),\n          option('miter', 'Sharp', 'Острые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n        ],\n        { en: 'Corners', ru: 'Углы' },\n      ),\n      range('opacity', 1, 0.1, 1, 0.05, { en: 'Opacity', ru: 'Непрозрачность' }, { unit: '%' }),\n      range('glow', 0, 0, 12, 0.5, { en: 'Glow', ru: 'Свечение' }),\n      select(\n        'palette',\n        'site',\n        [\n          option('site', 'Site', 'Как на сайте'),\n          option('neon', 'Neon', 'Неон'),\n          option('pastel', 'Pastel', 'Пастель'),\n          option('warm', 'Warm', 'Тёплые'),\n          option('cold', 'Cold', 'Холодные'),\n          option('print', 'For light backgrounds', 'Для светлого фона'),\n          option('mono', 'One colour', 'Один цвет'),\n          option('custom', 'Own colour of each link', 'Свой цвет каждой связи'),\n        ],\n        { en: 'Colours of the links', ru: 'Цвета связей' },\n      ),\n      color(\n        'monoColor',\n        '#e6edf7',\n        { en: 'Colour of the links', ru: 'Цвет связей' },\n        {\n          when: (s) => s.palette === 'mono',\n        },\n      ),\n    ],\n  },\n  {\n    id: 'background',\n    title: { en: 'Background and card', ru: 'Фон и карточка' },\n    fields: [\n      select(\n        'background',\n        'solid',\n        [\n          option('transparent', 'Transparent', 'Прозрачный'),\n          option('solid', 'One colour', 'Один цвет'),\n          option('linear', 'Linear gradient', 'Линейный градиент'),\n          option('radial', 'Radial gradient', 'Радиальный градиент'),\n        ],\n        { en: 'Background', ru: 'Фон' },\n      ),\n      color(\n        'bgColor',\n        '#000000',\n        { en: 'Background colour', ru: 'Цвет фона' },\n        {\n          when: (s) => s.background !== 'transparent',\n        },\n      ),\n      color(\n        'bgColor2',\n        '#1e1b4b',\n        { en: 'Second colour', ru: 'Второй цвет' },\n        {\n          when: (s) => s.background === 'linear' || s.background === 'radial',\n        },\n      ),\n      range(\n        'bgAngle',\n        135,\n        0,\n        359,\n        1,\n        { en: 'Gradient angle', ru: 'Угол градиента' },\n        {\n          unit: '°',\n          when: (s) => s.background === 'linear',\n        },\n      ),\n      toggle('card', false, { en: 'Card around the symbol', ru: 'Карточка вокруг символа' }),\n      color('cardColor', '#0d1220', { en: 'Card colour', ru: 'Цвет карточки' }, { when: (s) => s.card }),\n      range(\n        'cardOpacity',\n        0.8,\n        0,\n        1,\n        0.05,\n        { en: 'Card opacity', ru: 'Непрозрачность карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n      select(\n        'borderStyle',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('double', 'Double', 'Двойная'),\n          option('none', 'No border', 'Без рамки'),\n        ],\n        { en: 'Border', ru: 'Рамка' },\n        { when: (s) => s.card },\n      ),\n      range(\n        'border',\n        0.6,\n        0.1,\n        6,\n        0.1,\n        { en: 'Border width', ru: 'Толщина рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      color(\n        'borderColor',\n        '#2b3b57',\n        { en: 'Border colour', ru: 'Цвет рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      range(\n        'radius',\n        10,\n        0,\n        50,\n        1,\n        { en: 'Corner radius', ru: 'Скругление углов' },\n        { unit: '%', when: (s) => s.card },\n      ),\n      range(\n        'inset',\n        3,\n        0,\n        30,\n        0.5,\n        { en: 'Space around the card', ru: 'Отступ вокруг карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n    ],\n  },\n  {\n    id: 'caption',\n    title: { en: 'Caption', ru: 'Подпись' },\n    fields: [\n      select('notation', 'L', [option('L', 'L → L²'), option('R', 'R → R²')], {\n        en: 'Theory notation',\n        ru: 'Нотация теории',\n      }),\n      select(\n        'caption',\n        'none',\n        [\n          option('none', 'None', 'Нет'),\n          option('theory', 'Math notation', 'Математическая нотация'),\n          option('pairs', 'Pairs with the base', 'Пары с основанием'),\n          option('number', 'N-ary number', 'N-ричное число'),\n          option('links', 'Links notation', 'Нотация связей'),\n          option('custom', 'Own text', 'Свой текст'),\n        ],\n        { en: 'Caption', ru: 'Подпись' },\n      ),\n      {\n        key: 'captionText',\n        type: 'text',\n        d: '',\n        max: 80,\n        label: { en: 'Text', ru: 'Текст' },\n        when: (s) => s.caption === 'custom',\n      },\n      color(\n        'captionColor',\n        '#7d8aa3',\n        { en: 'Caption colour', ru: 'Цвет подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      range(\n        'captionSize',\n        6,\n        3,\n        14,\n        0.5,\n        { en: 'Caption size', ru: 'Размер подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      select(\n        'captionFont',\n        'mono',\n        [\n          option('mono', 'Monospace', 'Моноширинный'),\n          option('sans', 'Sans serif', 'Без засечек'),\n          option('serif', 'Serif', 'С засечками'),\n        ],\n        { en: 'Font', ru: 'Шрифт' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n    ],\n  },\n  {\n    id: 'image',\n    title: { en: 'Image size', ru: 'Размер изображения' },\n    fields: [\n      range('width', 2048, 64, 4096, 1, { en: 'Width', ru: 'Ширина' }, { unit: 'px' }),\n      range('height', 2048, 64, 4096, 1, { en: 'Height', ru: 'Высота' }, { unit: 'px' }),\n      range('quality', 0.92, 0.5, 1, 0.01, { en: 'JPEG and WebP quality', ru: 'Качество JPEG и WebP' }, { unit: '%' }),\n    ],\n  },\n  {\n    id: 'experimental',\n    title: { en: 'Experimental: fewer overlaps', ru: 'Эксперимент: меньше наложений' },\n    lead: {\n      en: 'Turns the ends and optionally adjusts individual reference gaps and middle cuts to reduce crossings. Small cuts are preferred; manual values are the starting point. Apply the result to keep editing it.',\n      ru: 'Поворачивает концы и при желании меняет зазоры ссылок и разрывы середины отдельных связей. Предпочитает небольшие разрывы и начинает с ручных значений. Примените результат, чтобы продолжить редактирование.',\n    },\n    fields: [\n      toggle('solve', false, { en: 'Reduce overlaps automatically', ru: 'Уменьшать наложения автоматически' }),\n      toggle('solveGaps', true, { en: 'Adjust individual gaps', ru: 'Менять отдельные зазоры' }),\n      range('solveGapRange', 0.2, 0, 1, 0.05, { en: 'Largest reference gap change', ru: 'Изменение зазора ссылки' }),\n      range('solveMiddleRange', 4, 0, 15, 0.5, { en: 'Largest middle cut change', ru: 'Изменение разрыва середины' }),\n      range('solveRange', 60, 0, 180, 5, { en: 'Largest turn', ru: 'Наибольший поворот' }, { unit: '°' }),\n      range('solveStep', 15, 5, 30, 5, { en: 'Turn step', ru: 'Шаг поворота' }, { unit: '°' }),\n    ],\n  },\n];\n\n/** The options kept per link: its colour (with the own colours) and the turns of its ends. */\nconst PER_LINK = [\n  { key: 'colors', type: 'list', d: COLORS.join(',') },\n  { key: 'gap', type: 'range', d: 0.08, min: 0, max: 0.4 },\n  { key: 'turns', type: 'list', d: '' },\n  { key: 'gaps', type: 'list', d: '' },\n];\n\nexport const STYLE_FIELDS = [...STYLE_SECTIONS.flatMap((section) => section.fields), ...PER_LINK];\nexport const STYLE_DEFAULTS = Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, field.d]));\n\nconst HEX = /^#[0-9a-f]{6}$/i;\nconst clamp = (value, min, max) => Math.min(max, Math.max(min, value));\n\n/** A per-link list \"a,b,c\" of colours, or of turns \"source target\". */\nfunction normalizeList(key, value) {\n  if (key === 'gaps') return normalizeGaps(value);\n  const items = String(value ?? '').split(',');\n  if (key === 'colors')\n    return items.every((c) => HEX.test(c.trim())) ? items.map((c) => c.trim().toLowerCase()).join(',') : '';\n  const turns = items.map((item) =>\n    item\n      .trim()\n      .split(/\\s+/)\n      .slice(0, 2)\n      .map((a) => clamp(Math.round(Number(a)) || 0, -180, 180)),\n  );\n  // Links after the last turned one need no entry: they are not turned.\n  while (turns.length && turns[turns.length - 1].every((a) => a === 0)) turns.pop();\n  return turns.map((pair) => `${pair[0]} ${pair[1] ?? 0}`).join(',');\n}\n\n/** One value of a style checked against its field: the default if it is not valid. */\nfunction normalizeValue(field, value) {\n  if (value === undefined) return field.d;\n  switch (field.type) {\n    case 'range': {\n      const number = typeof value === 'number' ? value : Number(value);\n      return Number.isFinite(number) && value !== '' && value !== null ? clamp(number, field.min, field.max) : field.d;\n    }\n    case 'toggle':\n      if (typeof value === 'boolean') return value;\n      return value === 'true' || value === '1' ? true : value === 'false' || value === '0' ? false : field.d;\n    case 'select':\n      return field.options.some((o) => o.value === value) ? value : field.d;\n    case 'color':\n      return HEX.test(value) ? value.toLowerCase() : field.d;\n    case 'text':\n      return typeof value === 'string' ? value.slice(0, field.max) : field.d;\n    default:\n      return normalizeList(field.key, value);\n  }\n}\n\n/** A complete, valid style: every option of `raw` checked, the rest the defaults. */\nexport function normalizeStyle(raw = {}) {\n  // Bookmarks from issue #17 used one gap for both references.\n  // Older shared links omitted palette=custom because it was the default.\n  if (raw?.colors !== undefined && raw?.palette === undefined) raw = { ...raw, palette: 'custom' };\n  if (raw?.gap !== undefined) raw = { startGap: raw.gap, endGap: raw.gap, ...raw };\n  return Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, normalizeValue(field, raw?.[field.key])]));\n}\n\n/** The options that differ from the defaults as query parameters. */\nexport function styleToParams(style) {\n  const params = new URLSearchParams();\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (style[key] !== STYLE_DEFAULTS[key]) params.set(key, String(style[key]));\n  });\n  return params;\n}\n\n/** A style read from query parameters (unknown or invalid values are left out). */\nexport function styleFromParams(params) {\n  const raw = {};\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i % COLORS.length];\n    const palette = PALETTES[style.palette] || COLORS;\n    return palette[i % palette.length];\n  });\n}\n\n/** The [source, target] turns of each of `n` links, in degrees. */\nexport function linkTurns(style, n) {\n  const turns = style.turns ? style.turns.split(',').map((pair) => pair.split(' ').map(Number)) : [];\n  return Array.from({ length: n }, (_, i) => turns[i] || [0, 0]);\n}\n\n/** A style with the turns of each link set to `turns` ([[source, target], …]). */\nexport const withTurns = (style, turns) =>\n  normalizeStyle({ ...style, turns: turns.map((pair) => pair.join(' ')).join(',')