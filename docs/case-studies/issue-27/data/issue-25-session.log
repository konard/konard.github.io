[2026-10-26T21:11:03.255Z] [STDOUT] {"type":"item.started","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -lc \"cat > experiments/issue-25-pixels.mjs <<'EOF'\n// Bounded native-pixel investigation: antialias coverage in the last 20 rows.\n/* global document, Image */\nimport { readFile, writeFile } from 'node:fs/promises';\nimport { webkit } from 'playwright';\nconst { cases } = JSON.parse(await readFile('docs/case-studies/issue-25/data/webkit-browser.json', 'utf8'));\nconst browser = await webkit.launch();\ntry {\n  const page = await browser.newPage();\n  const rows = await page.evaluate(async (svg) => {\n    const image = new Image();\n    image.src = \"'`data:image/svg+xml,${encodeURIComponent(svg)}`;\n    await image.decode();\n    const canvas = document.createElement('\"'canvas');\n    canvas.width = canvas.height = 1000;\n    const ctx = canvas.getContext('2d');\n    ctx.drawImage(image, 0, 0, 1000, 1000);\n    const pixels = ctx.getImageData(0, 0, 1000, 1000).data;\n    return Array.from({ length: 20 }, (_, j) => {\n      const y = 630 + j;\n      const maxBlue = [0, 0];\n      for (let x = 0; x < 1000; x++) {\n        const i = (y * 1000 + x) * 4;\n        if (pixels[i] < pixels[i + 2] * 0.3 && pixels[i + 1] > pixels[i + 2] * 0.7)\n          maxBlue[x < 500 ? 0 : 1] = Math.max(maxBlue[x < 500 ? 0 : 1], pixels[i + 2]);\n      }\n      return { y, maxBlue };\n    });\n  }, cases.acute.svg);\n  await writeFile('docs/case-studies/issue-25/data/webkit-pixels.json', JSON.stringify(rows, null, 2));\n  console.log(JSON.stringify(rows));\n} finally {\n  await browser.close();\n}\nEOF\nnode experiments/issue-25-pixels.mjs > docs/case-studies/issue-25/logs/webkit-pixels.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
