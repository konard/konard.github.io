[2026-10-26T20:40:20.927Z] [STDOUT] {"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat src/links/collisions.js src/links/collision-gaps.js src/links/collision-gap-cache.js && cat src/links/solver-23.test.js'","aggregated_output":"// Experimental (issue #17): fewer overlaps of the lines of a network. Each end\n// of a link may leave its source or enter its target at another angle (the\n// per-link turns of glyph.js). This tries turns for one end at a time and\n// keeps the one that makes the drawing cleaner, a few passes over every end\n// (coordinate descent). Only the turned link changes, so only its pairs with\n// the other links are measured again.\n//\n// The cost of a drawing, in layout units (neighbouring middles are 1 apart):\n//   - every crossing of the lines of two links, away from the middles where\n//     links touch on purpose;\n//   - every sampled point of a line that comes closer than NEAR to a line of\n//     another link (the lines run together and overlap);\n//   - a little for every degree turned, so nothing turns without a reason.\nimport { bezier, curveTransform, layout, layoutCurves, linkCurve, shapeOf } from './glyph';\nimport { trimCurve } from './curve-tools';\nimport { adjustCollisionGaps } from './collision-gaps';\n\nconst SAMPLES = 16; // points per Bézier segment\nconst NEAR = 0.09; // lines closer than this overlap (a stroke is about 0.04)\nconst MIDDLE = 0.14; // touching around a middle is the drawing, not an overlap\nconst CROSSING = 1;\nconst CLOSE = 0.25;\nconst TURNING = 0.002; // per degree\n\nexport const polyline = (curve) =>\n  curve.segments.flatMap((seg, k) =>\n    Array.from({ length: SAMPLES + (k ? 0 : 1) }, (_, j) => bezier(seg, (j + (k ? 1 : 0)) / SAMPLES)),\n  );\n\nconst distance = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);\n\nfunction crossing(p1, p2, q1, q2) {\n  const d = (a, b, c) => (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);\n  const [d1, d2, d3, d4] = [d(q1, q2, p1), d(q1, q2, p2), d(p1, p2, q1), d(p1, p2, q2)];\n  if (!(d1 * d2 < 0 && d3 * d4 < 0)) return null;\n  const t = d1 / (d1 - d2);\n  return [p1[0] + t * (p2[0] - p1[0]), p1[1] + t * (p2[1] - p1[1])];\n}\n\n/** How much the lines of two links (polylines) overlap and cross; `middles` are exempt. */\nexport function pairCost(a, b, middles) {\n  const free = (p) => p && middles.every((m) => distance(p, m) > MIDDLE);\n  let cost = 0;\n  for (let i = 0; i < a.length - 1; i++) {\n    for (let j = 0; j < b.length - 1; j++) {\n      if (!a[i] || !a[i + 1] || !b[j] || !b[j + 1]) continue;\n      const point = crossing(a[i], a[i + 1], b[j], b[j + 1]);\n      if (point && free(point)) cost += CROSSING;\n    }\n  }\n  for (const p of a) {\n    if (!free(p)) continue;\n    if (b.some((q) => q && distance(p, q) < NEAR)) cost += CLOSE;\n  }\n  for (const q of b) {\n    if (!free(q)) continue;\n    if (a.some((p) => p && distance(p, q) < NEAR)) cost += CLOSE;\n  }\n  return cost;\n}\n\nconst turning = (turns) => turns.flat().reduce((sum, a) => sum + Math.abs(a), 0) * TURNING;\n\n/** The cost of a drawing of `links` with `shape` (lower is cleaner). */\nexport function overlapCost(links, shape = {}) {\n  const curves = layoutCurves(links, shape);\n  const o = shapeOf(shape);\n  const scale = curveTransform(curves, o).scale;\n  const lines = curves.map((curve, i) => visiblePolyline(curve, o, i, scale));\n  const middles = curves.map((c) => c.middle.at);\n  let cost = turning(shapeOf(shape).turns);\n  for (let i = 0; i < lines.length; i++)\n    for (let j = i + 1; j < lines.length; j++) cost += pairCost(lines[i], lines[j], middles);\n  return cost;\n}\n\n/**\n * Turns of the ends of every link that make the drawing cleaner. `shape.turns`\n * are kept as the starting point; the result adds turns from −range to +range\n * degrees in steps of `step`. Returns the turns found (`delta`, to add to the\n * starting turns), the turns in total (`turns`) and the cost before and after.\n */\nexport function solveCollisions(\n  links,\n  shape = {},\n  { range = 60, step = 15, passes = 3, adjustGaps = false, gapRange = 0.2, middleRange = 4 } = {},\n) {\n  range = Math.min(180, Math.max(0, Number(range) || 0));\n  step = Math.max(1, Number(step) || 15);\n  passes = Math.min(10, Math.max(0, Number(passes) || 0));\n  const n = links.length;\n  const base = shapeOf(shape);\n  const start = Array.from({ length: n }, (_, i) => base.turns[i] || [0, 0]);\n  const delta = start.map(() => [0, 0]);\n  const total = () => start.map((pair, i) => [pair[0] + delta[i][0], pair[1] + delta[i][1]]);\n  const places = layout(n, base, links);\n  const curveOf = (i) => linkCurve(links, i, places, { ...base, turns: total() });\n  const middles = layoutCurves(links, base).map((c) => c.middle.at);\n  const scale = curveTransform(layoutCurves(links, base), base).scale;\n  const lines = links.map((_, i) => visiblePolyline(curveOf(i), base, i, scale));\n  const costOf = (i, line) => {\n    let cost = 0;\n    for (let j = 0; j < n; j++) if (j !== i) cost += pairCost(line, lines[j], middles);\n    return cost + turning([total()[i]]);\n  };\n  const before = overlapCost(links, base);\n  const candidates = [0];\n  for (let a = step; a <= range; a += step) candidates.push(a, -a);\n\n  for (let pass = 0; pass < passes; pass++) {\n    let improved = false;\n    for (let i = 0; i < n; i++) {\n      for (let end = 0; end < 2; end++) {\n        const kept = delta[i][end];\n        let best = { angle: kept, cost: costOf(i, lines[i]), line: lines[i] };\n        for (const angle of candidates) {\n          if (angle === kept) continue;\n          // Applied turns go back through the editable table's −180…180° range.\n          if (Math.abs(start[i][end] + angle) > 180) continue;\n          delta[i][end] = angle;\n          const line = visiblePolyline(curveOf(i), base, i, scale);\n          const cost = costOf(i, line);\n          if (cost < best.cost - 1e-9) best = { angle, cost, line };\n        }\n        delta[i][end] = best.angle;\n        lines[i] = best.line;\n        if (best.angle !== kept) improved = true;\n      }\n    }\n    if (!improved) break;\n  }\n  let result = {\n    delta,\n    turns: total(),\n    linkGaps: base.linkGaps,\n    before,\n    after: overlapCost(links, { ...base, turns: total() }),\n  };\n  // Middle cuts use image units: a turn can change fitting scale. Reject a\n  // cached candidate if the exact complete drawing would become worse.\n  if (result.after > before)\n    result = { delta: start.map(() => [0, 0]), turns: start, linkGaps: base.linkGaps, before, after: before };\n  return adjustGaps ? adjustCollisionGaps(links, base, result, { gapRange, middleRange, passes }) : result;\n}\n\n/** Keep each cut as a real break: no artificial chord across the missing middle. */\nexport function visiblePolyline(curve, o, i, scale) {\n  const before = o.linkGaps[i]?.[2] ?? o.middleGapStart;\n  const after = o.linkGaps[i]?.[3] ?? o.middleGapEnd;\n  if (!before && !after) return polyline(curve);\n  return curve.segments.flatMap((segment, k) => {\n    const kept = trimCurve(segment, (k ? after : before) / scale, Boolean(k));\n    return kept\n      ? [...(k ? [null] : []), ...Array.from({ length: SAMPLES + 1 }, (_, j) => bezier(kept, j / SAMPLES))]\n      : [];\n  });\n}\n// A second coordinate-descent stage: try modest gaps after turning the ends.\n// Score the exact visible curves and penalize extra cuts so the solver cannot\n// \"solve\" a diagram by erasing it. Manual gaps remain the starting point.\nimport { overlapCost } from './collisions';\nimport { GapScoreCache } from './collision-gap-cache';\nimport { GAP_FIELDS } from './gaps';\nimport { bezier, layout, layoutCurves, linkCurve } from './glyph';\n\nexport function adjustCollisionGaps(links, base, result, { gapRange, middleRange, passes }) {\n  gapRange = Math.min(1, Math.max(0, Number(gapRange) || 0));\n  middleRange = Math.min(15, Math.max(0, Number(middleRange) || 0));\n  const rows = links.map((_, i) => GAP_FIELDS.map((_, k) => base.linkGaps[i]?.[k] ?? null));\n  const initial = rows.map((row) => row.map((v, k) => v ?? base[GAP_FIELDS[k].key] ?? base.gap));\n  const currentShape = () => ({ ...base, turns: result.turns, linkGaps: rows });\n  const places = layout(links.length, base, links);\n  const cache = new GapScoreCache(layoutCurves(links, currentShape()), currentShape());\n  const turningCost = result.after - cache.total;\n  const halfLength = (i, k) => {\n    const segment = cache.curves[i].segments[k];\n    let length = 0;\n    let previous = segment[0];\n    for (let j = 1; j <= 64; j++) {\n      const point = bezier(segment, j / 64);\n      length += Math.hypot(point[0] - previous[0], point[1] - previous[1]);\n      previous = point;\n    }\n    return length * cache.scale;\n  };\n  const penalty = () =>\n    rows.reduce(\n      (sum, row, i) =>\n        sum + row.reduce((s, v, k) => s + Math.abs((v ?? initial[i][k]) - initial[i][k]) * (k < 2 ? 0.1 : 0.025), 0),\n      0,\n    );\n  let bestScore = result.after;\n  for (let pass = 0; pass < Math.min(passes, 2); pass++) {\n    let improved = false;\n    for (let i = 0; i < links.length; i++)\n      for (let k = 0; k < 4; k++) {\n        if (k < 2 && links[i][k] === 0) continue;\n        const kept = rows[i][k];\n        const range = k < 2 ? gapRange : middleRange;\n        if (!range) continue;\n        // Never shorten an existing manual cut just to satisfy the automatic\n        // cap. New cuts may consume at most 30% of either half of the line.\n        const max = k < 2 ? 1 : Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));\n        let best = kept;\n        let bestState;\n        for (const fraction of [-1, -0.5, 0.5, 1]) {\n          const value = Math.round(Math.max(0, Math.min(max, initial[i][k] + range * fraction)) * 1000) / 1000;\n          if (value === (kept ?? initial[i][k])) continue;\n          rows[i][k] = value;\n          const curve = k < 2 ? linkCurve(links, i, places, currentShape()) : cache.curves[i];\n          const candidate = cache.measure(i, curve);\n          const score = turningCost + candidate.total + penalty();\n          if (score < bestScore - 1e-9) {\n            bestScore = score;\n            best = value;\n            bestState = candidate;\n          }\n        }\n        rows[i][k] = best;\n        if (bestState) {\n          cache.accept(bestState);\n          improved = true;\n        }\n      }\n    if (!improved) break;\n  }\n  // Later reference-gap changes can shorten earlier halves or their fitted\n  // scale. Enforce the cut budget against the final geometry as well.\n  rows.forEach((row, i) => {\n    for (let k = 2; k < 4; k++) {\n      const max = Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));\n      if (row[k] > max) row[k] = Math.floor(max * 1000) / 1000;\n    }\n  });\n  const after = overlapCost(links, currentShape());\n  return after <= result.after ? { ...result, linkGaps: rows, after } : result;\n}\n// Changing one gap normally affects only that link's pair scores. A reference\n// gap can also change the fitted scale: then every existing image-unit middle\n// cut must be rescored. Keep that uncommon case exact as well.\nimport { pairCost, visiblePolyline } from './collisions';\nimport { curveTransform } from './glyph';\n\nexport class GapScoreCache {\n  constructor(curves, shape) {\n    this.curves = curves;\n    this.shape = shape;\n    this.middles = curves.map((curve) => curve.middle.at);\n    Object.assign(this, this.fullState(curveTransform(curves, shape).scale));\n  }\n\n  fullState(scale) {\n    const lines = this.curves.map((curve, i) => visiblePolyline(curve, this.shape, i, scale));\n    const pairs = lines.map(() => Array(lines.length).fill(0));\n    let total = 0;\n    for (let i = 0; i < lines.length; i++)\n      for (let j = i + 1; j < lines.length; j++) {\n        pairs[i][j] = pairs[j][i] = pairCost(lines[i], lines[j], this.middles);\n        total += pairs[i][j];\n      }\n    return { scale, lines, pairs, total };\n  }\n\n  measure(i, curve) {\n    const previous = this.curves[i];\n    this.curves[i] = curve;\n    const scale = curve === previous ? this.scale : curveTransform(this.curves, this.shape).scale;\n    const cuts = this.curves.some(\n      (_, j) =>\n        (this.shape.linkGaps[j]?.[2] ?? this.shape.middleGapStart) > 0 ||\n        (this.shape.linkGaps[j]?.[3] ?? this.shape.middleGapEnd) > 0,\n    );\n    let state;\n    if (scale !== this.scale && cuts) state = this.fullState(scale);\n    else {\n      const line = visiblePolyline(curve, this.shape, i, scale);\n      const pairRow = this.lines.map((other, j) => (i === j ? 0 : pairCost(line, other, this.middles)));\n      const sum = (values) => values.reduce((a, b) => a + b, 0);\n      state = { scale, line, pairRow, total: this.total - sum(this.pairs[i]) + sum(pairRow) };\n    }\n    this.curves[i] = previous;\n    return { ...state, i, curve };\n  }\n\n  accept(state) {\n    const { i, curve, scale, total } = state;\n    this.curves[i] = curve;\n    this.scale = scale;\n    this.total = total;\n    if (state.lines) {\n      this.lines = state.lines;\n      this.pairs = state.pairs;\n    } else {\n      this.lines[i] = state.line;\n      state.pairRow.forEach((cost, j) => {\n        this.pairs[i][j] = this.pairs[j][i] = cost;\n      });\n    }\n  }\n}\nimport { expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { overlapCost, pairCost, solveCollisions } from './collisions';\nimport { withGaps } from './gaps';\nimport { bezier, glyphCurves } from './glyph';\nimport { networkSvg } from './render';\nimport { STYLE_DEFAULTS, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams, withTurns } from './style';\n\nit('reduces overlaps by adjusting individual gaps with angle search disabled', () => {\n  const links = decode('22 13 31');\n  const shape = shapeOfStyle(STYLE_DEFAULTS, 3);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(result.delta.flat().every((angle) => angle === 0)).toBe(true);\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row.some((value) => value !== null))).toBe(true);\n  const applied = withGaps(withTurns(STYLE_DEFAULTS, result.turns), result.linkGaps);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n  expect(networkSvg(links, applied)).toBe(\n    networkSvg(links, STYLE_DEFAULTS, {\n      extraTurns: result.delta,\n      extraGaps: result.linkGaps,\n    }),\n  );\n  expect(styleFromParams(styleToParams(applied))).toEqual(normalizeStyle(applied));\n});\nit('bounds manual gap adjustments, preserves the input and never increases the exact score', () => {\n  const links = decode('23 31 12');\n  const style = normalizeStyle({ gaps: '0.5 0.7 20 25,0.4 0.3 2 3' });\n  const shape = shapeOfStyle(style, 3);\n  const original = structuredClone(shape);\n  const result = solveCollisions(links, shape, { adjustGaps: true, gapRange: 0.1, middleRange: 2 });\n  expect(shape).toEqual(original);\n  expect(result.after).toBeLessThanOrEqual(result.before);\n  result.linkGaps.forEach((row, i) =>\n    row.forEach((value, k) => {\n      const initial =\n        original.linkGaps[i]?.[k] ?? original[['startGap', 'endGap', 'middleGapStart', 'middleGapEnd'][k]];\n      expect(Math.abs((value ?? initial) - initial)).toBeLessThanOrEqual((k < 2 ? 0.1 : 2) + 1e-9);\n    }),\n  );\n  const applied = withGaps(withTurns(style, result.turns), result.linkGaps);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n});\nit('does not count an artificial crossing through a cut in the middle', () => {\n  const line = [[-1, 0], [-0.4, 0], null, [0.4, 0], [1, 0]];\n  const cross = [\n    [0, -1],\n    [0, 1],\n  ];\n  expect(pairCost(line, cross, [])).toBe(0);\n  expect(pairCost(line.filter(Boolean), cross, [])).toBeGreaterThan(0);\n});\n\nit('also reduces overlaps by center cuts alone, without reference gap or angle changes', () => {\n  const links = decode('22 13 31');\n  const result = solveCollisions(links, shapeOfStyle(STYLE_DEFAULTS, 3), {\n    range: 0,\n    adjustGaps: true,\n    gapRange: 0,\n    middleRange: 15,\n  });\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row[2] > 0 || row[3] > 0)).toBe(true);\n  expect(result.linkGaps.every((row) => row[0] === null && row[1] === null)).toBe(true);\n  expect(result.turns.flat().every((value) => value === 0)).toBe(true);\n});\n\nit('bounds gap search cost for a dense 24-link drawing and returns its exact score', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const started = performance.now();\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(performance.now() - started).toBeLessThan(10000);\n  expect(result.after).toBeLessThan(result.before);\n  expect(overlapCost(links, { ...shape, turns: result.turns, linkGaps: result.linkGaps })).toBeCloseTo(result.after, 8);\n}, 15000);\n\nit('keeps automatic cuts within the final fitted half-length after reference gaps change', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true, gapRange: 1, middleRange: 15 });\n  expect(result.after).toBeLessThan(result.before);\n  const fitted = { ...shape, turns: result.turns, linkGaps: result.linkGaps };\n  glyphCurves(links, fitted).forEach((curve, i) => {\n    curve.segments.forEach((segment, k) => {\n      let length = 0;\n      let previous = segment[0];\n      for (let j = 1; j <= 1024; j++) {\n        const point = bezier(segment, j / 1024);\n        length += Math.hypot(point[0] - previous[0], point[1] - previous[1]);\n        previous = point;\n      }\n      expect(result.linkGaps[i]?.[k + 2] ?? 0).toBeLessThanOrEqual(length * 0.3 + 0.001);\n    });\n  });\n  expect(overlapCost(links, fitted)).toBeCloseTo(result.after, 8);\n}, 15000);\n","exit_code":0,"status":"completed"}}
