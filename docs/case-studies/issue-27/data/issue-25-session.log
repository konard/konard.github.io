[2026-10-26T20:41:24.530Z] [STDOUT] {"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '130,220p' src/links/style-geometry.js && sed -n '130,205p' src/links/glyph.js && sed -n '130,210p' src/links/network.test.js && sed -n '55,110p' src/links/mechanics-19.test.js\"","aggregated_output":"  },\n  {\n    id: 'ends',\n    title: { en: 'Start, end and middle', ru: 'Начало, конец и середина' },\n    fields: [\n      ...['start', 'end', 'middle'].flatMap((key, i) => {\n        const en = ['start', 'end', 'middle'][i];\n        const ru = ['начала', 'конца', 'середины'][i];\n        const shown = (s) => s[key] !== 'none';\n        return [\n          select(\n            key,\n            EDITOR_SHAPE[key],\n            MARKERS.map((m) => option(m, ...names[m])),\n            {\n              en: `${['Start', 'End', 'Middle'][i]} of a link`,\n              ru: ['Начало связи', 'Конец связи', 'Середина связи'][i],\n            },\n          ),\n          field(`${key}Size`, 0.5, 15, 0.1, `Size of the ${en}`, `Размер ${ru}`, { when: shown }),\n          field(`${key}Angle`, 5, 85, 1, `Angle of the ${en}`, `Угол ${ru}`, {\n            ...degrees,\n            when: (s) => ['arrow', 'triangle', 'tail'].includes(s[key]),\n          }),\n          field(`${key}Offset`, -20, 20, 0.1, `Offset of the ${en}`, `Сдвиг ${ru}`, {\n            when: shown,\n            hint: {\n              en: 'Distance along the curve; the marker follows its tangent. Positive moves an endpoint marker inward. Beyond an end, the tangent extends the path. Units: 1/100 of the symbol.',\n              ru: 'Расстояние вдоль кривой; маркер следует её касательной. Положительное значение смещает концевой маркер внутрь. За концом путь продолжается по касательной. Единица — 1/100 символа.',\n            },\n          }),\n          field(`${key}Across`, -20, 20, 0.1, `Sideways offset of the ${en}`, `Поперечный сдвиг ${ru}`, {\n            when: shown,\n          }),\n          field(`${key}Rotation`, -180, 180, 1, `Rotation of the ${en}`, `Поворот ${ru}`, {\n            ...degrees,\n            when: (s) => !['none', 'circle', 'dot'].includes(s[key]),\n          }),\n        ];\n      }),\n      field('middleGapStart', 0, 30, 0.1, 'Cut before the middle', 'Разрыв перед серединой', {\n        hint: {\n          en: 'Optional: for a ring, try half its size on each side. Zero keeps the line continuous.',\n          ru: 'Необязательно: для кольца попробуйте половину его размера с каждой стороны. Ноль оставляет линию непрерывной.',\n        },\n      }),\n      field('middleGapEnd', 0, 30, 0.1, 'Cut after the middle', 'Разрыв после середины'),\n    ],\n  },\n];\n\n/** Whether a geometry option can affect this network. Field-specific style conditions are separate. */\nexport function geometryAvailable(key, style, links) {\n  if (!links) return true;\n  const other = (ref, i) => ref !== 0 && ref !== i + 1;\n  const any = (predicate) => links.some(predicate);\n  switch (key) {\n    case 'angles':\n    case 'tension':\n      return any(([s, t]) => s || t);\n    case 'sourceAngle':\n    case 'startGap':\n      return any(([s]) => s !== 0);\n    case 'targetAngle':\n    case 'endGap':\n      return any(([, t]) => t !== 0);\n    case 'lens':\n      return style.angles === 'mirror' && any(([s, t], i) => s === t && other(s, i));\n    case 'bendMode':\n    case 'bulge':\n      return any(([s, t], i) => !(other(s, i) && other(t, i)));\n    case 'free':\n      return any(([s, t]) => s === 0 || t === 0);\n    case 'loop':\n    case 'loopBend':\n      return any(([s, t], i) => s === i + 1 || t === i + 1);\n    case 'forceDistance':\n      return any(([s, t], i) => other(s, i) || other(t, i));\n    case 'spread':\n    case 'placement':\n    case 'layoutAspect':\n    case 'columns':\n    case 'forceCharge':\n    case 'forceCollision':\n      return links.length > 1;\n    default:\n      return true;\n  }\n}\n * of the middle direction, or with fixed angles the chord turned by `angle`\n * to the same side as the mirror.\n */\nfunction approach(d, chord, twice, angle, o) {\n  const mirror = lens(reflect(d, chord), chord, twice && o.lens);\n  if (o.angles !== 'fixed') return mirror;\n  const side = chord[0] * mirror[1] - chord[1] * mirror[0] < 0 ? -1 : 1;\n  return rotate(chord, side * angle * RAD);\n}\n\n/** The cubic segments of link `i` (0-based) and its two ends, in layout units. */\nexport function linkCurve(links, i, places, o) {\n  const n = links.length;\n  const [s, t] = links[i];\n  const { at: m, out } = places[i];\n  const other = (ref) => ref !== 0 && ref !== i + 1;\n  const free = (n === 1 ? LONE.free : FREE) * o.free;\n  const loop = (n === 1 ? LONE.loop : LOOP) * o.loop;\n  const [turnIn, turnOut] = (o.turns[i] || [0, 0]).map((a) => (a || 0) * RAD);\n  const bulge = o.bulge * RAD;\n  const startGap = o.linkGaps[i]?.[0] ?? o.startGap ?? o.gap;\n  const endGap = o.linkGaps[i]?.[1] ?? o.endGap ?? o.gap;\n  const tangent = rotate(out, Math.PI / 2);\n  const tIn = other(s) ? unit(sub(m, places[s - 1].at)) : null;\n  const tOut = other(t) ? unit(sub(places[t - 1].at, m)) : null;\n\n  // The direction in which the link passes through its own middle.\n  let d;\n  if (tIn && tOut) {\n    const sum = add(tIn, tOut);\n    d = length(sum) < 1e-9 ? side(tOut, [0, 0], out) : unit(sum);\n  } else if (tIn || tOut) d = rotate(tIn || tOut, bulge);\n  else if (s && t) d = rotate(tangent, Math.PI / 4 + bulge - SHAPE.bulge * RAD);\n  else d = rotate(tangent, bulge - SHAPE.bulge * RAD);\n\n  // Editor bending changes handles, with fixed endpoint axes. The legacy\n  // branch above remains the gallery/rain's original construction.\n  const balanced = o.bendMode === 'curve';\n  const freeAxis = balanced ? tIn || tOut || tangent : d;\n  if (balanced && !tIn && !tOut) {\n    d = s && t ? rotate(tangent, Math.PI / 4) : s || t ? tangent : rotate(tangent, bulge / 2);\n  }\n  const loopWidth = balanced ? Math.exp((o.bulge + o.loopBend) / 180) : 1;\n\n  let first;\n  let start;\n  if (s === 0) {\n    const dir = rotate(freeAxis, turnIn);\n    const from = sub(m, mul(dir, free));\n    first = [from, add(from, mul(dir, free / 3)), sub(m, mul(d, free / 3)), m];\n    start = { at: from, dir };\n  } else if (s === i + 1) {\n    // A loop that leaves the middle sideways and comes back through it.\n    const angle = o.angles === 'fixed' ? (o.sourceAngle - SHAPE.sourceAngle) * RAD : 0;\n    const away = rotate(t === i + 1 ? rotate(d, Math.PI / 2) : side(d, mul(d, -1), out), turnIn + angle);\n    const from = add(m, mul(away, startGap));\n    first = [\n      from,\n      add(m, mul(away, Math.max(loop * loopWidth, startGap + 0.01))),\n      sub(m, mul(d, (loop * Math.max(0.03, o.tension)) / SHAPE.tension)),\n      m,\n    ];\n    start = { at: from, dir: away };\n  } else {\n    const p = places[s - 1].at;\n    const chord = unit(sub(m, p));\n    const dir = rotate(approach(d, chord, s === t, o.sourceAngle, o), turnIn);\n    const k = o.tension * length(sub(m, p));\n    const from = add(p, mul(dir, startGap));\n    first = [from, add(from, mul(dir, k)), sub(m, mul(d, k)), m];\n    start = { at: from, dir };\n  }\n\n  let second;\n  let end;\n  if (t === 0) {\n    expect(style.card).toBe(false);\n    expect(style.captionText).toHaveLength(80);\n    expect(style.turns).toBe('30 -180');\n    expect(style.colors).toBe('#ff0000,#00ff00');\n    expect(normalizeStyle({ colors: '#ff0000,blue' }).colors).toBe('');\n  });\n\n  it('keeps only the options that differ from the defaults in the address', () => {\n    expect(styleToParams(STYLE_DEFAULTS).toString()).toBe('');\n    const style = normalizeStyle({ card: false, bgColor: '#000000', end: 'dot', turns: '15 -30' });\n    const params = styleToParams(style);\n    expect(Object.fromEntries(params)).toEqual({ end: 'dot', turns: '15 -30' });\n    expect(styleFromParams(new URLSearchParams(params.toString()))).toEqual(style);\n    expect(styleFromParams(new URLSearchParams('strokeWidth=abc&unknown=1'))).toEqual(STYLE_DEFAULTS);\n  });\n\n  it('gives each link a colour and turns', () => {\n    expect(linkColors(STYLE_DEFAULTS, 2)).toHaveLength(2);\n    expect(linkColors(normalizeStyle({ palette: 'mono', monoColor: '#123456' }), 3)).toEqual([\n      '#123456',\n      '#123456',\n      '#123456',\n    ]);\n    const own = withColor(STYLE_DEFAULTS, 2, 1, '#abcdef');\n    expect(own.palette).toBe('custom');\n    expect(linkColors(own, 2)).toEqual([linkColors(STYLE_DEFAULTS, 1)[0], '#abcdef']);\n    const turned = withTurns(STYLE_DEFAULTS, [\n      [10, 20],\n      [0, -45],\n    ]);\n    expect(turned.turns).toBe('10 20,0 -45');\n    expect(linkTurns(turned, 3)).toEqual([\n      [10, 20],\n      [0, -45],\n      [0, 0],\n    ]);\n    expect(withTurns(STYLE_DEFAULTS, [[0, 0]]).turns).toBe('');\n    expect(\n      shapeOfStyle(turned, 2, [\n        [5, 5],\n        [0, 0],\n      ]).turns,\n    ).toEqual([\n      [15, 25],\n      [0, -45],\n    ]);\n  });\n\n  it('offers both a card and a plain black background, and keeps the hand-made turns', () => {\n    expect(LOOKS.map((look) => look.id)).toEqual(expect.arrayContaining(['card', 'black', 'transparent']));\n    const turned = normalizeStyle({ turns: '10 20', strokeWidth: 5 });\n    const black = applyLook(turned, 'black');\n    expect(black).toMatchObject({ card: false, background: 'solid', bgColor: '#000000', turns: '10 20' });\n    expect(black.strokeWidth).toBe(STYLE_DEFAULTS.strokeWidth);\n    expect(applyLook(turned, 'card').card).toBe(true);\n    expect(applyLook(turned, 'social')).toMatchObject({ width: 1200, height: 630, caption: 'theory' });\n  });\n});\n\ndescribe('picture of a network (issue #17)', () => {\n  it('is a standalone SVG of the chosen size with the links of the gallery', () => {\n    const svg = networkSvg(links, applyLook(STYLE_DEFAULTS, 'card'));\n    expect(svg.startsWith('<svg xmlns=\"http://www.w3.org/2000/svg\"')).toBe(true);\n    expect(svg).toContain('width=\"2048\" height=\"2048\"');\n    expect(svg).toContain('aria-label=\"Links network 01₃ 20₃\"');\n    // The card preset preserves the gallery; the lines are the same curves as the symbols.\n    expect(svg).toContain(STYLE_DEFAULTS.cardColor);\n    const symbol = glyphSvg(links);\n    const line = symbol.match(/ d=\"(M[^M\"]+)/)[1];\n    expect(svg).toContain(line);\n  });\n\n  it('draws a transparent background, no card and a wide image on request', () => {\n    const svg = networkSvg(links, { background: 'transparent', card: false, width: 1200, height: 630 });\n    expect(svg).toContain('viewBox=\"0 0 190.48 100\"');\n    expect(svg).not.toContain(STYLE_DEFAULTS.bgColor);\n    expect(svg).not.toContain(STYLE_DEFAULTS.cardColor);\n    expect(networkSvg(links, { background: 'linear' })).toContain('<linearGradient');\n    expect(networkSvg(links, { background: 'radial' })).toContain('<radialGradient');\n    expect(networkSvg(links, { card: true, borderStyle: 'dashed' })).toContain('stroke-dasharray');\n    expect(networkSvg(links, { glow: 2 })).toContain('feGaussianBlur');\n  it('offers every marker at each position, with independent size, offsets and direction', () => {\n    for (const position of ['start', 'end', 'middle'])\n      for (const kind of MARKERS) {\n        const style = normalizeStyle({\n          [position]: kind,\n          [`${position}Offset`]: 12,\n          [`${position}Across`]: -8,\n          [`${position}Rotation`]: 37,\n        });\n        const shape = shapeOfStyle(style, 1);\n        const [parts] = glyphParts([[1, 1]], shape);\n        expect(Boolean(parts[position].d)).toBe(kind !== 'none');\n        expect(networkSvg([[1, 1]], style)).not.toMatch(/NaN|Infinity|undefined/);\n      }\n  });\n\n  it('hides ineffective controls but keeps angles and bends for self references', () => {\n    const available = (key, links, patch = {}) => geometryAvailable(key, normalizeStyle(patch), links);\n    for (const key of ['free', 'placement', 'lens']) expect(available(key, [[1, 1]])).toBe(false);\n    for (const key of ['sourceAngle', 'targetAngle', 'tension', 'loop', 'bulge'])\n      expect(available(key, [[1, 1]])).toBe(true);\n    for (const key of ['angles', 'sourceAngle', 'targetAngle', 'loop', 'tension', 'startGap', 'endGap'])\n      expect(available(key, [[0, 0]])).toBe(false);\n    expect(\n      available(\n        'lens',\n        [\n          [2, 2],\n          [1, 1],\n        ],\n        { angles: 'mirror' },\n      ),\n    ).toBe(true);\n    expect(\n      available('bulge', [\n        [2, 2],\n        [1, 1],\n      ]),\n    ).toBe(false);\n    expect(\n      available(\n        'forceDistance',\n        [\n          [1, 1],\n          [0, 2],\n        ],\n        { placement: 'force' },\n      ),\n    ).toBe(false);\n    expect(\n      available(\n        'forceDistance',\n        [\n          [2, 1],\n          [0, 2],\n        ],\n","exit_code":0,"status":"completed"}}
