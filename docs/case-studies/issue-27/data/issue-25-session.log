ine, date: new Date().toISOString(), checks: [], errors: [], cases: {} }; try {   browser = await { chromium, firefox, webkit }[engine].launch();   results.version = browser.version();   const context = await browser.newContext({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });   await context.addInitScript(() => {     localStorage.setItem('theme', 'dark');     localStorage.setItem('lang', 'en');     localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));   });   const page = await context.newPage();   page.setDefaultTimeout(15000);   page.on('pageerror', (error) => results.errors.push(error.message));   const go = async (query) => {     await page.goto(`http://localhost:4185/network/?code=2222&lang=en&rotation=90&${query}`);     await page.locator('.network__preview svg').waitFor();   };   const shot = async (name, element = page.locator('.network__preview')) => element.screenshot({ path: join(output, `${engine}-after-${name}.png`) });   const manual = 'turns=15+-15&gaps=0.18+0.18+%7E+%7E';   for (const [name, query] of Object.entries({ manual, auto: 'solve=true', 'auto-gaps': 'solve=true&gaps=0.18+0.18+%7E+%7E', acute: `${manual}&endAngle=5`, rounded: `${manual}&arrowJoin=round`, legacy: `${manual}&balanceArrows=false&arrowJoin=inherit` })) {     await go(query);     await shot(name);     results.cases[name] = { svg: await page.locator('.network__preview').innerHTML(), caption: await page.locator('figcaption').innerText() };     if (name.startsWith('auto')) {       const preview = await page.locator('.network__preview').innerHTML();       await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();       assert.equal(await page.locator('.network__preview').innerHTML(), preview);       const url = await page.getByLabel('Link to this picture', { exact: true }).inputValue();       assert(new URL(url).searchParams.has('gaps'));       assert(Number(await page.getByLabel('Link 1: Gap at the source reference', { exact: true }).inputValue()) > 0.08);       assert(Number(await page.getByLabel('Link 1: Gap at the target reference', { exact: true }).inputValue()) > 0.08);       await page.goto(url);       assert.equal(await page.locator('.network__preview').innerHTML(), preview);       results.checks.push(`${name}: apply/share/reload preserves exact drawing and discovered gaps`);     }   }   // Inspect actual rasterized SVG paint, independently of the geometry helper.   // Equally gapped lens endpoints must have the same horizontal pixel boundary.   results.pixels = [];   for (const angle of [5, 15, 45]) {     await go(`${manual}&endAngle=${angle}&linejoin=round`);     const measurement = await page.locator('.network__preview svg').evaluate(async (svg) => {       const image = new Image();       const url = URL.createObjectURL(new Blob([svg.outerHTML], { type: 'image/svg+xml' }));       try {         image.src = url;         await image.decode();         const canvas = document.createElement('canvas');         canvas.width = canvas.height = 1000;         const ctx = canvas.getContext('2d');         ctx.drawImage(image, 0, 0, 1000, 1000);         const pixels = ctx.getImageData(0, 0, 1000, 1000).data;         const bottom = [-1, -1];         for (let y = 0; y < 1000; y++) for (let x = 0; x < 1000; x++) {           const i = (y * 1000 + x) * 4;           if (Math.abs(pixels[i] - 34) < 4 && Math.abs(pixels[i + 1] - 211) < 4 && Math.abs(pixels[i + 2] - 238) < 4) bottom[x < 500 ? 0 : 1] = y;         }         const arrow = svg.querySelectorAll('g[stroke]')[0].querySelectorAll('path')[2];         return { bottom, join: getComputedStyle(arrow).strokeLinejoin, limit: Number(getComputedStyle(arrow).strokeMiterlimit) };       } finally { URL.revokeObjectURL(url); }     });     assert(measurement.bottom.every((y) => y > 0));     assert(Math.abs(measurement.bottom[0] - measurement.bottom[1]) <= 1, JSON.stringify({ angle, measurement }));     assert.equal(measurement.join, 'miter');     assert(measurement.limit >= 1 / Math.sin(angle * Math.PI / 180));     results.pixels.push({ angle, ...measurement });   }   results.checks.push('native SVG rasterization: sharp acute tips and aligned painted boundaries at 5°, 15°, 45°');   await go(manual);   const cards = page.getByRole('list', { name: 'Link configurations' });   assert.equal(await cards.getByRole('listitem').count(), 2);   assert.equal(await cards.locator('details').count(), 0);   await shot('editor', cards);   await page.locator('#links').scrollIntoViewIfNeeded();   await shot('desktop', page);   await page.getByLabel('Link 1: Gap at the source reference', { exact: true }).fill('0.21');   await page.getByLabel('Link 2: Cut after the middle', { exact: true }).fill('3');   const changed = await page.getByLabel('Link to this picture', { exact: true }).inputValue();   const drawing = await page.locator('.network__preview').innerHTML();   await page.goto(changed);   assert.equal(await page.locator('.network__preview').innerHTML(), drawing);   await page.getByRole('button', { name: 'Remove: Link 1', exact: true }).click();   assert.equal(await page.getByLabel('Link 1: Cut after the middle', { exact: true }).inputValue(), '3');   results.checks.push('visible card fields, editing, inheritance, sharing and removal/renumbering');   for (const lang of ['en', 'ru']) {     await page.setViewportSize({ width: 390, height: 844 });     await page.goto(`http://localhost:4185/network/?code=2222&rotation=90&${manual}&lang=${lang}`);     await page.locator('#links').scrollIntoViewIfNeeded();     const bounds = await page.evaluate(() => {       const overflow = [...document.querySelectorAll('.link-card input, .link-card select')].filter((node) => {         const a = node.getBoundingClientRect();         const b = node.closest('.link-card').getBoundingClientRect();         return a.left < b.left || a.right > b.right || a.width < 40;       }).length;       return { width: document.documentElement.scrollWidth, viewport: innerWidth, overflow };     });     assert.equal(bounds.width, bounds.viewport);     assert.equal(bounds.overflow, 0);     await shot(`mobile-${lang}`, page);   }   results.checks.push('English/Russian mobile card controls fit without horizontal scrolling');   assert.deepEqual(results.errors, []);   console.log(JSON.stringify(results.checks, null, 2)); } finally {   await writeFile(join(data, `${engine}-browser.json`), JSON.stringify(results, null, 2));   await browser?.close();   await server.httpServer.close(); } EOF python3 - <<'PY' import json p='package.json';s=json.load(open(p));s['scripts']['test:network:issue25']='node experiments/issue-25-browser.mjs';open(p,'w').write(json.dumps(s,indent=2)+'\\n') p='.github/workflows/github-pages.yml';s=open(p).read();key='      - name: Preserve browser evidence\\n';s=s.replace(key,'''      - name: Verify automatic spacing, sharp balanced arrows and per-link cards         if: ${{ !cancelled() && steps.browser.outcome == 'success' }}         run: npm run test:network:issue25         env:           CAPTURE_DIR: browser-results/screenshots/issue25           RESULT_DIR: browser-results/data/issue25  '''+key);open(p,'w').write(s) PY npx prettier --write experiments/issue-25-*.mjs package.json .github/workflows/github-pages.yml > docs/case-studies/issue-25/logs/format-browser.log 2>&1 npm run test:ci -- --maxWorkers=1 > docs/case-studies/issue-25/logs/all-tests.log 2>&1\n   2977    2976  1944       14:02 sh -lc (export CODEX_HOME=/home/box/.codex/hive-mind/repositories/konard/konard.github.io; export HIVE_MIND_PARENT_CODEX_HOME=/home/box/.codex; cd \"/tmp/gh-issue-solver-1793047110454\" && codex exec --model \"gpt-6.1-sol\" --json --skip-git-repo-check -o \"/tmp/codex_last_message_1793047160155_1.txt\" -c \"model_reasoning_summary=auto\" -c \"model_reasoning_effort=xhigh\" --dangerously-bypass-approvals-and-sandbox \"-c\" \"service_tier=default\" \"-c\" \"model_context_window=272000\" \"-c\" \"model_auto_compact_t