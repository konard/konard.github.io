        : '';\n          return `<path d=\"${m.d}\"${m.fill ? ` fill=\"${colors[i]}\"` : ''}${join}/>`;\n        })\n        .join('');\n      return `<g stroke=\"${colors[i]}\"><path d=\"${line}\"${dash ? ` stroke-dasharray=\"${dash}\"` : ''}/>${shapes}</g>`;\n    })\n    .join('');\n  if (style.glow > 0)\n    defs.push(\n      `<filter id=\"glow\" x=\"-25%\" y=\"-25%\" width=\"150%\" height=\"150%\"><feGaussianBlur stdDeviation=\"${num(style.glow * 0.5)}\" result=\"b\"/>` +\n        `<feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>`,\n    );\n\n  let text = '';\n  if (caption) {\n    const size = style.captionSize;\n    const width = w - 2 * edge - size * 2;\n    const estimate = caption.length * size * WIDTH[style.captionFont];\n    const fit = estimate > width ? ` textLength=\"${num(width)}\" lengthAdjust=\"spacingAndGlyphs\"` : '';\n    text =\n      `<text x=\"${num(w / 2)}\" y=\"${num(h - edge - room / 2 + size * 0.35)}\" text-anchor=\"middle\" ` +\n      `font-family=\"${escapeXml(FONTS[style.captionFont])}\" font-size=\"${num(size)}\" fill=\"${style.captionColor}\"${fit}>` +\n      `${escapeXml(caption)}</text>`;\n  }\n\n  const label = escapeXml(title || `Links network ${mathNotation(encode(links))}`);\n  return (\n    `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${style.width}\" height=\"${style.height}\" ` +\n    `viewBox=\"0 0 ${num(w)} ${num(h)}\" role=\"img\" aria-label=\"${label}\"><title>${label}</title>` +\n    (defs.length ? `<defs>${defs.join('')}</defs>` : '') +\n    back +\n    `<g transform=\"translate(${num(x)} ${num(y)}) scale(${+(side / SIZE).toFixed(4)})\" fill=\"none\" ` +\n    `stroke-width=\"${style.strokeWidth}\" stroke-linecap=\"${style.linecap}\" stroke-linejoin=\"${style.linejoin}\" ` +\n    `opacity=\"${style.opacity}\"${style.glow > 0 ? ' filter=\"url(#glow)\"' : ''}>${lines}</g>${text}</svg>`\n  );\n}\n// A second coordinate-descent stage: try modest gaps after turning the ends.\n// Score the exact visible curves and penalize extra cuts so the solver cannot\n// \"solve\" a diagram by erasing it. Manual gaps remain the starting point.\nimport { overlapCost } from './collisions';\nimport { GapScoreCache } from './collision-gap-cache';\nimport { GAP_FIELDS } from './gaps';\nimport { bezier, layout, layoutCurves, linkCurve, curveTransform } from './glyph';\n\nexport function adjustCollisionGaps(links, base, result, { gapRange, middleRange, passes }) {\n  gapRange = Math.min(1, Math.max(0, Number(gapRange) || 0));\n  middleRange = Math.min(15, Math.max(0, Number(middleRange) || 0));\n  const rows = links.map((_, i) => GAP_FIELDS.map((_, k) => result.linkGaps[i]?.[k] ?? base.linkGaps[i]?.[k] ?? null));\n  // Refine the previous stage's drawing, while keeping bounds and penalties\n  // relative to the user's original gaps throughout the joint search.\n  const initial = links.map((_, i) =>\n    GAP_FIELDS.map((field, k) => base.linkGaps[i]?.[k] ?? base[field.key] ?? base.gap),\n  );\n  const currentShape = () => ({ ...base, turns: result.turns, linkGaps: rows });\n  const places = layout(links.length, base, links);\n  const cache = new GapScoreCache(layoutCurves(links, currentShape()), currentShape());\n  const turningCost = result.after - cache.total;\n  const halfLength = (i, k) => {\n    const segment = cache.curves[i].segments[k];\n    let length = 0;\n    let previous = segment[0];\n    for (let j = 1; j <= 64; j++) {\n      const point = bezier(segment, j / 64);\n      length += Math.hypot(point[0] - previous[0], point[1] - previous[1]);\n      previous = point;\n    }\n    return length * cache.scale;\n  };\n  const penalty = () =>\n    rows.reduce(\n      (sum, row, i) =>\n        sum + row.reduce((s, v, k) => s + Math.abs((v ?? initial[i][k]) - initial[i][k]) * (k < 2 ? 0.1 : 0.025), 0),\n      0,\n    );\n  let bestScore = result.after + penalty();\n  for (let pass = 0; pass < Math.min(passes, 2); pass++) {\n    let improved = false;\n    for (let i = 0; i < links.length; i++)\n      for (let k = 0; k < 4; k++) {\n        if (k < 2 && links[i][k] === 0) continue;\n        const kept = rows[i][k];\n        const range = k < 2 ? gapRange : middleRange;\n        if (!range) continue;\n        // Never shorten an existing manual cut just to satisfy the automatic\n        // cap. New cuts may consume at most 30% of either half of the line.\n        const max = k < 2 ? 1 : Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));\n        let best = kept;\n        let bestState;\n        for (const fraction of [-1, -0.75, -0.5, -0.25, 0.25, 0.5, 0.75, 1]) {\n          const center = pass ? (kept ?? initial[i][k]) : initial[i][k];\n          const radius = pass ? range / 4 : range;\n          const value =\n            Math.round(\n              Math.max(0, initial[i][k] - range, Math.min(max, initial[i][k] + range, center + radius * fraction)) *\n                1000,\n            ) / 1000;\n          if (value === (kept ?? initial[i][k])) continue;\n          rows[i][k] = value;\n          const curve = k < 2 ? linkCurve(links, i, places, currentShape()) : cache.curves[i];\n          const candidate = cache.measure(i, curve);\n          const score = turningCost + candidate.total + penalty();\n          if (score < bestScore - 1e-9) {\n            bestScore = score;\n            best = value;\n            bestState = candidate;\n          }\n        }\n        rows[i][k] = best;\n        if (bestState) {\n          cache.accept(bestState);\n          improved = true;\n        }\n      }\n    if (!improved) break;\n  }\n  // Later reference-gap changes can shorten earlier halves or their fitted\n  // scale. Enforce the cut budget against the final geometry as well.\n  cache.scale = curveTransform(cache.curves, currentShape()).scale;\n  rows.forEach((row, i) => {\n    for (let k = 2; k < 4; k++) {\n      const max = Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));\n      if (row[k] > max) row[k] = Math.floor(max * 1000) / 1000;\n    }\n  });\n  const after = overlapCost(links, currentShape());\n  return after <= result.after ? { ...result, linkGaps: rows, after } : result;\n}\n// Changing one gap normally affects only that link's pair scores. A reference\n// gap can also change the fitted scale: then every existing image-unit middle\n// cut must be rescored. Keep that uncommon case exact as well.\nimport { pairCost, visiblePolyline } from './collisions';\nimport { selfCost } from './painted-collisions';\nimport { curveTransform } from './glyph';\n\nexport class GapScoreCache {\n  constructor(curves, shape) {\n    this.curves = curves;\n    this.shape = shape;\n    this.middles = curves.map((curve) => curve.middle.at);\n    Object.assign(this, this.fullState(curveTransform(curves, shape).scale));\n  }\n\n  fullState(scale) {\n    const lines = this.curves.map((curve, i) => visiblePolyline(curve, this.shape, i, scale));\n    const pairs = lines.map(() => Array(lines.length).fill(0));\n    let total = lines.reduce((sum, line) => sum + selfCost(line), 0);\n    for (let i = 0; i < lines.length; i++)\n      for (let j = i + 1; j < lines.length; j++) {\n        pairs[i][j] = pairs[j][i] = pairCost(lines[i], lines[j], this.middles);\n        total += pairs[i][j];\n      }\n    return { scale, lines, pairs, total };\n  }\n\n  measure(i, curve) {\n    const previous = this.curves[i];\n    this.curves[i] = curve;\n    // Freeze the fitted scale during painted-coordinate descent. A refit moves\n    // every image-unit marker and would make each candidate quadratic in N.\n    // The caller refits and verifies the complete exact score before returning.\n    const scale =\n      curve === previous || this.shape.clearance != null ? this.scale : curveTransform(this.curves, this.shape).scale;\n    const cuts = this.curves.some(\n      (_, j) =>\n        (this.shape.linkGaps[j]?.[2] ?? this.shape.middleGapStart) > 0 ||\n        (this.shape.linkGaps[j]?.[3] ?? this.shape.middleGapEnd) > 0,\n    );\n    let state;\n    if (scale !== this.scale && (cuts || this.shape.clearance != null)) state = this.fullState(scale);\n    else {\n      const line = visiblePolyline(curve, this.shape, i, scale);\n      const pairRow = this.lines.map((other, j) => (i === j ? 0 : pairCost(line, other, this.middles)));\n      const sum = (values) => values.reduce((a, b) => a + b, 0);\n      state = {\n        scale,\n        line,\n        pairRow,\n        total: this.total - sum(this.pairs[i]) + sum(pairRow) - selfCost(this.lines[i]) + selfCost(line),\n      };\n    }\n    this.curves[i] = previous;\n    return { ...state, i, curve };\n  }\n\n  accept(state) {\n    const { i, curve, scale, total } = state;\n    this.curves[i] = curve;\n    this.scale = scale;\n    this.total = total;\n    if (state.lines) {\n      this.lines = state.lines;\n      this.pairs = state.pairs;\n    } else {\n      this.lines[i] = state.line;\n      state.pairRow.forEach((cost, j) => {\n        this.pairs[i][j] = this.pairs[j][i] = cost;\n      });\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
