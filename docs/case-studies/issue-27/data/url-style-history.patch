+function normalizeList(key, value) {
+  const items = String(value ?? '')
+    .split(',')
+    .slice(0, MAX_LINKS);
+  if (key === 'colors')
+    return items.every((c) => HEX.test(c.trim())) ? items.map((c) => c.trim().toLowerCase()).join(',') : '';
