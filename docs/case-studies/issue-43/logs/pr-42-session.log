[2026-10-30T13:46:05.492Z] [STDOUT] {"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat src/pages/network-29.test.jsx\nsed -n '125,190p' src/pages/network.test.jsx\nsed -n '330,410p' .github/workflows/github-pages.yml\ncat experiments/issue-37-sheet.mjs | head -100\ncat docs/case-studies/issue-41/logs/focused-tests.log | tail -18\"","aggregated_output":"import { fireEvent, render, screen } from '@testing-library/react';\nimport { afterEach, expect, it } from 'vitest';\nimport NetworkPage from './NetworkPage';\n\nafterEach(() => window.history.replaceState(null, '', '/'));\nconst open = () => {\n  window.history.replaceState(null, '', '/network/?code=1111&lang=en&turns=,-15+15&gaps=,0.18+0.18');\n  render(<NetworkPage />);\n};\nit('pairs one-degree turn sliders below the separator and supports horizontal keyboard edits and resets', () => {\n  open();\n  const source = screen.getByRole('slider', { name: 'Link 2: turn of the source, °' });\n  const target = screen.getByRole('slider', { name: 'Link 2: turn of the target, °' });\n  expect(source).toHaveAttribute('min', '-180');\n  expect(source).toHaveAttribute('max', '180');\n  expect(source).toHaveAttribute('step', '1');\n  expect(source.closest('.link-card__geometry')).toBe(target.closest('.link-card__geometry'));\n  fireEvent.keyDown(source, { key: 'ArrowRight' });\n  expect(source).toHaveValue('-14');\n  expect(target).toHaveValue('15');\n  fireEvent.click(screen.getByRole('button', { name: 'Back to the default: Link 2: turn of the source, °' }));\n  expect(source).toHaveValue('0');\n  expect(target).toHaveValue('15');\n});\nit('shows inherited reference gaps as sliders and resets an explicit override to inheritance', () => {\n  open();\n  const gap = screen.getByRole('slider', { name: 'Link 1: Gap at the target reference' });\n  expect(gap).toHaveValue('0.08');\n  expect(gap).toHaveAttribute('max', '1');\n  fireEvent.keyDown(gap, { key: 'ArrowRight' });\n  expect(gap).toHaveValue('0.09');\n  fireEvent.click(screen.getByRole('button', { name: 'Back to the default: Link 1: Gap at the target reference' }));\n  expect(gap).toHaveValue('0.08');\n  const params = new URL(screen.getByLabelText('Link to this picture').value).searchParams;\n  expect(params.get('gaps').split(',')[0]).toBe('');\n  const global = screen.getByLabelText('Gap at the target reference', { selector: 'input[type=\"range\"]' });\n  fireEvent.change(global, { target: { value: '0.12' } });\n  expect(gap).toHaveValue('0.12');\n});\n\n  it('edits the links one by one: references, colours, turns, adding and removing', () => {\n    go('/network/?code=0120');\n    render(<NetworkPage />);\n    fireEvent.change(screen.getByLabelText('Link 2: target'), { target: { value: '2' } });\n    expect(field('Pairs with the base')).toHaveValue('01₃ 22₃');\n    fireEvent.click(screen.getByRole('button', { name: /Add a link/ }));\n    expect(field('Pairs with the base')).toHaveValue('01₄ 22₄ 00₄');\n    fireEvent.change(screen.getByLabelText('Link 3: colour'), { target: { value: '#ff0000' } });\n    expect(preview().innerHTML).toContain('#ff0000');\n    expect(new URLSearchParams(search()).get('colors')).toContain('#ff0000');\n    fireEvent.change(screen.getByLabelText('Link 2: turn of the target, °'), { target: { value: '30' } });\n    expect(new URLSearchParams(search()).get('turns')).toBe(',0 30');\n    fireEvent.click(screen.getByRole('button', { name: 'Remove: Link 1' }));\n    // Link 2 becomes link 1 and keeps its turn; references to the removed link become 0.\n    expect(field('Pairs with the base')).toHaveValue('11₃ 00₃');\n    expect(new URLSearchParams(search()).get('turns')).toBe('0 30');\n    fireEvent.click(screen.getByRole('button', { name: /Next network/ }));\n    expect(field('Pairs with the base')).toHaveValue('11₃ 01₃');\n  });\n\n  it('switches between the card and a plain black background, and every option changes the picture', () => {\n    go('/network/?code=0120');\n    render(<NetworkPage />);\n    expect(preview().innerHTML).not.toContain(STYLE_DEFAULTS.cardColor);\n    fireEvent.click(screen.getByRole('button', { name: 'Plain black' }));\n    expect(preview().innerHTML).not.toContain(STYLE_DEFAULTS.cardColor);\n    expect(preview().innerHTML).toContain('fill=\"#000000\"');\n    expect(new URLSearchParams(search()).get('card')).toBeNull();\n    fireEvent.click(screen.getByRole('button', { name: 'Card (as in the gallery)' }));\n    expect(new URLSearchParams(search()).get('card')).toBe('true');\n    expect(preview().innerHTML).toContain(STYLE_DEFAULTS.cardColor);\n\n    fireEvent.change(screen.getByLabelText('End of a link'), { target: { value: 'dot' } });\n    expect(search()).toContain('end=dot');\n    fireEvent.change(screen.getByRole('combobox', { name: 'Background' }), { target: { value: 'transparent' } });\n    expect(preview().className).toContain('is-transparent');\n  });\n\n  it('reduces overlaps of lines on request (experimental)', () => {\n    go('/network/?code=221331');\n    render(<NetworkPage />);\n    fireEvent.click(screen.getByLabelText('Reduce overlaps automatically'));\n    expect(screen.getByText(/overlaps \\d+\\.\\d → \\d+\\.\\d/)).toBeInTheDocument();\n    fireEvent.click(screen.getByRole('button', { name: 'Apply turns and gaps to links' }));\n    expect(new URLSearchParams(search()).get('turns')).toMatch(/-?\\d+ -?\\d+/);\n    expect(screen.queryByText(/overlaps \\d+\\.\\d → /)).toBeNull();\n    fireEvent.click(screen.getByRole('button', { name: 'Clear all turns' }));\n    expect(new URLSearchParams(search()).get('turns')).toBeNull();\n  });\n\n  it('downloads, copies and links to the share dialogs with the address of the picture', () => {\n    go('/network/?code=0120&end=dot');\n    render(<NetworkPage />);\n    const share = document.getElementById('share');\n    ['⤓ SVG', '⤓ PNG', '⤓ JPEG', '⤓ WebP', '⤓ .lino'].forEach((name) =>\n      expect(within(share).getByRole('button', { name })).toBeInTheDocument(),\n    );\n    expect(within(share).getByRole('button', { name: 'Copy the link' })).toBeInTheDocument();\n    expect(within(share).getByLabelText('Link to this picture')).toHaveValue(\n      `${window.location.origin}/network/?code=0120&end=dot`,\n    );\n    const telegram = share.querySelector('[data-share=\"telegram\"]');\n    expect(telegram.getAttribute('href')).toContain(encodeURIComponent('/network/?code=0120&end=dot'));\n  });\n\n          sparse-checkout: scripts\n\n      - name: Verify the deployed site\n        run: bash scripts/check-deployed-site.sh \"$PAGE_URL\"\n        env:\n          PAGE_URL: ${{ steps.deployment.outputs.page_url }}\n\n  tooling:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-tooling\n      cancel-in-progress: true\n    needs: prepare\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Setup Python\n        uses: actions/setup-python@v7\n        with:\n          python-version: '3.13'\n      - name: Verify public source attribution and mirror deduplication\n        run: |\n          curl --fail --location --silent --show-error https://raw.githubusercontent.com/AlDanial/cloc/v2.10/cloc -o \"$CLOC_PATH\"\n          printf '%s  %s\\n' 'bf59272455172108072a0a106379f7509fd4349bdcfd85203bac038ccd286d83' \"$CLOC_PATH\" | sha256sum --check\n          python3 experiments/test_source_lines.py\n        env:\n          CLOC_PATH: ${{ runner.temp }}/cloc.pl\n      - name: Install pinned source linters\n        run: python -m pip install ruff==0.17.3 shellcheck-py==0.11.0.1\n      - name: Check Python syntax, lint and formatting\n        run: |\n          python scripts/check-python.py\n          ruff check .\n          ruff format --check .\n      - name: Check every standalone shell script and hook\n        run: git ls-files -z '*.sh' '.husky/*' ':(exclude)dev/log/**' ':(exclude)docs/**' | xargs -0 shellcheck\n      - name: Audit workflow security, including low-confidence credential findings\n        uses: zizmorcore/zizmor-action@v0.8.0\n        with:\n          version: 1.31.1\n          advanced-security: false\n          annotations: true\n          min-confidence: low\n          config: .github/zizmor.yml\n          inputs: .github/\n      - name: Audit pedantic image pins\n        env:\n          GH_TOKEN: [REDACTED] github.token }}\n        run: >-\n          pipx run zizmor==1.31.1 --config .github/zizmor.yml\n          --persona pedantic --min-severity high --min-confidence high .github/\n\n  docs:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-docs\n      cancel-in-progress: true\n    needs: [prepare, checks]\n    if: needs.prepare.outputs.docs == 'true'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Check required documentation\n        run: node scripts/check-docs.mjs\n      - name: Restore link cache\n        uses: actions/cache@v6\n        with:\n          path: .lycheecache\n          key: lychee-${{ runner.os }}-${{ github.sha }}\n          restore-keys: lychee-${{ runner.os }}-\n      - name: Check maintained documentation links\n        uses: lycheeverse/lychee-action@v2\n        with:\n          args: --no-progress --config lychee.toml README.md\n          fail: true\n/* global document */\nimport { chromium } from 'playwright';\nimport { resolve } from 'node:path';\nconst phase = process.env.PHASE || 'preserved';\nconst browser = await chromium.launch();\ntry {\n  const page = await browser.newPage({ viewport: { width: 1400, height: 1000 }, deviceScaleFactor: 1 });\n  for (const part of [0, 1]) {\n    await page.goto(`file://${resolve(`docs/case-studies/issue-37/data/random-${phase}.html`)}`);\n    await page.evaluate((part) => {\n      [...document.querySelectorAll('article')].forEach((el, i) => {\n        if (Math.floor(i / 10) !== part) el.remove();\n      });\n    }, part);\n    await page.screenshot({\n      path: `docs/case-studies/issue-37/screenshots/random-${phase}-${part + 1}.png`,\n      fullPage: true,\n    });\n  }\n} finally {\n  await browser.close();\n}\n\n RUN  v5.0.5 /tmp/gh-issue-solver-1793367536891\n\n","exit_code":0,"status":"completed"}}
