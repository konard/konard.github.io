[2026-10-30T13:55:05.729Z] [STDOUT] {"type":"item.completed","item":{"id":"item_98","type":"command_execution","command":"/bin/bash -lc \"cat docs/case-studies/issue-41/PLAN.md; sed -n '1,250p' src/links/issue-37.test.js; sed -n '1,220p' src/links/solver-23.test.js; cat vitest.config.js\"","aggregated_output":"# Issue 41 work plan\n\nObjective: implement and verify every issue requirement in PR 42, preserving gaps,\nmanual settings, established loop/lens geometry and link identity.\n\n- [x] Read the complete issue, issue comments, PR conversation, inline comments and reviews.\n- [x] Inspect repository guidance, geometry, editor, solver, tests and recent related PRs.\n- [ ] Archive issue/PR data, related history and available CI logs; research existing layout components.\n- [ ] Reproduce all four supplied examples with failing geometry tests and before screenshots.\n- [ ] Implement topology-aware default turns in the shared editor/render/solver path; preserve explicit turns.\n- [ ] Audit other straight-capable configurations and every rendering call site.\n- [ ] Verify 20 seeded random cases with 1–3 links, plus exhaustive small-network geometry checks.\n- [ ] Verify gap settings stay unchanged, previous perfect configurations, manual turns,\n      style controls, worker spacing, Apply, sharing, downloads, gallery and mobile behavior.\n- [ ] Capture after screenshots and complete a requirement-by-requirement case study,\n      including timeline, root cause, alternatives and reproducible evidence.\n- [ ] Run local unit/browser/check/build/tooling validation sequentially within memory limits.\n- [ ] Commit atomic changes after local checks; merge latest main if needed; push only the prepared branch.\n- [ ] Update PR title/body with reproduction, tests, before/after images and Fixes #41.\n- [ ] Inspect the complete PR diff and refreshed feedback; verify current-head CI and save logs.\n- [ ] Confirm clean worktree, mark PR ready and report its URL; leave PR unmerged.\n\nCI investigation protocol: list the five newest runs with timestamp and head SHA;\ncompare with the latest commit; download each failed run to ci-logs; read logs in\nchunks of at most 1500 lines; record concrete errors and verify their resolution.\nNo required sub-issues or images are linked in the initial issue or PR feedback.\nNo Playwright MCP tools are exposed; use the repository's native Playwright harness.\nimport { expect, it } from 'vitest';\nimport { overlapCost, solveCollisions, turningCost } from './collisions';\nimport { decode } from './configurations';\nimport { bezier, glyphCurves, paintedCurve, layoutCurves, layout } from './glyph';\nimport { randomNetworks } from '../../experiments/issue-37-networks.mjs';\nimport { networkSvg } from './render';\nimport { normalizeStyle, shapeOfStyle, withSpacing, styleFromParams, styleToParams } from './style';\n\n// Independent dense centerline check: the two halves may join at their own\n// middle, but must not intersect elsewhere. Exclude the adjacent join segments.\nexport function shaftCrossings(curve) {\n  const points = curve.segments.map((segment) => Array.from({ length: 129 }, (_, k) => bezier(segment, k / 128)));\n  const side = (a, b, p) => (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0]);\n  let count = 0;\n  for (let i = 1; i < points[0].length; i++)\n    for (let j = 1; j < points[1].length; j++) {\n      const [a, b, c, d] = [points[0][i - 1], points[0][i], points[1][j - 1], points[1][j]];\n      if (side(a, b, c) * side(a, b, d) < -1e-20 && side(c, d, a) * side(c, d, b) < -1e-20) count++;\n    }\n  return count;\n}\n\nit('scores the self crossing that the old 2222 solution incorrectly reported as collision-free', () => {\n  const links = decode('22 22');\n  const shape = shapeOfStyle(normalizeStyle({ turns: '47 -47', gaps: '0.16 0.16' }), 2);\n  expect(shaftCrossings(layoutCurves(links, shape)[0])).toBe(1);\n  expect(overlapCost(links, shape) - turningCost(shape.turns)).toBeGreaterThan(1);\n});\n\nit('solves the reported 2222 network without introducing a crossing between its own references', () => {\n  const links = decode('22 22');\n  const shape = shapeOfStyle(normalizeStyle(), 2);\n  const result = solveCollisions(links, shape, { adjustGaps: true });\n  const curves = layoutCurves(links, { ...shape, turns: result.turns, linkGaps: result.linkGaps, frame: result.frame });\n  expect(curves.map(shaftCrossings)).toEqual([0, 0]);\n  expect(result.after - turningCost(result.turns)).toBeCloseTo(0, 8);\n});\n\nit('improves the four-link drawing with small reference adjustments at its original positions', () => {\n  const links = decode('34 44 21 32');\n  const style = normalizeStyle();\n  const shape = shapeOfStyle(style, 4);\n  const result = solveCollisions(links, shape, {\n    adjustGaps: true,\n    range: style.solveRange,\n    step: style.solveStep,\n    gapRange: style.solveGapRange,\n  });\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.after - turningCost(result.turns)).toBeLessThan(14);\n  expect(result.layout).toBeUndefined();\n  result.delta.flat().forEach((angle) => expect(Math.abs(angle)).toBeLessThanOrEqual(30));\n  expect(\n    overlapCost(links, { ...shape, turns: result.turns, linkGaps: result.linkGaps, frame: result.frame }),\n  ).toBeCloseTo(result.after, 8);\n});\n\n// Existing crossings and frozen closed-half marker clearances cannot always\n// vanish under the owner's stronger requirement to preserve the drawing.\n// Keep explicit regression ceilings; never turn those residuals into zero.\nconst FIXED_RESIDUAL = {\n  2012: 0.102,\n  '032113': 0.178,\n  43434143: 7,\n  33044224: 8,\n  31324042: 3,\n};\nit.each(randomNetworks())('locally spaces discovered random network %s without changing its arrangement', (code) => {\n  const links = decode(code.match(/../g).join(' '));\n  const shape = shapeOfStyle(normalizeStyle(), links.length);\n  const snapshot = JSON.stringify(shape);\n  const result = solveCollisions(links, shape, { adjustGaps: true });\n  expect(result.after - turningCost(result.turns)).toBeLessThanOrEqual(FIXED_RESIDUAL[code] ?? 1e-8);\n  expect(result.after).toBeLessThanOrEqual(result.before);\n  expect(JSON.stringify(shape)).toBe(snapshot);\n  const applied = normalizeStyle({\n    ...withSpacing(normalizeStyle(), result),\n  });\n  const fitted = shapeOfStyle(applied, links.length);\n  expect(overlapCost(links, fitted)).toBeCloseTo(result.after, 8);\n  expect(glyphCurves(links, fitted).map((curve) => shaftCrossings(paintedCurve(curve, fitted)))).toEqual(\n    links.map(() => 0),\n  );\n  expect(networkSvg(links, applied)).toBe(\n    networkSvg(links, normalizeStyle(), {\n      extraTurns: result.delta,\n      extraGaps: result.linkGaps,\n      extraFrame: result.frame,\n    }),\n  );\n  expect(styleFromParams(styleToParams(applied))).toEqual(applied);\n  result.delta.flat().forEach((angle) => expect(Math.abs(angle)).toBeLessThanOrEqual(30));\n  result.linkGaps.forEach((row, i) =>\n    row.forEach((value, k) => {\n      if (k >= 2 || links[i][k] === i + 1 || links[i][k] === 0) expect(value).toBe(shape.linkGaps[i]?.[k] ?? null);\n    }),\n  );\n});\n\nit('reduces overlaps in the suggested URL within its step/gap bounds and original placement', () => {\n  const links = decode('34 44 21 32');\n  const shape = shapeOfStyle(normalizeStyle(), 4);\n  const result = solveCollisions(links, shape, { adjustGaps: true, range: 180, step: 13, gapRange: 0.05 });\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.layout).toBeUndefined();\n  result.delta.flat().forEach((angle) => expect(angle % 13).toBeCloseTo(0, 8));\n  result.linkGaps.forEach((row) =>\n    row.slice(0, 2).forEach((gap) => {\n      if (gap !== null) expect(Math.abs(gap - shape.startGap)).toBeLessThanOrEqual(0.05 + 1e-9);\n    }),\n  );\n});\n\nit('maps circular positions to stable link IDs and ignores invalid orders', () => {\n  const natural = layout(4, { placement: 'circle' });\n  const reordered = layout(4, { placement: 'circle', order: '1 3 2 4' });\n  expect(reordered).toEqual([natural[0], natural[2], natural[1], natural[3]]);\n  for (const order of ['1 2', '1 1 3 4', '1 2 3 5', 'x'])\n    expect(layout(4, { placement: 'circle', order })).toEqual(natural);\n});\n\nit('preserves explicit layouts and disabled search bounds', () => {\n  const links = decode('34 44 21 32');\n  for (const patch of [{ placement: 'circle' }, { order: '1 2 3 4' }]) {\n    const shape = shapeOfStyle(normalizeStyle(patch), 4);\n    expect(solveCollisions(links, shape, { adjustGaps: true, passes: 1 }).layout).toBeUndefined();\n  }\n  const shape = shapeOfStyle(normalizeStyle(), 4);\n  for (const options of [{ passes: 0 }, { range: 0, gapRange: 0 }]) {\n    const result = solveCollisions(links, shape, { adjustGaps: true, ...options });\n    expect(result.layout).toBeUndefined();\n    expect(result.turns).toEqual(shape.turns);\n    expect(result.linkGaps).toEqual(shape.linkGaps);\n  }\n});\n\nit('preserves even the smallest configured spread', () => {\n  const links = decode('34 44 21 32');\n  const style = normalizeStyle({ spread: 0.1 });\n  const shape = shapeOfStyle(style, 4);\n  const result = solveCollisions(links, shape, { adjustGaps: true, passes: 1 });\n  expect(result.layout).toBeUndefined();\n  const applied = withSpacing(style, result);\n  expect(applied.spread).toBe(0.1);\n  expect(applied.order).toBe(style.order);\n});\nimport { expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { overlapCost, pairCost, solveCollisions } from './collisions';\nimport { bezier, glyphCurves } from './glyph';\nimport { networkSvg } from './render';\nimport { STYLE_DEFAULTS, normalizeStyle, shapeOfStyle, withSpacing, styleFromParams, styleToParams } from './style';\n\nit('reduces overlaps by adjusting individual gaps with angle search disabled', () => {\n  const links = decode('22 13 31');\n  const shape = shapeOfStyle(STYLE_DEFAULTS, 3);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(result.delta.flat().every((angle) => angle === 0)).toBe(true);\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row.some((value) => value !== null))).toBe(true);\n  const applied = withSpacing(STYLE_DEFAULTS, result);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n  expect(networkSvg(links, applied)).toBe(\n    networkSvg(links, STYLE_DEFAULTS, {\n      extraTurns: result.delta,\n      extraGaps: result.linkGaps,\n      extraFrame: result.frame,\n    }),\n  );\n  expect(styleFromParams(styleToParams(applied))).toEqual(normalizeStyle(applied));\n});\nit('bounds manual gap adjustments, preserves the input and never increases the exact score', () => {\n  const links = decode('23 31 12');\n  const style = normalizeStyle({ gaps: '0.5 0.7 20 25,0.4 0.3 2 3' });\n  const shape = shapeOfStyle(style, 3);\n  const original = structuredClone(shape);\n  const result = solveCollisions(links, shape, { adjustGaps: true, gapRange: 0.1, middleRange: 2 });\n  expect(shape).toEqual(original);\n  expect(result.after).toBeLessThanOrEqual(result.before);\n  result.linkGaps.forEach((row, i) =>\n    row.forEach((value, k) => {\n      const initial =\n        original.linkGaps[i]?.[k] ?? original[['startGap', 'endGap', 'middleGapStart', 'middleGapEnd'][k]];\n      expect(Math.abs((value ?? initial) - initial)).toBeLessThanOrEqual((k < 2 ? 0.1 : 2) + 1e-9);\n    }),\n  );\n  const applied = withSpacing(style, result);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n});\nit('does not count an artificial crossing through a cut in the middle', () => {\n  const line = [[-1, 0], [-0.4, 0], null, [0.4, 0], [1, 0]];\n  const cross = [\n    [0, -1],\n    [0, 1],\n  ];\n  expect(pairCost(line, cross, [])).toBe(0);\n  expect(pairCost(line.filter(Boolean), cross, [])).toBeGreaterThan(0);\n});\n\nit('also reduces overlaps by center cuts alone, without reference gap or angle changes', () => {\n  const links = decode('22 13 31');\n  const result = solveCollisions(links, shapeOfStyle(STYLE_DEFAULTS, 3), {\n    range: 0,\n    adjustGaps: true,\n    gapRange: 0,\n    middleRange: 15,\n  });\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row[2] > 0 || row[3] > 0)).toBe(true);\n  expect(result.linkGaps.every((row) => row[0] === null && row[1] === null)).toBe(true);\n  expect(result.turns.flat().every((value) => value === 0)).toBe(true);\n});\n\nit('bounds gap search cost for a dense 24-link drawing and returns its exact score', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const started = performance.now();\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(performance.now() - started).toBeLessThan(10000);\n  expect(result.after).toBeLessThan(result.before);\n  expect(\n    overlapCost(links, { ...shape, turns: result.turns, linkGaps: result.linkGaps, frame: result.frame }),\n  ).toBeCloseTo(result.after, 8);\n}, 15000);\n\nit('keeps automatic cuts within the final fitted half-length after reference gaps change', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true, gapRange: 1, middleRange: 15 });\n  expect(result.after).toBeLessThan(result.before);\n  const fitted = { ...shape, turns: result.turns, linkGaps: result.linkGaps, frame: result.frame };\n  glyphCurves(links, fitted).forEach((curve, i) => {\n    curve.segments.forEach((segment, k) => {\n      let length = 0;\n      let previous = segment[0];\n      for (let j = 1; j <= 1024; j++) {\n        const point = bezier(segment, j 