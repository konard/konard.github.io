lse if (tIn || tOut) d = rotate(tIn || tOut, bulge);\n  else if (s && t) d = rotate(tangent, Math.PI / 4 + bulge - SHAPE.bulge * RAD);\n  else d = rotate(tangent, bulge - SHAPE.bulge * RAD);\n\n  // Editor bending changes handles, with fixed endpoint axes. The legacy\n  // branch above remains the gallery/rain's original construction.\n  const balanced = o.bendMode === 'curve';\n  const freeAxis = balanced ? tIn || tOut || tangent : d;\n  if (balanced && !tIn && !tOut) {\n    d = s && t ? rotate(tangent, Math.PI / 4) : s || t ? tangent : rotate(tangent, bulge / 2);\n  }\n  const loopWidth = balanced ? Math.exp((o.bulge + o.loopBend) / 180) : 1;\n\n  let first;\n  let start;\n  if (s === 0) {\n    const dir = rotate(freeAxis, turnIn);\n    const from = sub(m, mul(dir, free));\n    first = [from, add(from, mul(dir, free / 3)), sub(m, mul(d, free / 3)), m];\n    start = { at: from, dir };\n  } else if (s === i + 1) {\n    // A loop that leaves the middle sideways and comes back through it.\n    const angle = o.angles === 'fixed' ? (o.sourceAngle - SHAPE.sourceAngle) * RAD : 0;\n    const away = rotate(t === i + 1 ? rotate(d, Math.PI / 2) : side(d, mul(d, -1), out), turnIn + angle);\n    const from = add(m, mul(away, startGap));\n    first = [\n      from,\n      add(m, mul(away, Math.max(loop * loopWidth, startGap + 0.01))),\n      sub(m, mul(d, (loop * Math.max(0.03, o.tension)) / SHAPE.tension)),\n      m,\n    ];\n    start = { at: from, dir: away };\n  } else {\n    const p = places[s - 1].at;\n    const chord = unit(sub(m, p));\n    const dir = rotate(approach(d, chord, s === t, o.sourceAngle, o), turnIn);\n    const k = o.tension * length(sub(m, p));\n    const from = add(p, mul(dir, startGap));\n    first = [from, add(from, mul(dir, k)), sub(m, mul(d, k)), m];\n    start = { at: from, dir };\n  }\n\n  let second;\n  let end;\n  if (t === 0) {\n    const dir = rotate(freeAxis, turnOut);\n    const to = add(m, mul(dir, free));\n    second = [m, add(m, mul(d, free / 3)), sub(to, mul(dir, free / 3)), to];\n    end = { at: to, dir };\n  } else if (t === i + 1) {\n    // Point-symmetric to the source loop, so (1: 1 1) is an even ∞.\n    const angle = o.angles === 'fixed' ? (o.targetAngle - SHAPE.targetAngle) * RAD : 0;\n    const away = rotate(s === i + 1 ? rotate(d, -Math.PI / 2) : side(d, d, out), turnOut + (balanced ? angle : -angle));\n    const to = add(m, mul(away, endGap));\n    second = [\n      m,\n      add(m, mul(d, (loop * Math.max(0.03, o.tension)) / SHAPE.tension)),\n      add(m, mul(away, Math.max(loop * loopWidth, endGap + 0.01))),\n      to,\n    ];\n    end = { at: to, dir: mul(away, -1) };\n  } else {\n    const q = places[t - 1].at;\n    const chord = unit(sub(q, m));\n    const dir = rotate(approach(d, chord, s === t, o.targetAngle, o), turnOut);\n    const k = o.tension * length(sub(q, m));\n    const to = sub(q, mul(dir, endGap));\n    second = [m, add(m, mul(d, k)), sub(to, mul(dir, k)), to];\n    end = { at: to, dir };\n  }\n  return { segments: [first, second], start, end, middle: { at: m, dir: d }, sharedReference: s === t && other(s) };\n}\n\n/** The point at parameter u ∈ [0, 1] of a cubic Bézier segment. */\nexport const bezier = ([p0, p1, p2, p3], u) => {\n  const v = 1 - u;\n  return add(add(mul(p0, v * v * v), mul(p1, 3 * v * v * u)), add(mul(p2, 3 * v * u * u), mul(p3, u * u * u)));\n};\n\n/** The shape options with the defaults filled in. */\nexport const shapeOf = (shape = {}) => ({ ...SHAPE, ...shape, turns: shape.turns || SHAPE.turns });\n\n/** The curves of every link in layout units, before they are scaled into the box. */\nexport function layoutCurves(links, shape = {}) {\n  const n = links.length;\n  if (n < 1) throw new RangeError('A symbol needs at least one link');\n  const o = shapeOf(shape);\n  const places = layout(n, o, links);\n  return links.map((_, i) => linkCurve(links, i, places, o));\n}\n\n/** Shared fitting transform, also used to score middle cuts in image units. */\nexport function curveTransform(curves, shape = {}) {\n  const o = shapeOf(shape);\n  const frame = normalizeFrame(o.frame);\n  if (frame) {\n    const [scale, x, y] = frame.split(' ').map(Number);\n    return { scale, shift: [x, y] };\n  }\n  const markerRoom = Math.max(\n    ...['start', 'end', 'middle'].map((key) =>\n      o[key] === 'none' ? 0 : o[`${key}Size`] + Math.hypot(o[`${key}Offset`], o[`${key}Across`]),\n    ),\n  );\n  const pad = Math.min(48, Math.max(o.padding, markerRoom + (o.strokeWidth || 0) / 2));\n  const points = curves.flatMap((c) =>\n    c.segments.flatMap((seg) => Array.from({ length: 17 }, (_, k) => bezier(seg, k / 16))),\n  );\n  const xs = points.map((p) => p[0]);\n  const ys = points.map((p) => p[1]);\n  const [minX, maxX, minY, maxY] = [\n    xs.reduce((a, b) => Math.min(a, b), Infinity),\n    xs.reduce((a, b) => Math.max(a, b), -Infinity),\n    ys.reduce((a, b) => Math.min(a, b), Infinity),\n    ys.reduce((a, b) => Math.max(a, b), -Infinity),\n  ];\n  const scale = Math.min(SCALE, (SIZE - 2 * pad) / Math.max(maxX - minX, maxY - minY, 1e-9));\n  const shift = [SIZE / 2 - ((minX + maxX) / 2) * scale, SIZE / 2 - ((minY + maxY) / 2) * scale];\n  return { scale, shift };\n}\n\n/** Persist the original image frame without accepting arbitrary layout data. */\nexport function normalizeFrame(value) {\n  if (typeof value !== 'string' || !value.trim()) return '';\n  const parts = value.trim().split(/\\s+/).map(Number);\n  if (parts.length !== 3 || parts.some((v) => !Number.isFinite(v) || Math.abs(v) > 1e6)) return '';\n  if (parts[0] < 1e-9 || parts[0] > SCALE) return '';\n  return parts.join(' ');\n}\n\n/** The curves of every link, already scaled into the SIZE box. */\nexport function glyphCurves(links, shape = {}) {\n  const curves = layoutCurves(links, shape);\n  const { scale, shift } = curveTransform(curves, shape);\n  const place = (p) => add(mul(p, scale), shift);\n  return curves.map((c) => ({\n    sharedReference: c.sharedReference,\n    segments: c.segments.map((seg) => seg.map(place)),\n    start: { at: place(c.start.at), dir: c.start.dir },\n    end: { at: place(c.end.at), dir: c.end.dir },\n    middle: { at: place(c.middle.at), dir: c.middle.dir },\n  }));\n}\n\nconst fmt = (p) => `${+p[0].toFixed(2)} ${+p[1].toFixed(2)}`;\n\n/** A circle of radius `r` around `c` as a path. */\nconst circle = (c, r) =>\n  `M${fmt(sub(c, [r, 0]))}a${+r.toFixed(2)} ${+r.toFixed(2)} 0 1 0 ${+(2 * r).toFixed(2)} 0` +\n  `a${+r.toFixed(2)} ${+r.toFixed(2)} 0 1 0 ${+(-2 * r).toFixed(2)} 0Z`;\nconst polygon = (points) => `M${points.map(fmt).join('L')}Z`;\n\n/**\n * The shape `kind` at point `at` of a line going in direction `dir`: `size`\n * is its size in SIZE units, `angle` the half-angle of an arrow head.\n * Returns `{ d, fill }`; filled shapes are painted in the link colour.\n */\nfunction markerPath(kind, at, dir, size, angle) {\n  const a = angle * RAD;\n  const across = rotate(dir, Math.PI / 2);\n  const back = mul(dir, -size);\n  switch (kind) {\n    case 'bar':\n      return { d: `M${fmt(add(at, mul(across, size)))}L${fmt(sub(at, mul(across, size)))}`, fill: false };\n    case 'arrow':\n      return { d: `M${fmt(add(at, rotate(back, a)))}L${fmt(at)}L${fmt(add(at, rotate(back, -a)))}`, fill: false };\n    case 'tail':\n      return {\n        d: `M${fmt(sub(at, rotate(back, a)))}L${fmt(at)}L${fmt(sub(at, rotate(back, -a)))}`,\n        fill: false,\n      };\n    case 'triangle':\n      return { d: polygon([at, add(at, rotate(back, a)), add(at, rotate(back, -a))]), fill: true };\n    case 'dot':\n      return { d: circle(at, size / 2), fill: true };\n    case 'circle':\n      return { d: circle(at, size / 2), fill: false };\n    case 'square': {\n      const h = size / 2;\n      const [u, v] = [mul(dir, h), mul(across, h)];\n      return {\n        d: polygon([add(add(at, u), v), sub(add(at, u), v), sub(sub(at, u), v), add(sub(at, u), v)]),\n        fill: true,\n      };\n    }\n    case 'diamond': {\n      const h = size / 2;\n      return {\n        d: polygon([\n          add(at, mul(dir, h * 1.4)),\n          add(at, mul(across, h)),\n          sub(at, mul(dir, h * 1.4)),\n          sub(at, mul(across, h)),\n        ]),\n        fill: true,\n      };\n    }\n    default:\n      return { d: '', fill: false };\n  }\n}\n\n/** Arrow stroke joins have a geometric extension beyond their path vertex. */\nexport function arrowMiterLimit(angle, outline = [], kind = 'arrow') {\n  // SVG coordinates are rounded for export. At acute angles that tiny change\n  // can cross the nominal miter threshold, so measure the exported arms too.\n  const [tip, a, b] = kind === 'triangle' ? [outline[0], outline[1], outline[2]] : [outline[1], outline[0], outline[2]];\n  let actual = 0;\n  if (tip && a && b) {\n    const u = sub(a, tip);\n    const v = sub(b, tip);\n    const cosine = dot(u, v) / (length(u) * length(v) || 1);\n    actual = 1 / Math.sqrt(Math.max(1e-12, (1 - Math.min(1, cosine)) / 2));\n  }\n  return Math.max(4, 1 / Math.sin(angle * RAD), actual) + 0.01;\n}\n\n/** Keep the same painted outward extent as the nominal round/flat line end.\n * Move the endpoint and its adjacent handle together, retaining its tangent\n * and the curve's middle. The legacy option leaves both unchanged.\n */\nexport function paintedCurve(curve, o) {\n  if (!o.balanceArrows || o.arrowJoin !== 'miter') return curve;\n  const segments = curve.segments.map((segment) => segment.map((p) => [...p]));\n  const result = { ...curve, segments };\n  for (const key of ['start', 'end']) {\n    if (!(key === 'end' ? ['arrow', 'triangle'] : ['tail']).includes(o[key])) continue;\n    // Explicit marker displacement/rotation is intentional and keeps its meaning.\n    if (o[`${key}Offset`] || o[`${key}Across`] || o[`${key}Rotation`]) continue;\n    const cap = o.linecap === 'butt' ? 0 : (o.strokeWidth || 0) / 2;\n    const extra = (o.strokeWidth || 0) / 2 / Math.sin(o[`${key}Angle`] * RAD);\n    // A lens has one common outward axis. Its equally gapped ends therefore\n    // share an exact painted boundary, even when the tip tangent is oblique.\n    // Only a lens shares an outward axis. Self-reference endpoints point\n    // toward their own middle: averaging their opposite positions flips the\n    // cap correction as soon as the two gaps cross equality (issue #27).\n    const axis = curve.sharedReference ? sub(mul(add(curve.start.at, curve.end.at), 0.5), curve.middle.at) : [0, 0];\n    const outward = length(axis) > 1e-6 ? unit(axis) : mul(curve[key].dir, key === 'end' ? 1 : -1);\n    const move = add(mul(curve[key].dir, key === 'end' ? -extra : extra), mul(outward, cap));\n    const segment = segments[key === 'end' ? 1 : 0];\n    for (const j of key === 'end' ? [2, 3] : [0, 1]) segment[j] = add(segment[j], move);\n    result[key] = { ...curve[key], at: add(curve[key].at, move) };\n  }\n  return result;\n}\n\n/** Path plus a bounded outline for collision scoring, from the same marker. */\nexport function marker(kind, at, dir, size, angle) {\n  const result = markerPath(kind, at, dir, size, angle);\n  if (!result.d) return { ...result, outline: [] };\n  let outline;\n  if (kind === 'dot' || kind === 'circle') {\n    outline = Array.from({ length: 17 }, (_, k) => add(at, mul(rotate(dir, (k * Math.PI) / 8), size / 2)));\n  } else {\n    const values = result.d.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\n    outline = Array.from({ length: values.length / 2 }, (_, i) => values.slice(i * 2, i * 2 + 2));\n    if (result.fill) outline.push(outline[0]);\n  }\n  return { ...result, outline };\n}\n\n/** Shared placement for rendering and scoring, including curve-following offsets. */\nexport function curveMarkers(curve, o) {\n  return Object.fromEntries(\n    ['start', 'end', 'middle'].map((key) => {\n      let point = curve[key];\n      const offset = (key === 'end' ? -1 : 1) * o[`${key}Offset`];\n      if (offset !== 0) point = pointAlongCurve(curve.segments, offset, key);\n      const at = add(point.at, mul(rotate(point.dir, Math.PI / 2), o[`${key}Across`]));\n      return [key, marker(o[key], at, rotate(point.dir, o[`${key}Rotation`] * RAD), o[`${key}Size`], o[`${key}Angle`])];\n    }),\n  );\n}\n\n/** The parts of every link: its line and the shapes of its start, end and middle (`{ d, fill }`). */\nexport function glyphParts(links, shape = {}) {\n  const o = shapeOf(shape);\n  return glyphCurves(links, o).map((raw, i) => {\n    const curve = paintedCurve(raw, o);\n    const { segments } = curve;\n    const marks = curveMarkers(curve, o);\n    const middleGapStart = o.linkGaps[i]?.[2] ?? o.middleGapStart;\n    const middleGapEnd = o.linkGaps[i]?.[3] ?? o.middleGapEnd;\n    const split = middleGapStart > 0 || middleGapEnd > 0;\n    const visible = [trimCurve(segments[0], middleGapStart), trimCurve(segments[1], middleGapEnd, true)].filter(\n      Boolean,\n    );\n    const line = split\n      ? visible.map((seg) => `M${fmt(seg[0])}C${seg.slice(1).map(fmt).join(' ')}`).join('')\n      : `M${fmt(segments[0][0])}` + segments.map((seg) => `C${seg.slice(1).map(fmt).join(' ')}`).join('');\n    return {\n      line,\n      ...marks,\n      color: COLORS[i % COLORS.length],\n    };\n  });\n}\n\n/** One SVG path per link: the continuous line, the source bar and the target arrow. */\nexport function glyphPaths(links, shape = {}) {\n  return glyphParts(links, shape).map(({ line, start, end, middle, color }) => ({\n    d: line + start.d + end.d + middle.d,\n    color,\n  }));\n}\n\n/** A standalone SVG document of a network (used by tests and experiments). */\nexport function glyphSvg(links, size = SIZE) {\n  const paths = glyphPaths(links)\n    .map(({ d, color }) => `<path d=\"${d}\" stroke=\"${color}\"/>`)\n    .join('');\n  return (\n    `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${size}\" height=\"${size}\" viewBox=\"0 0 ${SIZE} ${SIZE}\" ` +\n    `fill=\"none\" stroke-width=\"${STROKE}\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${paths}</svg>`\n  );\n}\n// Every option of the picture of a network in the editor of /network/\n// (issue #17): the shape of the links (the angle at which a link leaves its\n// source and enters its target, its start, end and middle), the lines, the\n// colours, the background, the card around the symbol, a caption, the size of\n// the exported image and the experimental solver of overlaps.\n//\n// The fields reuse the helpers of the settings page (src/settings/fields.js).\n// A style is a flat object; `normalizeStyle` checks every value (it may come\n// from a shared link), and `styleToParams` / `styleFromParams` keep only the\n// values that differ from the defaults in the query string, so a shared link\n// opens exactly the picture that was shared.\nimport { color, option, range, select, toggle } from '../settings/fields';\nimport { COLORS, SHAPE, normalizeFrame } from './glyph';\nimport { GEOMETRY_SECTIONS } from './style-geometry';\nimport { linkGaps, normalizeGaps, withGaps } from './gaps';\n\n/** Link colours: the site's, and a few more sets of nine. */\nexport const PALETTES = {\n  site: COLORS,\n  neon: ['#00f0ff', '#ff00e6', '#faff00', '#00ff85', '#ff6b00', '#8a5cff', '#ff2d55', '#00b3ff', '#c6ff00'],\n  pastel: ['#93c5fd', '#c4b5fd', '#f9a8d4', '#fde68a', '#a7f3d0', '#fed7aa', '#bae6fd', '#fecaca', '#d9f99d'],\n  warm: ['#f97316', '#ef4444', '#eab308', '#f43f5e', '#fb923c', '#facc15', '#dc2626', '#fbbf24', '#e11d48'],\n  cold: ['#06b6d4', '#3b82f6', '#8b5cf6', '#14b8a6', '#0ea5e9', '#6366f1', '#22d3ee', '#a78bfa', '#2dd4bf'],\n  // The light-theme link colours of src/index.css, for light backgrounds.\n  print: ['#0e7490', '#9333ea', '#db2777', '#b45309', '#047857', '#c2410c', '#1d4ed8', '#b91c1c', '#4d7c0f'],\n};\n\n/** Sections of the editor; each field is one option of the style. */\nexport const STYLE_SECTIONS = [\n  ...GEOMETRY_SECTIONS,\n  {\n    id: 'lines',\n    title: { en: 'Lines and colours', ru: 'Линии и цвета' },\n    fields: [\n      range('strokeWidth', 1.3, 0.5, 10, 0.1, { en: 'Line width', ru: 'Толщина линий' }),\n      select(\n        'dash',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('dashdot', 'Dash and dot', 'Штрих-пунктир'),\n          option('long', 'Long dashes', 'Длинные штрихи'),\n        ],\n        { en: 'Line style', ru: 'Стиль линий' },\n      ),\n      select(\n        'linecap',\n        'round',\n        [\n          option('round', 'Round', 'Круглые'),\n          option('butt', 'Flat', 'Плоские'),\n          option('square', 'Square', 'Квадратные'),\n        ],\n        { en: 'Line ends', ru: 'Концы линий' },\n      ),\n      select(\n        'linejoin',\n        'miter',\n        [\n          option('round', 'Round', 'Скруглённые'),\n          option('miter', 'Sharp', 'Острые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n        ],\n        { en: 'Corners', ru: 'Углы' },\n      ),\n      range('opacity', 1, 0.1, 1, 0.05, { en: 'Opacity', ru: 'Непрозрачность' }, { unit: '%' }),\n      range('glow', 0, 0, 12, 0.5, { en: 'Glow', ru: 'Свечение' }),\n      select(\n        'palette',\n        'site',\n        [\n          option('site', 'Site', 'Как на сайте'),\n          option('neon', 'Neon', 'Неон'),\n          option('pastel', 'Pastel', 'Пастель'),\n          option('warm', 'Warm', 'Тёплые'),\n          option('cold', 'Cold', 'Холодные'),\n          option('print', 'For light backgrounds', 'Для светлого фона'),\n          option('mono', 'One colour', 'Один цвет'),\n          option('custom', 'Own colour of each link', 'Свой цвет каждой связи'),\n        ],\n        { en: 'Colours of the links', ru: 'Цвета связей' },\n      ),\n      color(\n        'monoColor',\n        '#e6edf7',\n        { en: 'Colour of the links', ru: 'Цвет связей' },\n        {\n          when: (s) => s.palette === 'mono',\n        },\n      ),\n    ],\n  },\n  {\n    id: 'background',\n    title: { en: 'Background and card', ru: 'Фон и карточка' },\n    fields: [\n      select(\n        'background',\n        'solid',\n        [\n          option('transparent', 'Transparent', 'Прозрачный'),\n          option('solid', 'One colour', 'Один цвет'),\n          option('linear', 'Linear gradient', 'Линейный градиент'),\n          option('radial', 'Radial gradient', 'Радиальный градиент'),\n        ],\n        { en: 'Background', ru: 'Фон' },\n      ),\n      color(\n        'bgColor',\n        '#000000',\n        { en: 'Background colour', ru: 'Цвет фона' },\n        {\n          when: (s) => s.background !== 'transparent',\n        },\n      ),\n      color(\n        'bgColor2',\n        '#1e1b4b',\n        { en: 'Second colour', ru: 'Второй цвет' },\n        {\n          when: (s) => s.background === 'linear' || s.background === 'radial',\n        },\n      ),\n      range(\n        'bgAngle',\n        135,\n        0,\n        359,\n        1,\n        { en: 'Gradient angle', ru: 'Угол градиента' },\n        {\n          unit: '°',\n          when: (s) => s.background === 'linear',\n        },\n      ),\n      toggle('card', false, { en: 'Card around the symbol', ru: 'Карточка вокруг символа' }),\n      color('cardColor', '#0d1220', { en: 'Card colour', ru: 'Цвет карточки' }, { when: (s) => s.card }),\n      range(\n        'cardOpacity',\n        0.8,\n        0,\n        1,\n        0.05,\n        { en: 'Card opacity', ru: 'Непрозрачность карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n      select(\n        'borderStyle',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('double', 'Double', 'Двойная'),\n          option('none', 'No border', 'Без рамки'),\n        ],\n        { en: 'Border', ru: 'Рамка' },\n        { when: (s) => s.card },\n      ),\n      range(\n        'border',\n        0.6,\n        0.1,\n        6,\n        0.1,\n        { en: 'Border width', ru: 'Толщина рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      color(\n        'borderColor',\n        '#2b3b57',\n        { en: 'Border colour', ru: 'Цвет рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      range(\n        'radius',\n        10,\n        0,\n        50,\n        1,\n        { en: 'Corner radius', ru: 'Скругление углов' },\n        { unit: '%', when: (s) => s.card },\n      ),\n      range(\n        'inset',\n        3,\n        0,\n        30,\n        0.5,\n        { en: 'Space around the card', ru: 'Отступ вокруг карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n    ],\n  },\n  {\n    id: 'caption',\n    title: { en: 'Caption', ru: 'Подпись' },\n    fields: [\n      select('notation', 'L', [option('L', 'L → L²'), option('R', 'R → R²')], {\n        en: 'Theory notation',\n        ru: 'Нотация теории',\n      }),\n      select(\n        'caption',\n        'none',\n        [\n          option('none', 'None', 'Нет'),\n          option('theory', 'Math notation', 'Математическая нотация'),\n          option('pairs', 'Pairs with the base', 'Пары с основанием'),\n          option('number', 'N-ary number', 'N-ричное число'),\n          option('links', 'Links notation', 'Нотация связей'),\n          option('custom', 'Own text', 'Свой текст'),\n        ],\n        { en: 'Caption', ru: 'Подпись' },\n      ),\n      {\n        key: 'captionText',\n        type: 'text',\n        d: '',\n        max: 80,\n        label: { en: 'Text', ru: 'Текст' },\n        when: (s) => s.caption === 'custom',\n      },\n      color(\n        'captionColor',\n        '#7d8aa3',\n        { en: 'Caption colour', ru: 'Цвет подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      range(\n        'captionSize',\n        6,\n        3,\n        14,\n        0.5,\n        { en: 'Caption size', ru: 'Размер подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      select(\n        'captionFont',\n        'mono',\n        [\n          option('mono', 'Monospace', 'Моноширинный'),\n          option('sans', 'Sans serif', 'Без засечек'),\n          option('serif', 'Serif', 'С засечками'),\n        ],\n        { en: 'Font', ru: 'Шрифт' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n    ],\n  },\n  {\n    id: 'image',\n    title: { en: 'Image size', ru: 'Размер изображения' },\n    fields: [\n      range('width', 2048, 64, 4096, 1, { en: 'Width', ru: 'Ширина' }, { unit: 'px' }),\n      range('height', 2048, 64, 4096, 1, { en: 'Height', ru: 'Высота' }, { unit: 'px' }),\n      range('quality', 0.92, 0.5, 1, 0.01, { en: 'JPEG and WebP quality', ru: 'Качество JPEG и WebP' }, { unit: '%' }),\n    ],\n  },\n  {\n    id: 'experimental',\n    title: { en: 'Experimental: fewer overlaps', ru: 'Эксперимент: меньше наложений' },\n    lead: {\n      en: 'Keeps link placement, order and colors. Makes small adjustments to open references; already well-spaced drawings and self-closed halves stay unchanged. References to a closed link prefer mirrored ends and uniform spaces. Some crossings remain with fixed placement. Apply the result to keep editing it.',\n      ru: 'Сохраняет размещение, порядок и цвета связей. Немного корректирует открытые ссылки; уже настроенные рисунки и замкнутые половины остаются без изменений. Ссылки на замкнутую связь предпочитает делать зеркальными, с равномерными промежутками. При фиксированном размещении некоторые пересечения остаются. Примените результат, чтобы продолжить редактирование.',\n    },\n    fields: [\n      toggle('solve', false, { en: 'Reduce overlaps automatically', ru: 'Уменьшать наложения автоматически' }),\n      range(\n        'clearance',\n        1,\n        0,\n        10,\n        0.25,\n        { en: 'Space between strokes', ru: 'Промежуток между линиями' },\n        {\n          hint: {\n            en: 'Preferred minimum space between painted lines and markers, in 1/100 of the symbol. The solver finds the nearest arrangement within its search limits.',\n            ru: 'Желаемый минимальный промежуток между линиями и маркерами в 1/100 символа. Поиск находит ближайшую конфигурацию в заданных пределах.',\n          },\n        },\n      ),\n      toggle('solveDebug', false, { en: 'Solver diagnostics in console', ru: 'Диагностика поиска в консоли' }),\n      toggle('solveGaps', true, { en: 'Adjust individual gaps', ru: 'Менять отдельные зазоры' }),\n      range('solveGapRange', 0.2, 0, 1, 0.05, { en: 'Largest reference gap change', ru: 'Изменение зазора ссылки' }),\n      range(\n        'solveMiddleRange',\n        0,\n        0,\n        15,\n        0.5,\n        { en: 'Largest middle cut change', ru: 'Изменение разрыва середины' },\n        {\n          hint: {\n            en: 'Zero preserves the configured middle cuts. Increase this value to let automatic spacing open or adjust cuts.',\n            ru: 'Ноль сохраняет заданные разрывы середины. Увеличьте значение, чтобы автоматическая настройка могла создавать или менять разрывы.',\n          },\n        },\n      ),\n      range(\n        'solveRange',\n        30,\n        0,\n        180,\n        1,\n        { en: 'Largest turn', ru: 'Наибольший поворот' },\n        {\n          unit: '°',\n          hint: {\n            en: 'Defaults to small corrections of at most 30°. Larger values allow stronger reference bending, while link placement and colors stay fixed.',\n            ru: 'По умолчанию небольшие поправки до 30°. Большие значения разрешают сильнее изгибать ссылки, сохраняя размещение и цвета связей.',\n          },\n        },\n      ),\n      range('solveStep', 1, 1, 30, 1, { en: 'Turn step', ru: 'Шаг поворота' }, { unit: '°' }),\n    ],\n  },\n];\n\n/** The options kept per link: its colour (with the own colours) and the turns of its ends. */\nconst PER_LINK = [\n  { key: 'colors', type: 'list', d: COLORS.join(',') },\n  { key: 'gap', type: 'range', d: 0.08, min: 0, max: 0.4 },\n  { key: 'turns', type: 'list', d: '' },\n  { key: 'gaps', type: 'list', d: '' },\n  { key: 'frame', type: 'frame', d: '' },\n];\n\nexport const STYLE_FIELDS = [...STYLE_SECTIONS.flatMap((section) => section.fields), ...PER_LINK];\nexport const STYLE_DEFAULTS = Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, field.d]));\n\nconst HEX = /^#[0-9a-f]{6}$/i;\nconst clamp = (value, min, max) => Math.min(max, Math.max(min, value));\n\n/** A per-link list \"a,b,c\" of colours, or of turns \"source target\". */\nfunction normalizeList(key, value) {\n  if (key === 'gaps') return normalizeGaps(value);\n  const items = String(value ?? '').split(',');\n  if (key === 'colors')\n    return items.every((c) => HEX.test(c.trim())) ? items.map((c) => c.trim().toLowerCase()).join(',') : '';\n  const turns = items.map((item) =>\n    item\n      .trim()\n      .split(/\\s+/)\n      .slice(0, 2)\n      .map((a) => clamp(Math.round(Number(a)) || 0, -180, 180)),\n  );\n  // Links after the last turned one need no entry: they are not turned.\n  while (turns.length && turns[turns.length - 1].every((a) => a === 0)) turns.pop();\n  return turns.map((pair) => `${pair[0]} ${pair[1] ?? 0}`).join(',');\n}\n\n/** One value of a style checked against its field: the default if it is not valid. */\nfunction normalizeValue(field, value) {\n  if (value === undefined) return field.d;\n  switch (field.type) {\n    case 'frame':\n      return normalizeFrame(value);\n    case 'range': {\n      const number = typeof value === 'number' ? value : Number(value);\n      return Number.isFinite(number) && value !== '' && value !== null ? clamp(number, field.min, field.max) : field.d;\n    }\n    case 'toggle':\n      if (typeof value === 'boolean') return value;\n      return value === 'true' || value === '1' ? true : value === 'false' || value === '0' ? false : field.d;\n    case 'select':\n      return field.options.some((o) => o.value === value) ? value : field.d;\n    case 'color':\n      return HEX.test(value) ? value.toLowerCase() : field.d;\n    case 'text':\n      return typeof value === 'string' ? value.slice(0, field.max) : field.d;\n    default:\n      return normalizeList(field.key, value);\n  }\n}\n\n/** A complete, valid style: every option of `raw` checked, the rest the defaults. */\nexport function normalizeStyle(raw = {}) {\n  // Bookmarks from issue #17 used one gap for both references.\n  // Older shared links omitted palette=custom because it was the default.\n  if (raw?.colors !== undefined && raw?.palette === undefined) raw = { ...raw, palette: 'custom' };\n  if (raw?.gap !== undefined) raw = { startGap: raw.gap, endGap: raw.gap, ...raw };\n  return Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, normalizeValue(field, raw?.[field.key])]));\n}\n\n/** The options that differ from the defaults as query parameters. */\nexport function styleToParams(style) {\n  const params = new URLSearchParams();\n  STYLE_FIELDS.forEach(({ key }) => {\n    let value = String(style[key]);\n    if (key === 'turns')\n      value = normalizeList(key, value)\n        .split(',')\n        .map((row) => (row === '0 0' ? '' : row))\n        .join(',');\n    if (key === 'gaps')\n      value = normalizeGaps(value)\n        .split(',')\n        .map((row) => row.replace(/(?: ?~)+$/, ''))\n        .join(',');\n    if (value !== String(STYLE_DEFAULTS[key])) params.set(key, value);\n  });\n  return params;\n}\n\n/** A style read from query parameters (unknown or invalid values are left out). */\nexport function styleFromParams(params) {\n  const raw = {};\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i % COLORS.length];\n    const palette = PALETTES[style.palette] || COLORS;\n    return palette[i % palette.length];\n  });\n}\n\n/** The [source, target] turns of each of `n` links, in degrees. */\nexport function linkTurns(style, n) {\n  const turns = style.turns ? style.turns.split(',').map((pair) => pair.split(' ').map(Number)) : [];\n  return Array.from({ length: n }, (_, i) => turns[i] || [0, 0]);\n}\n\n/** A style with the turns of each link set to `turns` ([[source, target], …]). */\nexport const withTurns = (style, turns) =>\n  normalizeStyle({ ...style, turns: turns.map((pair) => pair.join(' ')).join(',') });\n\n/** Apply only spacing fields. Placement, colors and concurrent style edits stay owned by the editor. */\nexport const withSpacing = (style, result) =>\n  normalizeStyle({\n    ...withGaps(withTurns(style, result.turns), result.linkGaps),\n    frame: result.frame ?? style.frame,\n    solve: false,\n  });\n\n/** A style where link `i` has its own colour `value` (the other links keep the colours they had). */\nexport function withColor(style, n, i, value) {\n  const colors = linkColors(style, Math.max(n, COLORS.length));\n  colors[i] = value;\n  return normalizeStyle({ ...style, palette: 'custom', colors: colors.join(',') });\n}\n\n/** The shape options of glyph.js taken from a style. */\nexport function shapeOfStyle(style, n, extraTurns = null, extraGaps = null) {\n  const turns = linkTurns(style, n).map((pair, i) =>\n    extraTurns ? [pair[0] + extraTurns[i][0], pair[1] + extraTurns[i][1]] : pair,\n  );\n  return Object.fromEntries([\n    ...Object.keys(SHAPE)\n      .filter((key) => !['turns', 'linkGaps'].includes(key))\n      .map((key) => [key, style[key]]),\n    ['turns', turns],\n    