st.jsx:74:  expect(window.location.search).toContain('targetAngle=66');\nsrc/pages/network-history.test.jsx:90:  expect(window.location.search).toContain('targetAngle=66');\nimport { describe, expect, it } from 'vitest';\nimport { bezier, glyphCurves, glyphParts, layoutCurves } from './glyph';\nimport { STYLE_DEFAULTS, STYLE_FIELDS, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams } from './style';\n\nconst shape = (raw = {}, n = 1) => shapeOfStyle(normalizeStyle(raw), n);\nconst numbers = (path) => path.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\nconst sub = (a, b) => a.map((v, i) => v - b[i]);\nconst cross = (a, b) => a[0] * b[1] - a[1] * b[0];\n\ndescribe('issue 23 geometry regressions', () => {\n  it('defaults to straight free links with neutral bend and rotation', () => {\n    expect(STYLE_DEFAULTS.bulge).toBe(0);\n    expect(STYLE_DEFAULTS.rotation).toBe(0);\n    const [curve] = layoutCurves([[0, 0]], shape());\n    const axis = sub(curve.end.at, curve.start.at);\n    for (const segment of curve.segments)\n      for (let k = 0; k <= 20; k++)\n        expect(Math.abs(cross(sub(bezier(segment, k / 20), curve.start.at), axis))).toBeLessThan(1e-10);\n  });\n\n  it('accepts signed bends and endpoint angles over a full turn', () => {\n    for (const key of ['bulge', 'rotation', 'sourceAngle', 'targetAngle']) {\n      const field = STYLE_FIELDS.find((f) => f.key === key);\n      expect(field.min, key).toBeLessThanOrEqual(-180);\n      expect(field.max, key).toBeGreaterThanOrEqual(180);\n      expect(normalizeStyle({ [key]: -150 })[key]).toBe(-150);\n    }\n  });\n\n  it('adjusts self/partial loop width independently while leaving free links straight', () => {\n    const free = layoutCurves([[0, 0]], shape());\n    for (const loopBend of [-180, 0, 180]) {\n      expect(layoutCurves([[0, 0]], shape({ loopBend }))).toEqual(free);\n      for (const links of [[[1, 1]], [[0, 1]], [[1, 0]]]) {\n        const [base] = layoutCurves(links, shape());\n        const [curve] = layoutCurves(links, shape({ loopBend }));\n        expect(curve.start.at).toEqual(base.start.at);\n        expect(curve.end.at).toEqual(base.end.at);\n        if (loopBend !== 0) expect(curve.segments).not.toEqual(base.segments);\n        if (links[0][0] === 0) expect(curve.segments[0]).toEqual(base.segments[0]);\n        if (links[0][1] === 0) expect(curve.segments[1]).toEqual(base.segments[1]);\n      }\n    }\n  });\n\n  it('moves a source bar along its cubic and rotates it with the local tangent', () => {\n    const options = shape({ bulge: 90, startOffset: 12 });\n    const [curve] = glyphCurves([[0, 0]], options);\n    const [part] = glyphParts([[0, 0]], options);\n    const [x1, y1, x2, y2] = numbers(part.start.d);\n    const at = [(x1 + x2) / 2, (y1 + y2) / 2];\n    let best = { distance: Infinity };\n    for (let k = 0; k <= 10000; k++) {\n      const t = k / 10000;\n      const p = bezier(curve.segments[0], t);\n      const distance = Math.hypot(...sub(p, at));\n      if (distance < best.distance) best = { distance, t };\n    }\n    expect(best.distance).toBeLessThan(0.02);\n    const tangent = sub(bezier(curve.segments[0], best.t + 0.00001), bezier(curve.segments[0], best.t - 0.00001));\n    const bar = [x2 - x1, y2 - y1];\n    expect(\n      Math.abs((tangent[0] * bar[0] + tangent[1] * bar[1]) / Math.hypot(...tangent) / Math.hypot(...bar)),\n    ).toBeLessThan(0.005);\n  });\n\n  it('preserves independent per-link gaps through normalization and sharing', () => {\n    const style = normalizeStyle({ gaps: '0.2 0.3 4 5,~ 0 0 0' });\n    expect(style.gaps).toBe('0.2 0.3 4 5,~ 0 0 0');\n    expect(styleFromParams(styleToParams(style))).toEqual(style);\n    const links = [\n      [1, 1],\n      [2, 2],\n    ];\n    const curves = layoutCurves(links, shapeOfStyle(style, 2));\n    const distance = (a, b) => Math.hypot(...sub(a, b));\n    expect(distance(curves[0].start.at, curves[0].middle.at)).toBeCloseTo(0.2, 10);\n    expect(distance(curves[0].end.at, curves[0].middle.at)).toBeCloseTo(0.3, 10);\n    expect(distance(curves[1].start.at, curves[1].middle.at)).toBeCloseTo(STYLE_DEFAULTS.startGap, 10);\n    const parts = glyphParts(links, shapeOfStyle(style, 2));\n    expect(parts[0].line.match(/M/g)).toHaveLength(2);\n    expect(parts[1].line.match(/M/g)).toHaveLength(1);\n  });\n});\nimport { expect, it } from 'vitest';\nimport { pointAlongCurve } from './curve-tools';\nimport { bezier, glyphCurves, glyphParts } from './glyph';\nimport { normalizeStyle, shapeOfStyle } from './style';\nconst numbers = (path) => path.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\nconst sub = (a, b) => a.map((v, i) => v - b[i]);\nit('places endpoint and middle markers on both halves with local tangents, even across the join', () => {\n  for (const key of ['start', 'end', 'middle']) {\n    for (const offset of [-12, 12, 20]) {\n      const shape = shapeOfStyle(\n        normalizeStyle({\n          bulge: 130,\n          start: 'bar',\n          end: 'bar',\n          middle: 'bar',\n          startOffset: 0,\n          [`${key}Offset`]: offset,\n        }),\n        1,\n      );\n      const [curve] = glyphCurves([[1, 1]], shape);\n      const expected = pointAlongCurve(curve.segments, key === 'end' ? -offset : offset, key);\n      const marker = glyphParts([[1, 1]], shape)[0][key];\n      const [x, y, u, v] = numbers(marker.d);\n      expect(Math.hypot(x + u - 2 * expected.at[0], y + v - 2 * expected.at[1])).toBeLessThan(0.02);\n      expect(Math.abs((u - x) * expected.dir[0] + (v - y) * expected.dir[1])).toBeLessThan(0.025);\n    }\n  }\n});\nit('measures path distance rather than a tangent translation and extends ends safely', () => {\n  const segments = [\n    [\n      [0, 0],\n      [0, 10],\n      [10, 10],\n      [10, 0],\n    ],\n    [\n      [10, 0],\n      [10, -10],\n      [20, -10],\n      [20, 0],\n    ],\n  ];\n  const at = pointAlongCurve(segments, 10);\n  expect(Math.hypot(...sub(at.at, bezier(segments[0], 0.5)))).toBeLessThan(0.001);\n  expect(pointAlongCurve(segments, 25).at[0]).toBeGreaterThan(10);\n  expect(pointAlongCurve(segments, 0, 'middle').at).toEqual([10, 0]);\n  expect(pointAlongCurve(segments, -4).at).toEqual([0, -4]);\n  expect(pointAlongCurve(segments, 4, 'end').at).toEqual([20, 4]);\n  expect(pointAlongCurve([Array(4).fill([3, 5])], 10)).toEqual({ at: [13, 5], dir: [1, 0] });\n});\n// Experimental (issue #17): fewer overlaps of the lines of a network. Each end\n// of a link may leave its source or enter its target at another angle (the\n// per-link turns of glyph.js). This tries turns for one end at a time and\n// keeps the one that makes the drawing cleaner, a few passes over every end\n// (coordinate descent). Only the turned link changes, so only its pairs with\n// the other links are measured again.\n//\n// Editor scoring includes painted shafts, markers, fills and requested space\n// between them, including near referenced middles. The original centerline\n// scoring remains available for legacy shapes whose clearance is null.\n// A small turn penalty discourages changing angles without a reason.\nimport { bezier, curveTransform, layout, layoutCurves, linkCurve, shapeOf, paintedCurve, curveMarkers } from './glyph';\nimport { trimCurve } from './curve-tools';\nimport { paintedPairCost, selfCost } from './painted-collisions';\nimport { adjustCollisionGaps } from './collision-gaps';\nimport { symmetricReferences } from './collision-symmetry';\n\nconst SAMPLES = 16; // points per Bézier segment\nconst NEAR = 0.09; // lines closer than this overlap (a stroke is about 0.04)\nconst MIDDLE = 0.14; // touching around a middle is the drawing, not an overlap\nconst CROSSING = 1;\nconst CLOSE = 0.25;\nconst TURNING = 0.000001; // per degree\n\nexport const polyline = (curve) =>\n  curve.segments.flatMap((seg, k) =>\n    Array.from({ length: SAMPLES + (k ? 0 : 1) }, (_, j) => bezier(seg, (j + (k ? 1 : 0)) / SAMPLES)),\n  );\n\nconst distance = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);\n\nfunction crossing(p1, p2, q1, q2) {\n  const d = (a, b, c) => (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);\n  const [d1, d2, d3, d4] = [d(q1, q2, p1), d(q1, q2, p2), d(p1, p2, q1), d(p1, p2, q2)];\n  if (!(d1 * d2 < 0 && d3 * d4 < 0)) return null;\n  const t = d1 / (d1 - d2);\n  return [p1[0] + t * (p2[0] - p1[0]), p1[1] + t * (p2[1] - p1[1])];\n}\n\n/** How much the lines of two links (polylines) overlap and cross; `middles` are exempt. */\nexport function pairCost(a, b, middles) {\n  if (a.width !== undefined || b.width !== undefined) return paintedPairCost(a, b);\n  const free = (p) => p && middles.every((m) => distance(p, m) > MIDDLE);\n  let cost = 0;\n  for (let i = 0; i < a.length - 1; i++) {\n    for (let j = 0; j < b.length - 1; j++) {\n      if (!a[i] || !a[i + 1] || !b[j] || !b[j + 1]) continue;\n      const point = crossing(a[i], a[i + 1], b[j], b[j + 1]);\n      if (point && free(point)) cost += CROSSING;\n    }\n  }\n  for (const p of a) {\n    if (!free(p)) continue;\n    if (b.some((q) => q && distance(p, q) < NEAR)) cost += CLOSE;\n  }\n  for (const q of b) {\n    if (!free(q)) continue;\n    if (a.some((p) => p && distance(p, q) < NEAR)) cost += CLOSE;\n  }\n  return cost;\n}\n\nexport const turningCost = (turns) => turns.flat().reduce((sum, a) => sum + Math.abs(a), 0) * TURNING;\n\n/** The cost of a drawing of `links` with `shape` (lower is cleaner). */\nexport function overlapCost(links, shape = {}) {\n  const curves = layoutCurves(links, shape);\n  const o = shapeOf(shape);\n  const scale = curveTransform(curves, o).scale;\n  const lines = curves.map((curve, i) => visiblePolyline(curve, o, i, scale));\n  const middles = curves.map((c) => c.middle.at);\n  let cost = turningCost(shapeOf(shape).turns) + lines.reduce((sum, line) => sum + selfCost(line), 0);\n  for (let i = 0; i < lines.length; i++)\n    for (let j = i + 1; j < lines.length; j++) cost += pairCost(lines[i], lines[j], middles);\n  return cost;\n}\n\n/**\n * Turns of the ends of every link that make the drawing cleaner. `shape.turns`\n * are kept as the starting point; the result adds turns from −range to +range\n * degrees in steps of `step`. Returns the turns found (`delta`, to add to the\n * starting turns), the turns in total (`turns`) and the cost before and after.\n */\nexport function solveTurns(links, shape = {}, { range = 30, step = 1, passes = 3, localRange = null } = {}, origins) {\n  range = Math.min(180, Math.max(0, Number(range) || 0));\n  step = Math.max(1, Number(step) || 1);\n  passes = Math.min(10, Math.max(0, Number(passes) || 0));\n  const n = links.length;\n  const base = shapeOf(shape);\n  const initial = Array.from({ length: n }, (_, i) => base.turns[i] || [0, 0]);\n  const start = initial.map((pair, i) => origins?.[i] || pair);\n  const delta = initial.map((pair, i) => pair.map((angle, end) => angle - start[i][end]));\n  const total = () => start.map((pair, i) => [pair[0] + delta[i][0], pair[1] + delta[i][1]]);\n  const places = layout(n, base, links);\n  const curveOf = (i) => linkCurve(links, i, places, { ...base, turns: total() });\n  const middles = layoutCurves(links, base).map((c) => c.middle.at);\n  const scale = curveTransform(layoutCurves(links, base), base).scale;\n  const lines = links.map((_, i) => visiblePolyline(curveOf(i), base, i, scale));\n  const costOf = (i, line) => {\n    let cost = selfCost(line);\n    for (let j = 0; j < n; j++) if (j !== i) cost += pairCost(line, lines[j], middles);\n    return cost + turningCost([total()[i]]);\n  };\n  const before = overlapCost(links, base);\n  const candidates = [0];\n  for (let a = step; a <= range; a += step) candidates.push(a, -a);\n\n  for (let pass = 0; pass < passes; pass++) {\n    let improved = false;\n    for (let i = 0; i < n; i++) {\n      for (let end = 0; end < 2; end++) {\n        // A self-closed half is already positioned; move the open references.\n        if (links[i][end] === i + 1) continue;\n        const kept = delta[i][end];\n        let best = { angle: kept, cost: costOf(i, lines[i]), line: lines[i] };\n        for (const angle of candidates) {\n          if (angle === kept || (localRange !== null && Math.abs(angle - kept) > localRange)) continue;\n          // Applied turns go back through the editable table's −180…180° range.\n          if (Math.abs(start[i][end] + angle) > 180) continue;\n          delta[i][end] = angle;\n          const line = visiblePolyline(curveOf(i), base, i, scale);\n          const cost = costOf(i, line);\n          if (cost < best.cost - 1e-9) best = { angle, cost, line };\n        }\n        delta[i][end] = best.angle;\n        lines[i] = best.line;\n        if (best.angle !== kept) improved = true;\n      }\n    }\n    if (!improved) break;\n  }\n  let result = {\n    delta,\n    turns: total(),\n    linkGaps: base.linkGaps,\n    before,\n    after: overlapCost(links, { ...base, turns: total() }),\n  };\n  // Middle cuts use image units: a turn can change fitting scale. Reject a\n  // cached candidate if the exact complete drawing would become worse.\n#!/usr/bin/env bash\n# Keep the 1500-line source limit aligned with ESLint; warn above 1350.\n# Historical docs/case-studies and dev/log evidence retain original formatting.\nset -euo pipefail\n\nroot=$(git rev-parse --show-toplevel)\ncd \"$root\"\nLIMIT=1500\nWARN_THRESHOLD=1350\nCHECKED=0\nFAILED=0\nfiles=$(mktemp)\ntrap 'rm -f \"$files\"' EXIT\n# Materialize the list: process-substitution failures must not become a green walk.\ngit ls-files -z > \"$files\"\nwhile IFS= read -r -d '' file; do\n  case \"$file\" in docs/case-studies/*|dev/log/*) continue ;; esac\n  case \"$file\" in *.js|*.jsx|*.cjs|*.mjs|*.css|*.md|*.yml|*.yaml|*.sh|*.py|*.html|*.toml) ;; *) continue ;; esac\n  [ -f \"$file\" ] || continue\n  # awk counts a final unterminated line too, unlike wc -l.\n  lines=$(awk 'END { print NR }' \"$file\")\n  CHECKED=$((CHECKED + 1))\n  if [ \"$lines\" -gt \"$LIMIT\" ]; then\n    echo \"::error file=$file::$file has $lines lines (limit $LIMIT)\"\n    FAILED=1\n  elif [ \"$lines\" -gt \"$WARN_THRESHOLD\" ]; then\n    echo \"::warning file=$file::$file has $lines lines (warning threshold $WARN_THRESHOLD, limit $LIMIT); extract a module.\"\n  fi\ndone < \"$files\"\nif [ \"$CHECKED\" -eq 0 ]; then\n  echo '::error::No files were checked; the file size gate is broken.'\n  exit 2\nfi\necho \"Checked $CHECKED files against the $LIMIT-line limit.\"\nexit \"$FAILED\"\n/home/box/.nvm/versions/node/v26.12.1/bin/node\n/home/box/.nvm/versions/node/v26.12.1/bin/npm\nv26.12.1\n/home/box/.cache/ms-playwright:\nchromium-1248\nchromium_headless_shell-1248\nffmpeg-1013\nfirefox-1555\nwebkit-2370\n\n/home/box/.local/share:\nclaude\nopencode\n\n/opt:\ncontainerd\ngoogle\nmicrosoft\n\n/tmp:\nbox-dind-ready\ncc-socks\ncodex_prompt_1793367590513_1.txt\ngh-issue-solver-1793367536891\nhive-mind-use-m-locks\nissue41-files.txt\nnode-compile-cache\nopencode\n","exit_code":0,"status":"completed"}}
