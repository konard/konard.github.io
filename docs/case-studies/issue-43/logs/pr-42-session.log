etwork:issue37 # own-shaft crossings, 20 seeded networks, pointer focus and worker responsiveness\n+npm run test:network:issue41 # simple default turns, 20 seeded networks, Apply/share and SVG downloads\n npm run build:cv   # prints every CV of build/ to build/cv/pdf/ (needs `npx playwright install chromium`)\n ```\n \n@@ -131,3 +134,4 @@ The generated site is never committed to `docs/`; that directory holds the case\n - [`issue-33`](docs/case-studies/issue-33/README.md): dated public indicators, repository and personal source lines, the exact GitHub calendar, social embeds and a complete associative ecosystem audit.\n - [`issue-35`](docs/case-studies/issue-35/README.md): continuous link middles during automatic spacing, explicit cut preservation and native browser regressions.\n - [`issue-37`](docs/case-studies/issue-37/README.md): self-crossing detection, local spacing with fixed link positions, 20 seeded networks, pointer focus and cancellable background spacing.\n+- [`issue-41`](docs/case-studies/issue-41/README.md): straight default references, preserved manual turns and reciprocal routes, exhaustive small-network checks and before/after screenshots.\ndiff --git a/experiments/issue-41-browser.mjs b/experiments/issue-41-browser.mjs\nnew file mode 100644\nindex 0000000..595b5a9\n--- /dev/null\n+++ b/experiments/issue-41-browser.mjs\n@@ -0,0 +1,105 @@\n+/* global document, window */\n+import assert from 'node:assert/strict';\n+import { mkdir, readFile, writeFile } from 'node:fs/promises';\n+import { join } from 'node:path';\n+import { chromium, firefox, webkit } from 'playwright';\n+import { preview } from 'vite';\n+import { reported, randomNetworks } from './issue-41-cases.mjs';\n+import { waitForNetwork } from './wait-for-network.mjs';\n+\n+const engine = process.env.ENGINE || 'chromium';\n+const phase = process.env.PHASE || 'after';\n+const output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-41/screenshots';\n+const data = process.env.RESULT_DIR || 'docs/case-studies/issue-41/data';\n+await mkdir(output, { recursive: true });\n+await mkdir(data, { recursive: true });\n+const result = { engine, phase, date: new Date().toISOString(), networks: [], errors: [] };\n+const server = await preview({ preview: { port: 4141, strictPort: true } });\n+let browser;\n+try {\n+  browser = await { chromium, firefox, webkit }[engine].launch();\n+  result.version = browser.version();\n+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n+  page.setDefaultTimeout(15000);\n+  page.on('pageerror', (error) => result.errors.push(error.message));\n+  await page.addInitScript(() => {\n+    localStorage.setItem('lang', 'en');\n+    localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const go = async (code, options = '') => {\n+    await page.goto(`http://localhost:4141/network/?code=${code}&lang=en&${options}`);\n+    await waitForNetwork(page);\n+  };\n+  const picture = () => page.locator('.network__preview').innerHTML();\n+  const entries = [...reported, ...randomNetworks().map((code) => ({ code }))];\n+  for (const { code, turns } of entries) {\n+    await go(code);\n+    const original = await picture();\n+    const controls = await page\n+      .locator('.link-cards input[type=range]')\n+      .evaluateAll((inputs) => inputs.map(({ id, value }) => ({ id, value })));\n+    await page.locator('.network__preview').screenshot({ path: join(output, `${engine}-${phase}-${code}.png`) });\n+    const paths = await page\n+      .locator('.network__preview g[stroke] > path:first-child')\n+      .evaluateAll((lines) => lines.map((line) => line.getAttribute('d')));\n+    const sample = { code, controls, paths, svg: original };\n+    result.networks.push(sample);\n+    const shared = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n+    await page.goto(shared);\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), original, `${code}: default share changed the picture`);\n+    if (turns) {\n+      await go(code, `turns=${encodeURIComponent(turns)}`);\n+      const manual = await picture();\n+      sample.manual = manual;\n+      if (phase !== 'before') assert.equal(original, manual, `${code}: default differs from supplied arrangement`);\n+    }\n+    console.log(`${engine} ${phase}: ${code} default/share${turns ? '/supplied turns' : ''}`);\n+  }\n+  if (phase !== 'before') {\n+    // Native keyboard editing starts from the resolved default and survives sharing.\n+    await go('0222');\n+    assert.equal(await page.locator('#link-1-turn-1').inputValue(), '-30');\n+    const numeric = page.locator('#link-1-turn-1-value');\n+    await numeric.fill('-29');\n+    await numeric.press('Tab');\n+    assert.equal(await page.locator('#link-1-turn-1').inputValue(), '-29');\n+    const edited = await picture();\n+    await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), edited);\n+    await go('0222', 'solve=true');\n+    const solved = await picture();\n+    await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), solved, 'Apply changed the drawing');\n+    await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), solved, 'applied share changed the drawing');\n+    const pending = page.waitForEvent('download');\n+    await page.getByRole('button', { name: '⤓ SVG', exact: true }).click();\n+    const exported = await readFile(await (await pending).path(), 'utf8');\n+    assert.equal(\n+      await page.evaluate((svg) => {\n+        const wrapper = document.createElement('div');\n+        wrapper.innerHTML = svg;\n+        return wrapper.innerHTML;\n+      }, exported),\n+      solved,\n+    );\n+    await page.setViewportSize({ width: 390, height: 844 });\n+    await go('0112');\n+    assert(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1));\n+    await page.screenshot({ path: join(output, `${engine}-${phase}-mobile.png`), fullPage: true });\n+    result.interactions = 'native turn edit, default/manual share, worker, Apply, SVG download, mobile';\n+  }\n+  assert.deepEqual(result.errors, []);\n+} catch (error) {\n+  result.failure = error.stack;\n+  throw error;\n+} finally {\n+  await browser?.close();\n+  await server.close();\n+  await writeFile(join(data, `${engine}-${phase}.json`), JSON.stringify(result, null, 2) + '\\n');\n+}\ndiff --git a/experiments/issue-41-cases.mjs b/experiments/issue-41-cases.mjs\nnew file mode 100644\nindex 0000000..489c1c8\n--- /dev/null\n+++ b/experiments/issue-41-cases.mjs\n@@ -0,0 +1,30 @@\n+export const reported = [\n+  { code: '0222', turns: '0 -30' },\n+  { code: '0112', turns: '0 0,-30 0' },\n+  { code: '0001', turns: '0 0,0 -30' },\n+  { code: '2002', turns: '-30 0' },\n+];\n+\n+// Twenty distinct cases: all four one-link networks, eight each for 2/3 links.\n+// A fixed seed and finite sampling budget keep the original sample reproducible.\n+export function randomNetworks() {\n+  let seed = 0x41c0de;\n+  const codes = [];\n+  for (const [n, count] of [\n+    [1, 4],\n+    [2, 8],\n+    [3, 8],\n+  ]) {\n+    const selected = new Set();\n+    for (let attempt = 0; selected.size < count && attempt < 1000; attempt++) {\n+      const code = Array.from({ length: n * 2 }, () => {\n+        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;\n+        return Math.floor((seed / 2 ** 32) * (n + 1));\n+      }).join('');\n+      selected.add(code);\n+    }\n+    if (selected.size !== count) throw new Error('Sampling budget exceeded');\n+    codes.push(...selected);\n+  }\n+  return codes;\n+}\ndiff --git a/experiments/issue-41-mcp-review.mjs b/experiments/issue-41-mcp-review.mjs\nnew file mode 100644\nindex 0000000..bb558ba\n--- /dev/null\n+++ b/experiments/issue-41-mcp-review.mjs\n@@ -0,0 +1,55 @@\n+/* global document, window */\n+\n+// Pass this function's source to Playwright MCP's run-code tool with its page.\n+export default async function review(page) {\n+  const root = 'docs/case-studies/issue-41';\n+  const equal = (a, b) => {\n+    if (a !== b) throw new Error(`Expected ${b}; got ${a}`);\n+  };\n+  const reported = [\n+    { code: '0222', turns: '0 -30' },\n+    { code: '0112', turns: '0 0,-30 0' },\n+    { code: '0001', turns: '0 0,0 -30' },\n+    { code: '2002', turns: '-30 0' },\n+  ];\n+  const result = { date: new Date().toISOString(), engine: 'Playwright MCP Chromium', examples: [], errors: [] };\n+  page.on('pageerror', (error) => result.errors.push(error.message));\n+  page.setDefaultTimeout(15000);\n+  await page.addInitScript(() => {\n+    localStorage.setItem('lang', 'en');\n+    localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const go = async (query) => {\n+    await page.goto(`http://127.0.0.1:4155/network/?lang=en&${query}`);\n+    await page.locator('.network__preview svg').waitFor();\n+  };\n+  const picture = () => page.locator('.network__preview').innerHTML();\n+  for (const { code, turns } of reported) {\n+    await go(`code=${code}`);\n+    const original = await picture();\n+    await go(`code=${code}&turns=${encodeURIComponent(turns)}`);\n+    equal(await picture(), original);\n+    result.examples.push({ code, manualEquality: true });\n+  }\n+  await page.setViewportSize({ width: 1440, height: 1000 });\n+  await go('code=0222&gaps=0.1+0.2+3+4');\n+  const original = await picture();\n+  const target = page.locator('#link-1-turn-1');\n+  await target.focus();\n+  await target.press('ArrowRight');\n+  equal(await target.inputValue(), '-29');\n+  await page.getByRole('button', { name: 'Back to the default: Link 1: turn of the target, °', exact: true }).click();\n+  equal(await target.inputValue(), '-30');\n+  equal(await picture(), original);\n+  const shared = new URL(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+  equal(shared.searchParams.get('gaps'), '0.1 0.2 3 4');\n+  await page.screenshot({ path: `${root}/screenshots/mcp-desktop.png` });\n+  await page.setViewportSize({ width: 390, height: 844 });\n+  await go('code=0112');\n+  equal(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1), true);\n+  await page.screenshot({ path: `${root}/screenshots/mcp-mobile.png` });\n+  equal(result.errors.length, 0);\n+  result.interactions = 'native keyboard, topology-aware reset, unchanged gaps, desktop and mobile';\n+  return result;\n+}\ndiff --git a/experiments/issue-41-measure.mjs b/experiments/issue-41-measure.mjs\nnew file mode 100644\nindex 0000000..44569ac\n--- /dev/null\n+++ b/experiments/issue-41-measure.mjs\n@@ -0,0 +1,51 @@\n+import assert from 'node:assert/strict';\n+import { writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+import { reported, randomNetworks } from './issue-41-cases.mjs';\n+\n+const server = await createServer({ server: { middlewareMode: true }, appType: 'custom' });\n+try {\n+  const { decode } = await server.ssrLoadModule('/src/links/configurations.js');\n+  const { layoutCurves, glyphCurves } = await server.ssrLoadModule('/src/links/glyph.js');\n+  const { normalizeStyle, shapeOfStyle, withSpacing } = await server.ssrLoadModule('/src/links/style.js');\n+  const { overlapCost, solveCollisions } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const results = [];\n+  for (const { code } of [...reported, ...randomNetworks().map((code) => ({ code }))]) {\n+    const links = decode(code.match(/../g).join(' '));\n+    const style = normalizeStyle();\n+    const before = shapeOfStyle(style, links.length);\n+    const after = shapeOfStyle(style, links);\n+    assert.deepEqual(after.linkGaps, before.linkGaps);\n+    const start = performance.now();\n+    const solved = solveCollisions(links, after, { adjustGaps: true });\n+    assert(solved.after <= solved.before + 1e-9);\n+    const original = glyphCurves(links, after);\n+    glyphCurves(links, shapeOfStyle(withSpacing(style, solved), links)).forEach((curve, i) =>\n+      assert.deepEqual(curve.middle.at, original[i].middle.at),\n+    );\n+    const result = {\n+      code,\n+      defaultTurns: after.turns,\n+      beforeCost: overlapCost(links, before),\n+      defaultCost: overlapCost(links, after),\n+      originalCurves: layoutCurves(links, before),\n+      defaultCurves: layoutCurves(links, after),\n+      configuredGaps: { start: style.startGap, end: style.endGap, perLink: style.gaps },\n+      solved: { turns: solved.turns, gaps: solved.linkGaps, before: solved.before, after: solved.after },\n+      milliseconds: performance.now() - start,\n+    };\n+    results.push(result);\n+    console.log(\n+      JSON.stringify({\n+        code,\n+        turns: after.turns,\n+        before: result.beforeCost,\n+        after: result.defaultCost,\n+        solved: solved.after,\n+      }),\n+    );\n+  }\n+  await writeFile('docs/case-studies/issue-41/data/measurements.json', JSON.stringify(results, null, 2) + '\\n');\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-41-perfect.mjs b/experiments/issue-41-perfect.mjs\nnew file mode 100644\nindex 0000000..70867ee\n--- /dev/null\n+++ b/experiments/issue-41-perfect.mjs\n@@ -0,0 +1,32 @@\n+import assert from 'node:assert/strict';\n+import { writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+\n+// Finite audit of every topology up to three links, using the existing scorer.\n+const server = await createServer({ server: { middlewareMode: true }, appType: 'custom' });\n+try {\n+  const { codeAt, decode } = await server.ssrLoadModule('/src/links/configurations.js');\n+  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');\n+  const { overlapCost, turningCost } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const result = { networks: 0, previouslyClear: 0, failures: [] };\n+  for (let n = 1; n <= 3; n++) {\n+    for (let index = 0; index < (n + 1) ** (2 * n); index++) {\n+      const code = codeAt(n, BigInt(index));\n+      const links = decode(code);\n+      const style = normalizeStyle();\n+      const before = shapeOfStyle(style, n);\n+      const cost = overlapCost(links, before);\n+      result.networks++;\n+      if (cost > 1e-8) continue;\n+      result.previouslyClear++;\n+      const after = shapeOfStyle(style, links);\n+      const next = overlapCost(links, after) - turningCost(after.turns);\n+      if (next > 1e-8) result.failures.push({ code, before: cost, after: next, turns: after.turns });\n+    }\n+  }\n+  await writeFile('docs/case-studies/issue-41/data/perfect-audit.json', JSON.stringify(result, null, 2) + '\\n');\n+  console.log(JSON.stringify(result));\n+  assert.deepEqual(result.failures, []);\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-41-reciprocal.mjs b/experiments/issue-41-reciprocal.mjs\nnew file mode 100644\nindex 0000000..31b1588\n","exit_code":0,"status":"completed"}}
