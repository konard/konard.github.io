from the defaults in the query string, so a shared link\n// opens exactly the picture that was shared.\nimport { color, option, range, select, toggle } from '../settings/fields';\nimport { COLORS, SHAPE, normalizeFrame } from './glyph';\nimport { GEOMETRY_SECTIONS } from './style-geometry';\nimport { linkGaps, normalizeGaps, withGaps } from './gaps';\n\n/** Link colours: the site's, and a few more sets of nine. */\nexport const PALETTES = {\n  site: COLORS,\n  neon: ['#00f0ff', '#ff00e6', '#faff00', '#00ff85', '#ff6b00', '#8a5cff', '#ff2d55', '#00b3ff', '#c6ff00'],\n  pastel: ['#93c5fd', '#c4b5fd', '#f9a8d4', '#fde68a', '#a7f3d0', '#fed7aa', '#bae6fd', '#fecaca', '#d9f99d'],\n  warm: ['#f97316', '#ef4444', '#eab308', '#f43f5e', '#fb923c', '#facc15', '#dc2626', '#fbbf24', '#e11d48'],\n  cold: ['#06b6d4', '#3b82f6', '#8b5cf6', '#14b8a6', '#0ea5e9', '#6366f1', '#22d3ee', '#a78bfa', '#2dd4bf'],\n  // The light-theme link colours of src/index.css, for light backgrounds.\n  print: ['#0e7490', '#9333ea', '#db2777', '#b45309', '#047857', '#c2410c', '#1d4ed8', '#b91c1c', '#4d7c0f'],\n};\n\n/** Sections of the editor; each field is one option of the style. */\nexport const STYLE_SECTIONS = [\n  ...GEOMETRY_SECTIONS,\n  {\n    id: 'lines',\n    title: { en: 'Lines and colours', ru: 'Линии и цвета' },\n    fields: [\n      range('strokeWidth', 1.3, 0.5, 10, 0.1, { en: 'Line width', ru: 'Толщина линий' }),\n      select(\n        'dash',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('dashdot', 'Dash and dot', 'Штрих-пунктир'),\n          option('long', 'Long dashes', 'Длинные штрихи'),\n        ],\n        { en: 'Line style', ru: 'Стиль линий' },\n      ),\n      select(\n        'linecap',\n        'round',\n        [\n          option('round', 'Round', 'Круглые'),\n          option('butt', 'Flat', 'Плоские'),\n          option('square', 'Square', 'Квадратные'),\n        ],\n        { en: 'Line ends', ru: 'Концы линий' },\n      ),\n      select(\n        'linejoin',\n        'miter',\n        [\n          option('round', 'Round', 'Скруглённые'),\n          option('miter', 'Sharp', 'Острые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n        ],\n        { en: 'Corners', ru: 'Углы' },\n      ),\n      range('opacity', 1, 0.1, 1, 0.05, { en: 'Opacity', ru: 'Непрозрачность' }, { unit: '%' }),\n      range('glow', 0, 0, 12, 0.5, { en: 'Glow', ru: 'Свечение' }),\n      select(\n        'palette',\n        'site',\n        [\n          option('site', 'Site', 'Как на сайте'),\n          option('neon', 'Neon', 'Неон'),\n          option('pastel', 'Pastel', 'Пастель'),\n          option('warm', 'Warm', 'Тёплые'),\n          option('cold', 'Cold', 'Холодные'),\n          option('print', 'For light backgrounds', 'Для светлого фона'),\n          option('mono', 'One colour', 'Один цвет'),\n          option('custom', 'Own colour of each link', 'Свой цвет каждой связи'),\n        ],\n        { en: 'Colours of the links', ru: 'Цвета связей' },\n      ),\n      color(\n        'monoColor',\n        '#e6edf7',\n        { en: 'Colour of the links', ru: 'Цвет связей' },\n        {\n          when: (s) => s.palette === 'mono',\n        },\n      ),\n    ],\n  },\n  {\n    id: 'background',\n    title: { en: 'Background and card', ru: 'Фон и карточка' },\n    fields: [\n      select(\n        'background',\n        'solid',\n        [\n          option('transparent', 'Transparent', 'Прозрачный'),\n          option('solid', 'One colour', 'Один цвет'),\n          option('linear', 'Linear gradient', 'Линейный градиент'),\nimport { option, range, select, toggle } from '../settings/fields';\nimport { MARKERS, SHAPE } from './glyph';\n\nconst names = {\n  bar: ['Bar', 'Черта'],\n  arrow: ['Arrow', 'Стрелка'],\n  triangle: ['Triangle', 'Треугольник'],\n  tail: ['Tail (reversed arrow)', 'Хвост (обратная стрелка)'],\n  dot: ['Dot', 'Точка'],\n  circle: ['Ring', 'Кольцо'],\n  square: ['Square', 'Квадрат'],\n  diamond: ['Diamond', 'Ромб'],\n  none: ['None', 'Нет'],\n};\nexport const EDITOR_SHAPE = {\n  ...SHAPE,\n  bendMode: 'curve',\n  arrowJoin: 'miter',\n  balanceArrows: true,\n  clearance: 1,\n  angles: 'fixed',\n  sourceAngle: 30,\n  targetAngle: 30,\n  tension: 0.4,\n  bulge: 0,\n  loopBend: 0,\n  startGap: 0.08,\n  endGap: 0.08,\n  startSize: 2.5,\n  startAngle: 70,\n  startOffset: 2.5,\n  endSize: 3.5,\n  endAngle: 45,\n  middle: 'dot',\n  middleSize: 2,\n  placement: 'auto',\n};\nconst field = (key, min, max, step, en, ru, extra = {}) =>\n  range(key, EDITOR_SHAPE[key], min, max, step, { en, ru }, extra);\nconst degrees = { unit: '°' };\n\nexport const GEOMETRY_SECTIONS = [\n  {\n    id: 'placement',\n    title: { en: 'Placement in space', ru: 'Размещение в пространстве' },\n    fields: [\n      select(\n        'placement',\n        'auto',\n        [\n          option('auto', 'Automatic (circle for 1–4, hexagonal after)', 'Авто (круг для 1–4, далее шестиугольники)'),\n          option('circle', 'Circle', 'Круг'),\n          option('square', 'Square grid', 'Квадратная сетка'),\n          option('hex', 'Hexagonal grid', 'Шестиугольная сетка'),\n          option('dice', 'Dice', 'Игральные кости'),\n          option('cards', 'Playing cards', 'Игральные карты'),\n          option('spiral', 'Sunflower spiral', 'Спираль подсолнуха'),\n          option('force', 'Physical forces', 'Физические силы'),\n        ],\n        { en: 'Placement', ru: 'Размещение' },\n      ),\n      {\n        key: 'order',\n        type: 'text',\n        d: '',\n        max: 2000,\n        label: { en: 'Circular order of links', ru: 'Порядок связей по кругу' },\n        when: (s) => ['auto', 'circle'].includes(s.placement),\n        hint: {\n          en: 'Empty uses link order. Enter all link IDs to choose another order (for example, 1 3 2 4). Automatic spacing always preserves this placement.',\n          ru: 'Пустое поле сохраняет порядок связей. Для другого порядка укажите все номера (например, 1 3 2 4). Автозазоры всегда сохраняют размещение.',\n        },\n      },\n      field('layoutAspect', 0.3, 3, 0.05, 'Horizontal layout scale', 'Масштаб размещения по горизонтали'),\n      field('columns', 0, 30, 1, 'Grid columns (0 = automatic)', 'Столбцы сетки (0 = авто)', {\n        when: (s) => s.placement === 'square',\n      }),\n      ...[\n        ['forceDistance', 'Spring length', 'Длина пружины'],\n        ['forceCharge', 'Repulsion', 'Отталкивание'],\n        ['forceCollision', 'Space for links and loops', 'Пространство связей и петель'],\n      ].map(([key, en, ru]) =>\n        range(key, SHAPE[key], 0.2, 3, 0.05, { en, ru }, { when: (s) => s.placement === 'force' }),\n      ),\n    ],\n  },\n  {\n    id: 'shape',\n    title: { en: 'Shape of the links', ru: 'Форма связей' },\n    fields: [\n      select(\n        'bendMode',\n        EDITOR_SHAPE.bendMode,\n        [\n          option('curve', 'Bend the curve', 'Изгибать кривую'),\n          option('rotate', 'Legacy tangent rotation', 'Прежний поворот касательной'),\n        ],\n        { en: 'Bend behavior', ru: 'Поведение изгиба' },\n      ),\n      select(\n        'angles',\n        EDITOR_SHAPE.angles,\n        [\n          option('mirror', 'Mirror the middle (as in the gallery)', 'Отражение середины (как в галерее)'),\n          option('fixed', 'Fixed angles', 'Заданные углы'),\n        ],\n        { en: 'Angles of the ends', ru: 'Углы концов' },\n      ),\n      field('sourceAngle', -180, 180, 1, 'Leaving angle', 'Угол выхода', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      field('targetAngle', -180, 180, 1, 'Entering angle', 'Угол входа', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      toggle('lens', SHAPE.lens, {\n        en: 'Two references to one link make a lens',\n        ru: 'Две ссылки на одну связь образуют линзу',\n      }),\n      field('tension', 0, 2, 0.01, 'Curvature', 'Изгиб', { unit: '%' }),\n      field('bulge', -180, 180, 1, 'Bend', 'Изгиб кривой', {\n        ...degrees,\n        hint: {\n          en: 'Curve mode bends free ends and widens self loops with fixed endpoints. Use Rotation to turn the whole network.',\n          ru: 'Режим кривой изгибает свободные концы и расширяет собственные петли с неподвижными концами. Для поворота всей сети используйте «Поворот».',\n        },\n      }),\n      field('loopBend', -180, 180, 1, 'Loop bend', 'Изгиб петли', {\n        ...degrees,\n        hint: {\n          en: 'Widens or narrows self-reference loops independently of straight free ends. Zero keeps balanced loops.',\n          ru: 'Расширяет или сужает собственные петли независимо от прямых свободных концов. Ноль сохраняет сбалансированные петли.',\n        },\n        when: (s) => s.bendMode === 'curve',\n      }),\n      field('startGap', 0, 1, 0.01, 'Gap at the source reference', 'Зазор у начальной ссылки'),\n      field('endGap', 0, 1, 0.01, 'Gap at the target reference', 'Зазор у конечной ссылки'),\n      field('free', 0.05, 5, 0.05, 'Length of a free end', 'Длина свободного конца', { unit: '×' }),\n      field('loop', 0.05, 5, 0.05, 'Size of a loop', 'Размер петли', { unit: '×' }),\n      field('spread', 0.1, 5, 0.05, 'Distance between links', 'Расстояние между связями', { unit: '×' }),\n      field('rotation', -180, 359, 1, 'Rotation', 'Поворот', degrees),\n      field('padding', 0, 40, 1, 'Margin', 'Поля', { unit: '%' }),\n    ],\n  },\n  {\n    id: 'ends',\n    title: { en: 'Start, end and middle', ru: 'Начало, конец и середина' },\n    fields: [\n      select(\n        'arrowJoin',\n        'miter',\n        [\n          option('miter', 'Sharp', 'Острые'),\n          option('round', 'Rounded', 'Скруглённые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n          option('inherit', 'Follow line corners', 'Как углы линий'),\n        ],\n        { en: 'Arrow corners', ru: 'Углы стрелок' },\n      ),\n      toggle(\n        'balanceArrows',\n        true,\n        { en: 'Balance sharp arrow lengths', ru: 'Выравнивать длину острых стрелок' },\n        {\n          hint: {\n            en: 'Shortens the line by the painted tip extension. Switch off for legacy lengths. Explicit marker offsets and rotations remain intentional.',\n            ru: 'Укорачивает линию на выступ острия. Выключите для прежней длины. Явные сдвиги и повороты маркеров сохраняются.',\n          },\n        },\n      ),\n      ...['start', 'end', 'middle'].flatMap((key, i) => {\n        const en = ['start', 'end', 'middle'][i];\n        const ru = ['начала', 'конца', 'середины'][i];\n        const shown = (s) => s[key] !== 'none';\n        return [\n          select(\n            key,\n            EDITOR_SHAPE[key],\n            MARKERS.map((m) => option(m, ...names[m])),\n            {\n              en: `${['Start', 'End', 'Middle'][i]} of a link`,\n              ru: ['Начало связи', 'Конец связи', 'Середина связи'][i],\n            },\n          ),\n          field(`${key}Size`, 0.5, 15, 0.1, `Size of the ${en}`, `Размер ${ru}`, { when: shown }),\n          field(`${key}Angle`, 5, 85, 1, `Angle of the ${en}`, `Угол ${ru}`, {\n            ...degrees,\n            when: (s) => ['arrow', 'triangle', 'tail'].includes(s[key]),\n          }),\n          field(`${key}Offset`, -20, 20, 0.1, `Offset of the ${en}`, `Сдвиг ${ru}`, {\n            when: shown,\n            hint: {\n              en: 'Distance along the curve; the marker follows its tangent. Positive moves an endpoint marker inward. Beyond an end, the tangent extends the path. Units: 1/100 of the symbol.',\n              ru: 'Расстояние вдоль кривой; маркер следует её касательной. Положительное значение смещает концевой маркер внутрь. За концом путь продолжается по касательной. Единица — 1/100 символа.',\n            },\n          }),\n          field(`${key}Across`, -20, 20, 0.1, `Sideways offset of the ${en}`, `Поперечный сдвиг ${ru}`, {\n            when: shown,\n          }),\n          field(`${key}Rotation`, -180, 180, 1, `Rotation of the ${en}`, `Поворот ${ru}`, {\n            ...degrees,\n            when: (s) => !['none', 'circle', 'dot'].includes(s[key]),\n          }),\n        ];\n      }),\n      field('middleGapStart', 0, 30, 0.1, 'Cut before the middle', 'Разрыв перед серединой', {\n        hint: {\n          en: 'Optional: for a ring, try half its size on each side. Zero keeps the line continuous.',\n          ru: 'Необязательно: для кольца попробуйте половину его размера с каждой стороны. Ноль оставляет линию непрерывной.',\n        },\n      }),\n      field('middleGapEnd', 0, 30, 0.1, 'Cut after the middle', 'Разрыв после середины'),\n    ],\n  },\n];\n\n/** Whether a geometry option can affect this network. Field-specific style conditions are separate. */\nexport function geometryAvailable(key, style, links) {\n  if (!links) return true;\n  const other = (ref, i) => ref !== 0 && ref !== i + 1;\n  const any = (predicate) => links.some(predicate);\n  switch (key) {\n    case 'angles':\n    case 'tension':\n      return any(([s, t]) => s || t);\n    case 'sourceAngle':\n    case 'startGap':\n      return any(([s]) => s !== 0);\n    case 'targetAngle':\n    case 'endGap':\n      return any(([, t]) => t !== 0);\n    case 'lens':\n      return style.angles === 'mirror' && any(([s, t], i) => s === t && other(s, i));\n    case 'bendMode':\n    case 'bulge':\n      return any(([s, t], i) => !(other(s, i) && other(t, i)));\n    case 'free':\n      return any(([s, t]) => s === 0 || t === 0);\n    case 'loop':\n    case 'loopBend':\n      return any(([s, t], i) => s === i + 1 || t === i + 1);\n    case 'forceDistance':\n      return any(([s, t], i) => other(s, i) || other(t, i));\n    case 'spread':\n    case 'placement':\n    case 'layoutAspect':\n    case 'columns':\n    case 'forceCharge':\n    case 'forceCollision':\n      return links.length > 1;\n    default:\n      return true;\n  }\n}\n/** The initial editable drawing remains visible during the worker search. */\nexport const waitForNetwork = async (page) => {\n  await page.locator('.network__preview[aria-busy=\"false\"] svg').waitFor();\n  const error = page.locator('.network__view [role=\"alert\"]');\n  if (await error.count()) throw new Error(await error.textContent());\n};\n// Regression of the exact reported URL and the native SVG/raster drawing.\n/* global document, Image */\nimport { waitForNetwork } from './wait-for-network.mjs';\nimport assert from 'node:assert/strict';\nimport { mkdir, readFile, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\n\nconst engine = process.env.ENGINE || 'chromium';\nconst output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-35/screenshots';\nconst data = process.env.RESULT_DIR || 'docs/case-studies/issue-35/data';\nconst label = process.env.CAPTURE_LABEL || 'after';\nawait mkdir(output, { recursive: true });\nawait mkdir(data, { recursive: true });\nconst server = await preview({ preview: { port: 4195, strictPort: true } });\nconst result = { engine, date: new Date().toISOString(), checks: [], errors: [] };\nlet browser;\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  result.version = browser.version();\n  const page = await browser.newPage({ viewport: { width: 1440, height: 1100 }, reducedMotion: 'reduce' });\n  page.setDefaultTimeout(15000);\n  page.on('pageerror', (error) => result.errors.push(error.message));\n  await page.addInitScript(() => {\n    localStorage.setItem('lang', 'en');\n    localStorage.setItem('theme', 'dark');\n    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n  });\n  const go = async (extra = '') => {\n    await page.goto(`http://localhost:4195/network/?code=003002&solve=true&lang=en&${extra}`);\n    await waitForNetwork(page);\n  };\n  const picture = async () => {\n    await waitForNetwork(page);\n    return page.locator('.network__preview').innerHTML();\n  };\n  const moveCounts = () =>\n    page\n      .locator('.network__preview g[stroke] > path:first-child')\n      .evaluateAll((lines) => lines.map((line) => (line.getAttribute('d').match(/M/g) || []).length));\n  const shot = (name) =>\n    page.locator('.network__preview').screenshot({ path: join(output, `${engine}-${label}-${name}.png`) });\n  await go();\n  await shot('reported');\n  result.moves = await moveCounts();\n  assert.deepEqual(result.moves, [1, 1, 1], 'zero-cut links must have one continuous SVG subpath');\n  for (const name of ['Cut before the middle', 'Cut after the middle', 'Largest middle cut change'])\n    assert.equal(await page.getByRole('slider', { name, exact: true }).inputValue(), '0');\n\n  // Sample native raster paint along the incoming purple half near its middle.\n  // Check the exported SVG too: its coordinates and path come from the preview.\n  result.raster = await page.locator('.network__preview svg').evaluate(async (svg) => {\n    const line = svg.querySelectorAll('g[stroke] > path:first-child')[1];\n    const first = document.createElementNS('http://www.w3.org/2000/svg', 'path');\n    first.setAttribute('d', line.getAttribute('d').split('C').slice(0, 2).join('C'));\n    const joinLength = first.getTotalLength();\n    const canvas = document.createElement('canvas');\n    canvas.width = canvas.height = 1000;\n    const context = canvas.getContext('2d');\n    const image = new Image();\n    image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg.outerHTML)}`;\n    await image.decode();\n    context.drawImage(image, 0, 0, 1000, 1000);\n    // Read the exported drawing transform without CSS viewport scaling.\n    // Root getCTM() includes that scaling differently across browser engines.\n    const drawing = line.parentElement.parentElement.cloneNode(false);\n    const matrix = drawing.transform.baseVal.consolidate().matrix;\n    const samples = Array.from({ length: 12 }, (_, i) => {\n      const point = first.getPointAtLength(joinLength - (i + 1) * 0.5).matrixTransform(matrix);\n      const x = Math.round((point.x / svg.viewBox.baseVal.width) * 1000);\n      const y = Math.round((point.y / svg.viewBox.baseVal.height) * 1000);\n      return { x, y, pixel: [...context.getImageData(x, y, 1, 1).data] };\n    });\n    return { joinLength, matrix: [matrix.a, matrix.b, matrix.c, matrix.d, matrix.e, matrix.f], samples };\n  });\n  result.raster.samples.forEach(({ x, y, pixel: [r, g, b, a] }) => {\n    assert(x >= 0 && x < 1000 && y >= 0 && y < 1000, 'raster sample must be inside the exported image');\n    assert(r > 100 && b > 150 && b > g && a > 240);\n  });\n  result.checks.push('reported URL: all three lines continuous, zero cut settings, purple shaft painted to its middle');\n\n  const solved = await picture();\n  await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n  assert.equal(await picture(), solved);\n#!/bin/sh\nset -eu\nnpx lint-staged --config package.json\nnpm run check:file-size\nnpm run check:secrets\npython scripts/check-python.py\nruff check .\nruff format --check .\ngit ls-files -z '*.sh' '.husky/*' ':(exclude)dev/log/**' ':(exclude)docs/**' | xargs -0 shellcheck\nimport { execFileSync } from 'node:child_process';\nimport { resolve } from 'node:path';\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nimport { applySettings, normalize } from './src/settings/apply.js';\nimport { CSS_RULES } from './src/settings/schema.js';\nimport { inlineJSON } from './scripts/inline-json.mjs';\n\n// Every page is its own HTML entry (a real URL on GitHub Pages, no client-side\n// routing). The home page must stay `index` so build/index.html keeps its name.\nconst PAGES = ['repositories', 'experience', 'research', 'associative', 'art', 'blog', 'cv', 'settings'