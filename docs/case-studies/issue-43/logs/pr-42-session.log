procal routes, exhaustive small-network checks and before/after screenshots.\ndiff --git a/experiments/issue-41-browser.mjs b/experiments/issue-41-browser.mjs\nnew file mode 100644\nindex 0000000..595b5a9\n--- /dev/null\n+++ b/experiments/issue-41-browser.mjs\n@@ -0,0 +1,105 @@\n+/* global document, window */\n+import assert from 'node:assert/strict';\n+import { mkdir, readFile, writeFile } from 'node:fs/promises';\n+import { join } from 'node:path';\n+import { chromium, firefox, webkit } from 'playwright';\n+import { preview } from 'vite';\n+import { reported, randomNetworks } from './issue-41-cases.mjs';\n+import { waitForNetwork } from './wait-for-network.mjs';\n+\n+const engine = process.env.ENGINE || 'chromium';\n+const phase = process.env.PHASE || 'after';\n+const output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-41/screenshots';\n+const data = process.env.RESULT_DIR || 'docs/case-studies/issue-41/data';\n+await mkdir(output, { recursive: true });\n+await mkdir(data, { recursive: true });\n+const result = { engine, phase, date: new Date().toISOString(), networks: [], errors: [] };\n+const server = await preview({ preview: { port: 4141, strictPort: true } });\n+let browser;\n+try {\n+  browser = await { chromium, firefox, webkit }[engine].launch();\n+  result.version = browser.version();\n+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n+  page.setDefaultTimeout(15000);\n+  page.on('pageerror', (error) => result.errors.push(error.message));\n+  await page.addInitScript(() => {\n+    localStorage.setItem('lang', 'en');\n+    localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const go = async (code, options = '') => {\n+    await page.goto(`http://localhost:4141/network/?code=${code}&lang=en&${options}`);\n+    await waitForNetwork(page);\n+  };\n+  const picture = () => page.locator('.network__preview').innerHTML();\n+  const entries = [...reported, ...randomNetworks().map((code) => ({ code }))];\n+  for (const { code, turns } of entries) {\n+    await go(code);\n+    const original = await picture();\n+    const controls = await page\n+      .locator('.link-cards input[type=range]')\n+      .evaluateAll((inputs) => inputs.map(({ id, value }) => ({ id, value })));\n+    await page.locator('.network__preview').screenshot({ path: join(output, `${engine}-${phase}-${code}.png`) });\n+    const paths = await page\n+      .locator('.network__preview g[stroke] > path:first-child')\n+      .evaluateAll((lines) => lines.map((line) => line.getAttribute('d')));\n+    const sample = { code, controls, paths, svg: original };\n+    result.networks.push(sample);\n+    const shared = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n+    await page.goto(shared);\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), original, `${code}: default share changed the picture`);\n+    if (turns) {\n+      await go(code, `turns=${encodeURIComponent(turns)}`);\n+      const manual = await picture();\n+      sample.manual = manual;\n+      if (phase !== 'before') assert.equal(original, manual, `${code}: default differs from supplied arrangement`);\n+    }\n+    console.log(`${engine} ${phase}: ${code} default/share${turns ? '/supplied turns' : ''}`);\n+  }\n+  if (phase !== 'before') {\n+    // Native keyboard editing starts from the resolved default and survives sharing.\n+    await go('0222');\n+    assert.equal(await page.locator('#link-1-turn-1').inputValue(), '-30');\n+    const numeric = page.locator('#link-1-turn-1-value');\n+    await numeric.fill('-29');\n+    await numeric.press('Tab');\n+    assert.equal(await page.locator('#link-1-turn-1').inputValue(), '-29');\n+    const edited = await picture();\n+    await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), edited);\n+    await go('0222', 'solve=true');\n+    const solved = await picture();\n+    await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), solved, 'Apply changed the drawing');\n+    await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+    await waitForNetwork(page);\n+    assert.equal(await picture(), solved, 'applied share changed the drawing');\n+    const pending = page.waitForEvent('download');\n+    await page.getByRole('button', { name: '⤓ SVG', exact: true }).click();\n+    const exported = await readFile(await (await pending).path(), 'utf8');\n+    assert.equal(\n+      await page.evaluate((svg) => {\n+        const wrapper = document.createElement('div');\n+        wrapper.innerHTML = svg;\n+        return wrapper.innerHTML;\n+      }, exported),\n+      solved,\n+    );\n+    await page.setViewportSize({ width: 390, height: 844 });\n+    await go('0112');\n+    assert(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1));\n+    await page.screenshot({ path: join(output, `${engine}-${phase}-mobile.png`), fullPage: true });\n+    result.interactions = 'native turn edit, default/manual share, worker, Apply, SVG download, mobile';\n+  }\n+  assert.deepEqual(result.errors, []);\n+} catch (error) {\n+  result.failure = error.stack;\n+  throw error;\n+} finally {\n+  await browser?.close();\n+  await server.close();\n+  await writeFile(join(data, `${engine}-${phase}.json`), JSON.stringify(result, null, 2) + '\\n');\n+}\ndiff --git a/experiments/issue-41-cases.mjs b/experiments/issue-41-cases.mjs\nnew file mode 100644\nindex 0000000..489c1c8\n--- /dev/null\n+++ b/experiments/issue-41-cases.mjs\n@@ -0,0 +1,30 @@\n+export const reported = [\n+  { code: '0222', turns: '0 -30' },\n+  { code: '0112', turns: '0 0,-30 0' },\n+  { code: '0001', turns: '0 0,0 -30' },\n+  { code: '2002', turns: '-30 0' },\n+];\n+\n+// Twenty distinct cases: all four one-link networks, eight each for 2/3 links.\n+// A fixed seed and finite sampling budget keep the original sample reproducible.\n+export function randomNetworks() {\n+  let seed = 0x41c0de;\n+  const codes = [];\n+  for (const [n, count] of [\n+    [1, 4],\n+    [2, 8],\n+    [3, 8],\n+  ]) {\n+    const selected = new Set();\n+    for (let attempt = 0; selected.size < count && attempt < 1000; attempt++) {\n+      const code = Array.from({ length: n * 2 }, () => {\n+        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;\n+        return Math.floor((seed / 2 ** 32) * (n + 1));\n+      }).join('');\n+      selected.add(code);\n+    }\n+    if (selected.size !== count) throw new Error('Sampling budget exceeded');\n+    codes.push(...selected);\n+  }\n+  return codes;\n+}\ndiff --git a/experiments/issue-41-measure.mjs b/experiments/issue-41-measure.mjs\nnew file mode 100644\nindex 0000000..44569ac\n--- /dev/null\n+++ b/experiments/issue-41-measure.mjs\n@@ -0,0 +1,51 @@\n+import assert from 'node:assert/strict';\n+import { writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+import { reported, randomNetworks } from './issue-41-cases.mjs';\n+\n+const server = await createServer({ server: { middlewareMode: true }, appType: 'custom' });\n+try {\n+  const { decode } = await server.ssrLoadModule('/src/links/configurations.js');\n+  const { layoutCurves, glyphCurves } = await server.ssrLoadModule('/src/links/glyph.js');\n+  const { normalizeStyle, shapeOfStyle, withSpacing } = await server.ssrLoadModule('/src/links/style.js');\n+  const { overlapCost, solveCollisions } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const results = [];\n+  for (const { code } of [...reported, ...randomNetworks().map((code) => ({ code }))]) {\n+    const links = decode(code.match(/../g).join(' '));\n+    const style = normalizeStyle();\n+    const before = shapeOfStyle(style, links.length);\n+    const after = shapeOfStyle(style, links);\n+    assert.deepEqual(after.linkGaps, before.linkGaps);\n+    const start = performance.now();\n+    const solved = solveCollisions(links, after, { adjustGaps: true });\n+    assert(solved.after <= solved.before + 1e-9);\n+    const original = glyphCurves(links, after);\n+    glyphCurves(links, shapeOfStyle(withSpacing(style, solved), links)).forEach((curve, i) =>\n+      assert.deepEqual(curve.middle.at, original[i].middle.at),\n+    );\n+    const result = {\n+      code,\n+      defaultTurns: after.turns,\n+      beforeCost: overlapCost(links, before),\n+      defaultCost: overlapCost(links, after),\n+      originalCurves: layoutCurves(links, before),\n+      defaultCurves: layoutCurves(links, after),\n+      configuredGaps: { start: style.startGap, end: style.endGap, perLink: style.gaps },\n+      solved: { turns: solved.turns, gaps: solved.linkGaps, before: solved.before, after: solved.after },\n+      milliseconds: performance.now() - start,\n+    };\n+    results.push(result);\n+    console.log(\n+      JSON.stringify({\n+        code,\n+        turns: after.turns,\n+        before: result.beforeCost,\n+        after: result.defaultCost,\n+        solved: solved.after,\n+      }),\n+    );\n+  }\n+  await writeFile('docs/case-studies/issue-41/data/measurements.json', JSON.stringify(results, null, 2) + '\\n');\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-41-perfect.mjs b/experiments/issue-41-perfect.mjs\nnew file mode 100644\nindex 0000000..70867ee\n--- /dev/null\n+++ b/experiments/issue-41-perfect.mjs\n@@ -0,0 +1,32 @@\n+import assert from 'node:assert/strict';\n+import { writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+\n+// Finite audit of every topology up to three links, using the existing scorer.\n+const server = await createServer({ server: { middlewareMode: true }, appType: 'custom' });\n+try {\n+  const { codeAt, decode } = await server.ssrLoadModule('/src/links/configurations.js');\n+  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');\n+  const { overlapCost, turningCost } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const result = { networks: 0, previouslyClear: 0, failures: [] };\n+  for (let n = 1; n <= 3; n++) {\n+    for (let index = 0; index < (n + 1) ** (2 * n); index++) {\n+      const code = codeAt(n, BigInt(index));\n+      const links = decode(code);\n+      const style = normalizeStyle();\n+      const before = shapeOfStyle(style, n);\n+      const cost = overlapCost(links, before);\n+      result.networks++;\n+      if (cost > 1e-8) continue;\n+      result.previouslyClear++;\n+      const after = shapeOfStyle(style, links);\n+      const next = overlapCost(links, after) - turningCost(after.turns);\n+      if (next > 1e-8) result.failures.push({ code, before: cost, after: next, turns: after.turns });\n+    }\n+  }\n+  await writeFile('docs/case-studies/issue-41/data/perfect-audit.json', JSON.stringify(result, null, 2) + '\\n');\n+  console.log(JSON.stringify(result));\n+  assert.deepEqual(result.failures, []);\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-41-reciprocal.mjs b/experiments/issue-41-reciprocal.mjs\nnew file mode 100644\nindex 0000000..31b1588\n--- /dev/null\n+++ b/experiments/issue-41-reciprocal.mjs\n@@ -0,0 +1,55 @@\n+import { writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+import { reported, randomNetworks } from './issue-41-cases.mjs';\n+const server = await createServer({ server: { middlewareMode: true }, appType: 'custom' });\n+try {\n+  const { decode } = await server.ssrLoadModule('/src/links/configurations.js');\n+  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');\n+  const { layoutCurves } = await server.ssrLoadModule('/src/links/glyph.js');\n+  const { overlapCost } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const results = [];\n+  for (const { code } of [...reported, ...randomNetworks().map((code) => ({ code }))]) {\n+    const links = decode(code.match(/../g).join(' '));\n+    const base = shapeOfStyle(normalizeStyle(), links);\n+    // Reconstruct the rejected candidate independently of the production guard.\n+    const curves = layoutCurves(links, { ...base, turns: links.map(() => [0, 0]) });\n+    base.turns = curves.map((curve, i) =>\n+      links[i].map((ref, end) => {\n+        if (!ref || ref === i + 1) return 0;\n+        const at = curve.middle.at;\n+        const to = curves[ref - 1].middle.at;\n+        const delta = end ? [to[0] - at[0], to[1] - at[1]] : [at[0] - to[0], at[1] - to[1]];\n+        const length = Math.hypot(...delta);\n+        const chord = delta.map((value) => value / length);\n+        if (chord[0] * curve.middle.dir[0] + chord[1] * curve.middle.dir[1] < 1 - 1e-10) return 0;\n+        const dir = (end ? curve.end : curve.start).dir;\n+        return (\n+          Math.round(\n+            (Math.atan2(dir[0] * chord[1] - dir[1] * chord[0], dir[0] * chord[0] + dir[1] * chord[1]) * 180) / Math.PI,\n+          ) || 0\n+        );\n+      }),\n+    );\n+    const variants = {};\n+    for (const kind of ['all', 'first', 'none']) {\n+      const turns = base.turns.map((pair, i) =>\n+        pair.map((angle, end) => {\n+          const ref = links[i][end];\n+          if (ref && links[ref - 1].includes(i + 1) && (kind === 'none' || (kind === 'first' && i > ref - 1))) return 0;\n+          return angle;\n+        }),\n+      );\n+      variants[kind] = { turns, cost: overlapCost(links, { ...base, turns }) };\n+    }\n+    results.push({ code, variants });\n+  }\n+  await writeFile(\n+    'docs/case-studies/issue-41/data/reciprocal-experiment.json',\n+    JSON.stringify(results, null, 2) + '\\n',\n+  );\n+  results.forEach(({ code, variants }) =>\n+    console.log(code, Object.fromEntries(Object.entries(variants).map(([key, value]) => [key, value.cost]))),\n+  );\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-41-regressions.sh b/experiments/issue-41-regressions.sh\nnew file mode 100644\nindex 0000000..4ce4270\n--- /dev/null\n+++ b/experiments/issue-41-regressions.sh\n@@ -0,0 +1,30 @@\n+#!/usr/bin/env bash\n+# Run existing browser contracts sequentially; keep evidence outside old case studies.\n+set -u\n+engines=(\"$@\")\n+if (( ${#engines[@]} == 0 )); then engines=(chromium firefox webkit); fi\n+log_dir=docs/case-studies/issue-41/logs\n+mkdir -p \"$log_dir\"\n+failed=0\n+for ENGINE in \"${engines[@]}\"; do\n+  export ENGINE\n+  for suite in browser issue19 issue21 issue23 issue25 issue27 issue29 issue35 issue37; do\n+    export CAPTURE_DIR=\"browser-results/local/$ENGINE/$suite/screenshots\"\n+    export RESULT_DIR=\"browser-results/local/$ENGINE/$suite/data\"\n+    log=\"$log_dir/legacy-$ENGINE-$suite.log\"\n+    mkdir -p \"$CAPTURE_DIR\" \"$RESULT_DIR\"\n+    if [[ \"$suite\" == issue23 ]]; then\n+      export XWD_FILE=\"$PWD/browser-results/local/$ENGINE/$suite/display/Xvfb_screen0\"\n+      mkdir -p \"$(dirname \"$XWD_FILE\")\"\n+      xvfb-run -a -s \"-screen 0 1600x1200x24 -fbdir $(dirname \"$XWD_FILE\")\" npm run \"test:network:$suite\" > \"$log\" 2>&1\n+      status=$?\n+      unset XWD_FILE\n+    else\n+      npm run \"test:network:$suite\" > \"$log\" 2>&1\n+      status=$?\n+    fi\n+    printf '%s %s: exit %s\\n' \"$ENGINE\" \"$suite\" \"$status\"\n+    if (( status != 0 )); then failed=1; fi\n+  done\n+done\n+exit \"$failed\"\ndiff --git a/experiments/issue-41-sheet.mjs b/experiments/issue-41-sheet.mjs\nnew file mode 100644\nindex 0000000..513f49e\n--- /dev/null\n+++ b/experiments/issue-41-sheet.mjs\n@@ -0,0 +1,24 @@\n+import { readFile, writeFile } from 'node:fs/promises';\n+import { chromium } from 'playwright';\n+const root = 'docs/case-studies/issue-41';\n+const before = JSON.parse(await readFile(`${root}/data/chromium-before.json`, 'utf8')).networks;\n+const after = JSON.parse(await readFile(`${root}/data/chromium-after.json`, 'utf8')).networks;\n+const browser = await chromium.launch();\n+try {\n+  const page = await browser.newPage({ viewport: { width: 1320, height: 1000 }, deviceScaleFactor: 1 });\n+  for (let part = 0; part < 2; part++) {\n+    const cards = after\n+      .slice(part * 12, (part + 1) * 12)\n+      .map(({ code, svg }) => {\n+        const original = before.find((item) => item.code === code).svg;\n+        return `<article><h2>${code}</h2><div><figure>${original}<figcaption>Before</figcaption></figure><figure>${svg}<figcaption>After</figcaption></figure></div></article>`;\n+      })\n+      .join('');\n+    const html = `<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Issue 41 before/after ${part + 1}</title><style>body{margin:16px;background:#101420;color:#fff;font:14px system-ui}main{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}article{border:1px solid #586178;border-radius:8px;padding:8px}h2{font:16px monospace;margin:0 0 8px}article div{display:flex;gap:8px}figure{flex:1;margin:0;min-width:0}svg{width:100%;height:auto;display:block}figcaption{text-align:center;margin-top:4px}</style><h1>Issue 41: four reported cases and twenty seeded 1–3-link networks (${part + 1}/2)</h1><main>${cards}</main></html>`;\n+    await writeFile(`${root}/data/comparison-${part + 1}.html`, html);\n+    await page.setContent(html);\n+    await page.screenshot({ path: `${root}/screenshots/comparison-${part + 1}.png`, fullPage: true });\n+  }\n+} finally {\n+  await browser.close();\n+}\ndiff --git a/package.json b/package.json\nindex 6c416c4..bd53682 100644\n--- a/package.json\n+++ b/package.json\n@@ -36,7 +36,8 @@\n     \"test:network:issue29\": \"node experiments/issue-29-browser.mjs\",\n     \"test:indicators:browser\": \"node experiments/issue-33-browser.mjs\",\n     \"test:network:issue35\": \"node experiments/issue-35-browser.mjs\",\n-    \"test:network:issue37\": \"node experiments/issue-37-browser.mjs\"\n+    \"test:network:issue37\": \"node experiments/issue-37-browser.mjs\",\n+    \"test:network:issue41\": \"node experiments/issue-41-browser.mjs\"\n   },\n   \"homepage\": \"https://konard.github.io\",\n   \"devDependencies\": {\ndiff --git a/src/links/glyph.js b/src/links/glyph.js\nindex e376b61..5c43a8f 100644\n--- a/src/links/glyph.js\n+++ b/src/links/glyph.js\n@@ -255,6 +255,34 @@ export function layoutCurves(links, shape = {}) {\n   return links.map((_, i) => linkCurve(links, i, places, o));\n }\n \n+/**\n+ * Prefer a straight reference when its chord already follows the middle's\n+ * tangent. Return ordinary editable turns; leave gaps and placement alone.\n+ * Explicit angles/bends and the gallery's legacy geometry remain deliberate.\n+ */\n+export function defaultTurns(links, shape = {}) {\n+  const o = shapeOf(shape);\n+  const zero = links.map(() => [0, 0]);\n+  if (o.bendMode !== 'curve' || o.angles !== 'fixed' || o.bulge !== 0) return zero;\n+  const places = layout(links.length, o, links);\n+  return links.map((pair, i) => {\n+    const curve = linkCurve(links, i, places, { ...o, turns: zero });\n+    return pair.map((ref, end) => {\n+      const key = end ? 'targetAngle' : 'sourceAngle';\n+      if (!ref || ref === i + 1 || o[key] !== SHAPE[key]) return 0;\n+      // Reciprocal references need distinct routes: straightening them puts\n+      // two shafts on the same chord and can also fold their free extensions.\n+      if (links[ref - 1].includes(i + 1)) return 0;\n+      const chord = unit(end ? sub(places[ref - 1].at, places[i].at) : sub(places[i].at, places[ref - 1].at));\n+      // Lenses and references approaching from different directions need their\n+      // existing curves. A closed half itself is never changed.\n+      if (dot(chord, curve.middle.dir) < 1 - 1e-10) return 0;\n+      const dir = curve[end ? 'end' : 'start'].dir;\n+      return Math.round(Math.atan2(dir[0] * chord[1] - dir[1] * chord[0], dot(dir, chord)) / RAD) || 0;\n+    });\n+  });\n+}\n+\n /** Shared fitting transform, also used to score middle cuts in image units. */\n export function curveTransform(curves, shape = {}) {\n   const o = shapeOf(shape);\ndiff --git a/src/links/issue-37.test.js b/src/links/issue-37.test.js\nindex 11f0b80..e9705a4 100644\n--- a/src/links/issue-37.test.js\n+++ b/src/links/issue-37.test.js\n@@ -67,7 +67,7 @@ const FIXED_RESIDUAL = {\n };\n it.each(randomNetworks())('locally spaces discovered random network %s without changing its arrangement', (code) => {\n   const links = decode(code.match(/../g).join(' '));\n-  const shape = shapeOfStyle(normalizeStyle(), links.length);\n+  const shape = shapeOfStyle(normalizeStyle(), links);\n   const snapshot = JSON.stringify(shape);\n   const result = solveCollisions(links, shape, { adjustGaps: true });\n   expect(result.after - turningCost(result.turns)).toBeLessThanOrEqual(FIXED_RESIDUAL[code] ?? 1e-8);\n@@ -76,7 +76,7 @@ it.each(randomNetworks())('locally spaces discovered random network %s without c\n   const applied = normalizeStyle({\n     ...withSpacing(normalizeStyle(), result),\n   });\n-  const fitted = shapeOfStyle(applied, links.length);\n+  const fitted = shapeOfStyle(applied, links);\n   expect(overlapCost(links, fitted)).toBeCloseTo(result.after, 8);\n   expect(glyphCurves(links, fitted).map((curve) => shaftCrossings(paintedCurve(curve, fitted)))).toEqual(\n     links.map(() => 0),\ndiff --git a/src/links/issue-41.test.js b/src/links/issue-41.test.js\nnew file mode 100644\nindex 0000000..4dcc7d8\n--- /dev/null\n+++ b/src/links/issue-41.test.js\n@@ -0,0 +1,118 @@\n+import { describe, expect, it } from 'vitest';\n+import { codeAt, decode } from './configurations';\n+import { layoutCurves } from './glyph';\n+import { linkTurns, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams, withTurns } from './style';\n+import { reported, randomNetworks } from '../../experiments/issue-41-cases.mjs';\n+\n+const linksOf = (code) => decode(code.match(/../g).join(' '));\n+const curves = (links, raw = {}) => layoutCurves(links, shapeOfStyle(normalizeStyle(raw), links));\n+const near = (a, b) => expect(Math.hypot(a[0] - b[0], a[1] - b[1])).toBeLessThan(1e-10);\n+const sub = (a, b) => a.map((v, i) => v - b[i]);\n+const simpleOpen = (links, i) =>\n+  links[i].includes(0) && links[i].some((ref) => ref && ref !== i + 1 && !links[ref - 1].includes(i + 1));\n+function straight(curve) {\n+  const axis = sub(curve.end.at, curve.start.at);\n+  for (const point of curve.segments.flat()) {\n+    const offset = sub(point, curve.start.at);\n+    expect(Math.abs(axis[0] * offset[1] - axis[1] * offset[0])).toBeLessThan(1e-10);\n+  }\n+}\n+\n+describe('simple default reference turns (issue 41)', () => {\n+  it.each(reported)('$code matches the supplied straight arrangement', ({ code, turns }) => {\n+    const links = linksOf(code);\n+    const actual = curves(links);\n+    const expected = curves(links, { turns });\n+    actual.forEach((curve, i) => {\n+      curve.segments.flat().forEach((point, k) => near(point, expected[i].segments.flat()[k]));\n+      if (simpleOpen(links, i)) straight(curve);\n+    });\n+    expect(linkTurns(normalizeStyle(), links)).toEqual(linkTurns(normalizeStyle({ turns }), links));\n+  });\n+\n+  it.each(randomNetworks())('%s keeps every free-to-other link straight', (code) => {\n+    const links = linksOf(code);\n+    curves(links).forEach((curve, i) => {\n+      if (simpleOpen(links, i)) straight(curve);\n+    });\n+  });\n+\n+  it('straightens a through-link when its two references and middle are collinear', () => {\n+    const links = [\n+      [0, 0],\n+      [1, 3],\n+      [0, 0],\n+    ];\n+    straight(curves(links, { placement: 'cards' })[1]);\n+  });\n+\n+  it('audits every 1–3-link topology: straight open links, fixed middles/closed halves and unchanged gaps', () => {\n+    let networks = 0;\n+    let adjusted = 0;\n+    for (let n = 