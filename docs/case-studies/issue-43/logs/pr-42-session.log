library.js\nsrc/sound/options.js\nsrc/sound/sound.test.jsx\nsrc/visuals/beams.js\nsrc/visuals/governor.js\nsrc/visuals/governor.test.js\nsrc/visuals/layers.test.jsx\nsrc/visuals/nebula.js\nsrc/visuals/rain.js\nsrc/visuals/size.js\nsrc/visuals/stars.js\nsrc/workflow.test.js\nname: Deploy to GitHub Pages\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    branches:\n      - main\n  workflow_dispatch:\n  schedule:\n    - cron: '0 6 * * 1'\n\n# Least-privilege default; only the deploy job may publish to Pages.\npermissions:\n  contents: read\n\n# actions/checkout runs `git init` before any step can configure Git; this\n# silences its \"default branch name\" hint.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  prepare:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-prepare\n      cancel-in-progress: true\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:\n      contents: read\n      pages: read\n    outputs:\n      code: ${{ steps.changes.outputs.code }}\n      docs: ${{ steps.changes.outputs.docs }}\n    steps:\n      - name: Checkout the merge result\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n      - name: Verify merge freshness and detect changes\n        id: changes\n        run: node scripts/ci-changes.mjs\n      - name: Check GitHub Pages configuration before building\n        run: node scripts/check-pages.mjs\n        env:\n          GH_TOKEN: [REDACTED] github.token }}\n          REQUIRE_PAGES: ${{ github.event_name != 'pull_request' && 'true' || 'false' }}\n\n  # Lint the workflows themselves (actionlint also runs shellcheck on run: blocks).\n  lint-workflows:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-lint-workflows\n      cancel-in-progress: true\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Run actionlint\n        uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          args: -color\n\n  # Fast checks run before the tests and the build.\n  checks:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-checks\n      cancel-in-progress: true\n    needs: prepare\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check file size limits\n        run: npm run check:file-size\n\n      - name: Check for secrets\n        run: npm run check:secrets\n\n      - name: Audit dependencies\n        run: npm audit --package-lock-only --audit-level=moderate\n\n  test:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-test\n      cancel-in-progress: true\n    needs: [prepare, lint-workflows, checks, network-browsers]\n    if: needs.prepare.outputs.code == 'true'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n\n    steps:\n      # On pull requests this is the merge result with main, not the branch head.\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Run tests\n        run: npm run test:ci\n\n      - name: Build the React app\n        run: npm run build\n\n      # Issue #11: every CV (position × style × language) is printed to PDF by\n      # headless Chromium and checked: at most 2 pages for a position, 1 page\n      # for the compact style, and a text layer an ATS can read.\n      - name: Install Chromium for the CV PDFs\n        run: npx playwright install --with-deps chromium\n\n      - name: Print the CV PDFs\n        run: npm run build:cv\n\n      # GitHub Pages is set to deploy from GitHub Actions, so the site is\n      # published from this artifact, not from a branch or the docs/ folder.\n      # Pull requests upload it too, so a broken artifact fails before merge.\n      - name: Upload the build as the Pages artifact with bounded transport retries\n        uses: ./.github/actions/upload-artifact\n        with:\n          name: github-pages\n          path: build/\n          pages: 'true'\n\n  network-browsers:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-network-browsers-${{ matrix.engine }}\n      cancel-in-progress: true\n    needs: [prepare, lint-workflows, checks, tooling]\n    if: needs.prepare.outputs.code == 'true'\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 15\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - engine: chromium\n            os: ubuntu-24.04\n          - engine: firefox\n            os: ubuntu-24.04\n          # This container's Linux GTK renderer omits backdrop effects on\n          # screen. Test WebKit on macOS, the platform used by the reported bug.\n          # Pin Intel: ARM capacity left a previous job without any runner.\n          - engine: webkit\n            os: macos-15-intel\n    env:\n      ENGINE: ${{ matrix.engine }}\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Build the editor\n        run: npm run build\n\n      - name: Install the browser\n        id: browser\n        # WebKit uses macOS because Linux GTK can stall on glass panels.\n        # https://github.com/microsoft/playwright/issues/43426\n        run: npx playwright install --with-deps \"$ENGINE\"\n\n      - name: Initialize browser evidence\n        run: |\n          mkdir -p browser-results\n          node -e 'require(\"node:fs\").writeFileSync(\"browser-results/run.json\", JSON.stringify({sha: process.env.GITHUB_SHA, engine: process.env.ENGINE}))'\n\n      - name: Verify existing editor features and image downloads\n        run: npm run test:network:browser\n        env:\n          CAPTURE_DIR: browser-results/screenshots/editor\n\n      - name: Verify history, self loops, layouts, clipboard and mobile editing\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue19\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue19\n          RESULT_DIR: browser-results/data/issue19\n\n      - name: Verify editor geometry, source colors and shared settings\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue21\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue21\n          RESULT_DIR: browser-results/data/issue21\n\n      - name: Verify curved markers, per-link gaps and bounded gallery blur surfaces\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        # Capture the actual compositor, including Firefox backdrop effects.\n        run: |\n          if [[ \"$RUNNER_OS\" == \"macOS\" ]]; then\n            DISPLAY_CAPTURE=1 npm run test:network:issue23\n          else\n            mkdir -p \"$(dirname \"$XWD_FILE\")\"\n            xvfb-run -a -s \"-screen 0 1600x1200x24 -fbdir $(dirname \"$XWD_FILE\")\" npm run test:network:issue23\n          fi\n        env:\n          CARD_BATCHES: '8' # The exact reported 4,131-card load, in every engine.\n          XWD_FILE: ${{ runner.temp }}/issue23-display/Xvfb_screen0\n          CAPTURE_DIR: browser-results/screenshots/issue23\n          RESULT_DIR: browser-results/data/issue23\n\n      - name: Verify automatic spacing, sharp balanced arrows and per-link cards\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue25\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue25\n          RESULT_DIR: browser-results/data/issue25\n\n      - name: Verify equal closed gaps, historical URLs and numeric keyboard controls\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue27\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue27\n          RESULT_DIR: browser-results/data/issue27\n\n      - name: Verify paired sliders, preserved manual layouts and symmetric automatic references\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue29\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue29\n          RESULT_DIR: browser-results/data/issue29\n\n      - name: Verify contribution calendar, code counts, social fallback and mobile layouts\n        if: ${{ !cancelled() && matrix.engine == 'chromium' && steps.browser.outcome == 'success' }}\n        run: npm run test:indicators:browser\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue33\n\n      - name: Verify continuous middles and explicit cuts after automatic spacing\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue35\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue35\n          RESULT_DIR: browser-results/data/issue35\n\n      - name: Verify self crossings, 20 random networks, slider focus and worker responsiveness\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue37\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue37\n          RESULT_DIR: browser-results/data/issue37\n\n      - name: Preserve browser evidence with bounded transport retries\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        uses: ./.github/actions/upload-artifact\n        with:\n          name: network-${{ matrix.engine }}\n          path: browser-results/\n\n  deploy:\n    concurrency:\n      group: main-writer-${{ github.repository }}-main\n      cancel-in-progress: false\n    needs: [prepare, test, tooling, docs, codeql]\n    if: >-\n      !cancelled() && github.event_name != 'pull_request' && github.event_name != 'schedule' &&\n      github.ref == 'refs/heads/main' && needs.prepare.outputs.code == 'true' &&\n      needs.test.result == 'success' && needs.tooling.result == 'success' && needs.codeql.result == 'success' &&\n      (needs.docs.result == 'success' || needs.prepare.outputs.docs == 'false')\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    permissions:\n      contents: read\n      pages: write\n      id-token: [REDACTED]    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v5\n\n      # A green deploy must mean the site is really there (issue #5).\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n          sparse-checkout: scripts\n\n      - name: Verify the deployed site\n        run: bash scripts/check-deployed-site.sh \"$PAGE_URL\"\n        env:\n          PAGE_URL: ${{ steps.deployment.outputs.page_url }}\n\n  tooling:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-tooling\n      cancel-in-progress: true\n    needs: prepare\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Setup Python\n        uses: actions/setup-python@v7\n        with:\n          python-version: '3.13'\n      - name: Verify public source attribution and mirror deduplication\n        run: |\n          curl --fail --location --silent --show-error https://raw.githubusercontent.com/AlDanial/cloc/v2.10/cloc -o \"$CLOC_PATH\"\n          printf '%s  %s\\n' 'bf59272455172108072a0a106379f7509fd4349bdcfd85203bac038ccd286d83' \"$CLOC_PATH\" | sha256sum --check\n          python3 experiments/test_source_lines.py\n        env:\n          CLOC_PATH: ${{ runner.temp }}/cloc.pl\n      - name: Install pinned source linters\n        run: python -m pip install ruff==0.17.3 shellcheck-py==0.11.0.1\n      - name: Check Python syntax, lint and formatting\n        run: |\n          python scripts/check-python.py\n          ruff check .\n          ruff format --check .\n      - name: Check every standalone shell script and hook\n        run: git ls-files -z '*.sh' '.husky/*' ':(exclude)dev/log/**' ':(exclude)docs/**' | xargs -0 shellcheck\n      - name: Audit workflow security, including low-confidence credential findings\n        uses: zizmorcore/zizmor-action@v0.8.0\n        with:\n          version: 1.31.1\n          advanced-security: false\n          annotations: true\n          min-confidence: low\n          config: .github/zizmor.yml\n          inputs: .github/\n      - name: Audit pedantic image pins\n        env:\n          GH_TOKEN: [REDACTED] github.token }}\n        run: >-\n          pipx run zizmor==1.31.1 --config .github/zizmor.yml\n          --persona pedantic --min-severity high --min-confidence high .github/\n\n  docs:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-docs\n      cancel-in-progress: true\n    needs: [prepare, checks]\n    if: needs.prepare.outputs.docs == 'true'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Check required documentation\n        run: node scripts/check-docs.mjs\n      - name: Restore link cache\n        uses: actions/cache@v6\n        with:\n          path: .lycheecache\n          key: lychee-${{ runner.os }}-${{ github.sha }}\n          restore-keys: lychee-${{ runner.os }}-\n      - name: Check maintained documentation links\n        uses: lycheeverse/lychee-action@v2\n        with:\n          args: --no-progress --config lychee.toml README.md\n          fail: true\n        env:\n          GITHUB_TOKEN: [REDACTED] github.token }}\n\n  codeql:\n    # Evidence-heavy PRs can exceed GitHub's 300-file compare API limit.\n    # Run full analysis for every language instead of requesting a partial diff.\n    env:\n      CODEQL_ACTION_DIFF_INFORMED_QUERIES: 'false'\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-codeql-${{ matrix.language }}\n      cancel-in-progress: true\n    needs: prepare\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    permissions:\n      contents: read\n      security-events: write\n    strategy:\n      fail-fast: false\n      matrix:\n        language: [javascript-typescript, python, actions]\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Initialize CodeQL\n        uses: github/codeql-action/init@v4\n        with:\n          languages: ${{ matrix.language }}\n          config-file: ./.github/codeql/codeql-config.yml\n          build-mode: none\n      - name: Analyze source\n        uses: github/codeql-action/analyze@v4\n        with:\n          output: ${{ runner.temp }}/codeql-results\n      - name: Setup Node.js for the security gate\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n      - name: Reject unresolved security findings\n        run: node scripts/check-codeql-results.mjs \"$SARIF_DIR\"\n        env:\n          SARIF_DIR: ${{ runner.temp }}/codeql-results\n\n  pipeline-status:\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-pipeline-status\n      cancel-in-progress: true\n    if: ${{ !cancelled() }}\n    needs: [prepare, lint-workflows, checks, tooling, docs, codeql, network-browsers, test, deploy]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Setup Node.js\n        uses: actions/setup-node@v7\n        with:\n          node-version: '24.x'\n          cache: npm\n      - name: Install dependencies\n        run: npm ci\n      - name: Verify every required outcome\n        run: node scripts/check-pipeline-status.mjs\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          CODE_CHANGED: ${{ needs.prepare.outputs.code }}\n          DOCS_CHANGED: ${{ needs.prepare.outputs.docs }}\n          SHOULD_DEPLOY: ${{ github.event_name != 'pull_request' && github.event_name != 'schedule' && github.ref == 'refs/heads/main' && needs.prepare.outputs.code == 'true' }}\n#!/usr/bin/env bash\n# Keep the 1500-line source limit aligned with ESLint; warn above 1350.\n# Historical docs/case-studies and dev/log evidence retain original formatting.\nset -euo pipefail\n\nroot=$(git rev-parse --show-toplevel)\ncd \"$root\"\nLIMIT=1500\nWARN_THRESHOLD=1350\nCHECKED=0\nFAILED=0\nfiles=$(mktemp)\ntrap 'rm -f \"$files\"' EXIT\n# Materialize the list: process-substitution failures must not become a green walk.\ngit ls-files -z > \"$files\"\nwhile IFS= read -r -d '' file; do\n  case \"$file\" in docs/case-studies/*|dev/log/*) continue ;; esac\n  case \"$file\" in *.js|*.jsx|*.cjs|*.mjs|*.css|*.md|*.yml|*.yaml|*.sh|*.py|*.html|*.toml) ;; *) continue ;; esac\n  [ -f \"$file\" ] || continue\n  # awk counts a final unterminated line too, unlike wc -l.\n  lines=$(awk 'END { print NR }' \"$file\")\n  CHECKED=$((CHECKED + 1))\n  if [ \"$lines\" -gt \"$LIMIT\" ]; then\n    echo \"::error file=$file::$file has $lines lines (limit $LIMIT)\"\n    FAILED=1\n  elif [ \"$lines\" -gt \"$WARN_THRESHOLD\" ]; then\n    echo \"::warning file=$file::$file has $lines lines (warning threshold $WARN_THRESHOLD, limit $LIMIT); extract a module.\"\n  fi\ndone < \"$files\"\nif [ \"$CHECKED\" -eq 0 ]; then\n  echo '::error::No files were checked; the file size gate is broken.'\n  exit 2\nfi\necho \"Checked $CHECKED files against the $LIMIT-line limit.\"\nexit \"$FAILED\"\n#!/bin/sh\nset -eu\nnpx lint-staged --config package.json\nnpm run check:file-size\nnpm run check:secrets\npython scripts/check-python.py\nruff check .\nruff format --check .\ngit ls-files -z '*.sh' '.husky/*' ':(exclude)dev/log/**' ':(exclude)docs/**' | xargs -0 shellcheck\n# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.\n\n# dependencies\n/node_modules\n/.pnp\n.pnp.js\n\n# testing\n/coverage\n\n# production\n/build\n\n# misc\n.DS_Store\n.env.local\n.env.development.local\n.env.test.local\n.env.production.local\n\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\n\n# playwright\n/.playwright-mcp\n\n# contact sheets and screenshots written by experiments/contact-sheet.mjs\n/experiments/out\n\n# Python/tool and generated CI evidence\n__pycache__/\n.ruff_cache/\n/browser-results/\n/lychee/\n/.lycheecache\n","exit_code":0,"status":"completed"}}
