[2026-10-30T13:50:06.235Z] [STDOUT] {"type":"item.completed","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat src/links/painted-collisions.js\nsed -n '235,330p' src/links/collisions.js\ncat src/links/collision-gap-cache.js\ncat docs/case-studies/issue-41/data/reciprocal-experiment.json | head -45\"","aggregated_output":"// Collision scoring of painted pieces in layout units. Distances are between\n// segments, not just sampled vertices, so parallel close strokes are detected.\n// Middle disks and marker interiors are included; intentional attachment of a\n// marker to its own shaft is excluded by the caller.\nconst pointDistance2 = (p, a, b) => {\n  const x = b[0] - a[0];\n  const y = b[1] - a[1];\n  const t = Math.max(0, Math.min(1, ((p[0] - a[0]) * x + (p[1] - a[1]) * y) / (x * x + y * y || 1)));\n  return (p[0] - a[0] - t * x) ** 2 + (p[1] - a[1] - t * y) ** 2;\n};\nconst side = (a, b, p) => (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0]);\nconst intersects = (a, b, c, d) => side(a, b, c) * side(a, b, d) < 0 && side(c, d, a) * side(c, d, b) < 0;\nconst inside = (p, polygon) => {\n  let yes = false;\n  for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {\n    const a = polygon[i];\n    const b = polygon[j];\n    if (a[1] > p[1] !== b[1] > p[1] && p[0] < ((b[0] - a[0]) * (p[1] - a[1])) / (b[1] - a[1]) + a[0]) yes = !yes;\n  }\n  return yes;\n};\nconst segmentCache = new WeakMap();\nconst segments = (line) => {\n  if (segmentCache.has(line)) return segmentCache.get(line);\n  const result = [];\n  for (let i = 1; i < line.length; i++) {\n    const a = line[i - 1];\n    const b = line[i];\n    if (a && b)\n      result.push({\n        a,\n        b,\n        x0: Math.min(a[0], b[0]),\n        x1: Math.max(a[0], b[0]),\n        y0: Math.min(a[1], b[1]),\n        y1: Math.max(a[1], b[1]),\n      });\n  }\n  segmentCache.set(line, result);\n  return result;\n};\nexport function paintedPairCost(a, b) {\n  const stroke = ((a.width || 0) + (b.width || 0)) / 2;\n  const clearance = Math.max(a.clearance || 0, b.clearance || 0);\n  const near = stroke + clearance;\n  let cost = 0;\n  for (const first of segments(a)) {\n    const p = first.a;\n    const q = first.b;\n    for (const second of segments(b)) {\n      if (\n        first.x1 + near < second.x0 ||\n        second.x1 + near < first.x0 ||\n        first.y1 + near < second.y0 ||\n        second.y1 + near < first.y0\n      )\n        continue;\n      const r = second.a;\n      const s = second.b;\n      const crosses = intersects(p, q, r, s);\n      const distance = crosses\n        ? 0\n        : Math.sqrt(\n            Math.min(\n              pointDistance2(p, r, s),\n              pointDistance2(q, r, s),\n              pointDistance2(r, p, q),\n              pointDistance2(s, p, q),\n            ),\n          );\n      if (distance < near) {\n        // Overlap dominates clearance preference. Continuous distance terms\n        // give gap search a gradient even when no crossing count changes.\n        cost += (crosses ? 1 : 0) + 0.25 * (1 - distance / Math.max(near, 1e-12));\n        if (distance < stroke) cost += 0.5 * (1 - distance / Math.max(stroke, 1e-12));\n      }\n    }\n  }\n  for (const [first, second] of [\n    [a, b],\n    [b, a],\n  ])\n    for (const polygon of second.fills || []) if (first.some((point) => point && inside(point, polygon))) cost += 2;\n  return cost;\n}\nexport const selfCost = (line) => line.self || 0;\n\n/** Minimum space between painted boundaries, in the caller's units. */\nexport function paintedDistance(a, b) {\n  let nearest = Infinity;\n  for (const p of segments(a))\n    for (const q of segments(b)) {\n      if (intersects(p.a, p.b, q.a, q.b)) return 0;\n      nearest = Math.min(\n        nearest,\n        pointDistance2(p.a, q.a, q.b),\n        pointDistance2(p.b, q.a, q.b),\n        pointDistance2(q.a, p.a, p.b),\n        pointDistance2(q.b, p.a, p.b),\n      );\n    }\n  for (const [first, second] of [\n    [a, b],\n    [b, a],\n  ])\n    for (const polygon of second.fills || []) if (first.some((point) => point && inside(point, polygon))) return 0;\n  return Math.max(0, Math.sqrt(nearest) - ((a.width || 0) + (b.width || 0)) / 2);\n}\n/** Same fitted geometry, cuts and markers as the SVG, converted back to layout units. */\nfunction paintedPolyline(raw, o, i, scale) {\n  const fit = (point) => point.map((v) => v * scale);\n  const curve = paintedCurve(\n    {\n      ...raw,\n      segments: raw.segments.map((segment) => segment.map(fit)),\n      ...Object.fromEntries(['start', 'end', 'middle'].map((key) => [key, { ...raw[key], at: fit(raw[key].at) }])),\n    },\n    o,\n  );\n  const marks = curveMarkers(curve, o);\n  const decorate = (points, fills = []) =>\n    Object.assign(points, { width: (o.strokeWidth || 0) / scale, clearance: o.clearance / scale, fills });\n  const markLine = (m) => {\n    const points = m.outline.map((p) => p.map((v) => v / scale));\n    // Include the actual sharp miter tip, which is outside the marker centerline.\n    return decorate(points, m.fill ? [points] : []);\n  };\n  const markerLines = ['start', 'end', 'middle'].map((key) => {\n    const line = markLine(marks[key]);\n    if (o.arrowJoin === 'miter' && ['arrow', 'triangle', 'tail'].includes(o[key]) && line.length >= 3) {\n      const index = o[key] === 'triangle' ? 0 : 1;\n      const tip = line[index];\n      const previous = line[o[key] === 'triangle' ? 1 : 0];\n      const next = line[2];\n      const mid = previous.map((v, j) => (v + next[j]) / 2);\n      const dir = tip.map((v, j) => v - mid[j]);\n      const length = Math.hypot(...dir) || 1;\n      const extra = (o.strokeWidth || 0) / 2 / Math.sin((o[`${key}Angle`] * Math.PI) / 180) / scale;\n      // Conservatively include the painted apex as well as stroked arms.\n      line.push(\n        null,\n        tip.map((v, j) => v + (dir[j] / length) * extra),\n        tip,\n      );\n    }\n    return line;\n  });\n  const halves = curve.segments.map((segment, k) => {\n    const amount = o.linkGaps[i]?.[k + 2] ?? o[k ? 'middleGapEnd' : 'middleGapStart'];\n    const kept = trimCurve(segment, amount, Boolean(k));\n    return decorate(\n      kept ? Array.from({ length: SAMPLES + 1 }, (_, j) => bezier(kept, j / SAMPLES).map((v) => v / scale)) : [],\n    );\n  });\n  // The two shafts intentionally meet at their own middle. Away from that\n  // small attachment region they must be scored against each other too:\n  // otherwise a folded lens can be misreported as having zero collisions.\n  const middle = curve.middle.at.map((v) => v / scale);\n  const joint = (o.strokeWidth + o.clearance + o.middleSize / 2) / scale;\n  const separated = halves.map((half) =>\n    decorate(half.map((point) => (distance(point, middle) > joint ? point : null))),\n  );\n  const all = decorate(\n    [...halves[0], null, ...halves[1], ...markerLines.flatMap((line) => [null, ...line])],\n    markerLines.flatMap((line) => line.fills),\n  );\n  all.ends = markerLines.slice(0, 2).map((marker, k) => {\n    const endpoint = (k ? curve.end.at : curve.start.at).map((v) => v / scale);\n    return decorate([endpoint, endpoint, null, ...marker], marker.fills);\n  });\n  all.self =\n    paintedPairCost(separated[0], separated[1]) +\n    paintedPairCost(markerLines[0], markerLines[1]) +\n    paintedPairCost(markerLines[0], halves[1]) +\n    paintedPairCost(markerLines[1], halves[0]) +\n    paintedPairCost(markerLines[2], markerLines[0]) +\n    paintedPairCost(markerLines[2], markerLines[1]);\n  return all;\n}\n// Changing one gap normally affects only that link's pair scores. A reference\n// gap can also change the fitted scale: then every existing image-unit middle\n// cut must be rescored. Keep that uncommon case exact as well.\nimport { pairCost, visiblePolyline } from './collisions';\nimport { selfCost } from './painted-collisions';\nimport { curveTransform } from './glyph';\n\nexport class GapScoreCache {\n  constructor(curves, shape) {\n    this.curves = curves;\n    this.shape = shape;\n    this.middles = curves.map((curve) => curve.middle.at);\n    Object.assign(this, this.fullState(curveTransform(curves, shape).scale));\n  }\n\n  fullState(scale) {\n    const lines = this.curves.map((curve, i) => visiblePolyline(curve, this.shape, i, scale));\n    const pairs = lines.map(() => Array(lines.length).fill(0));\n    let total = lines.reduce((sum, line) => sum + selfCost(line), 0);\n    for (let i = 0; i < lines.length; i++)\n      for (let j = i + 1; j < lines.length; j++) {\n        pairs[i][j] = pairs[j][i] = pairCost(lines[i], lines[j], this.middles);\n        total += pairs[i][j];\n      }\n    return { scale, lines, pairs, total };\n  }\n\n  measure(i, curve) {\n    const previous = this.curves[i];\n    this.curves[i] = curve;\n    // Freeze the fitted scale during painted-coordinate descent. A refit moves\n    // every image-unit marker and would make each candidate quadratic in N.\n    // The caller refits and verifies the complete exact score before returning.\n    const scale =\n      curve === previous || this.shape.clearance != null ? this.scale : curveTransform(this.curves, this.shape).scale;\n    const cuts = this.curves.some(\n      (_, j) =>\n        (this.shape.linkGaps[j]?.[2] ?? this.shape.middleGapStart) > 0 ||\n        (this.shape.linkGaps[j]?.[3] ?? this.shape.middleGapEnd) > 0,\n    );\n    let state;\n    if (scale !== this.scale && (cuts || this.shape.clearance != null)) state = this.fullState(scale);\n    else {\n      const line = visiblePolyline(curve, this.shape, i, scale);\n      const pairRow = this.lines.map((other, j) => (i === j ? 0 : pairCost(line, other, this.middles)));\n      const sum = (values) => values.reduce((a, b) => a + b, 0);\n      state = {\n        scale,\n        line,\n        pairRow,\n        total: this.total - sum(this.pairs[i]) + sum(pairRow) - selfCost(this.lines[i]) + selfCost(line),\n      };\n    }\n