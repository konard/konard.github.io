network__preview svg').waitFor();\n  };\n  const shot = async (name, element = page.locator('.network__preview')) =>\n    element.screenshot({ path: join(output, `${engine}-after-${name}.png`) });\n  const manual = 'turns=15+-15&gaps=0.18+0.18+%7E+%7E';\n  for (const [name, query] of Object.entries({\n    manual,\n    auto: 'solve=true',\n    'auto-gaps': 'solve=true&gaps=0.18+0.18+%7E+%7E',\n    acute: `${manual}&endAngle=5`,\n    rounded: `${manual}&arrowJoin=round`,\n    legacy: `${manual}&balanceArrows=false&arrowJoin=inherit`,\n  })) {\n    await go(query);\n    await shot(name);\n    results.cases[name] = {\n      svg: await page.locator('.network__preview').innerHTML(),\n      caption: await page.locator('figcaption').innerText(),\n    };\n    if (name.startsWith('auto')) {\n      const preview = await page.locator('.network__preview').innerHTML();\n      await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n      assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n      const url = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n      assert(new URL(url).searchParams.has('gaps'));\n      assert(Number(await page.getByLabel('Link 1: Gap at the source reference', { exact: true }).inputValue()) > 0.08);\n      assert(Number(await page.getByLabel('Link 1: Gap at the target reference', { exact: true }).inputValue()) > 0.08);\n      await page.goto(url);\n      assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n      results.checks.push(`${name}: apply/share/reload preserves exact drawing and discovered gaps`);\n    }\n  }\n  // Inspect actual rasterized SVG paint, independently of the geometry helper.\n  // Equally gapped lens endpoints must have the same horizontal pixel boundary.\n  results.pixels = [];\n  for (const angle of [5, 15, 45]) {\n    await go(`${manual}&endAngle=${angle}&linejoin=round`);\n    const measurement = await page.locator('.network__preview svg').evaluate(async (svg) => {\n      // Supersample narrow tips to avoid OS-specific antialias quantization;\n      // two pixels here keep the original one-pixel-per-1000 tolerance.\n      const size = 2000;\n      const copy = svg.cloneNode(true);\n      copy.setAttribute('width', size);\n      copy.setAttribute('height', size);\n      const image = new Image();\n      const url = URL.createObjectURL(new Blob([copy.outerHTML], { type: 'image/svg+xml' }));\n      try {\n        image.src = url;\n        await image.decode();\n        const canvas = document.createElement('canvas');\n        canvas.width = canvas.height = size;\n// Prints every CV (position × style × language) of the built site to PDF with\n// headless Chromium, as the browser's \"Save as PDF\" would (issue #11):\n//\n//   npm run build && npm run build:cv [-- --verbose] [position…]\n//\n// The PDFs go to build/cv/pdf/ and are published at /cv/pdf/…, the links of\n// the \"Download PDF\" buttons. The script fails when a CV for a position takes\n// more than 2 pages, a compact CV more than 1 page, a PDF has no extractable\n// text (ATS parsers read the text layer, never images) or a part of the CV is\n// positioned (its text would be out of reading order in the PDF).\nimport { mkdir, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { inflateSync } from 'node:zlib';\nimport { chromium } from 'playwright';\nimport { createServer, preview } from 'vite';\n\nconst ROOT = path.resolve(import.meta.dirname, '..');\nconst OUT = path.join(ROOT, 'build');\nconst LANGS = ['en', 'ru'];\nconst VERBOSE = process.argv.includes('--verbose');\n// Positions to print, e.g. `npm run build:cv -- developer rust`; all by default.\nconst ONLY = process.argv.slice(2).filter((arg) => !arg.startsWith('--'));\n\n/** The page limit of a CV: 1 for compact, 2 for a position, none for the full record. */\nexport const pageLimit = (role, style) => (style === 'compact' ? 1 : role === 'all' ? Infinity : 2);\n\n/** Number of pages of a PDF made by Chromium (its page objects are never compressed). */\nexport const countPages = (pdf) => (pdf.toString('latin1').match(/\\/Type\\s*\\/Page(?![a-zA-Z])/g) || []).length;\n\n/** True when the fonts carry a ToUnicode map, i.e. the text can be selected and extracted. */\nexport function hasTextLayer(pdf) {\n  const raw = pdf.toString('latin1');\n  if (/\\/ToUnicode/.test(raw)) return true;\n  // Object streams may hide the font dictionaries: look inside them too.\n  for (const match of raw.matchAll(/stream\\r?\\n([\\s\\S]*?)endstream/g)) {\n    try {\n      if (inflateSync(Buffer.from(match[1], 'latin1')).toString('latin1').includes('/ToUnicode')) return true;\n    } catch {\n      // Not a Flate stream.\n    }\n  }\n  return false;\n}\n\n/**\n * The parts of the CV that are positioned or floated. Chrome paints them in a\n * later layer and writes their text after the rest of the page into the PDF, so\n * an ATS would read them out of order: the CV must have none. Runs in the page.\n */\nexport function positionedParts(cv) {\n  const parts = [];\n  for (const el of [cv, ...cv.querySelectorAll('*')]) {\n    for (const pseudo of [null, '::before', '::after']) {\n      const style = el.ownerDocument.defaultView.getComputedStyle(el, pseudo);\n      if (pseudo && ['none', 'normal', ''].includes(style.content)) continue;\n      if (style.position !== 'static' || style.float !== 'none')\n        parts.push(`${el.className || el.tagName}${pseudo || ''}`);\n    }\n  }\n  return parts;\n}\n\n/** Loads src/cv/buildCv.js through Vite, which resolves its JSON and extensionless imports. */\nasync function loadBuildCv() {\n  const vite = await createServer({\n// Browser regression checks for issue #17. Uses the built site; starts Vite\n// preview unless BASE is set. ENGINE=chromium|firefox|webkit, CAPTURE_DIR=...\n/* global document, window, getComputedStyle, Image */\nimport assert from 'node:assert/strict';\nimport { m