[2026-10-27T19:54:06.073Z] [STDOUT] {"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'cat src/links/issue-25.test.js && cat src/pages/network-25.test.jsx && cat src/pages/network-history.test.jsx && cat src/history.js'","aggregated_output":"import { expect, it, vi } from 'vitest';\nimport { decode } from './configurations';\nimport { solveCollisions, overlapCost } from './collisions';\nimport { glyphParts, glyphCurves } from './glyph';\nimport { networkSvg } from './render';\nimport { normalizeStyle, shapeOfStyle, styleFromParams, styleToParams, withTurns } from './style';\nimport { withGaps } from './gaps';\n\nconst links = decode('22 22');\nconst fixture = (patch = {}) => normalizeStyle({ rotation: 90, ...patch });\nit('discovers separated reference gaps for 2222 without manual gaps', () => {\n  const style = fixture();\n  const shape = shapeOfStyle(style, 2);\n  const result = solveCollisions(links, shape, { adjustGaps: true });\n  expect(result.linkGaps[0][0]).toBeGreaterThan(0.08);\n  expect(result.linkGaps[0][1]).toBeGreaterThan(0.08);\n  expect(result.after).toBeLessThan(result.before);\n  const applied = withGaps(withTurns(style, result.turns), result.linkGaps);\n  expect(networkSvg(links, style, { extraTurns: result.delta, extraGaps: result.linkGaps })).toBe(\n    networkSvg(links, applied),\n  );\n  expect(overlapCost(links, shapeOfStyle(applied, 2))).toBeCloseTo(result.after, 8);\n});\nit('scores painted markers and user selected spacing, including near reference middles', () => {\n  const cost = (patch) => overlapCost(links, shapeOfStyle(fixture(patch), 2));\n  expect(cost({ start: 'none', end: 'none', middle: 'none' })).toBeLessThan(cost({}));\n  expect(cost({ clearance: 6 })).toBeGreaterThan(cost({ clearance: 0 }));\n  expect(cost({ strokeWidth: 5 })).toBeGreaterThan(cost({ strokeWidth: 0.5 }));\n});\nit('recognizes the supplied perfect manual arrangement and keeps diagnostics opt-in', () => {\n  const shape = shapeOfStyle(fixture({ turns: '15 -15', gaps: '0.18 0.18 ~ ~' }), 2);\n  // Only the 30 degrees of existing turns contribute; no painted overlap.\n  expect(overlapCost(links, shape)).toBeCloseTo(30 * 0.002, 8);\n  const debug = vi.spyOn(console, 'debug').mockImplementation(() => {});\n  try {\n    solveCollisions(links, shape, { passes: 0 });\n    expect(debug).not.toHaveBeenCalled();\n    solveCollisions(links, shape, { passes: 0, debug: true });\n    expect(debug).toHaveBeenCalledWith('[network solver]', expect.objectContaining({ links: 2, clearance: 1 }));\n  } finally {\n    debug.mockRestore();\n  }\n});\nit('keeps acute arrow tips sharp independent of line corners, with balanced extent by default', () => {\n  for (const endAngle of [5, 15, 45]) {\n    const style = fixture({ turns: '15 -15', gaps: '0.18 0.18 ~ ~', endAngle, linejoin: 'round' });\n    const svg = networkSvg(links, style);\n    expect(svg).toMatch(/stroke-linejoin=\"miter\" stroke-miterlimit=\"[\\d.]+\"/);\n    const part = glyphParts(links, shapeOfStyle(style, 2))[0];\n    const numbers = (path) => path.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\n    const start = numbers(part.line).slice(0, 2);\n    const tip = numbers(part.end.d).slice(2, 4);\n    const raw = glyphParts(links, shapeOfStyle({ ...style, balanceArrows: false }, 2))[0];\n    const rawTip = numbers(raw.end.d).slice(2, 4);\n    expect(tip[1]).toBeLessThan(rawTip[1]);\n    const extension = style.strokeWidth / 2 / Math.sin((endAngle * Math.PI) / 180);\n    const curve = glyphCurves(links, shapeOfStyle(style, 2))[0];\n    expect(Math.abs(tip[1] + extension * curve.end.dir[1] - (start[1] + style.strokeWidth / 2))).toBeLessThan(0.03);\n  }\n});\nit('round trips rounded arrows, legacy lengths and spacing settings', () => {\n  const style = fixture({ arrowJoin: 'round', balanceArrows: false, clearance: 4.5 });\n  expect(styleFromParams(styleToParams(style))).toEqual(style);\n  expect(style.arrowJoin).toBe('round');\n  expect(style.balanceArrows).toBe(false);\n  expect(style.clearance).toBe(4.5);\n});\nit('keeps zero-gap self loops finite when both endpoints coincide with their middle', () => {\n  const style = fixture({ start: 'tail', startOffset: 0, startGap: 0, endGap: 0 });\n  const svg = networkSvg(decode('11'), style);\n  expect(svg).not.toMatch(/NaN|Infinity/);\n});\nimport { fireEvent, render, screen, within } from '@testing-library/react';\nimport { afterEach, expect, it } from 'vitest';\nimport NetworkPage from './NetworkPage';\nafterEach(() => window.history.replaceState(null, '', '/'));\nit('keeps every per-link input visible in one card, with no disclosure', () => {\n  window.history.replaceState(null, '', '/network/?code=2222&lang=en');\n  render(<NetworkPage />);\n  const list = screen.getByRole('list', { name: 'Link configurations' });\n  const cards = within(list).getAllByRole('listitem');\n  expect(cards).toHaveLength(2);\n  expect(list.querySelector('details')).toBeNull();\n  for (const [i, card] of cards.entries()) {\n    const fields = within(card);\n    for (const label of [\n      'source',\n      'target',\n      'colour',\n      'turn of the source, °',\n      'turn of the target, °',\n      'Gap at the source reference',\n      'Gap at the target reference',\n      'Cut before the middle',\n      'Cut after the middle',\n    ])\n      expect(fields.getByLabelText(`Link ${i + 1}: ${label}`)).toBeVisible();\n  }\n  fireEvent.change(within(cards[1]).getByLabelText('Link 2: Cut after the middle'), { target: { value: '3' } });\n  fireEvent.click(within(cards[0]).getByRole('button', { name: 'Remove: Link 1' }));\n  expect(screen.getByLabelText('Link 1: Cut after the middle')).toHaveValue(3);\n});\nimport { useLayoutEffect } from 'react';\nimport { act, fireEvent, render, screen } from '@testing-library/react';\nimport { afterEach, beforeEach, expect, it, vi } from 'vitest';\nimport NetworkPage from './NetworkPage';\n\nbeforeEach(() => {\n  window.history.replaceState(null, '', '/network/?code=1221&angles=fixed');\n  vi.useFakeTimers();\n});\nafterEach(() => {\n  vi.restoreAllMocks();\n  vi.useRealTimers();\n});\nconst tick = (ms = 450) => act(() => vi.advanceTimersByTime(ms));\n\nit('keeps the preview/share link live but writes history once after a drag and repeated releases', () => {\n  render(<NetworkPage />);\n  tick();\n  const replace = vi.spyOn(window.history, 'replaceState');\n  const slider = screen.getByLabelText('Entering angle');\n  const before = document.querySelector('.network__preview').innerHTML;\n  fireEvent.pointerDown(slider);\n  for (let value = 1; value <= 120; value++) {\n    fireEvent.change(slider, { target: { value: value % 80 } });\n    tick(5);\n  }\n  expect(document.querySelector('.network__preview').innerHTML).not.toBe(before);\n  expect(screen.getByLabelText('Link to this picture').value).toContain('targetAngle=40');\n  tick(1000);\n  expect(replace).not.toHaveBeenCalled();\n  fireEvent.pointerUp(document);\n  tick(200);\n  fireEvent.pointerDown(slider);\n  fireEvent.change(slider, { target: { value: 41 } });\n  fireEvent.pointerUp(document);\n  tick();\n  expect(replace).toHaveBeenCalledTimes(1);\n  expect(window.location.search).toContain('targetAngle=41');\n});\n\nit('defers held keyboard input until keyup and recovers from a history SecurityError', () => {\n  render(<NetworkPage />);\n  tick();\n  const replace = vi.spyOn(window.history, 'replaceState');\n  replace.mockImplementationOnce(() => {\n    throw new DOMException('rate limit', 'SecurityError');\n  });\n  const slider = screen.getByLabelText('Entering angle');\n  fireEvent.keyDown(slider, { key: 'ArrowRight' });\n  fireEvent.change(slider, { target: { value: 48 } });\n  tick(1000);\n  expect(replace).not.toHaveBeenCalled();\n  fireEvent.keyUp(slider, { key: 'ArrowRight' });\n  tick();\n  expect(screen.getByRole('heading', { level: 1 })).toBeInTheDocument();\n  tick(1100);\n  expect(window.location.search).toContain('targetAngle=48');\n});\n\nit('captures a touch as soon as controls mount, before passive effects run', () => {\n  function EarlyTouch() {\n    useLayoutEffect(() => {\n      document.querySelector('#style-targetAngle').dispatchEvent(new Event('touchstart', { bubbles: true }));\n    }, []);\n    return <NetworkPage />;\n  }\n  render(<EarlyTouch />);\n  const replace = vi.spyOn(window.history, 'replaceState');\n  fireEvent.change(screen.getByLabelText('Entering angle'), { target: { value: 66 } });\n  tick(1000);\n  expect(replace).not.toHaveBeenCalled();\n  fireEvent.touchEnd(document);\n  tick();\n  expect(window.location.search).toContain('targetAngle=66');\n});\n\nit('does not release a pointer drag on an unrelated keyup or focus change', () => {\n  render(<NetworkPage />);\n  tick();\n  const replace = vi.spyOn(window.history, 'replaceState');\n  const slider = screen.getByLabelText('Entering angle');\n  fireEvent.pointerDown(slider);\n  fireEvent.change(slider, { target: { value: 66 } });\n  fireEvent.keyUp(document, { key: 'a' });\n  fireEvent.focusOut(screen.getByLabelText('N-ary number'));\n  tick(1000);\n  expect(replace).not.toHaveBeenCalled();\n  fireEvent.pointerCancel(document);\n  tick();\n  expect(window.location.search).toContain('targetAngle=66');\n});\n/** Address persistence may fail (quota, inactive document); UI state must survive. */\nexport function replaceAddress(url) {\n  try {\n    window.history.replaceState(window.history.state, '', url);\n    return null;\n  } catch (error) {\n    return error;\n  }\n}\n","exit_code":0,"status":"completed"}}
