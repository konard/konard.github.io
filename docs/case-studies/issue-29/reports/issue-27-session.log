from './Presets';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { getSaved, setSaved, withImported } from '../settings/presets';\nimport { formatValue } from '../settings/fields';\nimport { DEFAULTS, FIELDS, PALETTES, SECTIONS } from '../settings/schema';\nimport { changesOf, resetSettings, setSettings, useSettings } from '../settings/store';\nimport { cue } from '../sound/options';\n\nconst SETTINGS = { en: ['setting', 'settings'], ru: ['настройка', 'настройки', 'настроек'] };\nconst CHANGED = { en: ['differs', 'differ'], ru: ['отличается', 'отличаются', 'отличаются'] };\n\nexport { formatValue };\n\n// Two explicit columns instead of CSS multi-column layout (issue #15): with\n// multicol the browser rebalanced the sections whenever the skin section\n// changed size, so Skin jumped between the columns, and Safari laid them out in\n// one column or with uneven tops. Each section now names its column.\nconst COLUMNS = [1, 2];\n\nconst visibleSections = (settings) => SECTIONS.filter((section) => !section.when || section.when(settings));\n\nfunction Control({ field, value, settings }) {\n  const { t } = useLang();\n  const id = `setting-${field.key.replace(/\\./g, '-')}`;\n  const set = (next) => setSettings({ [field.key]: next });\n  const changed = value !== DEFAULTS[field.key];\n  let input;\n  let shown = null;\n  if (field.type === 'range') {\n    input = (\n      <input\n        id={id}\n        type=\"range\"\n        min={field.min}\n        max={field.max}\n        step={field.step}\n        value={value}\n        onChange={(event) => set(Number(event.target.value))}\n      />\n    );\n    shown = formatValue(field, value);\n  } else if (field.type === 'toggle') {\n    input = <input id={id} type=\"checkbox\" checked={value} onChange={(event) => set(event.target.checked)} />;\n  } else if (field.type === 'color') {\n    input = <input id={id} type=\"color\" value={value} onChange={(event) => set(event.target.value)} />;\n    shown = value;\n  } else if (field.tiles) {\n    input = <CornerTiles field={field} value={value} settings={settings} labelId={`${id}-label`} />;\n  } else {\n    input = (\n      <select id={id} value={value} onChange={(event) => set(event.target.value)}>\n        {field.options.map((option) => (\n          <option key={option.value} value={option.value}>\n            {t(option.label)}\n          </option>\n        ))}\n      </select>\n    );\n    if (field.preview === 'sound') {\n      // ▶ plays the chosen sound, so a sound can be heard before it is kept.\n      input = (\n        <>\n          {input}\n          <button\n            type=\"button\"\n            className=\"setting__play\"\n            disabled={value === 'none'}\n            onClick={() => previewSound(value)}\n            title={t({ en: 'Play', ru: 'Проиграть' })}\n            aria-label={`${t({ en: 'Play', ru: 'Проиграть' })}: ${t(field.label)}`}\n          >\n            ▶\n          </button>\n        </>\n      );\n    }\n  }\n  // Every row is the same grid: label | control | value | reset, so controls,\n  // values and reset buttons line up in a column on the whole page (issue #15).\n  return (\n    <li className={`setting setting--${field.tiles ? 'tiles' : field.type}${changed ? ' is-changed' : ''}`}>\n      <label htmlFor={field.tiles ? undefined : id} id={`${id}-label`}>\n        {t(field.label)}\n      </label>\n      <span className=\"setting__input\">{input}</span>\n      {shown !== null && (\n        <output htmlFor={id} className=\"setting__value mono\">\n          {shown}\n        </output>\n      )}\n      <button\n        type=\"button\"\n        className=\"setting__reset\"\n        onClick={() => resetSettings([field.key])}\n        disabled={!changed}\n        title={t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}\n        aria-label={`${t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}: ${t(field.label)}`}\n      >\n        ↺\n      </button>\n      {field.hint && <small className=\"setting__hint\">{t(field.hint)}</small>}\n    </li>\n  );\n}\n\n/** Colour chips of the futuristic palettes, a faster way to pick one. */\nfunction Palettes({ value }) {\n  const { t } = useLang();\n  return (\nimport { resolve } from 'node:path';\nimport { defineConfig } from 'vite';\nimport react from '@vitejs/plugin-react';\nimport { applySettings, normalize } from './src/settings/apply.js';\nimport { CSS_RULES } from './src/settings/schema.js';\n\n// Every page is its own HTML entry (a real URL on GitHub Pages, no client-side\n// routing). The home page must stay `index` so build/index.html keeps its name.\nconst PAGES = ['repositories', 'experience', 'research', 'associative', 'art', 'blog', 'cv', 'settings', 'network'];\nconst input = Object.fromEntries([\n  ['index', resolve(import.meta.dirname, 'index.html')],\n  ...PAGES.map((page) => [page, resolve(import.meta.dirname, page, 'index.html')]),\n]);\n\n// Applies the light or dark theme before the first paint, so a light-theme\n// visitor never sees a dark flash. The rules match src/i18n/prefs.js: the\n// remembered choice, otherwise prefers-color-scheme.\nexport const THEME_SCRIPT = `(function(){try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'}document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme='dark'}})();`;\n\n// Applies the remembered settings (skin, background, notation; issue #13)\n// before the first paint with the same rules as src/settings/store.js, so a\n// visitor with the futuristic skin never sees the glass one first.\nconst inline = (fn) => String(fn).replace(/\\s*\\n\\s*/g, ' ');\nexport const SETTINGS_SCRIPT = `(function(){try{${inline(normalize)};${inline(applySettings)};var r=${JSON.stringify(CSS_RULES)};applySettings(document.documentElement,r,normalize(r,JSON.parse(localStorage.getItem('settings')||'{}')))}catch(e){}})();`;\n\nconst themeBeforePaint = () => ({\n  name: 'theme-before-paint',\n  transformIndexHtml: () => [{ tag: 'script', children: THEME_SCRIPT + SETTINGS_SCRIPT, injectTo: 'head-prepend' }],\n});\n\n// The site is served from the root of https://konard.github.io, and the\n// deploy job publishes build/ with actions/deploy-pages (see .github/workflows/github-pages.yml).\nexport default defineConfig({\n  plugins: [react(), themeBeforePaint()],\n  build: {\n    outDir: 'build',\n    sourcemap: true,\n    rollupOptions: { input },\n  },\n  server: {\n    port: 3000,\n  },\n  test: {\n    environment: 'jsdom',\n    globals: true,\n    setupFiles: './src/setupTests.js',\n    include: ['src/**/*.test.{js,jsx}'],\n    testTimeout: 10000,\n  },\n});\nconst mix = (a, b, t) => a.map((v, i) => v + (b[i] - v) * t);\nconst distance = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1]);\n\n/** Exact de Casteljau subdivision, preserving the cubic's endpoint tangents. */\nexport function splitCurve([a, b, c, d], t) {\n  const [ab, bc, cd] = [mix(a, b, t), mix(b, c, t), mix(c, d, t)];\n  const [abc, bcd] = [mix(ab, bc, t), mix(bc, cd, t)];\n  const at = mix(abc, bcd, t);\n  return [\n    [a, ab, abc, at],\n    [at, bcd, cd, d],\n  ];\n}\n\n/** Trim an arc length from one end; a fully consumed half is omitted. */\nexport function trimCurve(segment, amount, fromStart = false) {\n  if (amount <= 0) return segment;\n  const curve = fromStart ? segment : [...segment].reverse();\n  let previous = curve[0];\n  let travelled = 0;\n  for (let k = 1; k <= 128; k++) {\n    const point = splitCurve(curve, k / 128)[0][3];\n    const step = distance(previous, point);\n    if (travelled + step >= amount) {\n      const t = (k - 1 + (amount - travelled) / Math.max(step, 1e-12)) / 128;\n      const kept = splitCurve(curve, t)[1];\n      return fromStart ? kept : kept.reverse();\n    }\n    travelled += step;\n    previous = point;\n  }\n  return null;\n}\n\nconst evaluate = ([a, b, c, d], t) => {\n  const