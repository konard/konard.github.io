 window.removeEventListener('blur', end);\n    };\n  }, []);\n\n  useEffect(() => {\n    if (interacting) return;\n    let timer;\n    let failures = 0;\n    const write = () => {\n      if (window.location.search === query) return;\n      const error = replaceAddress(`${window.location.pathname}${query}${window.location.hash}`);\n      if (error) {\n        networkDebug('address write failed', { name: error.name, message: error.message, failures });\n        // A rate-limited or temporarily inactive document must never take down the editor.\n        if (failures < 5) timer = setTimeout(write, 1000 * 2 ** failures++);\n      } else networkDebug('address saved', query);\n    };\n    timer = setTimeout(write, 400);\n    return () => clearTimeout(timer);\n  }, [query, interacting]);\n}\nimport { GAP_FIELDS } from '../links/gaps';\nimport { useLang } from '../i18n/prefs';\n\n/** All four overrides stay visible inside their link's card. */\nexport default function NetworkGaps({ i, row, style, onGap }) {\n  const { t } = useLang();\n  return (\n    <div className=\"link-gaps link-card__fields\">\n      {GAP_FIELDS.map((field, k) => (\n        <label key={field.key}>\n          {t(field.label)}\n          <input\n            type=\"number\"\n            min={0}\n            max={field.max}\n            step={field.step}\n            aria-label={`${t({ en: 'Link', ru: 'Связь' })} ${i + 1}: ${t(field.label)}`}\n            value={row[k] ?? ''}\n            placeholder={String(style[field.key])}\n            onChange={(event) => onGap(i, k, event.target.value === '' ? null : Number(event.target.value))}\n          />\n        </label>\n      ))}\n    </div>\n  );\n}\nimport { useState } from 'react';\nimport { formatValue } from '../settings/fields';\nimport { LOOKS, SIZES, STYLE_DEFAULTS, STYLE_SECTIONS, applyLook, normalizeStyle } from '../links/style';\nimport { geometryAvailable } from '../links/style-geometry';\nimport { useLang } from '../i18n/prefs';\n\nconst SAVED_KEY = 'network.styles';\nconst MAX_SAVED = 12;\n\n/** The styles saved in this browser: [{ name, style }]. */\nexport function readSaved() {\n  try {\n    const list = JSON.parse(localStorage.getItem(SAVED_KEY) || '[]');\n    return Array.isArray(list)\n      ? list\n          .filter((item) => item && typeof item.name === 'string')\n          .slice(0, MAX_SAVED)\n          .map((item) => ({ name: item.name.slice(0, 40), style: normalizeStyle(item.style) }))\n      : [];\n  } catch {\n    return [];\n  }\n}\n\nfunction writeSaved(list) {\n  try {\n    localStorage.setItem(SAVED_KEY, JSON.stringify(list));\n  } catch {\n    // Private mode or a full storage: the list lives until the page is closed.\n  }\n}\n\n/** One option of the picture, in the same rows as the settings page (label | control | value | reset). */\nfunction Control({ field, value, onChange }) {\n  const { t } = useLang();\n  const id = `style-${field.key}`;\n  const changed = value !== STYLE_DEFAULTS[field.key];\n  let input;\n  let shown = null;\n  if (field.type === 'range') {\n    input = (\n      <input\n        id={id}\n        type=\"range\"\n        min={field.min}\n        max={field.max}\n        step={field.step}\n        value={value}\n        onChange={(event) => onChange(Number(event.target.value))}\n      />\n    );\n    shown = formatValue(field, value);\n  } else if (field.type === 'toggle') {\n    input = <input id={id} type=\"checkbox\" checked={value} onChange={(event) => onChange(event.target.checked)} />;\n  } else if (field.type === 'color') {\n    input = <input id={id} type=\"color\" value={value} onChange={(event) => onChange(event.target.value)} />;\n    shown = value;\n  } else if (field.type === 'text') {\n    input = (\n      <input\n        id={id}\n        type=\"text\"\n        maxLength={field.max}\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n      />\n    );\n  } else {\n    input = (\n      <select id={id} value={value} onChange={(event) => onChange(event.target.value)}>\n        {field.options.map((option) => (\n          <option key={option.value} value={option.value}>\n            {t(option.label)}\n          </option>\n        ))}\n      </select>\n    );\n  }\n  return (\n    <li className={`setting setting--${field.type === 'text' ? 'select' : field.type}${changed ? ' is-changed' : ''}`}>\n      <label htmlFor={id}>{t(field.label)}</label>\n      <span className=\"setting__input\">{input}</span>\n      {shown !== null && (\n        <output htmlFor={id} className=\"setting__value mono\">\n          {shown}\n        </output>\n      )}\n      <button\n        type=\"button\"\n        className=\"setting__reset\"\n        onClick={() => onChange(STYLE_DEFAULTS[field.key])}\n        disabled={!changed}\n        title={t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}\n        aria-label={`${t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}: ${t(field.label)}`}\n      >\n        ↺\n      </button>\n      {field.hint && <small className=\"setting__hint\">{t(field.hint)}</small>}\n    </li>\n  );\n}\n\n/** Ready looks, the usual image sizes and the styles saved in this browser. */\nexport function Looks({ style, onStyle }) {\n  const { t } = useLang();\n  const [saved, setSaved] = useState(readSaved);\n  const [name, setName] = useState('');\n  const size = SIZES.findIndex((s) => s.width === style.width && s.height === style.height);\n  const save = () => {\n    const label = name.trim() || `${t({ en: 'Style', ru: 'Стиль' })} ${saved.length + 1}`;\n    const next = [{ name: label.slice(0, 40), style }, ...saved.filter((item) => item.name !== label)].slice(\n      0,\n      MAX_SAVED,\n    );\n    setSaved(next);\n    writeSaved(next);\n    setName('');\n  };\n  const remove = (label) => {\n    const next = saved.filter((item) => item.name !== label);\n    setSaved(next);\n    writeSaved(next);\n  };\n  return (\n    <div className=\"looks\">\n      <div className=\"looks__row\" role=\"group\" aria-label={t({ en: 'Looks', ru: 'Оформления' })}>\n        {LOOKS.map((look) => (\n          <button\n            key={look.id}\n            type=\"button\"\n            className=\"button button--small\"\n            onClick={() => onStyle(applyLook(style, look.id))}\n          >\n            {t(look.label)}\n          </button>\n        ))}\n      </div>\n      <label className=\"looks__size\">\n        {t({ en: 'Image size', ru: 'Размер изображения' })}{' '}\n        <select\n          value={size}\n          onChange={(event) => {\n            const chosen = SIZES[Number(event.target.value)];\n            if (chosen) onStyle({ ...style, width: chosen.width, height: chosen.height });\n          }}\n        >\n          <option value={-1}>\n            {style.width} × {style.height} ({t({ en: 'own', ru: 'свой' })})\n          </option>\n          {SIZES.map((s, i) => (\n            <option key={s.label} value={i}>\n              {s.label}\n            </option>\n          ))}\n        </select>\n      </label>\n      <div className=\"looks__saved\">\n        <input\n          type=\"text\"\n          value={name}\n          maxLength={40}\n          onChange={(event) => setName(event.target.value)}\n          placeholder={t({ en: 'Name of the style', ru: 'Название стиля' })}\n          aria-label={t({ en: 'Name of the style', ru: 'Название стиля' })}\n        />\n        <button type=\"button\" className=\"button button--small\" onClick={save}>\n          {t({ en: 'Save the style', ru: 'Сохранить стиль' })}\n        </button>\n      </div>\n      {saved.length > 0 && (\n        <ul className=\"looks__list\" aria-label={t({ en: 'Saved styles', ru: 'Сохранённые стили' })}>\n          {saved.map((item) => (\n            <li key={item.name}>\n              <button\n                type=\"button\"\n                className=\"button button--small\"\n                onClick={() => onStyle({ ...item.style, turns: style.turns, gaps: style.gaps, solve: style.solve })}\n              >\n                {item.name}\n              </button>\n              <button\n                type=\"button\"\n                className=\"setting__reset\"\n                onClick={() => remove(item.name)}\n                aria-label={`${t({ en: 'Delete', ru: 'Удалить' })}: ${item.name}`}\n              >\n                ✕\n              </button>\n            </li>\n          ))}\n        </ul>\n      )}\n    </div>\n  );\n}\n\n/** Every option of the picture, section by section (issue #17). */\nexport function StyleSections({ style, onStyle, children = null, only = null, links = null }) {\n  const { t } = useLang();\n  const set = (key, value) => onStyle(normalizeStyle({ ...style, [key]: value }));\n  return STYLE_SECTIONS.filter((section) => !only || only.includes(section.id)).map((section) => {\n    const keys = section.fields.map((field) => field.key);\n    const changed = keys.some((key) => style[key] !== STYLE_DEFAULTS[key]);\n    return (\n      <section\n        key={section.id}\n        id={`style-section-${section.id}`}\n        className=\"settings__group\"\n        aria-labelledby={`style-section-${section.id}-title`}\n      >\n        <header className=\"settings__head\">\n          <h3 id={`style-section-${section.id}-title`}>{t(section.title)}</h3>\n          <button\n            type=\"button\"\n            className=\"button button--small\"\n            disabled={!changed}\n            onClick={() =>\n              onStyle(\n                normalizeStyle({ ...style, ...Object.fromEntries(keys.map((key) => [key, STYLE_DEFAULTS[key]])) }),\n              )\n            }\n          >\n            {t({ en: 'Reset', ru: 'Сбросить' })}\n          </button>\n        </header>\n        {section.lead && <p className=\"settings__lead\">{t(section.lead)}</p>}\n        <ul className=\"settings__fields\">\n          {section.fields\n            .filter((field) => (!field.when || field.when(style)) && geometryAvailable(field.key, style, links))\n            .map((field) => (\n              <Control\n                key={field.key}\n                field={field}\n                value={style[field.key]}\n                onChange={(value) => set(field.key, value)}\n              />\n            ))}\n        </ul>\n        {section.id === 'experimental' && children}\n      </section>\n    );\n  });\n}\nimport { useState } from 'react';\nimport NetworkGaps from './NetworkGaps';\nimport { canonical, decode, encode, mathNotation } from '../links/configurations';\nimport {\n  addLink,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  setReference,\n  signatureOf,\n  theoryNotation,\n} from '../links/edit';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from '../components/format';\n\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\", \"one of N networks\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst OF_NETWORKS = { en: ['network', 'networks'], ru: ['сети', 'сетей', 'сетей'] };\n// Finding the smallest renaming tries every order of the links: n! of them.\nconst CANONICAL_UP_TO = 7;\n\n/**\n * One editable notation. While it is typed in, the text stays as it is typed;\n * every valid text changes the network at once, and an invalid one shows why.\n * When the network is changed elsewhere, the field shows the new network.\n */\nfunction NotationField({ id, label, hint, value, parse, format, onLinks, multiline = false }) {\n  const { t } = useLang();\n  const [draft, setDraft] = useState(null);\n  // A draft belongs to the value it was typed against (or the value it produced).\n  const active = draft && draft.at === value;\n  const text = active ? draft.text : value;\n  const error = active ? draft.error : null;\n  const change = (event) => {\n    const next = event.target.value;\n    const result = parse(next);\n    if (result.links) {\n      setDraft({ text: next, at: format(result.links), error: null });\n      onLinks(result.links);\n    } else setDraft({ text: next, at: value, error: result.error });\n  };\n  const Input = multiline ? 'textarea' : 'input';\n  return (\n    <div className={`notation${error ? ' is-invalid' : ''}`}>\n      <label htmlFor={id}>{t(label)}</label>\n      <Input\n        id={id}\n        className=\"mono\"\n        value={text}\n        onChange={change}\n        onBlur={() => active && !error && setDraft(null)}\n        spellCheck=\"false\"\n        autoComplete=\"off\"\n        aria-invalid={error ? 'true' : undefined}\n        aria-describedby={`${id}-note`}\n        rows={multiline ? 2 : undefined}\n      />\n      <small\n        id={`${id}-note`}\n        className={error ? 'notation__error' : 'notation__hint'}\n        role={error ? 'alert' : undefined}\n      >\n        {error ? t(error) : t(hint)}\n      </small>\n    </div>\n  );\n}\n\n/** The four editable notations of the network (issue #17). */\nexport function Notations({ links, notation, onLinks }) {\n  const { lang, t } = useLang();\n  const n = links.length;\n  const count = countOf(n);\n  return (\n    <div className=\"notations\">\n      <p className=\"muted\">\n        {t({\n          en: `${n} ${plural(n, lang, LINKS)} after the zero link 0, in a doublet network ${signatureOf(notation)}: one of ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} of ${n} ${plural(n, lang, OF_LINKS)}, written with ${2 * n} digits in base ${n + 1}. Every notation below can be edited; the others follow.`,\n          ru: `${n} ${plural(n, lang, LINKS)} после нулевой связи 0 в дуплетной сети ${signatureOf(notation)}: одна из ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} из ${n} ${plural(n, lang, OF_LINKS)}, записанная ${2 * n} цифрами в системе с основанием ${n + 1}. Любую запись ниже можно изменить, остальные изменятся вслед за ней.`,\n        })}\n      </p>\n      <NotationField\n        id=\"notation-theory\"\n        label={{ en: 'Math notation (the links theory)', ru: 'Математическая нотация (теория связей)' }}\n        hint={{\n          en: 'The function of the network: link ↦ (source, target). The names may be left out.',\n          ru: 'Функция сети: связь ↦ (начало, конец). Имена связей можно не писать.',\n        }}\n        value={theoryNotation(links, notation)}\n        format={(l) => theoryNotation(l, notation)}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-pairs\"\n        label={{ en: 'Pairs with the base', ru: 'Пары с основанием' }}\n        hint={{\n          en: 'Source and target of each link as two digits (use (source,target) with a base for 10+ links), as under the symbols of the gallery.',\n          ru: 'Начало и конец каждой связи двумя цифрами (для 10+ связей — (начало,конец) с основанием), как под символами галереи.',\n        }}\n        value={mathNotation(encode(links))}\n        format={(l) => mathNotation(encode(l))}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-number\"\n        label={{ en: 'N-ary number', ru: 'N-ричное число' }}\n        hint={{\n          en: `The whole network as one number of ${2 * n} digits in base ${n + 1}; for 10+ links use space-separated digits in [brackets].`,\n          ru: `Вся сеть как одно число из ${2 * n} цифр в системе с основанием ${n + 1}; для 10+ связей разделяйте цифры пробелами в [скобках].`,\n        }}\n        value={numberNotation(links)}\n        format={numberNotation}\n        parse={parseNumber}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-decimal\"\n        label={{ en: 'The same number in decimal', ru: 'То же число в десятичной системе' }}\n        hint={{\n          en: `The position of the network among all networks of ${n} ${plural(n, lang, LINKS)}, from 0 to ${count - 1n}.`,\n          ru: `Номер сети среди всех сетей из ${n} ${plural(n, lang, OF_LINKS)}, от 0 до ${count - 1n}.`,\n        }}\n        value={decimalOf(links)}\n        format={decimalOf}\n        parse={(text) => parseIndex(text, n)}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-links\"\n        label={{ en: 'Links notation', ru: 'Нотация связей' }}\n        hint={{\n          en: '(index: source target) for each link; 0 is nothing.',\n          ru: '(индекс: начало конец) для каждой связи; 0 — это «ничего».',\n        }}\n        value={linksText(links)}\n        format={(l) => linksText(l)}\n        parse={parseLinks}\n        onLinks={onLinks}\n        multiline\n      />\n    </div>\n  );\n}\n\n/** A choice of the link that an end refers to: 0 (nothing), the link itself or another link. */\nfunction ReferenceSelect({ id, value, n, self, onChange, label }) {\n  const { t } = useLang();\n  // Avoid two n-option selects per row (quadratic DOM size) on large networks.\n  if (n > 50)\n    return (\n      <input\n        id={id}\n        type=\"number\"\n        min={0}\n        max={n}\n        step={1}\n        value={value}\n        aria-label={label}\n        onChange={(event) => {\n          const ref = Number(event.target.value);\n          if (event.target.value !== '' && Number.isInteger(ref) && ref >= 0 && ref <= n) onChange(ref);\n        }}\n      />\n    );\n  return (\n    <select id={id} value={value} onChange={(event) => onChange(Number(event.target.value))} aria-label={label}>\n      {Array.from({ length: n + 1 }, (_, ref) => (\n        <option key={ref} value={ref}>\n          {ref}\n          {ref === 0\n            ? ` — ${t({ en: 'nothing', ru: 'ничего' })}`\n            : ref === self\n              ? ` — ${t({ en: 'itself', ru: 'сама' })}`\n              : ''}\n        </option>\n      ))}\n    </select>\n  );\n}\n\n/**\n * The links one by one: what each refers to, its colour and the turns of its\n * ends, with buttons to add and remove links and to move through the networks.\n */\nexport function LinksTable({\n  links,\n  colors,\n  turns,\n  gaps,\n  style,\n  onGap,\n  onLinks,\n  onRemove,\n  onColor,\n  onTurn,\n  onStep,\n  onRandom,\n}) {\n  const { t } = useLang();\n  const n = links.length;\n  const start = t({ en: 'source', ru: 'начало' });\n  const end = t({ en: 'target', ru: 'конец' });\n  return (\n    <div className=\"links-table\">\n      <p className=\"network__lead\">\n        {t({\n          en: 'Each card contains all settings for one link. Empty gaps follow the global values shown in the fields. Reference gaps use layout units; middle cuts use 1/100 of the symbol.',\n          ru: 'В каждой карточке — все настройки одной связи. Пустые зазоры следуют общим значениям из подсказок. Зазоры ссылок — в единицах размещения, разрывы середины — в 1/100 символа.',\n        })}\n      </p>\n      <ul className=\"link-cards\" aria-label={t({ en: 'Link configurations', ru: 'Настройки связей' })}>\n        {links.map(([s, tg], i) => {\n          const name = `${t({ en: 'Link', ru: 'Связь' })} ${i + 1}`;\n          return (\n            <li className=\"link-card\" key={i}>\n              <div className=\"link-card__head\">\n                <h3>\n                  <span className=\"links-table__swatch\" style={{ background: colors[i] }} aria-hidden=\"true\" />\n                  {name}\n                </h3>\n                <button\n                  type=\"button\"\n                  className=\"button button--small\"\n                  disabled={n <= 1}\n                  onClick={() => onRemove(i + 1)}\n                  aria-label={`${t({ en: 'Remove', ru: 'Удалить' })}: ${name}`}\n                  title={t({\n                    en: 'References to this link become references to 0',\n                    ru: 'Ссылки на эту связь станут ссылками на 0',\n                  })}\n                >\n                  ✕\n                </button>\n              </div>\n              <div className=\"link-card__fields\">\n                {[\n                  [s, start, 'source'],\n                  [tg, end, 'target'],\n                ].map(([value, label, id], e) => (\n                  <label key={id} htmlFor={`link-${i + 1}-${id}`}>\n                    {t(e ? { en: 'Target', ru: 'Конец' } : { en: 'Source', ru: 'Начало' })}\n                    <ReferenceSelect\n                      id={`link-${i + 1}-${id}`}\n                      value={value}\n                      n={n}\n                      self={i + 1}\n                      label={`${name}: ${label}`}\n                      onChange={(ref) => onLinks(setReference(links, i, e, ref))}\n                    />\n                  </label>\n                ))}\n                <label>\n                  {t({ en: 'Colour', ru: 'Цвет' })}\n                  <input\n                    type=\"color\"\n                    value={colors[i]}\n                    aria-label={`${name}: ${t({ en: 'colour', ru: 'цвет' })}`}\n                    onChange={(event) => onColor(i, event.target.value)}\n                  />\n                </label>\n                {[0, 1].map((e) => (\n                  <label key={e}>\n                    {t(\n                      e\n                        ? { en: 'Turn of the target, °', ru: 'Поворот конца, °' }\n                        : { en: 'Turn of the source, °', ru: 'Поворот начала, °' },\n                    )}\n                    <input\n                      type=\"number\"\n                      className=\"mono\"\n                      min={-180}\n                      max={180}\n                      step={5}\n                      value={turns[i][e]}\n                      aria-label={`${name}: ${t({ en: 'turn of the', ru: 'поворот' })} ${e ? end : start}, °`}\n                      onChange={(event) => onTurn(i, e, Number(event.target.value) || 0)}\n                    />\n                  </label>\n                ))}\n              </div>\n              <NetworkGaps i={i} row={gaps[i]} style={style} onGap={onGap} />\n            </li>\n          );\n        })}\n      </ul>\n      <div className=\"network__actions\">\n        <button type=\"button\" className=\"button\" onClick={() => onLinks(addLink(links))}>\n          + {t({ en: 'Add a link', ru: 'Добавить связь' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(-1)}>\n          ← {t({ en: 'Previous network', ru: 'Предыдущая сеть' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(1)}>\n          {t({ en: 'Next network', ru: 'Следующая сеть' })} →\n        </button>\n        <button type=\"button\" className=\"button\" onClick={onRandom}>\n          {t({ en: 'Random network', ru: 'Случайная сеть' })}\n        </button>\n        <button\n          type=\"button\"\n          className=\"button\"\n          disabled={n > CANONICAL_UP_TO}\n          onClick={() => onLinks(decode(canonical(links)))}\n          title={t({\n            en: 'The same network with the links renamed so that its code is the smallest',\n            ru: 'Та же сеть, связи которой переименованы так, чтобы её код был наименьшим',\n          })}\n        >\n          {t({ en: 'Smallest renaming', ru: 'Наименьшее переименование' })}\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/** The network `step` positions after `links` among the networks of the same size (wrapping around). */\nexport function stepped(links, step) {\n  const n = links.length;\n  const count = countOf(n);\n  const index = (((BigInt(decimalOf(links)) + BigInt(step)) % count) + count) % count;\n  return parseIndex(index.toString(), n).links;\n}\n\n/** A random network of `n` links. */\nexport function randomLinks(n, random = Math.random) {\n  return Array.from({ length: n }, () => [Math.floor(random() * (n + 1)), Math.floor(random() * (n + 1))]);\n}\n","exit_code":0,"status":"completed"}}
