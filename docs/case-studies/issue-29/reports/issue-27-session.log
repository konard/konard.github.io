ks; the address keeps the network and every changed option (issue #17)\n7be35e9 Links networks: the notations of the editor (math notation of the theory, pairs with the base, the N-ary number and its decimal value, links notation) with parsers that explain errors in English and Russian; a checked style of the picture kept in the address; a standalone SVG of the picture with background, card, border, glow and caption; an experimental solver that turns the ends of links to reduce crossings and touching lines (507 of the 720 classes of 3 links get better, none worse); downloads, copies and share dialogs; tests (issue #17)\n// Every option of the picture of a network in the editor of /network/\n// (issue #17): the shape of the links (the angle at which a link leaves its\n// source and enters its target, its start, end and middle), the lines, the\n// colours, the background, the card around the symbol, a caption, the size of\n// the exported image and the experimental solver of overlaps.\n//\n// The fields reuse the helpers of the settings page (src/settings/fields.js).\n// A style is a flat object; `normalizeStyle` checks every value (it may come\n// from a shared link), and `styleToParams` / `styleFromParams` keep only the\n// values that differ from the defaults in the query string, so a shared link\n// opens exactly the picture that was shared.\nimport { color, option, range, select, toggle } from '../settings/fields';\nimport { COLORS, SHAPE } from './glyph';\nimport { GEOMETRY_SECTIONS } from './style-geometry';\nimport { linkGaps, normalizeGaps } from './gaps';\n\n/** Link colours: the site's, and a few more sets of nine. */\nexport const PALETTES = {\n  site: COLORS,\n  neon: ['#00f0ff', '#ff00e6', '#faff00', '#00ff85', '#ff6b00', '#8a5cff', '#ff2d55', '#00b3ff', '#c6ff00'],\n  pastel: ['#93c5fd', '#c4b5fd', '#f9a8d4', '#fde68a', '#a7f3d0', '#fed7aa', '#bae6fd', '#fecaca', '#d9f99d'],\n  warm: ['#f97316', '#ef4444', '#eab308', '#f43f5e', '#fb923c', '#facc15', '#dc2626', '#fbbf24', '#e11d48'],\n  cold: ['#06b6d4', '#3b82f6', '#8b5cf6', '#14b8a6', '#0ea5e9', '#6366f1', '#22d3ee', '#a78bfa', '#2dd4bf'],\n  // The light-theme link colours of src/index.css, for light backgrounds.\n  print: ['#0e7490', '#9333ea', '#db2777', '#b45309', '#047857', '#c2410c', '#1d4ed8', '#b91c1c', '#4d7c0f'],\n};\n\n/** Sections of the editor; each field is one option of the style. */\nexport const STYLE_SECTIONS = [\n  ...GEOMETRY_SECTIONS,\n  {\n    id: 'lines',\n    title: { en: 'Lines and colours', ru: 'Линии и цвета' },\n    fields: [\n      range('strokeWidth', 1.3, 0.5, 10, 0.1, { en: 'Line width', ru: 'Толщина линий' }),\n      select(\n        'dash',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('dashdot', 'Dash and dot', 'Штрих-пунктир'),\n          option('long', 'Long dashes', 'Длинные штрихи'),\n        ],\n        { en: 'Line style', ru: 'Стиль линий' },\n      ),\n      select(\n        'linecap',\n        'round',\n        [\n          option('round', 'Round', 'Круглые'),\n          option('butt', 'Flat', 'Плоские'),\n          option('square', 'Square', 'Квадратные'),\n        ],\n        { en: 'Line ends', ru: 'Концы линий' },\n      ),\n      select(\n        'linejoin',\n        'miter',\n        [\n          option('round', 'Round', 'Скруглённые'),\n          option('miter', 'Sharp', 'Острые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n        ],\n        { en: 'Corners', ru: 'Углы' },\n      ),\n      range('opacity', 1, 0.1, 1, 0.05, { en: 'Opacity', ru: 'Непрозрачность' }, { unit: '%' }),\n      range('glow', 0, 0, 12, 0.5, { en: 'Glow', ru: 'Свечение' }),\n      select(\n        'palette',\n        'site',\n        [\n          option('site', 'Site', 'Как на сайте'),\n          option('neon', 'Neon', 'Неон'),\n          option('pastel', 'Pastel', 'Пастель'),\n          option('warm', 'Warm', 'Тёплые'),\n          option('cold', 'Cold', 'Холодные'),\n          option('print', 'For light backgrounds', 'Для светлого фона'),\n          option('mono', 'One colour', 'Один цвет'),\n          option('custom', 'Own colour of each link', 'Свой цвет каждой связи'),\n        ],\n        { en: 'Colours of the links', ru: 'Цвета связей' },\n      ),\n      color(\n        'monoColor',\n        '#e6edf7',\n        { en: 'Colour of the links', ru: 'Цвет связей' },\n        {\n          when: (s) => s.palette === 'mono',\n        },\n      ),\n    ],\n  },\n  {\n    id: 'background',\n    title: { en: 'Background and card', ru: 'Фон и карточка' },\n    fields: [\n      select(\n        'background',\n        'solid',\n        [\n          option('transparent', 'Transparent', 'Прозрачный'),\n          option('solid', 'One colour', 'Один цвет'),\n          option('linear', 'Linear gradient', 'Линейный градиент'),\n          option('radial', 'Radial gradient', 'Радиальный градиент'),\n        ],\n        { en: 'Background', ru: 'Фон' },\n      ),\n      color(\n        'bgColor',\n        '#000000',\n        { en: 'Background colour', ru: 'Цвет фона' },\n        {\n          when: (s) => s.background !== 'transparent',\n        },\n      ),\n      color(\n        'bgColor2',\n        '#1e1b4b',\n        { en: 'Second colour', ru: 'Второй цвет' },\n        {\n          when: (s) => s.background === 'linear' || s.background === 'radial',\n        },\n      ),\n      range(\n        'bgAngle',\n        135,\n        0,\n        359,\n        1,\n        { en: 'Gradient angle', ru: 'Угол градиента' },\n        {\n          unit: '°',\n          when: (s) => s.background === 'linear',\n        },\n      ),\n      toggle('card', false, { en: 'Card around the symbol', ru: 'Карточка вокруг символа' }),\n      color('cardColor', '#0d1220', { en: 'Card colour', ru: 'Цвет карточки' }, { when: (s) => s.card }),\n      range(\n        'cardOpacity',\n        0.8,\n        0,\n        1,\n        0.05,\n        { en: 'Card opacity', ru: 'Непрозрачность карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n      select(\n        'borderStyle',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('double', 'Double', 'Двойная'),\n          option('none', 'No border', 'Без рамки'),\n        ],\n        { en: 'Border', ru: 'Рамка' },\n        { when: (s) => s.card },\n      ),\n      range(\n        'border',\n        0.6,\n        0.1,\n        6,\n        0.1,\n        { en: 'Border width', ru: 'Толщина рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      color(\n        'borderColor',\n        '#2b3b57',\n        { en: 'Border colour', ru: 'Цвет рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      range(\n        'radius',\n        10,\n        0,\n        50,\n        1,\n        { en: 'Corner radius', ru: 'Скругление углов' },\n        { unit: '%', when: (s) => s.card },\n      ),\n      range(\n        'inset',\n        3,\n        0,\n        30,\n        0.5,\n        { en: 'Space around the card', ru: 'Отступ вокруг карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n    ],\n  },\n  {\n    id: 'caption',\n    title: { en: 'Caption', ru: 'Подпись' },\n    fields: [\n      select('notation', 'L', [option('L', 'L → L²'), option('R', 'R → R²')], {\n        en: 'Theory notation',\n        ru: 'Нотация теории',\n      }),\n      select(\n        'caption',\n        'none',\n        [\n          option('none', 'None', 'Нет'),\n          option('theory', 'Math notation', 'Математическая нотация'),\n          option('pairs', 'Pairs with the base', 'Пары с основанием'),\n          option('number', 'N-ary number', 'N-ричное число'),\n          option('links', 'Links notation', 'Нотация связей'),\n          option('custom', 'Own text', 'Свой текст'),\n        ],\n        { en: 'Caption', ru: 'Подпись' },\n      ),\n      {\n        key: 'captionText',\n        type: 'text',\n        d: '',\n        max: 80,\n        label: { en: 'Text', ru: 'Текст' },\n        when: (s) => s.caption === 'custom',\n      },\n      color(\n        'captionColor',\n        '#7d8aa3',\n        { en: 'Caption colour', ru: 'Цвет подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      range(\n        'captionSize',\n        6,\n        3,\n        14,\n        0.5,\n        { en: 'Caption size', ru: 'Размер подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n// Real-browser geometry, keyboard and old bookmark regressions; finite fixtures.\n/* global document, Image, localStorage, KeyboardEvent */\nimport assert from 'node:assert/strict';\nimport { mkdir, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\nconst engine = process.env.ENGINE || 'chromium';\nconst output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-27/screenshots';\nconst data = process.env.RESULT_DIR || 'docs/case-studies/issue-27/data';\nawait mkdir(output, { recursive: true });\nawait mkdir(data, { recursive: true });\nconst server = await preview({ preview: { port: 4187, strictPort: true } });\nconst result = { engine, date: new Date().toISOString(), checks: [], errors: [] };\nlet browser;\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  result.version = browser.version();\n  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n  page.setDefaultTimeout(15000);\n  page.on('pageerror', (error) => result.errors.push(error.message));\n  await page.addInitScript(() => {\n    localStorage.setItem('theme', 'dark');\n    localStorage.setItem('lang', 'en');\n    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n  });\n  const go = async (query = '') => {\n    await page.goto(`http://localhost:4187/network/?code=1111&lang=en&rotation=-90&${query}`);\n    await page.locator('.network__preview svg').waitFor();\n  };\n  const shot = async (name, element = page.locator('.network__preview')) =>\n    element.screenshot({ path: join(output, `${engine}-after-${name}.png`) });\n  const manual = 'turns=0+0%2C-15+15&gaps=0.08+0.08+%7E+%7E%2C0.18+0.18+%7E+%7E';\n  await go(manual);\n  const initial = await page.locator('.network__preview').innerHTML();\n  await page.waitForURL((url) => url.searchParams.get('turns') === ',-15 15');\n  assert.equal(new URL(page.url()).searchParams.get('gaps'), '0.08 0.08,0.18 0.18');\n  assert.equal(await page.locator('.network__preview').innerHTML(), initial);\n  await page.reload();\n  assert.equal(await page.locator('.network__preview').innerHTML(), initial);\n  await shot('equal');\n  await page.locator('#links').scrollIntoViewIfNeeded();\n  await shot('editor', page);\n  result.checks.push('historical URL upgrades through history, compacts default rows, and reloads the exact SVG');\n\n  // Independent paint check: find nearest cyan pixels in narrow sectors around\n  // the opposite closed ends, excluding the central dot and crossing shaft.\n  result.paint = [];\n  for (const angle of [5, 15, 45, 85]) {\n    await go(`${manual}&endAngle=${angle}`);\n    const measurement = await page.locator('.network__preview svg').evaluate(async (svg) => {\n      const size = 2000;\n      const copy = svg.cloneNode(true);\n      copy.setAttribute('width', size);\n      copy.setAttribute('height', size);\n      const line = svg.querySelector('g[stroke] path');\n      const numbers = line\n        .getAttribute('d')\n        .match(/-?\\d+(?:\\.\\d+)?/g)\n        .map(Number);\n      const middle = numbers.slice(6, 8).map((v) => (v * size) / 100);\n      const starts = numbers.slice(0, 2).map((v) => (v * size) / 100);\n      const dir = starts.map((v, i) => v - middle[i]);\n      const length = Math.hypot(...dir);\n      const axis = dir.map((v) => v / length);\n      const image = new Image();\n      const url = URL.createObjectURL(new Blob([copy.outerHTML], { type: 'image/svg+xml' }));\n      try {\n        image.src = url;\n        await image.decode();\n        const canvas = document.createElement('canvas');\n        canvas.width = canvas.height = size;\n        const ctx = canvas.getContext('2d');\n        ctx.drawImage(image, 0, 0);\n        const pixels = ctx.getImageData(0, 0, size, size).data;\n        const nearest = [Infinity, Infinity];\n        for (let y = 0; y < size; y++)\n          for (let x = 0; x < size; x++) {\n            const p = (y * size + x) * 4;\n            if (!(pixels[p + 2] > 40 && pixels[p] < pixels[p + 2] * 0.3 && pixels[p + 1] > pixels[p + 2] * 0.7))\n              continue;\n            const dx = x + 0.5 - middle[0];\n            const dy = y + 0.5 - middle[1];\n            const radius = Math.hypot(dx, dy);\n            const projection = dx * axis[0] + dy * axis[1];\n            if (radius > (2.5 * size) / 100 && Math.abs(projection) / radius > 0.99)\n              nearest[projection > 0 ? 0 : 1] = Math.min(nearest[projection > 0 ? 0 : 1], (radius * 100) / size);\n          }\n        return { nearest, size };\n      } finally {\n        URL.revokeObjectURL(url);\n      }\n    });\n    assert(measurement.nearest.every(Number.isFinite));\n    assert(Math.abs(measurement.nearest[0] - measurement.nearest[1]) < 0.12, JSON.stringify({ angle, measurement }));\n    result.paint.push({ angle, ...measurement });\n  }\n  result.checks.push('native rasterized closed gaps agree within 0.12 image units at 5°, 15°, 45°, 85°');\n  await go('solve=true');\n  await shot('auto');\n  const preview = await page.locator('.network__preview').innerHTML();\n  await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n  for (const name of ['Gap at the source reference', 'Gap at the target reference']) {\n    assert.equal(await page.getByLabel(`Link 1: ${name}`, { exact: true }).inputValue(), '');\n    assert(Number(await page.getByLabel(`Link 2: ${name}`, { exact: true }).inputValue()) > 0.08);\n  }\n  assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n  await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n  assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n  result.checks.push(\n    'automatic spacing preserves the closed link, changes open references, and applies/shares/reloads exactly',\n  );\n\n  await go(manual);\n  const gap = page.getByLabel('Link 1: Gap at the target reference', { exact: true });\n  await gap.fill('0.07');\n  await gap.press('ArrowUp');\n  assert.equal(await gap.inputValue(), '0.08');\n  await gap.press('ArrowDown');\n  assert.equal(await gap.inputValue(), '0.07');\n  // Native stepUp/Down use the same HTML constraints as the spinner buttons.\n  for (const [method, expected] of [\n    ['stepUp', '0.08'],\n    ['stepDown', '0.07'],\n  ]) {\n    await gap.evaluate((input, method) => {\n      input[method]();\n      input.dispatchEvent(new Event('input', { bubbles: true }));\n    }, method);\n    assert.equal(await gap.inputValue(), expected);\n  }\n  await gap.fill('');\n  await gap.press('ArrowUp');\n  assert.equal(await gap.inputValue(), '0.09');\n  const turn = page.getByLabel('Link 2: turn of the source, °', { exact: true });\n  await turn.fill('');\n  await turn.pressSequentially('-25');\n  assert.equal(await turn.inputValue(), '-25');\n  await turn.press('ControlOrMeta+A');\n  await turn.press('Backspace');\n  assert.equal(await turn.inputValue(), '');\n  await turn.pressSequentially('-15');\n  await turn.press('Tab');\n  assert.equal(await turn.inputValue(), '-15');\n  await gap.fill('0.07');\n  await gap.press('Home');\n  assert.equal(await gap.inputValue(), '0.07');\n  result.checks.push(\n    '0.07↔0.08 arrows/native stepping, inherited decimal steps, negative typing, select-all, delete, Home and Tab',\n  );\n\n  console.log('Geometry, URL and number editing checks passed. Auditing sliders.');\n  const audit = async (selector) => {\n    const controls = await page\n      .locator(selector)\n      .evaluateAll((inputs) =>\n        inputs.map((input) => ({\n          id: input.id,\n          min: +input.min,\n          max: +input.max,\n          step: +input.step,\n          value: +input.value,\n        })),\n      );\n    for (const control of controls) {\n      console.log(`Keyboard: ${control.id}`);\n      const input = page.locator(`[id=\"${control.id}\"]`);\n      let current = control.value;\n      for (const [key, count] of [\n        ['ArrowUp', 1],\n        ['ArrowDown', -1],\n        ['ArrowRight', 1],\n        ['ArrowLeft', -1],\n        ['PageUp', 10],\n        ['PageDown', -10],\n        ['Home', 0],\n        ['End', 0],\n      ]) {\n        const expected =\n          key === 'Home'\n            ? control.min\n            : key === 'End'\n              ? control.max\n              : Math.min(control.max, Math.max(control.min, current + count * control.step));\n        await input.press(key);\n        current = Number(await input.inputValue());\n        assert(Math.abs(current - expected) < 1e-8, JSON.stringify({ control, key, current, expected }));\n      }\n    }\n    return controls.map((control) => control.id);\n  };\n  await go('');\n  result.networkRanges = await audit('input[type=\"range\"]');\n  await page.goto('http://localhost:4187/settings/?lang=en');\n  result.settingsRanges = await audit('input[type=\"range\"]');\n  result.checks.push(\n    `all ${result.networkRanges.length} rendered network and ${result.settingsRanges.length} settings sliders support all eight navigation keys`,\n  );\n  assert.deepEqual(result.errors, []);\n  console.log(JSON.stringify(result.checks, null, 2));\n} finally {\n  await writeFile(join(data, `${engine}-browser.json`), JSON.stringify(result, null, 2));\n  await browser?.close();\n  await server.httpServer.close();\n}\nsrc/pages/useNetworkHistory.js:14:const continuous = (target) => target?.matches?.('input[type=\"range\"], input[type=\"color\"]');\nsrc/pages/NetworkStyle.jsx:45:        type=\"range\"\nsrc/sound/sound.test.jsx:301:    expect(clickEvent(element('<input type=\"range\">'))).toBe(null);\nsrc/sound/sound.test.jsx:321:      <input id=\"r\" type=\"range\"><input id=\"t\" type=\"text\"><select id=\"s\"><option>1</option></select>\nsrc/pages/SettingsPage.jsx:40:        type=\"range\"\nsrc/components/NumberInput.jsx:17:      type=\"number\"\nsrc/sound/interactions.js:74:        if (target?.matches?.('input[type=\"range\"]')) play('select', 70);\nsrc/pages/network-27.test.jsx:45:  const input = screen.getByLabelText('Gap at the target reference', { selector: 'input[type=\"range\"]' });\n(!) Your Vite config uses features that are unsupported by `configLoader: 'native'`, which is planned to become the default in a future major version of Vite:\n  - import \"./fields\" without a file extension (src/settings/schema.js:15:32). Add the file extension\n  - import \"./schema.background\" without a file extension (src/settings/schema.js:16:37). Add the file extension\n  - import \"./schema.layers\" without a file extension (src/settings/schema.js:17:32). Add the file extension\n  - import \"./schema.skins\" without a file extension (src/settings/schema.js:18:31). Add the file extension\n  - import \"./schema.sound\" without a file extension (src/settings/schema.js:19:31). Add the file extension\n  - import \"./schema.skins\" without a file extension (src/settings/schema.js:21:33). Add the file extension\n  - import \"./fields\" without a file extension (src/settings/schema.sound.js:7:47). Add the file extension\n  - im