[2026-10-27T19:54:05.824Z] [STDOUT] {"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'cat src/pages/NetworkEditor.jsx && cat src/pages/NetworkPage.jsx'","aggregated_output":"import { useState } from 'react';\nimport NetworkGaps from './NetworkGaps';\nimport { canonical, decode, encode, mathNotation } from '../links/configurations';\nimport {\n  addLink,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  setReference,\n  signatureOf,\n  theoryNotation,\n} from '../links/edit';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from '../components/format';\n\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\", \"one of N networks\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst OF_NETWORKS = { en: ['network', 'networks'], ru: ['сети', 'сетей', 'сетей'] };\n// Finding the smallest renaming tries every order of the links: n! of them.\nconst CANONICAL_UP_TO = 7;\n\n/**\n * One editable notation. While it is typed in, the text stays as it is typed;\n * every valid text changes the network at once, and an invalid one shows why.\n * When the network is changed elsewhere, the field shows the new network.\n */\nfunction NotationField({ id, label, hint, value, parse, format, onLinks, multiline = false }) {\n  const { t } = useLang();\n  const [draft, setDraft] = useState(null);\n  // A draft belongs to the value it was typed against (or the value it produced).\n  const active = draft && draft.at === value;\n  const text = active ? draft.text : value;\n  const error = active ? draft.error : null;\n  const change = (event) => {\n    const next = event.target.value;\n    const result = parse(next);\n    if (result.links) {\n      setDraft({ text: next, at: format(result.links), error: null });\n      onLinks(result.links);\n    } else setDraft({ text: next, at: value, error: result.error });\n  };\n  const Input = multiline ? 'textarea' : 'input';\n  return (\n    <div className={`notation${error ? ' is-invalid' : ''}`}>\n      <label htmlFor={id}>{t(label)}</label>\n      <Input\n        id={id}\n        className=\"mono\"\n        value={text}\n        onChange={change}\n        onBlur={() => active && !error && setDraft(null)}\n        spellCheck=\"false\"\n        autoComplete=\"off\"\n        aria-invalid={error ? 'true' : undefined}\n        aria-describedby={`${id}-note`}\n        rows={multiline ? 2 : undefined}\n      />\n      <small\n        id={`${id}-note`}\n        className={error ? 'notation__error' : 'notation__hint'}\n        role={error ? 'alert' : undefined}\n      >\n        {error ? t(error) : t(hint)}\n      </small>\n    </div>\n  );\n}\n\n/** The four editable notations of the network (issue #17). */\nexport function Notations({ links, notation, onLinks }) {\n  const { lang, t } = useLang();\n  const n = links.length;\n  const count = countOf(n);\n  return (\n    <div className=\"notations\">\n      <p className=\"muted\">\n        {t({\n          en: `${n} ${plural(n, lang, LINKS)} after the zero link 0, in a doublet network ${signatureOf(notation)}: one of ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} of ${n} ${plural(n, lang, OF_LINKS)}, written with ${2 * n} digits in base ${n + 1}. Every notation below can be edited; the others follow.`,\n          ru: `${n} ${plural(n, lang, LINKS)} после нулевой связи 0 в дуплетной сети ${signatureOf(notation)}: одна из ${formatNumber(count, lang)} ${plural(Number(count), lang, OF_NETWORKS)} из ${n} ${plural(n, lang, OF_LINKS)}, записанная ${2 * n} цифрами в системе с основанием ${n + 1}. Любую запись ниже можно изменить, остальные изменятся вслед за ней.`,\n        })}\n      </p>\n      <NotationField\n        id=\"notation-theory\"\n        label={{ en: 'Math notation (the links theory)', ru: 'Математическая нотация (теория связей)' }}\n        hint={{\n          en: 'The function of the network: link ↦ (source, target). The names may be left out.',\n          ru: 'Функция сети: связь ↦ (начало, конец). Имена связей можно не писать.',\n        }}\n        value={theoryNotation(links, notation)}\n        format={(l) => theoryNotation(l, notation)}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-pairs\"\n        label={{ en: 'Pairs with the base', ru: 'Пары с основанием' }}\n        hint={{\n          en: 'Source and target of each link as two digits (use (source,target) with a base for 10+ links), as under the symbols of the gallery.',\n          ru: 'Начало и конец каждой связи двумя цифрами (для 10+ связей — (начало,конец) с основанием), как под символами галереи.',\n        }}\n        value={mathNotation(encode(links))}\n        format={(l) => mathNotation(encode(l))}\n        parse={parseMath}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-number\"\n        label={{ en: 'N-ary number', ru: 'N-ричное число' }}\n        hint={{\n          en: `The whole network as one number of ${2 * n} digits in base ${n + 1}; for 10+ links use space-separated digits in [brackets].`,\n          ru: `Вся сеть как одно число из ${2 * n} цифр в системе с основанием ${n + 1}; для 10+ связей разделяйте цифры пробелами в [скобках].`,\n        }}\n        value={numberNotation(links)}\n        format={numberNotation}\n        parse={parseNumber}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-decimal\"\n        label={{ en: 'The same number in decimal', ru: 'То же число в десятичной системе' }}\n        hint={{\n          en: `The position of the network among all networks of ${n} ${plural(n, lang, LINKS)}, from 0 to ${count - 1n}.`,\n          ru: `Номер сети среди всех сетей из ${n} ${plural(n, lang, OF_LINKS)}, от 0 до ${count - 1n}.`,\n        }}\n        value={decimalOf(links)}\n        format={decimalOf}\n        parse={(text) => parseIndex(text, n)}\n        onLinks={onLinks}\n      />\n      <NotationField\n        id=\"notation-links\"\n        label={{ en: 'Links notation', ru: 'Нотация связей' }}\n        hint={{\n          en: '(index: source target) for each link; 0 is nothing.',\n          ru: '(индекс: начало конец) для каждой связи; 0 — это «ничего».',\n        }}\n        value={linksText(links)}\n        format={(l) => linksText(l)}\n        parse={parseLinks}\n        onLinks={onLinks}\n        multiline\n      />\n    </div>\n  );\n}\n\n/** A choice of the link that an end refers to: 0 (nothing), the link itself or another link. */\nfunction ReferenceSelect({ id, value, n, self, onChange, label }) {\n  const { t } = useLang();\n  // Avoid two n-option selects per row (quadratic DOM size) on large networks.\n  if (n > 50)\n    return (\n      <input\n        id={id}\n        type=\"number\"\n        min={0}\n        max={n}\n        step={1}\n        value={value}\n        aria-label={label}\n        onChange={(event) => {\n          const ref = Number(event.target.value);\n          if (event.target.value !== '' && Number.isInteger(ref) && ref >= 0 && ref <= n) onChange(ref);\n        }}\n      />\n    );\n  return (\n    <select id={id} value={value} onChange={(event) => onChange(Number(event.target.value))} aria-label={label}>\n      {Array.from({ length: n + 1 }, (_, ref) => (\n        <option key={ref} value={ref}>\n          {ref}\n          {ref === 0\n            ? ` — ${t({ en: 'nothing', ru: 'ничего' })}`\n            : ref === self\n              ? ` — ${t({ en: 'itself', ru: 'сама' })}`\n              : ''}\n        </option>\n      ))}\n    </select>\n  );\n}\n\n/**\n * The links one by one: what each refers to, its colour and the turns of its\n * ends, with buttons to add and remove links and to move through the networks.\n */\nexport function LinksTable({\n  links,\n  colors,\n  turns,\n  gaps,\n  style,\n  onGap,\n  onLinks,\n  onRemove,\n  onColor,\n  onTurn,\n  onStep,\n  onRandom,\n}) {\n  const { t } = useLang();\n  const n = links.length;\n  const start = t({ en: 'source', ru: 'начало' });\n  const end = t({ en: 'target', ru: 'конец' });\n  return (\n    <div className=\"links-table\">\n      <p className=\"network__lead\">\n        {t({\n          en: 'Each card contains all settings for one link. Empty gaps follow the global values shown in the fields. Reference gaps use layout units; middle cuts use 1/100 of the symbol.',\n          ru: 'В каждой карточке — все настройки одной связи. Пустые зазоры следуют общим значениям из подсказок. Зазоры ссылок — в единицах размещения, разрывы середины — в 1/100 символа.',\n        })}\n      </p>\n      <ul className=\"link-cards\" aria-label={t({ en: 'Link configurations', ru: 'Настройки связей' })}>\n        {links.map(([s, tg], i) => {\n          const name = `${t({ en: 'Link', ru: 'Связь' })} ${i + 1}`;\n          return (\n            <li className=\"link-card\" key={i}>\n              <div className=\"link-card__head\">\n                <h3>\n                  <span className=\"links-table__swatch\" style={{ background: colors[i] }} aria-hidden=\"true\" />\n                  {name}\n                </h3>\n                <button\n                  type=\"button\"\n                  className=\"button button--small\"\n                  disabled={n <= 1}\n                  onClick={() => onRemove(i + 1)}\n                  aria-label={`${t({ en: 'Remove', ru: 'Удалить' })}: ${name}`}\n                  title={t({\n                    en: 'References to this link become references to 0',\n                    ru: 'Ссылки на эту связь станут ссылками на 0',\n                  })}\n                >\n                  ✕\n                </button>\n              </div>\n              <div className=\"link-card__fields\">\n                {[\n                  [s, start, 'source'],\n                  [tg, end, 'target'],\n                ].map(([value, label, id], e) => (\n                  <label key={id} htmlFor={`link-${i + 1}-${id}`}>\n                    {t(e ? { en: 'Target', ru: 'Конец' } : { en: 'Source', ru: 'Начало' })}\n                    <ReferenceSelect\n                      id={`link-${i + 1}-${id}`}\n                      value={value}\n                      n={n}\n                      self={i + 1}\n                      label={`${name}: ${label}`}\n                      onChange={(ref) => onLinks(setReference(links, i, e, ref))}\n                    />\n                  </label>\n                ))}\n                <label>\n                  {t({ en: 'Colour', ru: 'Цвет' })}\n                  <input\n                    type=\"color\"\n                    value={colors[i]}\n                    aria-label={`${name}: ${t({ en: 'colour', ru: 'цвет' })}`}\n                    onChange={(event) => onColor(i, event.target.value)}\n                  />\n                </label>\n                {[0, 1].map((e) => (\n                  <label key={e}>\n                    {t(\n                      e\n                        ? { en: 'Turn of the target, °', ru: 'Поворот конца, °' }\n                        : { en: 'Turn of the source, °', ru: 'Поворот начала, °' },\n                    )}\n                    <input\n                      type=\"number\"\n                      className=\"mono\"\n                      min={-180}\n                      max={180}\n                      step={5}\n                      value={turns[i][e]}\n                      aria-label={`${name}: ${t({ en: 'turn of the', ru: 'поворот' })} ${e ? end : start}, °`}\n                      onChange={(event) => onTurn(i, e, Number(event.target.value) || 0)}\n                    />\n                  </label>\n                ))}\n              </div>\n              <NetworkGaps i={i} row={gaps[i]} style={style} onGap={onGap} />\n            </li>\n          );\n        })}\n      </ul>\n      <div className=\"network__actions\">\n        <button type=\"button\" className=\"button\" onClick={() => onLinks(addLink(links))}>\n          + {t({ en: 'Add a link', ru: 'Добавить связь' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(-1)}>\n          ← {t({ en: 'Previous network', ru: 'Предыдущая сеть' })}\n        </button>\n        <button type=\"button\" className=\"button\" onClick={() => onStep(1)}>\n          {t({ en: 'Next network', ru: 'Следующая сеть' })} →\n        </button>\n        <button type=\"button\" className=\"button\" onClick={onRandom}>\n          {t({ en: 'Random network', ru: 'Случайная сеть' })}\n        </button>\n        <button\n          type=\"button\"\n          className=\"button\"\n          disabled={n > CANONICAL_UP_TO}\n          onClick={() => onLinks(decode(canonical(links)))}\n          title={t({\n            en: 'The same network with the links renamed so that its code is the smallest',\n            ru: 'Та же сеть, связи которой переименованы так, чтобы её код был наименьшим',\n          })}\n        >\n          {t({ en: 'Smallest renaming', ru: 'Наименьшее переименование' })}\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/** The network `step` positions after `links` among the networks of the same size (wrapping around). */\nexport function stepped(links, step) {\n  const n = links.length;\n  const count = countOf(n);\n  const index = (((BigInt(decimalOf(links)) + BigInt(step)) % count) + count) % count;\n  return parseIndex(index.toString(), n).links;\n}\n\n/** A random network of `n` links. */\nexport function randomLinks(n, random = Math.random) {\n  return Array.from({ length: n }, () => [Math.floor(random() * (n + 1)), Math.floor(random() * (n + 1))]);\n}\nimport { useEffect, useMemo, useState } from 'react';\nimport './settings.css';\nimport './network.css';\nimport Layout from '../components/Layout';\nimport { decode, encode, mathNotation } from '../links/configurations';\nimport { solveCollisions } from '../links/collisions';\nimport { linkGaps, withGaps } from '../links/gaps';\nimport { parseCode, removeLink, theoryNotation } from '../links/edit';\nimport { networkSvg } from '../links/render';\nimport {\n  linkColors,\n  linkTurns,\n  normalizeStyle,\n  shapeOfStyle,\n  styleFromParams,\n  styleToParams,\n  withColor,\n  withTurns,\n} from '../links/style';\nimport { LANGS, useLang } from '../i18n/prefs';\nimport { LinksTable, Notations, randomLinks, stepped } from './NetworkEditor';\nimport NetworkShare from './NetworkShare';\nimport { Looks, StyleSections } from './NetworkStyle';\nimport { useNetworkHistory } from './useNetworkHistory';\n\n/** The network of the theory's example: two points and the link between them. */\nexport const DEFAULT_CODE = '11 22 12';\n\nconst SECTIONS = [\n  ['notations', { en: 'Notations', ru: 'Нотации' }],\n  ['links', { en: 'Links', ru: 'Связи' }],\n  ['style', { en: 'Style', ru: 'Оформление' }],\n  ['share', { en: 'Share', ru: 'Поделиться' }],\n];\n\n/** The network and the style of the picture in a query string (?code=112212&end=dot…). */\nexport function readNetwork(search) {\n  const params = new URLSearchParams(search);\n  const code = parseCode(params.get('code') || '') || DEFAULT_CODE;\n  return { links: decode(code), style: styleFromParams(params) };\n}\n\n/** \"?code=112212&…\": non-default image options and the explicit page language, if present. */\nexport function networkQuery(links, style, lang = null) {\n  const params = styleToParams(style);\n  if (LANGS.includes(lang)) params.set('lang', lang);\n  return `?code=${encode(links).replace(/ /g, '')}${params.size ? `&${params}` : ''}`;\n}\n\n/** The page of one network (issue #17): view it, edit it in every notation, style its picture and share it. */\nexport default function NetworkPage() {\n  const { t } = useLang();\n  const [initial] = useState(() => readNetwork(window.location.search));\n  const [links, setLinks] = useState(initial.links);\n  const [style, setStyleState] = useState(initial.style);\n  const notation = style.notation;\n  const setStyle = (next) => setStyleState(normalizeStyle(next));\n  const n = links.length;\n  const code = encode(links);\n  const query = networkQuery(links, style, new URLSearchParams(window.location.search).get('lang'));\n\n  useNetworkHistory(query);\n  // Existing links may open a section directly, such as /network/?code=…#share.\n  useEffect(() => {\n    const target = window.location.hash && document.getElementById(window.location.hash.slice(1));\n    target?.scrollIntoView?.();\n  }, []);\n\n  const shape = shapeOfStyle(style, n);\n  const solverOptions = {\n    debug: style.solveDebug,\n    range: style.solveRange,\n    step: style.solveStep,\n    adjustGaps: style.solveGaps,\n    gapRange: style.solveGapRange,\n    middleRange: style.solveMiddleRange,\n  };\n  const shapeKey = JSON.stringify([code, shape, solverOptions]);\n  // The experimental solver of overlaps; it runs only when it is switched on or asked for.\n  const solved = useMemo(\n    () => (style.solve ? solveCollisions(links, shape, solverOptions) : null),\n    // shapeKey stands for links, shape and the options of the solver.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n    [shapeKey, style.solve],\n  );\n  const svg = useMemo(\n    () => networkSvg(links, style, { notation, extraTurns: solved?.delta, extraGaps: solved?.linkGaps }),\n    [links, style, notation, solved],\n  );\n  const colors = linkColors(style, n);\n  const turns = linkTurns(style, n);\n  const gaps = linkGaps(style, n);\n\n  const changeLinks = (next) => setLinks(next);\n  const remove = (k) => {\n    const keep = (list) => list.filter((_, i) => i !== k - 1);\n    setLinks(removeLink(links, k));\n    let next = withTurns(style, keep(linkTurns(style, n)));\n    next = withGaps(next, keep(gaps));\n    if (style.palette === 'custom') next = { ...next, colors: keep(linkColors(style, n)).join(',') };\n    setStyle(next);\n  };\n  const turn = (i, end, value) =>\n    setStyle(\n      withTurns(\n        style,\n        turns.map((pair, k) => (k === i ? pair.map((a, e) => (e === end ? value : a)) : pair)),\n      ),\n    );\n  const applySolved = () => {\n    const found = solved || solveCollisions(links, shape, solverOptions);\n    setStyle({ ...withGaps(withTurns(style, found.turns), found.linkGaps), solve: false });\n  };\n\n  const url = `${window.location.origin}/network/${query}`;\n  const text = `${t({ en: 'Links network', ru: 'Сеть связей' })} ${mathNotation(code)}: ${theoryNotation(links, notation)}`;\n\n  return (\n    <Layout page=\"network\" sections={SECTIONS}>\n      <section className=\"section network\" id=\"top\">\n        <h1 className=\"section__title\">\n          {t({ en: 'Links network', ru: 'Сеть связей' })}{' '}\n          <span className=\"mono network__code\">{mathNotation(code)}</span>\n        </h1>\n        <p className=\"section__lead\">\n          {t({\n            en: 'One network of doublet links: change it in any notation or link by link, change every detail of its picture and save or share it. The address of the page keeps everything, so a link opens exactly this picture.',\n            ru: 'Одна сеть дуплетных связей: меняйте её в любой нотации или по одной связи, меняйте каждую деталь её картинки, сохраняйте и делитесь. Адрес страницы хранит всё, поэтому ссылка открывает ровно эту картинку.',\n          })}{' '}\n          <a href=\"/art/#symbols\">{t({ en: 'All networks of 1–4 links', ru: 'Все сети из 1–4 связей' })}</a>\n        </p>\n        <div className=\"network__layout\">\n          <figure className=\"network__view\">\n            <div\n              className={`network__preview${style.background === 'transparent' ? ' is-transparent' : ''}`}\n              style={{ aspectRatio: `${style.width} / ${style.height}` }}\n              // The SVG names itself (role img, aria-label). It is built from normalized\n              // options only and its caption is escaped (src/links/render.js).\n              dangerouslySetInnerHTML={{ __html: svg }}\n            />\n            <figcaption className=\"mono\">\n              {theoryNotation(links, notation)}\n              {solved && (\n                <span className=\"network__score\">\n                  {' · '}\n                  {t({ en: 'overlaps', ru: 'наложения' })} {solved.before.toFixed(1)} → {solved.after.toFixed(1)}\n                </span>\n              )}\n            </figcaption>\n          </figure>\n          <div className=\"network__panels\">\n            <section id=\"notations\" className=\"network__panel\" aria-labelledby=\"notations-title\">\n              <h2 id=\"notations-title\">{t({ en: 'Notations', ru: 'Нотации' })}</h2>\n              <Notations links={links} notation={notation} onLinks={changeLinks} />\n            </section>\n            <section id=\"links\" className=\"network__panel\" aria-labelledby=\"links-title\">\n              <h2 id=\"links-title\">{t({ en: 'Links', ru: 'Связи' })}</h2>\n              <LinksTable\n                links={links}\n                colors={colors}\n                turns={turns}\n                gaps={gaps}\n                style={style}\n                onGap={(i, k, value) =>\n                  setStyle(\n                    withGaps(\n                      style,\n                      gaps.map((row, j) => (j === i ? row.map((v, column) => (column === k ? value : v)) : row)),\n                    ),\n                  )\n                }\n                onLinks={changeLinks}\n                onRemove={remove}\n                onColor={(i, value) => setStyle(withColor(style, n, i, value))}\n                onTurn={turn}\n                onStep={(step) => setLinks(stepped(links, step))}\n                onRandom={() => setLinks(randomLinks(n))}\n              />\n            </section>\n            <section className=\"network__panel\" id=\"style\" aria-labelledby=\"style-title\">\n              <h2 id=\"style-title\">{t({ en: 'Style of the picture', ru: 'Оформление картинки' })}</h2>\n              <p className=\"network__lead\">\n                {t({\n                  en: 'Start from a look and change any detail. A card like in the gallery, or no card at all and only the lines on a black or transparent background: both are here.',\n                  ru: 'Начните с готового оформления и меняйте любую деталь. Карточка как в галерее или без карточки, только линии на чёрном или прозрачном фоне: есть и то, и другое.',\n                })}\n              </p>\n              <Looks style={style} onStyle={setStyle} />\n              <div className=\"network__styles\">\n                <StyleSections links={links} style={style} onStyle={setStyle}>\n                  <div className=\"network__actions\">\n                    <button type=\"button\" className=\"button button--small\" onClick={applySolved}>\n                      {t({ en: 'Apply turns and gaps to links', ru: 'Применить повороты и зазоры связей' })}\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"button button--small\"\n                      disabled={!style.turns}\n                      onClick={() => setStyle({ ...style, turns: '' })}\n                    >\n                      {t({ en: 'Clear all turns', ru: 'Убрать все повороты' })}\n                    </button>\n                  </div>\n                </StyleSections>\n              </div>\n            </section>\n            <section id=\"share\" className=\"network__panel\" aria-labelledby=\"share-title\">\n              <h2 id=\"share-title\">{t({ en: 'Save and share', ru: 'Сохранить и поделиться' })}</h2>\n              <NetworkShare code={code} links={links} svg={svg} style={style} url={url} text={text} />\n            </section>\n          </div>\n        </div>\n      </section>\n    </Layout>\n  );\n}\n","exit_code":0,"status":"completed"}}
