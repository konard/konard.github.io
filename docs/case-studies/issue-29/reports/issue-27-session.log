[2026-10-27T20:05:39.411Z] [STDOUT] {"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"cat > src/components/numericKeys.test.js <<'EOF'\nimport { expect, it, vi } from 'vitest';\nimport { numericKey } from './numericKeys';\nimport { STYLE_FIELDS } from '../links/style';\nimport { FIELDS } from '../settings/schema';\n\nconst key = (input, name, modifiers = {}, fallback = 0) => {\n  const change = vi.fn();\n  const event = { currentTarget: input, key: name, preventDefault: vi.fn(), ...modifiers };\n  numericKey(event, change, fallback);\n  return { value: change.mock.calls[0]?.[0], prevented: event.preventDefault.mock.calls.length > 0 };\n};\nit('steps off-grid typed numbers to the next valid decimal instead of accumulating a step mismatch', () => {\n  const input = Object.assign(document.createElement('input'), { type: 'number', min: '0', max: '1', step: '0.01', value: '0.075' });\n  expect(key(input, 'ArrowUp').value).toBe(0.08);\n  expect(key(input, 'ArrowDown').value).toBe(0.07);\n  expect(key(input, 'PageUp').value).toBe(0.17);\n  input.value = '';\n  expect(key(input, 'ArrowUp', {}, 0.08).value).toBe(0.09);\n  expect(key(input, 'ArrowUp', { shiftKey: true }, 0.08).value).toBe(0.18);\n  for (const name of ['ArrowLeft', 'ArrowRight', 'Home', 'End', 'Tab', 'Backspace', 'Delete', 'Escape', 'Enter'])\n    expect(key(input, name).prevented).toBe(false);\n  for (const modifier of ['ctrlKey', 'metaKey', 'altKey'])\n    expect(key(input, 'ArrowUp', { [modifier]: true }).prevented).toBe(false);\n});\nit('supports all eight navigation keys at valid limits for every slider schema, including conditional controls', () => {\n  for (const field of [...STYLE_FIELDS, ...FIELDS].filter((field) => field.type === 'range' && field.step)) {\n    const input = Object.assign(document.createElement('input'), {\n      type: 'range', min: String(field.min), max: String(field.max), step: String(field.step), value: String(field.d),\n    });\n    for (const name of ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End']) {\n      const { value, prevented } = key(input, name);\n      expect(prevented, \"'`${field.key}: ${name}`).toBe(true);\n      expect(value, field.key).toBeGreaterThanOrEqual(field.min);\n      expect(value, field.key).toBeLessThanOrEqual(field.max);\n      expect(Number.isFinite(value), field.key).toBe(true);\n    }\n    input.value = String(field.min);\n    expect(key(input, '\"'ArrowDown').value).toBe(field.min);\n    input.value = String(field.max);\n    expect(key(input, 'ArrowUp').value).toBe(field.max);\n  }\n});\nEOF\ncat > src/links/url-history-27.test.js <<'EOF'\nimport { readFileSync } from 'node:fs';\nimport { expect, it } from 'vitest';\nimport { STYLE_FIELDS, normalizeStyle, styleFromParams, styleToParams } from './style';\n\nconst history = JSON.parse(readFileSync(new URL('../../docs/case-studies/issue-27/data/url-schema-history.json', import.meta.url), 'utf8'));\nit.each(history)('retains every URL field and option from published schema \"'$sha'\"', ({ fields }) => {\n  for (const field of fields) {\n    const current = STYLE_FIELDS.find(({ key }) => key === field.key);\n    expect(current, field.key).toBeDefined();\n    const values = field.type === 'range' ? [field.min, field.d, field.max] : field.type === 'select' ? field.options : field.type === 'toggle' ? [false, true] : [field.d];\n    for (const value of values) {\n      const params = new URLSearchParams({ [field.key]: String(value) });\n      const style = styleFromParams(params);\n      expect(style[field.key], \"'`${field.key}=${value}`).toEqual(normalizeStyle({ [field.key]: value })[field.key]);\n      if (field.type !== '\"'list') expect(style[field.key], field.key).toEqual(value);\n      expect(styleFromParams(styleToParams(style)), \"'`${field.key}=${value}`).toEqual(style);\n    }\n  }\n});\nit('\"'preserves legacy gap aliases, explicit colors and empty rows without moving subsequent link indices', () => {\n  const old = styleFromParams(new URLSearchParams('gap=0.2&endGap=0.3&colors=%23ABCDEF,%23123456&turns=0+0,0+0,15+-15&gaps=~+~+~+~,~+0+~+~,0.18+0.18+~+~'));\n  expect(old.startGap).toBe(0.2);\n  expect(old.endGap).toBe(0.3);\n  expect(old.palette).toBe('custom');\n  expect(old.colors).toBe('#abcdef,#123456');\n  const params = styleToParams(old);\n  expect(params.get('turns')).toBe(',,15 -15');\n  expect(params.get('gaps')).toBe(',~ 0,0.18 0.18');\n  expect(styleFromParams(params)).toEqual(old);\n});\nEOF\nnode - <<'JS'\nconst fs = require('fs');\nconst p = JSON.parse(fs.readFileSync('package.json'));\np.scripts['test:network:issue27'] = 'node experiments/issue-27-browser.mjs';\nfs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\\\\n');\nconst file = '.github/workflows/github-pages.yml';\nconst s = fs.readFileSync(file, 'utf8');\nfs.writeFileSync(file, s.replace('      - name: Preserve browser evidence', \"'`      - name: Verify equal closed gaps, historical URLs and numeric keyboard controls\n        if: '\"\\\\\"'${{ !cancelled() && steps.browser.outcome == '\"'success' }}\n        run: npm run test:network:issue27\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue27\n          RESULT_DIR: browser-results/data/issue27\n\n      - name: Preserve browser evidence\"'`));\nJS'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
