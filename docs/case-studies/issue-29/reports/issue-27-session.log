= STORAGE_KEY || event.key === null) replace(loadSettings(), false);\nsrc/skins.test.jsx:38:    const f = FIELDS.find((x) => x.key === key);\nsrc/sound/interactions.js:74:        if (target?.matches?.('input[type=\"range\"]')) play('select', 70);\nsrc/sound/sound.test.jsx:301:    expect(clickEvent(element('<input type=\"range\">'))).toBe(null);\nsrc/sound/sound.test.jsx:321:      <input id=\"r\" type=\"range\"><input id=\"t\" type=\"text\"><select id=\"s\"><option>1</option></select>\nsrc/sound/sound.test.jsx:372:    expect(FIELDS.find((field) => field.key === 'sound.on').d).toBe(false);\nsrc/pages/Presets.jsx:289:                    onKeyDown={(event) => event.key === 'Escape' && setEditing(null)}\nsrc/pages/settings.test.jsx:10:const field = (key) => FIELDS.find((f) => f.key === key);\nsrc/pages/SettingsPage.jsx:39:        type=\"range\"\nsrc/pages/NetworkGaps.jsx:13:            type=\"number\"\nsrc/pages/useNetworkHistory.js:14:const continuous = (target) => target?.matches?.('input[type=\"range\"], input[type=\"color\"]');\nsrc/pages/useNetworkHistory.js:26:      if (continuous(event.target) && (event.type !== 'keydown' || SLIDER_KEYS.includes(event.key))) {\nsrc/pages/useNetworkHistory.js:41:        if (event.type === 'keyup' && !SLIDER_KEYS.includes(event.key)) return;\nsrc/pages/useNetworkHistory.js:48:    const starts = ['pointerdown', 'touchstart', 'keydown'];\nsrc/pages/NetworkStyle.jsx:44:        type=\"range\"\nsrc/pages/NetworkEditor.jsx:162:        type=\"number\"\nsrc/pages/NetworkEditor.jsx:278:                      type=\"number\"\nsrc/visuals/layers.test.jsx:26:        if (key === 'globalCompositeOperation') calls.ops.add(value);\nsrc/visuals/layers.test.jsx:27:        if (key === 'shadowColor') calls.shadows.push(value);\nsrc/components/visuals.test.jsx:186:          if (key === 'shadowBlur' && value) calls.glows.push(value);\nsrc/components/visuals.test.jsx:187:          if (key === 'lineWidth') calls.widths.push(value);\nsrc/components/visuals.test.jsx:188:          if (key === 'fillStyle') calls.fades.push(value);\nimport { useState } from 'react';\nimport './settings.css';\nimport Layout from '../components/Layout';\nimport { previewSound } from '../components/Sound';\nimport { CornerTiles, SameCorners } from './CornerTiles';\nimport Presets from './Presets';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { getSaved, setSaved, withImported } from '../settings/presets';\nimport { formatValue } from '../settings/fields';\nimport { DEFAULTS, FIELDS, PALETTES, SECTIONS } from '../settings/schema';\nimport { changesOf, resetSettings, setSettings, useSettings } from '../settings/store';\nimport { cue } from '../sound/options';\n\nconst SETTINGS = { en: ['setting', 'settings'], ru: ['настройка', 'настройки', 'настроек'] };\nconst CHANGED = { en: ['differs', 'differ'], ru: ['отличается', 'отличаются', 'отличаются'] };\n\nexport { formatValue };\n\n// Two explicit columns instead of CSS multi-column layout (issue #15): with\n// multicol the browser rebalanced the sections whenever the skin section\n// changed size, so Skin jumped between the columns, and Safari laid them out in\n// one column or with uneven tops. Each section now names its column.\nconst COLUMNS = [1, 2];\n\nconst visibleSections = (settings) => SECTIONS.filter((section) => !section.when || section.when(settings));\n\nfunction Control({ field, value, settings }) {\n  const { t } = useLang();\n  const id = `setting-${field.key.replace(/\\./g, '-')}`;\n  const set = (next) => setSettings({ [field.key]: next });\n  const changed = value !== DEFAULTS[field.key];\n  let input;\n  let shown = null;\n  if (field.type === 'range') {\n    input = (\n      <input\n        id={id}\n        type=\"range\"\n        min={field.min}\n        max={field.max}\n        step={field.step}\n        value={value}\n        onChange={(event) => set(Number(event.target.value))}\n      />\n    );\n    shown = formatValue(field, value);\n  } else if (field.type === 'toggle') {\n    input = <input id={id} type=\"checkbox\" checked={value} onChange={(event) => set(event.target.checked)} />;\n  } else if (field.type === 'color') {\n    input = <input id={id} type=\"color\" value={value} onChange={(event) => set(event.target.value)} />;\n    shown = value;\n  } else if (field.tiles) {\n    input = <CornerTiles field={field} value={value} settings={settings} labelId={`${id}-label`} />;\n  } else {\n    input = (\n      <select id={id} value={value} onChange={(event) => set(event.target.value)}>\n        {field.options.map((option) => (\n          <option key={option.value} value={option.value}>\n            {t(option.label)}\n          </option>\n        ))}\n      </select>\n    );\n    if (field.preview === 'sound') {\n      // ▶ plays the chosen sound, so a sound can be heard before it is kept.\n      input = (\n        <>\n          {input}\n          <button\n            type=\"button\"\n            className=\"setting__play\"\n            disabled={value === 'none'}\n            onClick={() => previewSound(value)}\n            title={t({ en: 'Play', ru: 'Проиграть' })}\n            aria-label={`${t({ en: 'Play', ru: 'Проиграть' })}: ${t(field.label)}`}\n          >\n            ▶\n          </button>\n        </>\n      );\n    }\n  }\n  // Every row is the same grid: label | control | value | reset, so controls,\n  // values and reset buttons line up in a column on the whole page (issue #15).\n  return (\n    <li className={`setting setting--${field.tiles ? 'tiles' : field.type}${changed ? ' is-changed' : ''}`}>\n      <label htmlFor={field.tiles ? undefined : id} id={`${id}-label`}>\n        {t(field.label)}\n      </label>\n      <span className=\"setting__input\">{input}</span>\n      {shown !== null && (\n        <output htmlFor={id} className=\"setting__value mono\">\n          {shown}\n        </output>\n      )}\n      <button\n        type=\"button\"\n        className=\"setting__reset\"\n        onClick={() => resetSettings([field.key])}\n        disabled={!changed}\n        title={t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}\n        aria-label={`${t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}: ${t(field.label)}`}\n      >\n        ↺\n      </button>\n      {field.hint && <small className=\"setting__hint\">{t(field.hint)}</small>}\n    </li>\n  );\n}\n\n/** Colour chips of the futuristic palettes, a faster way to pick one. */\nfunction Palettes({ value }) {\n  const { t } = useLang();\n  return (\n    <div className=\"palettes\" role=\"group\" aria-label={t({ en: 'Palettes', ru: 'Палитры' })}>\n      {PALETTES.map(([id, en, ru, neon]) => (\n        <button\n          key={id}\n          type=\"button\"\n          className=\"palettes__chip\"\n          style={{ '--chip': neon }}\n          aria-pressed={value === id}\n          title={t({ en, ru })}\n          aria-label={t({ en, ru })}\n          onClick={() => setSettings({ 'future.palette': id })}\n        />\n      ))}\n    </div>\n  );\n}\n\n/** Tabs of a section with layers (the star layers, corners and sounds of issue #15); a dot marks a layer that is on. */\nfunction Tabs({ section, settings, tab, onChange }) {\n  const { t } = useLang();\n  return (\n    <div className=\"settings__tabs\" role=\"tablist\" aria-label={t(section.title)}>\n      {section.tabs.map((item) => (\n        <button\n          key={item.id}\n          type=\"button\"\n          role=\"tab\"\n          id={`tab-${item.id}`}\n          aria-selected={tab === item.id}\n          aria-controls={`${section.id}-fields`}\n          className={`settings__tab${settings[item.on] ? ' is-on' : ''}`}\n          onClick={() => onChange(item.id)}\n        >\n          {t(item.label)}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction Group({ section, settings }) {\n  const { t } = useLang();\n  const [tab, setTab] = useState(section.tabs?.[0].id);\n  const keys = section.fields.map((field) => field.key);\n  const changed = keys.filter((key) => settings[key] !== DEFAULTS[key]).length;\n  // A field may belong to a tab and may apply only to some values of other fields.\n  const shown = (field) => !field.when || field.when(settings);\n  // The fields of every tab come first, then the tabs and the fields of the chosen tab;\n  // tabs with nothing in them are not shown (the sound tabs while the sound is off).\n  const shared = section.fields.filter((field) => !field.tab && shown(field));\n  const inTab = section.fields.filter((field) => field.tab === tab && shown(field));\n  const tabbed = section.tabs && section.fields.some((field) => field.tab && shown(field));\n  const list = (fields, extra) => (\n    <ul className=\"settings__fields\" {...extra}>\n      {fields.map((field) => (\n        <Control key={field.key} field={field} value={settings[field.key]} settings={settings} />\n      ))}\n    </ul>\n  );\n  return (\n    <section id={section.id} className=\"settings__group\" aria-labelledby={`${section.id}-title`}>\n      <header className=\"settings__head\">\n        <h2 id={`${section.id}-title`}>{t(section.title)}</h2>\n        <button type=\"button\" className=\"button button--small\" onClick={() => resetSettings(keys)} disabled={!changed}>\n          {t({ en: 'Reset', ru: 'Сбросить' })}\n        </button>\n      </header>\n      {section.lead && <p className=\"settings__lead\">{t(section.lead)}</p>}\n      {section.id === 'futuristic' && <Palettes value={settings['future.palette']} />}\n      {tabbed ? (\n        <>\n          {shared.length > 0 && list(shared)}\n          <Tabs section={section} settings={settings} tab={tab} onChange={setTab} />\n          {list(inTab, { id: `${section.id}-fields`, role: 'tabpanel', 'aria-labelledby': `tab-${tab}` })}\n        </>\n      ) : (\n        list(shared, { id: `${section.id}-fields` })\n      )}\n      {section.id === 'corners' && <SameCorners corner={tab} settings={settings} />}\n    </section>\n  );\n}\n\n/**\n * /settings/ (issue #13): every option of the background animation, the skin,\n * the sound (issue #15) and the theory notation, generated from src/settings/schema.js. A change is\n * applied at once, so the page itself is the preview, and it is remembered in\n * this browser (localStorage) as a difference from the defaults.\n */\nexport default function SettingsPage() {\n  const { lang, t } = useLang();\n  const settings = useSettings();\n  const [peek, setPeek] = useState(false);\n  const [status, setState] = useState('');\n  const setStatus = (message) => {\n    setState(message);\n    cue('notify');\n  };\n  const [draft, setDraft] = useState('');\n  const sections = visibleSections(settings);\n  const changes = changesOf(settings);\n  const changed = Object.keys(changes).length;\n  const json = JSON.stringify(changes, null, 2);\n\n  const copy = async () => {\n    try {\n      await navigator.clipboard.writeText(json);\n      setStatus(t({ en: 'Copied.', ru: 'Скопировано.' }));\n    } catch {\n      setStatus(\n        t({\n          en: 'Copying is not allowed here; select the text below.',\n          ru: 'Копирование запрещено; выделите текст ниже.',\n        }),\n      );\n    }\n  };\n  const load = () => {\n    try {\n      const parsed = JSON.parse(draft);\n      if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('not an object');\n      if (Array.isArray(parsed.presets)) {\n        // Looks copied from \"Presets\" in another browser.\n        setSaved(withImported(getSaved(), parsed.presets));\n        setStatus(t({ en: 'The looks are added to the presets.', ru: 'Виды добавлены к пресетам.' }));\n      } else {\n        setSettings({ ...DEFAULTS, ...parsed });\n        setStatus(t({ en: 'Settings loaded.', ru: 'Настройки загружены.' }));\n      }\n      setDraft('');\n    } catch {\n      setStatus(t({ en: 'This is not JSON of settings.', ru: 'Это не JSON с настройками.' }));\n    }\n  };\n\n  return (\n    <Layout\n      page=\"settings\"\n      sections={[\n        ['presets', { en: 'Presets', ru: 'Пресеты' }],\n        ...sections.map((section) => [section.id, section.title]),\n      ]}\n    >\n      <div className={`settings${peek ? ' settings--peek' : ''}`}>\n        <header className=\"page-hero\" id=\"top\">\n          <p className=\"section__kicker\">{t({ en: 'Settings', ru: 'Настройки' })}</p>\n          <h1 className=\"page-hero__title\">\n            {t({ en: 'Background, skin, sound and notation', ru: 'Фон, оформление, звук и нотация' })}\n          </h1>\n          <p className=\"page-hero__lead\">\n            {t({\n              en: `${FIELDS.length} ${plural(FIELDS.length, lang, SETTINGS)}. Every change is applied at once to this page and its background, and is remembered in this browser only. ${changed} ${plural(changed, lang, SETTINGS)} ${plural(changed, lang, CHANGED)} from the defaults.`,\n              ru: `${FIELDS.length} ${plural(FIELDS.length, lang, SETTINGS)}. Каждое изменение сразу применяется к этой странице и её фону и запоминается только в этом браузере. От значений по умолчанию ${plural(changed, lang, CHANGED)} ${changed} ${plural(changed, lang, SETTINGS)}.`,\n            })}\n          </p>\n          <div className=\"page-hero__actions\">\n            <button\n              type=\"button\"\n              className=\"button button--primary\"\n              aria-pressed={peek}\n              data-sound={peek ? 'close' : 'open'}\n              onClick={() => setPeek(!peek)}\n            >\n              {peek\n                ? t({ en: 'Show the settings', ru: 'Показать настройки' })\n                : t({ en: 'Look at the background', ru: 'Посмотреть на фон' })}\n            </button>\n            <button type=\"button\" className=\"button\" onClick={() => resetSettings()} disabled={!changed}>\n              {t({ en: 'Reset everything', ru: 'Сбросить всё' })}\n            </button>\n          </div>\n        </header>\n\n        <Presets settings={settings} />\n\n        <div className=\"settings__groups\">\n          {COLUMNS.map((column) => (\n            <div key={column} className=\"settings__column\">\n              {sections\n                .filter((section) => (section.column || 1) === column)\n                .map((section) => (\n                  <Group key={section.id} section={section} settings={settings} />\n                ))}\n            </div>\n          ))}\n\n          <section id=\"share\" className=\"settings__group settings__share\" aria-labelledby=\"share-title\">\n            <header className=\"settings__head\">\n              <h2 id=\"share-title\">{t({ en: 'Your changes', ru: 'Ваши изменения' })}</h2>\n            </header>\n            <p className=\"settings__lead\">\n              {t({\n                en: 'Only what differs from the defaults, as JSON: copy it to move the settings to another browser or to suggest better defaults.',\n                ru: 'Только то, что отличается от значений по умолчанию, в виде JSON: скопируйте, чтобы перенести настройки в другой браузер или предложить лучшие значения по умолчанию.',\n              })}\n            </p>\n            <pre className=\"settings__json mono\" aria-label={t({ en: 'Changed settings', ru: 'Изменённые настройки' })}>\n              {json}\n            </pre>\n            <div className=\"page-hero__actions\">\n              <button type=\"button\" className=\"button\" onClick={copy} disabled={!changed}>\n                {t({ en: 'Copy', ru: 'Скопировать' })}\n              </button>\n            </div>\n            <label className=\"settings__import\">\n              {t({\n                en: 'Paste settings or saved looks to load them',\n                ru: 'Вставьте настройки или сохранённые виды, чтобы загрузить их',\n              })}\n              <textarea className=\"mono\" rows={4} value={draft} onChange={(event) => setDraft(event.target.value)} />\n            </label>\n            <div className=\"page-hero__actions\">\n              <button type=\"button\" className=\"button\" onClick={load} disabled={!draft.trim()}>\n                {t({ en: 'Load', ru: 'Загрузить' })}\n              </button>\n              <span role=\"status\" className=\"settings__status\">\n                {status}\n              </span>\n            </div>\n          </section>\n        </div>\n      </div>\n      {peek && (\n        <button\n          type=\"button\"\n          className=\"button button--primary settings__back\"\n          data-sound=\"close\"\n          onClick={() => setPeek(false)}\n        >\n          {t({ en: 'Show the settings', ru: 'Показать настройки' })}\n        </button>\n      )}\n    </Layout>\n  );\n}\nimport { chromium } from 'playwright';\nimport { preview } from 'vite';\nimport { mkdir, writeFile } from 'node:fs/promises';\nconst dir = 'docs/case-studies/issue-25';\nawait mkdir(`${dir}/screenshots`, { recursive: true });\nconst server = await preview({ preview: { port: 4185, strictPort: true } });\nlet browser;\ntry {\n  browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n  await page.addInitScript(() => {\n    localStorage.setItem('theme', 'dark');\n    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n  });\n  const cases = {\n    manual: 'rotation=90&turns=15+-15&gaps=0.18+0.18+%7E+%7E',\n    auto: 'rotation=90&solve=true',\n    'auto-gaps': 'rotation=90&solve=true&gaps=0.18+0.18+%7E+%7E',\n    acute: 'rotation=90&turns=15+-15&gaps=0.18+0.18+%7E+%7E&endAngle=5',\n  };\n  const results = {};\n  for (const [name, query] of Object.entries(cases)) {\n    await page.goto(`http://localhost:4185/network/?code=2222&lang=en&${query}`);\n    await page.locator('.network__preview svg').waitFor();\n    await page.locator('.network__preview').screenshot({ path: `${dir}/screenshots/before-${name}.png` });\n    results[name] = {\n      svg: await page.locator('.network__preview').innerHTML(),\n      score: await page.locator('figcaption').innerText(),\n    };\n  }\n  await page.locator('#links').screenshot({ path: `${dir}/screenshots/before-editor.png` });\n  await writeFile(`${dir}/data/baseline.json`, JSON.stringify(results, null, 2));\n} finally {\n  await browser?.close();\n  await server.httpServer.close();\n}\n// Real-browser regressions for issue #25; finite fixtures, one engine at a time.\n/* global document, Image, getComputedStyle, innerWidth */\nimport assert from 'node:assert/strict';\nimport { mkdir, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\nconst engine = process.env.ENGINE || 'chromium';\nconst output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-25/screenshots';\nconst data = process.env.RESULT_DIR || 'docs/case-studies/issue-25/data';\nawait mkdir(output, { recursive: true });\nawait mkdir(data, { recursive: true });\nconst server = await preview({ preview: { port: 4185, strictPort: true } });\nlet browser;\nconst results = { engine, date: new Date().toISOString(), checks: [], errors: [], cases: {} };\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  results.version = browser.version();\n  const context = await browser.newContext({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n  await context.addInitScript(() => {\n    localStorage.setItem('theme', 'dark');\n    localStorage.setItem('lang', 'en');\n    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n  });\n  const page = await context.newPage();\n  page.setDefaultTimeout(15000);\n  page.on('pageerror', (error) => results.errors.push(error.message));\n  const go = async (query) => {\n    await page.goto(`http://localhost:4185/network/?code=2222&lang=en&rotation=90&${query}`);\n    await page.locator('.network__preview svg').waitFor();\n  };\n  const shot = async (name, element = page.locator('.network__preview')) =>\n    element.screenshot({ path: join(output, `${engine}-after-${name}.png`) });\n  const manual = 'turns=15+-15&gaps=0.18+0.18+%7E+%7E';\n  for (const [name, query] of Object.entries({\n    manual,\n    auto: 'solve=true',\n    'auto-gaps': 'solve=true&gaps=0.18+0.18+%7E+%7E',\n    acute: `${manual}&endAngle=5`,\n    rounded: `${manual}&arrowJoin=round`,\n    legacy: `${manual}&balanceArrows=false&arrowJoin=inherit`,\n  })) {\n    await go(query);\n    await shot(name);\n    results.cases[name] = {\n      svg: await page.locator('.network__preview').innerHTML(),\n      caption: await page.locator('figcaption').innerText(),\n    };\n    if (name.startsWith('auto')) {\n      const preview = await page.locator('.network__preview').innerHTML();\n      await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n      assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n      const url = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n      assert(new URL(url).searchParams.has('gaps'));\n      assert(Number(await page.getByLabel('Link 1: Gap at the source reference', { exact: true }).inputValue()) > 0.08);\n      assert(Number(await page.getByLabel('Link 1: Gap at the target reference', { exact: true }).inputValue()) > 0.08);\n      await page.goto(url);\n      assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n      results.checks.push(`${name}: apply/share/reload preserves exact drawing and discovered gaps`);\n    }\n  }\n  // Inspect actual rasterized SVG paint, independently of the geometry helper.\n  // Equally gapped lens endpoints must have the same horizontal pixel boundary.\n  results.pixels = [];\n  for (const angle of [5, 15, 45]) {\n    await go(`${manual}&endAngle=${angle}&linejoin=round`);\n    const measurement = await page.locator('.network__preview svg').evaluate(async (svg) => {\n      // Supersample narrow tips to avoid OS-specific antialias quantization;\n      // two pixels here keep the original one-pixel-per-1000 tolerance.\n      const size = 2000;\n      const copy = svg.cloneNode(true);\n      copy.setAttribute('width', size);\n      copy.setAttribute('height', size);\n      const image = new Image();\n      const url = URL.createObjectURL(new Blob([copy.outerHTML], { type: 'image/svg+xml' }));\n      try {\n        image.src = url;\n        await image.decode();\n        const canvas = document.createElement('canvas');\n        canvas.width = canvas.height = size;\n        const ctx = canvas.getContext('2d');\n        ctx.drawImage(image, 0, 0, size, size);\n        const pixels = ctx.getImageData(0, 0, size, size).data;\n        const bottom = [-1, -1];\n        for (let y = 0; y < size; y++)\n          for (let x = 0; x < size; x++) {\n            const i = (y * size + x) * 4;\n            // Include antialias coverage: an acute tip occupies only part of\n            // its last pixel, so exact full-color matching truncates it.\n            if (pixels[i + 2] > 5 && pixels[i] < pixels[i + 2] * 0.3 && pixels[i + 1] > pixels[i + 2] * 0.7)\n              bottom[x < size / 2 ? 0 : 1] = y;\n          }\n        const arrow = svg.querySelectorAll('g[stroke]')[0].querySelectorAll('path')[2];\n        return {\n          size,\n          bottom,\n          join: getComputedStyle(arrow).strokeLinejoin,\n          limit: Number(getComputedStyle(arrow).strokeMiterlimit),\n        };\n      } finally {\n        URL.revokeObjectURL(url);\n      }\n    });\n    assert(measurement.bottom.every((y) => y > 0));\n    assert(\n      Math.abs(measurement.bottom[0] - measurement.bottom[1]) <= measurement.size / 1000,\n      JSON.stringify({ angle, measurement }),\n    );\n    assert.equal(measurement.join, 'miter');\n    assert(measurement.limit >= 1 / Math.sin((angle * Math.PI) / 180));\n    results.pixels.push({ angle, ...measurement });\n  }\n  results.checks.push('native SVG rasterization: sharp acute tips and aligned painted boundaries at 5°, 15°, 45°');\n  await go(manual);\n  const cards = page.getByRole('list', { name: 'Link configurations' });\n  assert.equal(await cards.getByRole('listitem').count(), 2);\n  assert.equal(await cards.locator('details').count(), 0);\n  await shot('editor', cards);\n  await page.locator('#links').scrollIntoViewIfNeeded();\n  await shot('desktop', page);\n  await page.getByLabel('Link 1: Gap at the source reference', { exact: true }).fill('0.21');\n  await page.getByLabel('Link 2: Cut after the middle', { exact: true }).fill('3');\n  const changed = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n  const drawing = await page.locator('.network__preview').innerHTML();\n  await page.goto(changed);\n  assert.equal(await page.locator('.network__preview').innerHTML(), drawing);\n  await page.getByRole('button', { name: 'Remove: Link 1', exact: true }).click();\n  assert.equal(await page.getByLabel('Link 1: Cut after the middle', { exact: true }).inputValue(), '3');\n  results.checks.push('visible card fields, editing, inheritance, sharing and removal/renumbering');\n  for (const lang of ['en', 'ru']) {\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.goto(`http://localhost:4185/network/?code=2222&rotation=90&${manual}&lang=${lang}`);\n    await page.locator('#links').scrollIntoViewIfNeeded();\n    const bounds = await page.evaluate(() => {\n      const overflow = [...document.querySelectorAll('.link-card input, .link-card select')].filter((node) => {\n        const a = node.getBoundingClientRect();\n        const b = node.closest('.link-card').getBoundingClientRect();\n        return a.left < b.left || a.right > b.right || a.width < 40;\n      }).length;\n      return { width: document.documentElement.scrollWidth, viewport: innerWidth, overflow };\n    });\n    assert.equal(bounds.width, bounds.viewport);\n    assert.equal(bounds.overflow, 0);\n    await shot(`mobile-${lang}`, page);\n  }\n  results.checks.push('English/Russian mobile card controls fit without horizontal scrolling');\n  assert.deepEqual(results.errors, []);\n  console.log(JSON.stringify(results.checks, null, 2));\n} finally {\n  await writeFile(join(data, `${engine}-browser.json`), JSON.stringify(results, null, 2));\n","exit_code":0,"status":"completed"}}
