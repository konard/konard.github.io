[2026-10-27T19:53:31.217Z] [STDOUT] {"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'cat src/links/gaps.js && cat src/links/glyph.js && cat src/links/style-geometry.js && cat src/links/collisions.js'","aggregated_output":"// Per-link overrides share the global units: reference gaps in layout units,\n// middle cuts in 1/100 of the symbol. Null inherits, including after global edits.\nexport const GAP_FIELDS = [\n  { key: 'startGap', max: 1, step: 0.01, label: { en: 'Gap at the source reference', ru: 'Зазор у начальной ссылки' } },\n  { key: 'endGap', max: 1, step: 0.01, label: { en: 'Gap at the target reference', ru: 'Зазор у конечной ссылки' } },\n  { key: 'middleGapStart', max: 30, step: 0.1, label: { en: 'Cut before the middle', ru: 'Разрыв перед серединой' } },\n  { key: 'middleGapEnd', max: 30, step: 0.1, label: { en: 'Cut after the middle', ru: 'Разрыв после середины' } },\n];\nexport function normalizeGaps(value) {\n  const rows = String(value ?? '')\n    .split(',')\n    .map((row) => {\n      const values = row.trim().split(/\\s+/);\n      return GAP_FIELDS.map(({ max }, i) => {\n        const raw = values[i];\n        const number = raw === undefined || raw === '~' || raw === '' ? NaN : Number(raw);\n        return Number.isFinite(number) ? Math.round(Math.min(max, Math.max(0, number)) * 1000) / 1000 : null;\n      });\n    });\n  while (rows.length && rows.at(-1).every((v) => v === null)) rows.pop();\n  return rows.map((row) => row.map((v) => (v === null ? '~' : v)).join(' ')).join(',');\n}\nexport function linkGaps(style, n) {\n  const rows = style.gaps\n    ? style.gaps.split(',').map((row) => row.split(' ').map((v) => (v === '~' ? null : Number(v))))\n    : [];\n  return Array.from({ length: n }, (_, i) => rows[i] || [null, null, null, null]);\n}\nexport const gapsText = (rows) => rows.map((row) => row.map((v) => (v == null ? '~' : v)).join(' ')).join(',');\nexport const withGaps = (style, rows) => ({ ...style, gaps: normalizeGaps(gapsText(rows)) });\n// Draws a finite network of doublet links as one symbol, after the blueprint of\n// github.com/konard/links-visuals: every link is ONE continuous curve in its\n// own colour. It starts with a bar at its source, passes through its own\n// middle and ends with an arrow at its target; optional middle cuts are off\n// by default. Other links refer to a link by touching its middle. A reference\n// to 0 (nothing) is a free end, a reference to the link itself is a loop that\n// returns to its own middle, so (1: 1 1) is a symmetric figure eight (∞).\n//\n// Geometry is computed in layout units (neighbouring middles are 1 apart),\n// every curve is a chain of cubic Bézier segments that share tangents where\n// they meet, and the finished drawing is scaled into a SIZE × SIZE box.\n//\n// Every number of the drawing is a `shape` option (issue #17), so the editor\n// of /network/ can change the angle at which a link comes to another link,\n// the shapes of its start, end and middle, and turn each end on its own. The\n// defaults in SHAPE draw exactly the symbols of the gallery and the rain.\n\nimport { pointAlongCurve, trimCurve } from './curve-tools';\nimport { placeLinks } from './placement';\n\nexport const SIZE = 100;\nexport const STROKE = 2.4;\n/** Gallery colours; the editor cycles this palette beyond nine links. */\nexport const COLORS = [\n  '#22d3ee',\n  '#c084fc',\n  '#f472b6',\n  '#facc15',\n  '#34d399',\n  '#fb923c',\n  '#60a5fa',\n  '#f87171',\n  '#a3e635',\n];\n\nconst SCALE = 60; // SIZE units per layout unit, unless the drawing must shrink\nconst LONE = { free: 0.9, loop: 1.25 }; // a single link has the box to itself\nconst FREE = 0.42; // length of a free end (a reference to nothing)\nconst LOOP = 0.8; // size of a self-reference loop\n\n/** Shapes of the start, the end and the middle of a link (`marker`). */\nexport const MARKERS = ['bar', 'arrow', 'triangle', 'tail', 'dot', 'circle', 'square', 'diamond', 'n