 'PageUp', 'PageDown'];\nconst continuous = (target) => target?.matches?.('input[type=\"range\"], input[type=\"color\"]');\n\n/** Live state stays in React; history is a debounced, best-effort persistence layer. */\nexport function useNetworkHistory(query) {\n  const [interacting, setInteracting] = useState(false);\n  // Bind before paint: a first touch must not fall between mounting the input\n  // and installing passive effects (observable in mobile WebKit).\n  useLayoutEffect(() => {\n    const active = new Set();\n    let control = null;\n    const kind = (type) => (type.startsWith('pointer') ? 'pointer' : type.startsWith('touch') ? 'touch' : 'keyboard');\n    const start = (event) => {\n      if (continuous(event.target) && (event.type !== 'keydown' || SLIDER_KEYS.includes(event.key))) {\n        control = event.target;\n        active.add(kind(event.type));\n        networkDebug('interaction started', { type: event.type, control: event.target.id });\n        setInteracting(true);\n      }\n    };\n    const end = (event) => {\n      if (!active.size) return;\n      if (event.type === 'blur') active.clear();\n      else if (event.type === 'focusout') {\n        if (event.target !== control) return;\n        active.delete('keyboard');\n        if (control.type === 'color') active.clear();\n      } else {\n        if (event.type === 'keyup' && !SLIDER_KEYS.includes(event.key)) return;\n        if (event.type.startsWith('touch') && event.touches?.length) return;\n        active.delete(kind(event.type));\n      }\n      networkDebug('interaction ended', { type: event.type, remaining: [...active] });\n      setInteracting(active.size > 0);\n    };\n    const starts = ['pointerdown', 'touchstart', 'keydown'];\n    const ends = ['pointerup', 'pointercancel', 'touchend', 'touchcancel', 'keyup', 'focusout'];\n    starts.forEach((name) => document.addEventListener(name, start));\n    ends.forEach((name) => document.addEventListener(name, end));\n    window.addEventListener('blur', end);\n    return () => {\n      starts.forEach((name) => document.removeEventListener(name, start));\n      ends.forEach((name) => document.removeEventListener(name, end));\n      window.removeEventListener('blur', end);\n    };\n  }, []);\n\n  useEffect(() => {\n    if (interacting) return;\n    let timer;\n    let failures = 0;\n    const write = () => {\n      if (window.location.search === query) return;\n      const error = replaceAddress(`${window.location.pathname}${query}${window.location.hash}`);\n      if (error) {\n        networkDebug('address write failed', { name: error.name, message: error.message, failures });\n        // A rate-limited or temporarily inactive document must never take down the editor.\n        if (failures < 5) timer = setTimeout(write, 1000 * 2 ** failures++);\n      } else networkDebug('address saved', query);\n    };\n    timer = setTimeout(write, 400);\n    return () => clearTimeout(timer);\n  }, [query, interacting]);\n}\nimport { GAP_FIELDS } from '../links/gaps';\nimport { useLang } from '../i18n/prefs';\n\n/** All four overrides stay visible inside their link's card. */\nexport default function NetworkGaps({ i, row, style, onGap }) {\n  const { t } = useLang();\n  return (\n    <div className=\"link-gaps link-card__fields\">\n      {GAP_FIELDS.map((field, k) => (\n        <label key={field.key}>\n          {t(field.label)}\n          <input\n            type=\"number\"\n            min={0}\n            max={field.max}\n            step={field.step}\n            aria-label={`${t({ en: 'Link', ru: 'Связь' })} ${i + 1}: ${t(field.label)}`}\n            value={row[k] ?? ''}\n            placeholder={String(style[field.key])}\n            onChange={(event) => onGap(i, k, event.target.value === '' ? null : Number(event.target.value))}\n          />\n        </label>\n      ))}\n    </div>\n  );\n}\nimport { useState } from 'react';\nimport { formatValue } from '../settings/fields';\nimport { LOOKS, SIZES, STYLE_DEFAULTS, STYLE_SECTIONS, applyLook, normalizeStyle } from '../links/style';\nimport { geometryAvailable } from '../links/style-geometry';\nimport { useLang } from '../i18n/prefs';\n\nconst SAVED_KEY = 'network.styles';\nconst MAX_SAVED = 12;\n\n/** The styles saved in this browser: [{ name, style }]. */\nexport function readSaved() {\n  try {\n    const list = JSON.parse(localStorage.getItem(SAVED_KEY) || '[]');\n    return Array.isArray(list)\n      ? list\n          .filter((item) => item && typeof item.name === 'string')\n          .slice(0, MAX_SAVED)\n          .map((item) => ({ name: item.name.slice(0, 40), style: normalizeStyle(item.style) }))\n      : [];\n  } catch {\n    return [];\n  }\n}\n\nfunction writeSaved(list) {\n  try {\n    localStorage.setItem(SAVED_KEY, JSON.stringify(list));\n  } catch {\n    // Private mode or a full storage: the list lives until the page is closed.\n  }\n}\n\n/** One option of the picture, in the same rows as the settings page (label | control | value | reset). */\nfunction Control({ field, value, onChange }) {\n  const { t } = useLang();\n  const id = `style-${field.key}`;\n  const changed = value !== STYLE_DEFAULTS[field.key];\n  let input;\n  let shown = null;\n  if (field.type === 'range') {\n    input = (\n      <input\n        id={id}\n        type=\"range\"\n        min={field.min}\n        max={field.max}\n        step={field.step}\n        value={value}\n        onChange={(event) => onChange(Number(event.target.value))}\n      />\n    );\n    shown = formatValue(field, value);\n  } else if (field.type === 'toggle') {\n    input = <input id={id} type=\"checkbox\" checked={value} onChange={(event) => onChange(event.target.checked)} />;\n  } else if (field.type === 'color') {\n    input = <input id={id} type=\"color\" value={value} onChange={(event) => onChange(event.target.value)} />;\n    shown = value;\n  } else if (field.type === 'text') {\n    input = (\n      <input\n        id={id}\n        type=\"text\"\n        maxLength={field.max}\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n      />\n    );\n  } else {\n    input = (\n      <select id={id} value={value} onChange={(event) => onChange(event.target.value)}>\n        {field.options.map((option) => (\n          <option key={option.value} value={option.value}>\n            {t(option.label)}\n          </option>\n        ))}\n      </select>\n    );\n  }\n  return (\n    <li className={`setting setting--${field.type === 'text' ? 'select' : field.type}${changed ? ' is-changed' : ''}`}>\n      <label htmlFor={id}>{t(field.label)}</label>\n      <span className=\"setting__input\">{input}</span>\n      {shown !== null && (\n        <output htmlFor={id} className=\"setting__value mono\">\n          {shown}\n        </output>\n      )}\n      <button\n        type=\"button\"\n        className=\"setting__reset\"\n        onClick={() => onChange(STYLE_DEFAULTS[field.key])}\n        disabled={!changed}\n        title={t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}\n        aria-label={`${t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}: ${t(field.label)}`}\n      >\n        ↺\n      </button>\n      {field.hint && <small className=\"setting__hint\">{t(field.hint)}</small>}\n    </li>\n  );\n}\n\n/** Ready looks, the usual image sizes and the styles saved in this browser. */\nexport function Looks({ style, onStyle }) {\n  const { t } = useLang();\n  const [saved, setSaved] = useState(readSaved);\n  const [name, setName] = useState('');\n  const size = SIZES.findIndex((s) => s.width === style.width && s.height === style.height);\n  const save = () => {\n    const label = name.trim() || `${t({ en: 'Style', ru: 'Стиль' })} ${saved.length + 1}`;\n    const next = [{ name: label.slice(0, 40), style }, ...saved.filter((item) => item.name !== label)].slice(\n      0,\n      MAX_SAVED,\n    );\n    setSaved(next);\n    writeSaved(next);\n    setName('');\n  };\n  const remove = (label) => {\n    const next = saved.filter((item) => item.name !== label);\n    setSaved(next);\n    writeSaved(next);\n  };\n  return (\n    <div className=\"looks\">\n      <div className=\"looks__row\" role=\"group\" aria-label={t({ en: 'Looks', ru: 'Оформления' })}>\n        {LOOKS.map((look) => (\n          <button\n            key={look.id}\n            type=\"button\"\n            className=\"button button--small\"\n            onClick={() => onStyle(applyLook(style, look.id))}\n          >\n            {t(look.label)}\n          </button>\n        ))}\n      </div>\n      <label className=\"looks__size\">\n        {t({ en: 'Image size', ru: 'Размер изображения' })}{' '}\n        <select\n          value={size}\n          onChange={(event) => {\n            const chosen = SIZES[Number(event.target.value)];\n            if (chosen) onStyle({ ...style, width: chosen.width, height: chosen.height });\n          }}\n        >\n          <option value={-1}>\n            {style.width} × {style.height} ({t({ en: 'own', ru: 'свой' })})\n          </option>\n          {SIZES.map((s, i) => (\n            <option key={s.label} value={i}>\n              {s.label}\n            </option>\n          ))}\n        </select>\n      </label>\n      <div className=\"looks__saved\">\n        <input\n          type=\"text\"\n          value={name}\n          maxLength={40}\n          onChange={(event) => setName(event.target.value)}\n          placeholder={t({ en: 'Name of the style', ru: 'Название стиля' })}\n          aria-label={t({ en: 'Name of the style', ru: 'Название стиля' })}\n        />\n        <button type=\"button\" className=\"button button--small\" onClick={save}>\n          {t({ en: 'Save the style', ru: 'Сохранить стиль' })}\n        </button>\n      </div>\n      {saved.length > 0 && (\n        <ul className=\"looks__list\" aria-label={t({ en: 'Saved styles', ru: 'Сохранённые стили' })}>\n          {saved.map((item) => (\n            <li key={item.name}>\n              <button\n                type=\"button\"\n                className=\"button button--small\"\n                onClick={() => onStyle({ ...item.style, turns: style.turns, gaps: style.gaps, solve: style.solve })}\n              >\n                {item.name}\n              </button>\n              <button\n                type=\"button\"\n                className=\"setting__reset\"\n                onClick={() => remove(item.name)}\n                aria-label={`${t({ en: 'Delete', ru: 'Удалить' })}: ${item.name}`}\n              >\n                ✕\n              </button>\n            </li>\n          ))}\n        </ul>\n      )}\n    </div>\n  );\n}\n\n/** Every option of the picture, section by section (issue #17). */\nexport function StyleSections({ style, onStyle, children = null, only = null, links = null }) {\n  const { t } = useLang();\n  const set = (key, value) => onStyle(normalizeStyle({ ...style, [key]: value }));\n  return STYLE_SECTIONS.filter((section) => !only || only.includes(section.id)).map((section) => {\n    const keys = section.fields.map((field) => field.key);\n    const changed = keys.some((key) => style[key] !== STYLE_DEFAULTS[key]);\n    return (\n      <section\n        key={section.id}\n        id={`style-section-${section.id}`}\n        className=\"settings__group\"\n        aria-labelledby={`style-section-${section.id}-title`}\n      >\n        <header className=\"settings__head\">\n          <h3 id={`style-section-${section.id}-title`}>{t(section.title)}</h3>\n          <button\n            type=\"button\"\n            className=\"button button--small\"\n            disabled={!changed}\n            onClick={() =>\n              onStyle(\n                normalizeStyle({ ...style, ...Object.fromEntries(keys.map((key) => [key, STYLE_DEFAULTS[key]])) }),\n              )\n            }\n          >\n            {t({ en: 'Reset', ru: 'Сбросить' })}\n          </button>\n        </header>\n        {section.lead && <p className=\"settings__lead\">{t(section.lead)}</p>}\n        <ul className=\"settings__fields\">\n          {section.fields\n            .filter((field) => (!field.when || field.when(style)) && geometryAvailable(field.key, style, links))\n            .map((field) => (\n              <Control\n                key={field.key}\n                field={field}\n                value={style[field.key]}\n                onChange={(value) => set(field.key, value)}\n              />\n            ))}\n        </ul>\n        {section.id === 'experimental' && children}\n      </section>\n    );\n  });\n}\n","exit_code":0,"status":"completed"}}
