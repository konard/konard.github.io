[2026-10-27T20:47:41.316Z] [STDOUT] {"type":"item.completed","item":{"id":"item_284","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\ntext=Path('/tmp/issue27-final-pr.diff').read_text()\nselected=[]\nfor part in re.split(r'\"'^diff --git '\"',text,flags=re.MULTILINE)[1:]:\n    path=part.splitlines()[0].split(' b/',1)[1]\n    if not path.startswith('docs/case-studies/issue-27/') or path.endswith(('/README.md','/VALIDATION.md','/PLAN.md')):\n        selected.append('diff --git '+part)\nfiltered=''.join(selected)\nassert not any(ord(c)<32 and c not in '\\\\n\\\\r\\\\t' for c in filtered)\nPath('/tmp/issue27-final-review.diff').write_text(filtered)\nprint('Final PR diff:',len(text.splitlines()),'lines; handwritten review:',len(filtered.splitlines()),'lines')\nPY\nsed -n '1,700p' /tmp/issue27-final-review.diff\"","aggregated_output":"Final PR diff: 43155 lines; handwritten review: 1342 lines\ndiff --git a/.github/workflows/github-pages.yml b/.github/workflows/github-pages.yml\nindex 71b6564..f369bf8 100644\n--- a/.github/workflows/github-pages.yml\n+++ b/.github/workflows/github-pages.yml\n@@ -209,6 +209,13 @@ jobs:\n           CAPTURE_DIR: browser-results/screenshots/issue25\n           RESULT_DIR: browser-results/data/issue25\n \n+      - name: Verify equal closed gaps, historical URLs and numeric keyboard controls\n+        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n+        run: npm run test:network:issue27\n+        env:\n+          CAPTURE_DIR: browser-results/screenshots/issue27\n+          RESULT_DIR: browser-results/data/issue27\n+\n       - name: Preserve browser evidence\n         if: always()\n         uses: actions/upload-artifact@v7\ndiff --git a/.gitkeep b/.gitkeep\nnew file mode 100644\nindex 0000000..1f8c4cf\n--- /dev/null\n+++ b/.gitkeep\n@@ -0,0 +1 @@\n+# .gitkeep file auto-generated at 2026-10-27T19:52:00.320Z for PR creation at branch issue-27-5cf85bfa2348 for issue https://github.com/konard/konard.github.io/issues/27\n\\ No newline at end of file\ndiff --git a/docs/case-studies/issue-27/PLAN.md b/docs/case-studies/issue-27/PLAN.md\nnew file mode 100644\nindex 0000000..8cc2b1e\n--- /dev/null\n+++ b/docs/case-studies/issue-27/PLAN.md\n@@ -0,0 +1,26 @@\n+# Issue 27 work plan\n+\n+Objective: implement every requirement of issue 27 in PR 28; preserve existing features and all historical URLs. No required sub-issues are listed in the issue or current comments.\n+\n+- [x] Read issue 27, all comments, PR 28 conversation/inline comments/reviews, issue 25 and PR 26.\n+- [x] Archive input reports and verified original screenshots.\n+- [x] Audit historical URL changes and archive relevant reports, logs and configurations.\n+- [x] Reproduce and measure unequal closed-loop gaps and the 0.07→0.08 discontinuity before changing code; capture before screenshot.\n+- [x] Add failing minimal geometry, solver, URL and keyboard regressions.\n+- [x] Fix stable symmetric painted endpoints while preserving issue 25's equal lens boundaries and gallery geometry.\n+- [x] Preserve fully/partially self-closed endpoints during automatic gap/angle search; verify the exact 1111 arrangement and prior 2222 reference.\n+- [x] Compact default turn/gap rows and upgrade historical URLs through browser history without losing Back/Forward.\n+- [x] Audit every numeric field and slider across the app: decimal stepping, arrows, PageUp/Down, Home/End, editing, Tab and relevant shortcuts.\n+- [x] Run real Playwright browser checks in all three engines and actual native-spinner mouse clicks through MCP; capture after screenshots and quantitative evidence.\n+- [x] Research primary specifications and relevant libraries; document chronology, root causes, alternatives, all requirements and evidence in case study. Report upstream issues only if evidence identifies an upstream defect.\n+- [x] Reproduce and correct the additional native inherited-spinner path: failing unit test and actual MCP Down click return 0 before, 0.07 after.\n+- [x] Run complete local checks, 737 tests, production build, three-engine issue-27/25 suites, older compatibility suites, 120 CV PDFs and dependency audit sequentially; store large logs. No OOM events/kills.\n+- [x] Commit atomic implementation steps after local checks and push only issue-27-5cf85bfa2348; prepare the PR title/body with Fixes #27, reproductions, tests, screenshots and case study.\n+- [x] Confirm main is already an ancestor, review implementation diffs, match CI timestamps/SHAs and archive both passing implementation runs. No failing CI runs require investigation.\n+\n+This is the archived plan at the evidence commit. The native completion goal remains active through these publication gates; the PR records their final status after this file is committed:\n+\n+1. Push the case study and all evidence; update the existing PR title and description.\n+2. Inspect the final evidence commit's own CI run, matching its timestamp and head SHA; require every check to pass.\n+3. Re-read all latest issue/PR comments and reviews, confirm main ancestry, a clean tree and the complete requirements inventory.\n+4. Mark PR 28 ready, verify it remains unmerged, then complete the native goal.\ndiff --git a/docs/case-studies/issue-27/README.md b/docs/case-studies/issue-27/README.md\nnew file mode 100644\nindex 0000000..7f1eeb4\n--- /dev/null\n+++ b/docs/case-studies/issue-27/README.md\n@@ -0,0 +1,175 @@\n+# Equal closed-link gaps, stable numeric editing and URL compatibility\n+\n+[Issue 27](https://github.com/konard/konard.github.io/issues/27) · [PR 28](https://github.com/konard/konard.github.io/pull/28)\n+\n+The target arrow of the self-closed link had a discontinuous paint correction. At equal reference gaps of **0.08**, the source and target painted distances from the link's own middle were **4.15 and 5.45** SVG units. The corrected distances are **4.15 and 4.15**. This is a geometry error in the application, reproduced independently of the browser renderer. Automatic spacing also treated closed halves as movable. Numeric editing had separate inherited-value and intermediate-text problems.\n+\n+## Report, scope and timeline\n+\n+The complete [issue](data/issue-27.json), [comments](data/issue-comments.json), [initial PR](data/pr-28-initial.json), [inline comments](data/pr-inline-comments.json), [reviews](data/pr-reviews.json), and [sub-issue response](data/sub-issues.json) are retained. At investigation start there were no comments, reviews or required sub-issues. The original downloaded images are [reference 1](data/reference-1.png) and [reference 2](data/reference-2.png); their file signatures were verified as PNG before viewing.\n+\n+| UTC                  | Event and evidence                                                                                                                                                                                                                                                                                                                      |\n+| -------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n+| 2026-10-24 → 25      | [PR 18](data/pr-18.json) merges on October 24 (18:01:55 UTC); [PR 20](data/pr-20.json) merges October 25 (09:19:58 UTC). They introduce the editor, URL schema and later independent endpoints/history protections.                                                                                                                     |\n+| 2026-10-25           | [PR 22](data/pr-22.json) separates editor geometry from gallery/rain geometry and handles older explicit custom-color URLs.                                                                                                                                                                                                             |\n+| 2026-10-26           | [PR 24](data/pr-24.json) adds per-link gaps and optional middle cuts; omitted entries inherit the global setting.                                                                                                                                                                                                                       |\n+| 2026-10-26 21:37:44  | [Issue 25](data/issue-25.json) / [PR 26](data/pr-26.json) balance sharp painted arrow tips, align equal lens gaps, improve the solver and group per-link controls. The full prior [session log](data/issue-25-session.log) is downloaded, and its original [CI/browser evidence](../issue-25/VALIDATION.md) remains in this repository. |\n+| 2026-10-27 19:45:26  | Issue 27 opens with two screenshots and a manual `1111` URL. The supplied closed-link gaps are `0.08 0.07`; the equal upper lens gaps are `0.18 0.18`. Updated at 19:49:39.                                                                                                                                                             |\n+| 19:52                | Prepared PR branch starts at `406a2b4`; default branch includes merged PR 26. [Initial CI metadata](data/ci-initial.json).                                                                                                                                                                                                              |\n+| 19:54–19:59          | Before renders, numeric probes and failing geometry/solver/serialization/keyboard tests isolate independent application causes.                                                                                                                                                                                                         |\n+| 19:59–20:07          | Geometry and keyboard fixes pass the full 727-test suite and Chromium/Firefox browser checks. Six historical URL schemas are extracted from Git and checked. An additional off-grid stepping test reproduces `0.075 → 0.085`, then is corrected to native valid-step behavior.                                                          |\n+| Following validation | Expanded regression tests, production builds, all browser engines, compatibility suites and PR CI are recorded in [VALIDATION.md](VALIDATION.md).                                                                                                                                                                                       |\n+| 20:31                | A final audit extends the native spinner test to an empty inherited field. Both a unit regression and an actual Playwright MCP click reproduce Down returning `0` instead of `0.07`. The follow-up supplies inheritance as an unsaved draft before native pointer stepping, and repeats validation.                                     |\n+\n+Dates of older PRs above describe their development sequence; exact merged timestamps are preserved in their JSON snapshots. [Git's complete style-schema patch history](data/url-style-history.patch) and the [issue event timeline](data/issue-timeline.json) retain the underlying chronology.\n+\n+## Requirement inventory and evidence\n+\n+| Requirement in the report                                                          | Implementation and verification                                                                                                                                                                                                                                                                                                                                                                                                                        |\n+| ---------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n+| Exactly equal default painted gaps on the fully self-closed link                   | Tangent-based cap correction for self references in `glyph.js`; analytic equality at four rotations and four arrow angles in `src/links/issue-27.test.js`; independent native raster measurements in all browser engines.                                                                                                                                                                                                                              |\n+| Remove the sudden `0.07 → 0.08` jump                                               | No endpoint-average axis on self references. Six continuity samples around equality assert constant source extent and linear target movement; before/after measurements are retained.                                                                                                                                                                                                                                                                  |\n+| Preserve equal `0.18 0.18` upper lens boundaries from issue 25                     | Use the shared outward axis only for two references to the same other link. All issue-25 analytic and native raster tests remain enabled.                                                                                                                                                                                                                                                                                                              |\n+| Test the exact perfect arrangement                                                 | Fixed fixture: `1111`, rotation `-90`, turns `0 0,-15 15`, gaps `0.08 0.08,0.18 0.18`. Its overlap score is only the existing turn penalty, `30 × 0.002 = 0.06`. Final screenshot below. The original `0.08 0.07` URL also retains those explicit unequal settings.                                                                                                                                                                                    |\n+| Favor fully/partially self-closed halves during automatic spacing                  | Skip closed halves in turn search, reference-gap search, middle-cut search and final cut-budget trimming. Full and partial loop regressions check original turns, gaps and middle cuts. Open references still optimize and the exact applied/share/reloaded SVG matches the preview.                                                                                                                                                                   |\n+| Avoid explicit zero turn rows in URLs                                              | Serialize an all-default row as empty between commas; e.g. `turns=,-15 15`. Internal normalized styles and old parsers remain compatible. Trailing default rows were already omitted.                                                                                                                                                                                                                                                                  |\n+| Preserve every previous URL configuration                                          | Extract every historical style-schema revision, retain all keys/ranges/enums, test their values through canonical round trips, plus legacy `gap`, explicit colors, arbitrary rows and explicit zero gaps. Existing notation, large-index and public issue-19/21 URL browser suites remain enabled.                                                                                                                                                     |\n+| Upgrade URLs on arrival through browser history                                    | Existing debounced `replaceState` writes the shorter serialization after 400 ms. DOM/browser tests check the write, language, hash, unchanged SVG and reload. Existing history/back/forward/quota regressions stay enabled.                                                                                                                                                                                                                            |\n+| Up/down should use `0.01`, preserve `0.07`, avoid reset                            | Shared `NumberInput` / `numericKey`, inherited fallback, native `step` attributes, decimal rounding and off-grid snapping. Tests cover `0.07 ↔ 0.08`, blank inheritance, boundaries and native `stepUp/stepDown` input events. [Playwright MCP](data/mcp-browser.json) additionally verifies actual mouse clicks on the native Up/Down spinner.                                                                                                        |\n+| Audit all sliders, numeric fields and intuitive keys/shortcuts across the codebase | Only two range renderers and three numeric usages exist. Both range renderers use the shared handler; all numeric usages use `NumberInput`. All slider schemas (including conditional controls) are checked; browser tests exercise all eight navigation keys on 37 default network and 55 settings sliders per engine. Numeric fields keep text navigation and platform shortcuts, negative typing, select-all, deletion and Tab. More details below. |\n+| Download all related data/logs, deep analysis, online facts and alternatives       | This directory contains reports, screenshots, schema snapshots, prior session log, numerical data, failed/passing logs, research and source experiments. Existing previous-issue archives are linked rather than duplicated.                                                                                                                                                                                                                           |\n+| Diagnostics if causes are uncertain; report external defects if present            | The causes are reproduced in application code. Existing opt-in history and solver tracing remains available. No new dependency/browser defect was identified, so an unrelated upstream report would be misleading.                                                                                                                                                                                                                                     |\n+| Complete one PR without removed features or deferred work                          | Changes stay on the prepared PR branch; existing geometry, marker offsets/rotations, custom colors, placements, sharing, saved styles, downloads and gallery/rain hash tests remain. The PR retains `Fixes #27` and stays unmerged for review.                                                                                                                                                                                                         |\n+\n+## Root cause 1: a lens correction applied to self references\n+\n+`paintedCurve` compensates for the sharp miter extending beyond an arrow's path vertex. For an arrow half-angle θ and stroke width w, that extension is `w / (2 sin θ)`. The correction also accounts for the painted extent of a round/square shaft cap.\n+\n+Issue 25 correctly required a common outward axis for the two ends of a lens referencing **another** link. The old implementation selected that axis by averaging both endpoint positions relative to the curve's middle. On a self-closed link the endpoints lie on opposite sides of their own middle. At equal gaps the average cancels and uses a fallback; immediately on either side it points in opposite directions. The cap term therefore changes sign. At width 1.3 this introduces a full-stroke-width jump of 1.3 SVG units.\n+\n+The raw cubic endpoint movement is continuous. The incorrect paint correction is applied after construction, explaining why changing one hundredth looked disproportionately large. The issue is not a rounding or Safari paint problem.\n+\n+The fix carries an explicit `sharedReference` fact from link construction through fitted curves and solver paint sampling. Only a lens with both ends referencing the same **other** link shares an outward axis. Each remaining endpoint uses its own outward tangent. Moving the endpoint and its adjacent Bézier control point together preserves its tangent, middle and curvature construction. Explicit marker displacement/rotation and the opt-out `balanceArrows=false` retain their previous behavior.\n+\n+### Measurements\n+\n+Distances are from the closed link's own middle to the shaft's painted cap or arrow's miter tip, in the normalized `100 × 100` SVG. They do not subtract the central dot radius. Source gap stays at 0.08; default start marker is the cross at offset 2.5.\n+\n+| Target gap | Source before | Target before | Source after | Target after |\n+| ---------- | ------------- | ------------- | ------------ | ------------ |\n+| 0.06       | 4.15          | 2.95          | 4.15         | 2.95         |\n+| 0.07       | 4.15          | 3.55          | 4.15         | 3.55         |\n+| 0.08       | 4.15          | **5.45**      | 4.15         | **4.15**     |\n+| 0.09       | 4.15          | 6.05          | 4.15         | 4.75         |\n+\n+Expected change for each 0.01 is 0.60 SVG units in this fixture, not 1.90. The [raw before](data/measure-before.json) and [raw after](data/measure-after.json) contain exact coordinates and solver outputs. Values `0.079999` and `0.080001` in that probe round to `0.080` under the existing three-decimal gap normalization; the regression additionally uses representable `0.079`, `0.080`, `0.081` samples.\n+\n+Analytic equality is checked to nine decimal places for rotations −90°, 0°, 45°, 90° and arrow angles 5°, 15°, 45°, 85°. A separate browser canvas check rasterizes the exported SVG to 2000 pixels and samples nearest cyan pixels on opposite sides, excluding the middle dot/crossing shaft. The allowed difference is 0.12 SVG units for antialiasing, and each engine's actual values are in its JSON. Existing issue-25 browser tests independently guard the lens boundary.\n+\n+## Root cause 2: the solver had no closed-half constraint\n+\n+The turn optimizer and four gap dimensions previously considered every half of every link. Changing a closed loop could reduce the collision score, even though the loop was the reference shape the user wanted to preserve. In the baseline `1111` solve, the closed link's source gap grew to **0.218**, while its target remained inherited at 0.08. A zero collision score did not imply the intended arrangement.\n+\n+The fix treats a reference to the link itself as a preserved half in every optimization phase. Reference 0 and references to other links keep their existing eligibility rules. The corresponding middle cut is also preserved, including the final cut-budget pass. This works for complete and partial self references, and for existing explicit angles, cuts and gap overrides.\n+\n+After the fix, default `1111` preserves both closed halves and changes the open lens to source/target gaps **0.23 / 0.18**, with score 0. Its before score is approximately 8.24736. The manual symmetric `0.18 / 0.18`, `−15° / +15°` arrangement is separately verified. The heuristic still searches for overlap reduction rather than a particular aesthetic optimum, so it need not select exactly the manually chosen turns. It no longer damages the closed link to achieve its score. The opt-in experimental description now explains this preservation behavior in both languages.\n+\n+## Root cause 3: inherited values and editable drafts\n+\n+The old per-link gap input was blank when inheriting 0.08, with `0.08` only as a placeholder. Native stepping uses the actual input value, not its placeholder: blank can step from zero and Down can clamp to zero. Its `step=\"0.01\"` was already present, so the evidence does **not** establish a missing step attribute or upstream browser defect. Explicit `0.07` must nevertheless remain stable under both keyboard and native stepping, and is tested.\n+\n+The old turn input immediately converted an empty string to numeric zero. Clearing the field to type a negative number therefore restored `0` during editing. A controlled numeric component now keeps intermediate empty/minus/decimal drafts while valid values update state immediately. Blur restores an empty required turn/reference to its valid backing value; an empty gap remains an inherited override. Keyboard stepping from a blank gap starts at the inherited global value.\n+\n+Native mouse stepping needs the same inheritance. The first implementation supplied it only to keyboard navigation; the expanded regression and actual MCP click still produced `0` from native Down on an empty inherited field. `pointerdown` now primes an empty inherited input with a draft of its effective value before the browser's spinner action. Focusing without editing does not save an explicit override, and blur restores the empty inherited display. An actual spinner change commits the new value normally. [Failing unit log](logs/native-inheritance-reproduction.log), [native click trace](logs/native-spinner-before-mcp.log), [passing regression](logs/native-inheritance-fixed.log).\n+\n+`numericKey` supplies consistent small steps, ten-step PageUp/PageDown and Shift+Arrow behavior. Off-grid numbers snap to the next valid step from the minimum, matching native `stepUp/stepDown`; decimal output is rounded before updating React state and URLs. Clamps preserve field bounds.\n+\n+The audit found all numeric render sites: four gaps per card, two turn fields per card and the integer reference field used above 50 links. Textual numeric notations intentionally remain text inputs for arbitrary-precision indices and complete network syntax. Both application range renderers (network style and global settings) share the same handler. Conditional sliders use those same renderers; their complete metadata is included in the helper tests.\n+\n+Range keys: Up/Right increment, Down/Left decrement, Home/End go to bounds, PageUp/PageDown move ten steps, Shift+Arrow moves ten steps. Numeric text fields use Up/Down and page stepping; Left/Right/Home/End remain native caret navigation. Ctrl/Cmd/Alt combinations, selection, copy/paste/cut, undo/redo, Tab, delete, Enter and Escape are not intercepted by this handler. Browser tests explicitly exercise selection, deletion, negative typing, Home and Tab; platform shortcut passthrough is unit tested. Native editing remains browser/platform dependent, rather than reimplemented.\n+\n+## Historical URL audit and canonical form\n+\n+`experiments/issue-27-url-history.mjs` enumerates every pre-fix commit changing `style.js` or `style-geometry.js`, evaluates its schema in an ignored local archive and records six distinct revisions: `7be35e9`, `6d102ee`, `305a85e`, `30e1517`, `d2bd08a`, `a9001c9`. Field counts grow from 53 to 84. All keys, valid numeric ranges and enum values remain accepted. The [schema fixture](data/url-schema-history.json) makes the audit test independent of Git/network access in CI.\n+\n+`src/links/url-history-27.test.js` tests historical minima, maxima, defaults, enum values and toggles through normalization and repeated serialization. Legacy `gap` still populates both reference gaps unless explicitly overridden. Older explicit `colors` still imply `palette=custom`. Empty list rows preserve link indices; explicit zero gap is different from inherited `~` and remains explicit.\n+\n+Only list **serialization** changes. The original URL remains accepted:\n+\n+```\n+/network/?code=1111&rotation=-90&turns=0+0%2C-15+15&gaps=0.08+0.07+%7E+%7E%2C0.18+0.18+%7E+%7E\n+```\n+\n+Its shorter equivalent has decoded values `turns=,-15 15` and `gaps=0.08 0.07,0.18 0.18`. Commas retain empty positions; trailing inherited gap columns and trailing default rows add no information. The serializer preserves nontrailing `~`, explicit zeros and nondefault values. Parsers continue producing the same full normalized internal style, including saved styles.\n+\n+The browser replaces the current history entry after the existing 400 ms quiet period, preserving language and hash. It does not append an extra navigation step on arrival. Existing Back/Forward handling, quota protection and immediate share/preview updates remain covered by their original tests. Old URLs with omitted settings use the application's defaults, as before; the historical format never encoded a release-specific snapshot of omitted defaults. This change preserves explicit configurations and applies the requested geometry correction to the editor. Gallery, theory and rain retain their historical geometry/hash fixtures.\n+\n+## Research, alternatives and plan decisions\n+\n+Primary sources were checked online on 2026-10-27; concise findings and URLs are retained in [research.json](data/research.json).\n+\n+- [SVG 2 painting](https://www.w3.org/TR/SVG/painting.html#StrokeMiterlimitProperty) explains sharp join extension and cap geometry. That supports measuring the painted boundary, rather than comparing arrow path vertices alone.\n+- [HTML number input and stepping](https://html.spec.whatwg.org/multipage/input.html#dom-input-stepup) defines the number step default, step base and mismatch behavior. The application already supplies explicit fractional steps; inherited placeholders still need application-level handling.\n+- [WAI slider pattern](https://www.w3.org/WAI/ARIA/apg/patterns/slider/) documents arrows, bounds and optional page steps. [Spinbutton guidance](https://www.w3.org/WAI/ARIA/apg/patterns/spinbutton/) also emphasizes normal text editing. Native editable number fields retain caret Home/End behavior; sliders get bound shortcuts.\n+- [Radix Slider](https://www.radix-ui.com/primitives/docs/components/slider) supplies keyboard navigation, step and bounds with custom rendered parts. Replacing every native slider would add a dependency and alter styling/touch behavior for a fix that fits one shared handler. It would not resolve self-reference geometry or inherited per-link overrides.\n+- [React Aria NumberField](https://react-spectrum.adobe.com/react-aria/NumberField.html) provides a more complete numeric component, including formatting and increment/decrement controls. It is a reasonable alternative if localized numeric formatting becomes necessary. The current application keeps its established native decimal fields and adds a small shared draft/inheritance wrapper.\n+\n+Other evaluated approaches: changing the default target gap to 0.07 would hide the discontinuity without fixing it; changing arrow joins to round would remove requested sharp tips; disabling arrow balancing globally would regress issue 25; freezing all links would prevent the experimental feature from solving open references; increasing solver passes cannot express the missing closed-half priority. A schema version pinning all past implicit defaults would be a separate behavior change and is unnecessary to accept every published explicit parameter.\n+\n+The implementation plan therefore separated the causes: reproduce first, stabilize endpoint paint, constrain closed-half search, compact only URL serialization, unify numeric editing/keyboard behavior, then verify original and adjacent cases. [PLAN.md](PLAN.md) tracks those steps.\n+\n+## Diagnostics and reproducibility\n+\n+Existing opt-in diagnostics remain sufficient now that each cause is reproduced:\n+\n+```js\n+localStorage.setItem('network.debug', 'true'); // interaction/history events\n+// In a source experiment:\n+solveCollisions(links, shape, { adjustGaps: true, debug: true });\n+```\n+\n+Both are off by default. The measurement experiment prints complete coordinates and solver decisions; the browser experiment logs each slider ID so a failure identifies its control. No unresolved cause requires new always-on logging.\n+\n+Run from the repository root after `npm ci`:\n+\n+```sh\n+npm run check\n+npm run test:ci -- --maxWorkers=1\n+npm run build\n+npx playwright install chromium firefox webkit\n+node experiments/issue-27-measure.mjs\n+node experiments/issue-27-url-history.mjs\n+npm run test:network:issue27\n+ENGINE=firefox npm run test:network:issue27\n+ENGINE=webkit npm run test:network:issue27\n+```\n+\n+Run memory-heavy commands sequentially in this 2.92 GiB container. Browser fixtures and raster sizes are finite; browser action limits are 15 seconds and CI jobs have existing finite limits. Each browser closes in `finally`. Set `CAPTURE_DIR` and `RESULT_DIR` to preserve a new run outside committed evidence. The baseline script captures the **current** production build; to reproduce before evidence, run it against parent `406a2b4` in a separate checkout/build. Do not overwrite the archived before images with a fixed build.\n+\n+Initial failing tests: [geometry/solver/serialization](logs/reproduce-tests.log), [keyboard](logs/reproduce-keyboard-tests.log), [off-grid stepping](logs/off-grid-reproduction.log). The latter also records a test-fixture path-loading error corrected before the final run. The first schema archive attempt exceeded Node's default synchronous subprocess output buffer; the retained experiment uses a bounded 16 MiB archive buffer. This was tooling overhead, not an application defect.\n+\n+No tests need GitHub access. The repeatable browser suites use the Playwright API; a final interactive verification also uses Playwright MCP after its tools became discoverable during the session. The browser matrix runs the new suite after the existing editor and issue-19/21/23/25 suites, retaining JSON and screenshots as CI artifacts. [VALIDATION.md](VALIDATION.md) records final results and limits.\n+\n+## Visual evidence\n+\n+Equal closed gaps before and after, with the upper lens kept at `0.18 / 0.18` and turns `−15° / +15°`:\n+\n+| Before                                                         | After                                                              |\n+| -------------------------------------------------------------- | ------------------------------------------------------------------ |\n+| ![Closed arrow gap is too large](screenshots/before-equal.png) | ![Equal painted closed gaps](screenshots/chromium-after-equal.png) |\n+\n+Automatic spacing before and after (the closed link is now preserved):\n+\n+| Before                                                       | After                                                                  |\n+| ------------------------------------------------------------ | ---------------------------------------------------------------------- |\n+| ![Solver opens the closed loop](screenshots/before-auto.png) | ![Solver changes open references](screenshots/chromium-after-auto.png) |\n+\n+Final editor with individual gaps:\n+\n+![Editor and per-link controls](screenshots/chromium-after-editor.png)\n+\n+Native Down from an empty field inheriting `0.08`, using actual mouse clicks:\n+\n+| Before: resets to 0                                                        | After: steps to 0.07                                                              |\n+| -------------------------------------------------------------------------- | --------------------------------------------------------------------------------- |\n+| ![Inherited spinner resets to zero](screenshots/native-spinner-before.png) | ![Inherited spinner steps by one hundredth](screenshots/native-spinner-after.png) |\ndiff --git a/docs/case-studies/issue-27/VALIDATION.md b/docs/case-studies/issue-27/VALIDATION.md\nnew file mode 100644\nindex 0000000..6a2fd8f\n--- /dev/null\n+++ b/docs/case-studies/issue-27/VALIDATION.md\n@@ -0,0 +1,49 @@\n+# Validation record\n+\n+The before state is prepared parent `406a2b4`, containing the merged issue-25 implementation. Native browser checks use the pinned Playwright 1.63.0 browsers. All substantial commands write logs to files and final commands run sequentially under the container's 2.92 GiB memory budget.\n+\n+## Reproduction and focused checks\n+\n+- Five initial geometry/solver/serialization tests fail before the fixes: [log](logs/reproduce-tests.log).\n+- Three additional keyboard regressions fail: [log](logs/reproduce-keyboard-tests.log). The URL test was run after the serializer fix and already passed.\n+- The new off-grid stepping check fails with `0.075 → 0.085`: [log](logs/off-grid-reproduction.log). The same attempt records a fixture path error, corrected before acceptance.\n+- All 19 new focused tests then pass: [log](logs/focused-final.log). They cover painted equality/continuity, exact manual arrangement, full/partial closed halves, all six historical schema revisions, old aliases and compact rows, URL history, inherited stepping, negative drafts and every slider schema.\n+- Historical source audit passes all six schemas, retaining 53–84 fields as the schema grows: [audit log](logs/url-history-audit.log), [fixture](data/url-schema-history.json).\n+\n+## Full verification\n+\n+An initial full suite passed **727 tests in 45 files** before nine historical-schema/shared-key regressions were added: [log](logs/all-tests-first-pass.log). The expanded suite passes **736 tests in 47 files**: [log](logs/all-tests-final.log). The final inherited native-spinner regression fails with `0` instead of `0.07` before its fix ([log](logs/native-inheritance-reproduction.log)), then passes ([log](logs/native-inheritance-fixed.log)). The complete final suite passes **737 tests in 47 files** (181.59 seconds): [log](logs/all-tests-complete.log). Final repository checks ([log](logs/check-complete.log)) and production build ([log](logs/build-complete.log)) also pass. The only file-size warning is the existing 1354-line registry collector.\n+\n+All final production browser runs pass all five groups: preserved/canonical historical URLs, four rasterized arrow angles, automatic spacing/apply/share/reload, native and keyboard decimal stepping and editing, and all eight keys on 92 rendered sliders. These runs include off-grid snapping and native pointer stepping from inheritance. Their JSON includes exact painted distances, browser versions, exercised control IDs and zero page errors.\n+\n+| Local browser | Version       | Checks                   | Evidence                                                                      |\n+| ------------- | ------------- | ------------------------ | ----------------------------------------------------------------------------- |\n+| Chromium      | 153.0.8010.12 | 5/5; 92 sliders × 8 keys | [JSON](data/chromium-browser.json), [log](logs/browser-chromium-complete.log) |\n+| Firefox       | 155.0         | 5/5; 92 sliders × 8 keys | [JSON](data/firefox-browser.json), [log](logs/browser-firefox-complete.log)   |\n+| WebKit        | 26.6          | 5/5; 92 sliders × 8 keys | [JSON](data/webkit-browser.json), [log](logs/browser-webkit-complete.log)     |\n+\n+The maximum measured difference between rasterized closed endpoint distances is **0.04243 SVG units** at 2000-pixel resolution, below the independent 0.12-unit raster tolerance. Analytic equality remains exact to nine decimal places.\n+\n+The final build retains the application's existing warnings about extensionless imports and bundle chunks. JSDOM emits its existing unsupported canvas warnings; the browser suites verify actual canvas rendering and downloads.\n+\n+## Verification boundaries\n+\n+- The solver remains an opt-in overlap heuristic. The exact symmetric manual arrangement is verified separately; default solving finds a zero-overlap arrangement with unequal open-lens gaps while preserving all self-closed halves.\n+- Analytic paint equality uses the shaft cap and sharp miter tip. Native raster tests allow 0.12 SVG units for pixel/antialiasing differences at 2000-pixel resolution; they do not weaken analytic equality.\n+- Keyboard tests use real desktop browser engines. Native operating-system dialogs, touch assistive technologies and every operating-system clipboard/undo convention are not independently emulated. Their standard key events remain unintercepted.\n+- Historical URLs preserve explicit supported configurations and parser compatibility. Omitted defaults have always followed the current application; the historical URL scheme contains no release identifier.\n+- The initial full suite and Chromium validation briefly overlapped in this container; the cgroup approached its memory ceiling but recorded **zero OOM events/kills**. Subsequent heavy validation is sequential. No deliberately unbounded stress probes are used.\n+\n+## Interactive browser verification\n+\n+Playwright MCP passes actual mouse clicks on the native number spinner: **Up 0.07→0.08**, **Down 0.08→0.07**, keyboard Up, and native **Down/Up from empty inheritance →0.07 / 0.09**. The controls restore the shared URL to equal `0.08 / 0.08` closed gaps. [Result](data/mcp-browser.json), [final trace](logs/mcp-browser-final.log), [screenshot](screenshots/mcp-after-equal.png), [retained script](../../../experiments/issue-27-mcp.mjs). [Before](screenshots/native-spinner-before.png) and [after](screenshots/native-spinner-after.png) show the inherited native-Down problem and correction. The MCP page and preview server were closed after verification. An initial dynamic-import attempt failed because the MCP VM has no dynamic-import callback. The retained callback uses a named function so formatting cannot add an expression-ending semicolon that the MCP wrapper rejects; it is verified by loading that exact file through MCP.\n+\n+## Archived CI and compatibility evidence\n+\n+The first implementation commit `847d1faa8d3e9ac3028f2cc623ba7574ed248b19` passes [run 40577107753](https://github.com/konard/konard.github.io/actions/runs/40577107753), created **2026-10-27 20:20:09 UTC**: workflow lint, repository checks, all six browser suites in Chromium/Linux, Firefox/Linux and WebKit/macOS, 736 unit tests, production build and 120 CV PDFs. Deployment is intentionally skipped for pull requests. [Complete CI log](logs/ci-source-40577107753.log), [job metadata](data/ci-source-status.json), [all three artifact manifests, numerical JSON and issue-27 screenshots](ci-evidence/40577107753/). The manifests index every downloaded artifact file by size and SHA-256; unchanged older-suite screenshots already have dedicated case-study archives.\n+\n+That run precedes the final inherited native-spinner regression and correction. The final evidence commit is independently validated by the PR's checks; its head SHA must match the inspected run before marking ready. Baseline PR run `40572967850` and the latest default-branch deployment `40405958762` also pass, so no pre-existing failing CI check is bypassed.\n+\n+The native-spinner follow-up is application commit `400…a0b`. Its [run 40579640992](https://github.com/konard/konard.github.io/actions/runs/40579640992), created **2026-10-27 20:37:02 UTC**, passes every check: workflow lint, repository checks, all six browser suites in all three engines, **737 unit tests**, production build and **120 CV PDFs**. [Complete CI log](logs/ci-native-40579640992.log), [head SHA and job metadata](data/ci-native-status.json), [three browser artifact archives](ci-evidence/40579640992/). They verify the expanded inherited-pointer cases as well as all earlier browser groups, with no page errors. The [small follow-up diff](data/native-follow-up.diff) complements the [original implementation diff](data/pr-source.diff).\n+\n+Local compatibility suites pass the original editor/download checks and issues 19, 21 and 23 in Chromium, and issue 25 in all three engines. [Editor log](logs/compat-editor-chromium.log), [issue 19](logs/compat-issue19-chromium.log), [issue 21](logs/compat-issue21-chromium.log), [issue 23](logs/compat-issue23-chromium.log), [issue-25 JSON](data/compat-issue25/). Local gallery regression uses its finite 1,215-card default; CI verifies the exact prior 4,131-card load in every engine. [CV generation](logs/build-cv.log) prints all **120 PDFs**; [dependency audit](logs/audit.log) reports **zero vulnerabilities**. The [repeated historical-schema audit](logs/url-history-audit-final.log) passes and cleans up its temporary Git archives.\ndiff --git a/experiments/issue-27-baseline.mjs b/experiments/issue-27-baseline.mjs\nnew file mode 100644\nindex 0000000..471fdac\n--- /dev/null\n+++ b/experiments/issue-27-baseline.mjs\n@@ -0,0 +1,35 @@\n+import { chromium } from 'playwright';\n+import { preview } from 'vite';\n+import { mkdir, writeFile } from 'node:fs/promises';\n+const dir = 'docs/case-studies/issue-27';\n+await mkdir(`${dir}/screenshots`, { recursive: true });\n+const server = await preview({ preview: { port: 4187, strictPort: true } });\n+let browser;\n+try {\n+  browser = await chromium.launch();\n+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n+  await page.addInitScript(() => {\n+    localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const cases = {\n+    equal: 'rotation=-90&turns=0+0%2C-15+15&gaps=0.08+0.08+%7E+%7E%2C0.18+0.18+%7E+%7E',\n+    unequal: 'rotation=-90&turns=0+0%2C-15+15&gaps=0.08+0.07+%7E+%7E%2C0.18+0.18+%7E+%7E',\n+    auto: 'rotation=-90&solve=true',\n+  };\n+  const results = {};\n+  for (const [name, query] of Object.entries(cases)) {\n+    await page.goto(`http://localhost:4187/network/?code=1111&lang=en&${query}`);\n+    await page.locator('.network__preview svg').waitFor();\n+    await page.locator('.network__preview').screenshot({ path: `${dir}/screenshots/before-${name}.png` });\n+    results[name] = {\n+      svg: await page.locator('.network__preview').innerHTML(),\n+      score: await page.locator('figcaption').innerText(),\n+    };\n+  }\n+  await page.locator('#links').screenshot({ path: `${dir}/screenshots/before-editor.png` });\n+  await writeFile(`${dir}/data/baseline.json`, JSON.stringify(results, null, 2));\n+} finally {\n+  await browser?.close();\n+  await server.httpServer.close();\n+}\ndiff --git a/experiments/issue-27-browser.mjs b/experiments/issue-27-browser.mjs\nnew file mode 100644\nindex 0000000..7cda529\n--- /dev/null\n+++ b/experiments/issue-27-browser.mjs\n@@ -0,0 +1,228 @@\n+// Real-browser geometry, keyboard and old bookmark regressions; finite fixtures.\n+/* global document, Image */\n+import assert from 'node:assert/strict';\n+import { mkdir, writeFile } from 'node:fs/promises';\n+import { join } from 'node:path';\n+import { chromium, firefox, webkit } from 'playwright';\n+import { preview } from 'vite';\n+const engine = process.env.ENGINE || 'chromium';\n+const output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-27/screenshots';\n+const data = process.env.RESULT_DIR || 'docs/case-studies/issue-27/data';\n+await mkdir(output, { recursive: true });\n+await mkdir(data, { recursive: true });\n+const server = await preview({ preview: { port: 4187, strictPort: true } });\n+const result = { engine, date: new Date().toISOString(), checks: [], errors: [] };\n+let browser;\n+try {\n+  browser = await { chromium, firefox, webkit }[engine].launch();\n+  result.version = browser.version();\n+  const page = await browser.newPage({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n+  page.setDefaultTimeout(15000);\n+  page.on('pageerror', (error) => result.errors.push(error.message));\n+  await page.addInitScript(() => {\n+    localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('lang', 'en');\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const go = async (query = '') => {\n+    await page.goto(`http://localhost:4187/network/?code=1111&lang=en&rotation=-90&${query}`);\n+    await page.locator('.network__preview svg').waitFor();\n+  };\n+  const shot = async (name, element = page.locator('.network__preview')) =>\n+    element.screenshot({ path: join(output, `${engine}-after-${name}.png`) });\n+  const manual = 'turns=0+0%2C-15+15&gaps=0.08+0.08+%7E+%7E%2C0.18+0.18+%7E+%7E';\n+  await go(manual);\n+  const initial = await page.locator('.network__preview').innerHTML();\n+  await page.waitForURL((url) => url.searchParams.get('turns') === ',-15 15');\n+  assert.equal(new URL(page.url()).searchParams.get('gaps'), '0.08 0.08,0.18 0.18');\n+  assert.equal(await page.locator('.network__preview').innerHTML(), initial);\n+  await page.reload();\n+  assert.equal(await page.locator('.network__preview').innerHTML(), initial);\n+  await shot('equal');\n+  await page.locator('#links').scrollIntoViewIfNeeded();\n+  await shot('editor', page);\n+  result.checks.push('historical URL upgrades through history, compacts default rows, and reloads the exact SVG');\n+\n+  // Independent paint check: find nearest cyan pixels in narrow sectors around\n+  // the opposite closed ends, excluding the central dot and crossing shaft.\n+  result.paint = [];\n+  for (const angle of [5, 15, 45, 85]) {\n+    await go(`${manual}&endAngle=${angle}`);\n+    const measurement = await page.locator('.network__preview svg').evaluate(async (svg) => {\n+      const size = 2000;\n+      const copy = svg.cloneNode(true);\n+      copy.setAttribute('width', size);\n+      copy.setAttribute('height', size);\n+      const line = svg.querySelector('g[stroke] path');\n+      const numbers = line\n+        .getAttribute('d')\n+        .match(/-?\\d+(?:\\.\\d+)?/g)\n+        .map(Number);\n+      const middle = numbers.slice(6, 8).map((v) => (v * size) / 100);\n+      const starts = numbers.slice(0, 2).map((v) => (v * size) / 100);\n+      const dir = starts.map((v, i) => v - middle[i]);\n+      const length = Math.hypot(...dir);\n+      const axis = dir.map((v) => v / length);\n+      const image = new Image();\n+      const url = URL.createObjectURL(new Blob([copy.outerHTML], { type: 'image/svg+xml' }));\n+      try {\n+        image.src = url;\n+        await image.decode();\n+        const canvas = document.createElement('canvas');\n+        canvas.width = canvas.height = size;\n+        const ctx = canvas.getContext('2d');\n+        ctx.drawImage(image, 0, 0);\n+        const pixels = ctx.getImageData(0, 0, size, size).data;\n+        const nearest = [Infinity, Infinity];\n+        for (let y = 0; y < size; y++)\n+          for (let x = 0; x < size; x++) {\n+            const p = (y * size + x) * 4;\n+            if (!(pixels[p + 2] > 40 && pixels[p] < pixels[p + 2] * 0.3 && pixels[p + 1] > pixels[p + 2] * 0.7))\n+              continue;\n+            const dx = x + 0.5 - middle[0];\n+            const dy = y + 0.5 - middle[1];\n+            const radius = Math.hypot(dx, dy);\n+            const projection = dx * axis[0] + dy * axis[1];\n+            if (radius > (2.5 * size) / 100 && Math.abs(projection) / radius > 0.99)\n+              nearest[projection > 0 ? 0 : 1] = Math.min(nearest[projection > 0 ? 0 : 1], (radius * 100) / size);\n+          }\n+        return { nearest, size };\n+      } finally {\n+        URL.revokeObjectURL(url);\n+      }\n+    });\n+    assert(measurement.nearest.every(Number.isFinite));\n+    assert(Math.abs(measurement.nearest[0] - measurement.nearest[1]) < 0.12, JSON.stringify({ angle, measurement }));\n+    result.paint.push({ angle, ...measurement });\n+  }\n+  result.checks.push('native rasterized closed gaps agree within 0.12 image units at 5°, 15°, 45°, 85°');\n+  await go('solve=true');\n+  await shot('auto');\n+  const preview = await page.locator('.network__preview').innerHTML();\n+  await page.getByRole('button', { name: 'Apply turns and gaps to links', exact: true }).click();\n+  for (const name of ['Gap at the source reference', 'Gap at the target reference']) {\n+    assert.equal(await page.getByLabel(`Link 1: ${name}`, { exact: true }).inputValue(), '');\n+    assert(Number(await page.getByLabel(`Link 2: ${name}`, { exact: true }).inputValue()) > 0.08);\n+  }\n+  assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n+  await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+  assert.equal(await page.locator('.network__preview').innerHTML(), preview);\n+  result.checks.push(\n+    'automatic spacing preserves the closed link, changes open references, and applies/shares/reloads exactly',\n+  );\n+\n+  await go(manual);\n+  const gap = page.getByLabel('Link 1: Gap at the target reference', { exact: true });\n+  await gap.fill('0.07');\n+  await gap.press('ArrowUp');\n+  assert.equal(await gap.inputValue(), '0.08');\n+  await gap.press('ArrowDown');\n+  assert.equal(await gap.inputValue(), '0.07');\n+  // Native stepUp/Down use the same HTML constraints as the spinner buttons.\n+  for (const [method, expected] of [\n+    ['stepUp', '0.08'],\n+    ['stepDown', '0.07'],\n+  ]) {\n+    await gap.evaluate((input, method) => {\n+      input[method]();\n+      input.dispatchEvent(new Event('input', { bubbles: true }));\n+    }, method);\n+    assert.equal(await gap.inputValue(), expected);\n+    const shared = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n+    assert.equal(new URL(shared).searchParams.get('gaps').split(',')[0].split(' ')[1], expected);\n+  }\n+  await gap.fill('0.075');\n+  await gap.press('ArrowUp');\n+  assert.equal(await gap.inputValue(), '0.08');\n+  // Pointer events precede the browser's native spinner action. Inheritance\n+  // must be available to that action without changing the saved override.\n+  for (const [method, expected] of [\n+    ['stepDown', '0.07'],\n+    ['stepUp', '0.09'],\n+  ]) {\n+    await gap.fill('');\n+    const inherited = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n+    await gap.dispatchEvent('pointerdown');\n+    assert.equal(await page.getByLabel('Link to this picture', { exact: true }).inputValue(), inherited);\n+    await gap.evaluate((input, method) => {\n+      input[method]();\n+      input.dispatchEvent(new Event('input', { bubbles: true }));\n+    }, method);\n+    assert.equal(await gap.inputValue(), expected);\n+  }\n+  await gap.fill('');\n+  await gap.dispatchEvent('pointerdown');\n+  await gap.press('Tab');\n+  assert.equal(await gap.inputValue(), '');\n+  await gap.fill('');\n+  await gap.press('ArrowUp');\n+  assert.equal(await gap.inputValue(), '0.09');\n+  const turn = page.getByLabel('Link 2: turn of the source, °', { exact: true });\n+  await turn.fill('');\n+  await turn.pressSequentially('-25');\n+  assert.equal(await turn.inputValue(), '-25');\n+  await turn.press('ControlOrMeta+A');\n+  await turn.press('Backspace');\n+  assert.equal(await turn.inputValue(), '');\n+  await turn.pressSequentially('-15');\n+  await turn.press('Tab');\n+  assert.equal(await turn.inputValue(), '-15');\n+  await gap.fill('0.07');\n+  await gap.press('Home');\n+  assert.equal(await gap.inputValue(), '0.07');\n+  result.checks.push(\n+    '0.07↔0.08 arrows/native stepping, inherited native/keyboard steps, negative typing, select-all, delete, Home and Tab',\n+  );\n+\n+  console.log('Geometry, URL and number editing checks passed. Auditing sliders.');\n+  const audit = async (selector) => {\n+    const controls = await page.locator(selector).evaluateAll((inputs) =>\n+      inputs.map((input) => ({\n+        id: input.id,\n+        min: +input.min,\n+        max: +input.max,\n+        step: +input.step,\n+        value: +input.value,\n+      })),\n+    );\n+    for (const control of controls) {\n+      console.log(`Keyboard: ${control.id}`);\n+      const input = page.locator(`[id=\"${control.id}\"]`);\n+      let current = control.value;\n+      for (const [key, count] of [\n+        ['ArrowUp', 1],\n+        ['ArrowDown', -1],\n+        ['ArrowRight', 1],\n+        ['ArrowLeft', -1],\n+        ['PageUp', 10],\n+        ['PageDown', -10],\n+        ['Home', 0],\n+        ['End', 0],\n+      ]) {\n+        const expected =\n+          key === 'Home'\n+            ? control.min\n+            : key === 'End'\n+              ? control.max\n+              : Math.min(control.max, Math.max(control.min, current + count * control.step));\n+        await input.press(key);\n+        current = Number(await input.inputValue());\n+        assert(Math.abs(current - expected) < 1e-8, JSON.stringify({ control, key, current, expected }));\n+      }\n+    }\n+    return controls.map((control) => control.id);\n+  };\n+  await go('');\n+  result.networkRanges = await audit('input[type=\"range\"]');\n+  await page.goto('http://localhost:4187/settings/?lang=en');\n+  result.settingsRanges = await audit('input[type=\"range\"]');\n+  result.checks.push(\n+    `all ${result.networkRanges.length} rendered network and ${result.settingsRanges.length} settings sliders support all eight navigation keys`,\n+  );\n+  assert.deepEqual(result.errors, []);\n+  console.log(JSON.stringify(result.checks, null, 2));\n+} finally {\n+  await writeFile(join(data, `${engine}-browser.json`), JSON.stringify(result, null, 2));\n+  await browser?.close();\n+  await server.httpServer.close();\n+}\ndiff --git a/experiments/issue-27-mcp.mjs b/experiments/issue-27-mcp.mjs\nnew file mode 100644\nindex 0000000..aea7ea6\n--- /dev/null\n+++ b/experiments/issue-27-mcp.mjs\n@@ -0,0 +1,37 @@\n+// Function consumed by Playwright MCP browser_run_code_unsafe.\n+// eslint-disable-next-line no-unused-vars -- Evaluated as a callback by Playwright MCP.\n+async function verify(page) {\n+  await page.setViewportSize({ width: 1440, height: 1000 });\n+  await page.goto(\n+    'http://localhost:4187/network/?code=1111&lang=en&rotation=-90&turns=0+0%2C-15+15&gaps=0.08+0.08+%7E+%7E%2C0.18+0.18+%7E+%7E',\n+  );\n+  const gap = page.getByLabel('Link 1: Gap at the target reference', { exact: true });\n+  await gap.fill('0.07');\n+  await gap.hover();\n+  const box = await gap.boundingBox();\n+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 - 3);\n+  if ((await gap.inputValue()) !== '0.08') throw new Error('Native spinner Up should move 0.07 to 0.08');\n+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 + 3);\n+  if ((await gap.inputValue()) !== '0.07') throw new Error('Native spinner Down should restore 0.07');\n+  await gap.press('ArrowUp');\n+  if ((await gap.inputValue()) !== '0.08') throw new Error('Keyboard Up should restore 0.08');\n+  await gap.fill('');\n+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 + 3);\n+  if ((await gap.inputValue()) !== '0.07') throw new Error('Inherited native Down should start at 0.08');\n+  await gap.fill('');\n+  await page.mouse.click(box.x + box.width - 12, box.y + box.height / 2 - 3);\n+  if ((await gap.inputValue()) !== '0.09') throw new Error('Inherited native Up should start at 0.08');\n+  await gap.press('ArrowDown');\n+  const result = {\n+    date: new Date().toISOString(),\n+    checks: [\n+      'actual native spinner Up: 0.07→0.08',\n+      'actual native spinner Down: 0.08→0.07',\n+      'keyboard Up restores equal 0.08 gaps',\n+      'native spinner Down/Up from inheritance: 0.08→0.07 / 0.09',\n+    ],\n+    url: await page.getByLabel('Link to this picture', { exact: true }).inputValue(),\n+  };\n+  await page.locator('.network__preview').scrollIntoViewIfNeeded();\n+  return result;\n+}\ndiff --git a/experiments/issue-27-measure.mjs b/experiments/issue-27-measure.mjs\nnew file mode 100644\nindex 0000000..9a75d9b\n--- /dev/null\n+++ b/experiments/issue-27-measure.mjs\n@@ -0,0 +1,32 @@\n+// Bounded geometric and solver probes; no stress inputs. Run before/after a fix.\n+import { createServer } from 'vite';\n+import { writeFile } from 'node:fs/promises';\n+const server = await createServer({ server: { middlewareMode: true } });\n+try {\n+  const { normalizeStyle, shapeOfStyle } = await server.ssrLoadModule('/src/links/style.js');\n+  const { glyphCurves, paintedCurve } = await server.ssrLoadModule('/src/links/glyph.js');\n+  const { solveCollisions } = await server.ssrLoadModule('/src/links/collisions.js');\n+  const links = [\n+    [1, 1],\n+    [1, 1],\n+  ];\n+  const results = [];\n+  for (const gap of [0, 0.01, 0.06, 0.07, 0.079999, 0.08, 0.080001, 0.09]) {\n+    const style = normalizeStyle({ rotation: -90, turns: '0 0,-15 15', gaps: `0.08 ${gap} ~ ~,0.18 0.18 ~ ~` });\n+    const shape = shapeOfStyle(style, 2);\n+    const raw = glyphCurves(links, shape)[0];\n+    const painted = paintedCurve(raw, shape);\n+    const cap = style.strokeWidth / 2;\n+    const extra = cap / Math.sin((style.endAngle * Math.PI) / 180);\n+    const apex = painted.end.at.map((v, i) => v + extra * painted.end.dir[i]);\n+    const source = Math.hypot(...raw.start.at.map((v, i) => v - raw.middle.at[i])) - cap;\n+    const target = Math.hypot(...apex.map((v, i) => v - raw.middle.at[i]));\n+    results.push({ gap, source, target, rawEnd: raw.end.at, paintedEnd: painted.end.at, apex });\n+  }\n+  const shape = shapeOfStyle(normalizeStyle({ rotation: -90 }), 2);\n+  results.push({ solver: solveCollisions(links, shape, { adjustGaps: true }) });\n+  console.log(JSON.stringify(results, null, 2));\n+  if (process.env.RESULT_FILE) await writeFile(process.env.RESULT_FILE, JSON.stringify(results, null, 2));\n+} finally {\n+  await server.close();\n+}\ndiff --git a/experiments/issue-27-url-history.mjs b/experiments/issue-27-url-history.mjs\nnew file mode 100644\nindex 0000000..0d2f2d9\n--- /dev/null\n+++ b/experiments/issue-27-url-history.mjs\n@@ -0,0 +1,53 @@\n+// Audit every revision that changed the URL style schema. Archived metadata\n+// becomes a stable fixture; runtime tests never depend on Git/network access.\n+import assert from 'node:assert/strict';\n+import { execFileSync } from 'node:child_process';\n+import { mkdir, rm, writeFile } from 'node:fs/promises';\n+import { createServer } from 'vite';\n+const revisions = execFileSync(\n+  'git',\n+  ['log', '--format=%H', '406a2b4', '--', 'src/links/style.js', 'src/links/style-geometry.js'],\n+  { encoding: 'utf8' },\n+)\n+  .trim()\n+  .split('\\n');\n+const server = await createServer({ server: { middlewareMode: true } });\n+const data = [];\n+try {\n+  const current = await server.ssrLoadModule('/src/links/style.js');\n+  const keys = new Set(current.STYLE_FIELDS.map((field) => field.key));\n+  for (const sha of revisions) {\n+    const dir = `experiments/out/issue-27-history/${sha}`;\n+    await mkdir(dir, { recursive: true });\n+    const archive = execFileSync('git', ['archive', sha, 'src'], { maxBuffer: 16 * 1024 * 1024 });\n+    execFileSync('tar', ['-x', '-C', dir], { input: archive });\n+    const legacy = await server.ssrLoadModule(`/${dir}/src/links/style.js`);\n+    const fields = legacy.STYLE_FIELDS.map(({ key, type, d, min, max, options }) => ({\n+      key,\n+      type,\n+      d,\n+      min,\n+      max,\n+      options: options?.map((option) => option.value),\n+    }));\n+    for (const field of fields) {\n+      assert(keys.has(field.key), `Removed historical URL key: ${sha} ${field.key}`);\n+      const now = current.STYLE_FIELDS.find(({ key }) => key === field.key);\n+      if (field.type === 'range') {\n+        assert(now.min <= field.min && now.max >= field.max, `Narrowed historical range: ${sha} ${field.key}`);\n+      }\n+      if (field.type === 'select')\n+        for (const value of field.options)\n+          assert(\n+            now.options.some((item) => item.value === value),\n+            `Removed historical enum: ${sha} ${field.key}=${value}`,\n+          );\n","exit_code":0,"status":"completed"}}
