pages/useNetworkHistory.js\nsrc/panels.css\nsrc/settings/applied.test.js\nsrc/settings/apply.js\nsrc/settings/fields.js\nsrc/settings/presets.js\nsrc/settings/presets.test.js\nsrc/settings/schema.background.js\nsrc/settings/schema.js\nsrc/settings/schema.layers.js\nsrc/settings/schema.skins.js\nsrc/settings/schema.sound.js\nsrc/settings/settings.test.js\nsrc/settings/store.js\nsrc/setupTests.js\nsrc/skins.frames.css\nsrc/skins.frames.js\nsrc/skins.frames.test.jsx\nsrc/skins.future.css\nsrc/skins.glass.css\nsrc/skins.liquid.css\nsrc/skins.palettes.css\nsrc/skins.test.jsx\nsrc/sound/engine.js\nsrc/sound/interactions.js\nsrc/sound/library.js\nsrc/sound/options.js\nsrc/sound/sound.test.jsx\nsrc/visuals/beams.js\nsrc/visuals/governor.js\nsrc/visuals/governor.test.js\nsrc/visuals/layers.test.jsx\nsrc/visuals/nebula.js\nsrc/visuals/rain.js\nsrc/visuals/size.js\nsrc/visuals/stars.js\nsrc/workflow.test.js\nname: Deploy to GitHub Pages\n\non:\n  push:\n    branches:\n      - main\n    paths-ignore:\n      - 'docs/**'\n      - 'dev/**'\n  pull_request:\n    branches:\n      - main\n  workflow_dispatch:\n\n# Least-privilege default; only the deploy job may publish to Pages.\npermissions:\n  contents: read\n\n# Cancel superseded pull request runs, but never a deploy on main.\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\n# actions/checkout runs `git init` before any step can configure Git; this\n# silences its \"default branch name\" hint.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # Lint the workflows themselves (actionlint also runs shellcheck on run: blocks).\n  lint-workflows:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Run actionlint\n        uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          args: -color\n\n  # Fast checks run before the tests and the build.\n  checks:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check file size limits\n        run: npm run check:file-size\n\n      - name: Check for secrets\n        run: npm run check:secrets\n\n      - name: Audit dependencies\n        run: npm audit --audit-level=moderate\n\n  test:\n    needs: [lint-workflows, checks, network-browsers]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n\n    steps:\n      # On pull requests this is the merge result with main, not the branch head.\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Run tests\n        run: npm run test:ci\n\n      - name: Build the React app\n        run: npm run build\n\n      # Issue #11: every CV (position × style × language) is printed to PDF by\n      # headless Chromium and checked: at most 2 pages for a position, 1 page\n      # for the compact style, and a text layer an ATS can read.\n      - name: Install Chromium for the CV PDFs\n        run: npx playwright install --with-deps chromium\n\n      - name: Print the CV PDFs\n        run: npm run build:cv\n\n      # GitHub Pages is set to deploy from GitHub Actions, so the site is\n      # published from this artifact, not from a branch or the docs/ folder.\n      # Pull requests upload it too, so a broken artifact fails before merge.\n      - name: Upload the build as the Pages artifact\n        uses: actions/upload-pages-artifact@v5\n        with:\n          path: build/\n          include-hidden-files: true\n\n  network-browsers:\n    needs: [lint-workflows, checks]\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 15\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - engine: chromium\n            os: ubuntu-24.04\n          - engine: firefox\n            os: ubuntu-24.04\n          # This container's Linux GTK renderer omits backdrop effects on\n          # screen. Test WebKit on macOS, the platform used by the reported bug.\n          - engine: webkit\n            os: macos-15\n    env:\n      ENGINE: ${{ matrix.engine }}\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Build the editor\n        run: npm run build\n\n      - name: Install the browser\n        id: browser\n        # package.json pins 1.63.0: 1.64.x's Linux WebKit stalls on glass panels.\n        # https://github.com/microsoft/playwright/issues/43426\n        run: npx playwright install --with-deps \"$ENGINE\"\n\n      - name: Verify existing editor features and image downloads\n        run: npm run test:network:browser\n        env:\n          CAPTURE_DIR: browser-results/screenshots/editor\n\n      - name: Verify history, self loops, layouts, clipboard and mobile editing\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue19\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue19\n          RESULT_DIR: browser-results/data/issue19\n\n      - name: Verify editor geometry, source colors and shared settings\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue21\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue21\n          RESULT_DIR: browser-results/data/issue21\n\n      - name: Verify curved markers, per-link gaps and bounded gallery blur surfaces\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        # Capture the actual compositor, including Firefox backdrop effects.\n        run: |\n          if [[ \"$RUNNER_OS\" == \"macOS\" ]]; then\n            DISPLAY_CAPTURE=1 npm run test:network:issue23\n          else\n            mkdir -p \"$(dirname \"$XWD_FILE\")\"\n            xvfb-run -a -s \"-screen 0 1600x1200x24 -fbdir $(dirname \"$XWD_FILE\")\" npm run test:network:issue23\n          fi\n        env:\n          CARD_BATCHES: '8' # The exact reported 4,131-card load, in every engine.\n          XWD_FILE: ${{ runner.temp }}/issue23-display/Xvfb_screen0\n          CAPTURE_DIR: browser-results/screenshots/issue23\n          RESULT_DIR: browser-results/data/issue23\n\n      - name: Verify automatic spacing, sharp balanced arrows and per-link cards\n        if: ${{ !cancelled() && steps.browser.outcome == 'success' }}\n        run: npm run test:network:issue25\n        env:\n          CAPTURE_DIR: browser-results/screenshots/issue25\n          RESULT_DIR: browser-results/data/issue25\n\n      - name: Preserve browser evidence\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: network-${{ matrix.engine }}\n          path: browser-results/\n          if-no-files-found: warn\n\n  deploy:\n    needs: test\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    permissions:\n      contents: read\n      pages: write\n      id-token: [REDACTED]    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v5\n\n      # A green deploy must mean the site is really there (issue #5).\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n          sparse-checkout: scripts\n\n      - name: Verify the deployed site\n        run: bash scripts/check-deployed-site.sh \"$PAGE_URL\"\n        env:\n          PAGE_URL: ${{ steps.deployment.outputs.page_url }}\n#!/usr/bin/env bash\n# Fails when a tracked source, style, markdown or workflow file exceeds\n# 1500 lines, and warns above 1350 lines. Collected data (docs/ case\n# studies, dev/log), lock files and generated JSON are not checked.\n# Adapted from link-foundation/js-ai-driven-development-pipeline-template.\nset -euo pipefail\n\nLIMIT=1500\nWARN_THRESHOLD=1350\nCHECKED=0\nFAILED=0\n\nwhile IFS= read -r file; do\n  [ -f \"$file\" ] || continue\n  lines=$(wc -l < \"$file\")\n  CHECKED=$((CHECKED + 1))\n  if [ \"$lines\" -gt \"$LIMIT\" ]; then\n    echo \"::error file=$file::$file has $lines lines (limit $LIMIT)\"\n    FAILED=1\n  elif [ \"$lines\" -gt \"$WARN_THRESHOLD\" ]; then\n    echo \"::warning file=$file::$file has $lines lines (warning threshold $WARN_THRESHOLD, limit $LIMIT)\"\n  fi\ndone < <(git ls-files -- '*.js' '*.jsx' '*.cjs' '*.mjs' '*.css' '*.md' '*.yml' '*.yaml' '*.sh' \\\n  ':!:docs/**' ':!:dev/**')\n\nif [ \"$CHECKED\" -eq 0 ]; then\n  echo \"::error::No files were checked; the file size gate is broken.\"\n  exit 2\nfi\necho \"Checked $CHECKED files against the $LIMIT-line limit.\"\nexit \"$FAILED\"\nimport js from '@eslint/js';\nimport globals from 'globals';\nimport reactHooks from 'eslint-plugin-react-hooks';\nimport reactRefresh from 'eslint-plugin-react-refresh';\n\nexport default [\n  { ignores: ['build/**', 'docs/**', 'dev/**', 'coverage/**', 'node_modules/**'] },\n  js.configs.recommended,\n  {\n    files: ['**/*.{js,jsx}'],\n    languageOptions: {\n      ecmaVersion: 'latest',\n      sourceType: 'module',\n      globals: { ...globals.browser },\n      parserOptions: { ecmaFeatures: { jsx: true } },\n    },\n    plugins: { 'react-hooks': reactHooks, 'react-refresh': reactRefresh },\n    rules: {\n      ...reactHooks.configs.recommended.rules,\n      // Core no-unused-vars does not see JSX usage; components are PascalCase.\n      'no-unused-vars': ['error', { varsIgnorePattern: '^[A-Z_]' }],\n      'max-lines': ['error', { max: 1500, skipBlankLines: false, skipComments: false }],\n    },\n  },\n  {\n    files: ['**/*.test.{js,jsx}', 'src/setupTests.js'],\n    languageOptions: { globals: { ...globals.node, ...globals.vitest } },\n  },\n  {\n    files: ['**/*.cjs', '**/*.mjs', 'experiments/**/*.js', 'vite.config.js', 'eslint.config.js'],\n    languageOptions: { globals: { ...globals.node } },\n  },\n  { files: ['**/*.cjs'], languageOptions: { sourceType: 'commonjs' } },\n];\n# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.\n\n# dependencies\n/node_modules\n/.pnp\n.pnp.js\n\n# testing\n/coverage\n\n# production\n/build\n\n# misc\n.DS_Store\n.env.local\n.env.development.local\n.env.test.local\n.env.production.local\n\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\n\n# playwright\n/.playwright-mcp\n\n# contact sheets and screenshots written by experiments/contact-sheet.mjs\n/experiments/out\n406a2b4 Initial commit with task details\n4893407 Merge pull request #26 from konard/issue-25-665823cdf9ad\n09160c7 Archive issue 25 investigation, reproductions and cross-browser evidence\nffce48f Supersample acute arrow paint consistently across browser platforms\n3d077c2 Group all per-link settings in responsive cards and verify native arrow paint\na9001c9 Optimize painted spacing and b