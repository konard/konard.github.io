[2026-10-27T19:54:55.775Z] [STDOUT] {"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"sed -n '425,540p' src/links/glyph.js && cat src/links/geometry-21.test.js && cat src/links/solver-23.test.js && rg -n 'turns|gaps|styleToParams|gap=' src/links/network.test.js src/links/geometry-19.test.js src/pages/network*.test.jsx | head -110 && git show 7be35e9:src/links/style.js | tail -165 && git show 305a85e:src/links/style.js | tail -155\"","aggregated_output":"  return glyphCurves(links, o).map((raw, i) => {\n    const curve = paintedCurve(raw, o);\n    const { segments } = curve;\n    const marks = curveMarkers(curve, o);\n    const middleGapStart = o.linkGaps[i]?.[2] ?? o.middleGapStart;\n    const middleGapEnd = o.linkGaps[i]?.[3] ?? o.middleGapEnd;\n    const split = middleGapStart > 0 || middleGapEnd > 0;\n    const visible = [trimCurve(segments[0], middleGapStart), trimCurve(segments[1], middleGapEnd, true)].filter(\n      Boolean,\n    );\n    const line = split\n      ? visible.map((seg) => `M${fmt(seg[0])}C${seg.slice(1).map(fmt).join(' ')}`).join('')\n      : `M${fmt(segments[0][0])}` + segments.map((seg) => `C${seg.slice(1).map(fmt).join(' ')}`).join('');\n    return {\n      line,\n      ...marks,\n      color: COLORS[i % COLORS.length],\n    };\n  });\n}\n\n/** One SVG path per link: the continuous line, the source bar and the target arrow. */\nexport function glyphPaths(links, shape = {}) {\n  return glyphParts(links, shape).map(({ line, start, end, middle, color }) => ({\n    d: line + start.d + end.d + middle.d,\n    color,\n  }));\n}\n\n/** A standalone SVG document of a network (used by tests and experiments). */\nexport function glyphSvg(links, size = SIZE) {\n  const paths = glyphPaths(links)\n    .map(({ d, color }) => `<path d=\"${d}\" stroke=\"${color}\"/>`)\n    .join('');\n  return (\n    `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${size}\" height=\"${size}\" viewBox=\"0 0 ${SIZE} ${SIZE}\" ` +\n    `fill=\"none\" stroke-width=\"${STROKE}\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${paths}</svg>`\n  );\n}\nimport { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { describe, expect, it } from 'vitest';\nimport { codeAt, decode, networkCount } from './configurations';\nimport { COLORS, bezier, glyphSvg, layoutCurves } from './glyph';\nimport { STYLE_DEFAULTS, linkColors, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams } from './style';\n\nconst shape = (raw = {}, n = 1) => shapeOfStyle(normalizeStyle(raw), n);\nconst near = (a, b) => expect(Math.hypot(a[0] - b[0], a[1] - b[1])).toBeLessThan(1e-10);\nconst symmetric = ({ segments: [first, second], middle }) => {\n  for (let k = 0; k <= 32; k++) {\n    const p = bezier(first, 1 - k / 32);\n    near(bezier(second, k / 32), [2 * middle.at[0] - p[0], 2 * middle.at[1] - p[1]]);\n  }\n};\n\ndescribe('balanced editor geometry (issue #21)', () => {\n  it('makes equal self-reference ends point-symmetric for all equal angles and bends', () => {\n    for (const angle of [-60, 0, 24, 30, 60]) {\n      for (const bulge of [0, 19, 20, 25, 45, 90]) {\n        const links = decode('11 22');\n        for (const curve of layoutCurves(links, shape({ sourceAngle: angle, targetAngle: angle, bulge }, 2))) {\n          symmetric(curve);\n        }\n      }\n    }\n  });\n\n  it('changes curvature without moving free/loop anchors or rotating the whole symbol', () => {\n    for (const links of [decode('00'), decode('11'), decode('00 00 00 00'), decode('11 22')]) {\n      const a = layoutCurves(links, shape({ bulge: 10 }, links.length));\n      const b = layoutCurves(links, shape({ bulge: 60 }, links.length));\n      expect(b).not.toEqual(a);\n      a.forEach((curve, i) => {\n        near(b[i].start.at, curve.start.at);\n        near(b[i].end.at, curve.end.at);\n        near(b[i].middle.at, curve.middle.at);\n        symmetric(curve);\n        symmetric(b[i]);\n      });\n    }\n  });\n\n  it('starts with a centered cross made by a bar intersecting the line', () => {\n    expect(STYLE_DEFAULTS.start).toBe('bar');\n    expect(STYLE_DEFAULTS.startOffset).toBe(STYLE_DEFAULTS.startSize);\n    expect(STYLE_DEFAULTS.startAcross).toBe(0);\n    expect(STYLE_DEFAULTS.startRotation).toBe(0);\n  });\n\n  it('uses gallery colors until the user explicitly changes them', () => {\n    expect(linkColors(STYLE_DEFAULTS, 4)).toEqual(COLORS.slice(0, 4));\n    expect(linkColors(normalizeStyle({ palette: 'custom', colors: '#ff2600,#00f900' }), 2)).toEqual([\n      '#ff2600',\n      '#00f900',\n    ]);\n  });\n\n  it('keeps every explicit supplied setting through query serialization in both directions', () => {\n    for (const query of [\n      'sourceAngle=24&targetAngle=40&tension=0.4&bulge=25&startGap=0.09&startOffset=2.9',\n      'bulge=19&padding=10&startOffset=2.5',\n    ]) {\n      const params = new URLSearchParams(query);\n      const style = styleFromParams(params);\n      for (const [key, value] of params) expect(style[key]).toBe(Number(value));\n      expect(styleFromParams(styleToParams(style))).toEqual(style);\n    }\n  });\n\n  it('preserves the gallery and rain SVG byte for byte', () => {\n    const baseline = JSON.parse(readFileSync('docs/case-studies/issue-21/data/gallery-baseline.json'));\n    for (const n of [1, 2, 3, 4]) {\n      const hash = createHash('sha256');\n      for (let i = 0; i < baseline[n].count; i++) {\n        const index = n < 4 ? i : Math.floor((i * (networkCount(n) - 1)) / (baseline[n].count - 1));\n        hash.update(glyphSvg(decode(codeAt(n, index))));\n      }\n      expect(hash.digest('hex')).toBe(baseline[n].sha256);\n    }\n  });\n});\n\ndescribe('editor symmetry and compatibility', () => {\n  it('keeps four free links related by exact quarter turns, including after fitting', async () => {\n    const { glyphCurves } = await import('./glyph');\n    const curves = glyphCurves(decode('00 00 00 00'), shape({}, 4));\n    for (let i = 0; i < 4; i++) {\n      curves[i].segments.forEach((segment, k) =>\n        segment.forEach((p, j) => {\n          near(curves[(i + 1) % 4].segments[k][j], [100 - p[1], p[0]]);\n        }),\n      );\n    }\n  });\n\n  it('makes the source bar exactly centered and perpendicular to its tangent', async () => {\n    const { glyphCurves, glyphParts } = await import('./glyph');\n    const options = shape({ bulge: 0 });\n    const [curve] = glyphCurves([[0, 0]], options);\n    const [parts] = glyphParts([[0, 0]], options);\n    const [x1, y1, x2, y2] = parts.start.d.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\n    const center = [(x1 + x2) / 2, (y1 + y2) / 2];\n    near(center, [curve.start.at[0] + options.startOffset, curve.start.at[1]]);\n    expect(x1).toBe(x2);\n    expect(y1 - center[1]).toBe(center[1] - y2);\n    expect(Math.hypot(x1 - x2, y1 - y2)).toBe(2 * options.startSize);\n  });\n\n  it('honors colors stored by links shared when custom was the default', () => {\n    const style = styleFromParams(new URLSearchParams('colors=%23ff2600,%2300f900'));\n    expect(style.palette).toBe('custom');\n    expect(linkColors(style, 2)).toEqual(['#ff2600', '#00f900']);\n  });\n\n  it('keeps all small editor configurations finite and continuous', () => {\n    for (const n of [1, 2, 3]) {\n      for (let i = 0; i < networkCount(n); i++) {\n        const curves = layoutCurves(decode(codeAt(n, i)), shape({}, n));\n        for (const {\n          segments: [a, b],\n        } of curves) {\n          expect(a.flat().concat(b.flat()).every(Number.isFinite)).toBe(true);\n          near(a[3], b[0]);\n          const incoming = [a[3][0] - a[2][0], a[3][1] - a[2][1]];\n          const outgoing = [b[1][0] - b[0][0], b[1][1] - b[0][1]];\n          expect(Math.abs(incoming[0] * outgoing[1] - incoming[1] * outgoing[0])).toBeLessThan(1e-10);\n          expect(incoming[0] * outgoing[0] + incoming[1] * outgoing[1]).toBeGreaterThan(0);\n        }\n      }\n    }\n  });\n});\nimport { expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { overlapCost, pairCost, solveCollisions } from './collisions';\nimport { withGaps } from './gaps';\nimport { bezier, glyphCurves } from './glyph';\nimport { networkSvg } from './render';\nimport { STYLE_DEFAULTS, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams, withTurns } from './style';\n\nit('reduces overlaps by adjusting individual gaps with angle search disabled', () => {\n  const links = decode('22 13 31');\n  const shape = shapeOfStyle(STYLE_DEFAULTS, 3);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(result.delta.flat().every((angle) => angle === 0)).toBe(true);\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row.some((value) => value !== null))).toBe(true);\n  const applied = withGaps(withTurns(STYLE_DEFAULTS, result.turns), result.linkGaps);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n  expect(networkSvg(links, applied)).toBe(\n    networkSvg(links, STYLE_DEFAULTS, {\n      extraTurns: result.delta,\n      extraGaps: result.linkGaps,\n    }),\n  );\n  expect(styleFromParams(styleToParams(applied))).toEqual(normalizeStyle(applied));\n});\nit('bounds manual gap adjustments, preserves the input and never increases the exact score', () => {\n  const links = decode('23 31 12');\n  const style = normalizeStyle({ gaps: '0.5 0.7 20 25,0.4 0.3 2 3' });\n  const shape = shapeOfStyle(style, 3);\n  const original = structuredClone(shape);\n  const result = solveCollisions(links, shape, { adjustGaps: true, gapRange: 0.1, middleRange: 2 });\n  expect(shape).toEqual(original);\n  expect(result.after).toBeLessThanOrEqual(result.before);\n  result.linkGaps.forEach((row, i) =>\n    row.forEach((value, k) => {\n      const initial =\n        original.linkGaps[i]?.[k] ?? original[['startGap', 'endGap', 'middleGapStart', 'middleGapEnd'][k]];\n      expect(Math.abs((value ?? initial) - initial)).toBeLessThanOrEqual((k < 2 ? 0.1 : 2) + 1e-9);\n    }),\n  );\n  const applied = withGaps(withTurns(style, result.turns), result.linkGaps);\n  expect(overlapCost(links, shapeOfStyle(applied, 3))).toBeCloseTo(result.after, 6);\n});\nit('does not count an artificial crossing through a cut in the middle', () => {\n  const line = [[-1, 0], [-0.4, 0], null, [0.4, 0], [1, 0]];\n  const cross = [\n    [0, -1],\n    [0, 1],\n  ];\n  expect(pairCost(line, cross, [])).toBe(0);\n  expect(pairCost(line.filter(Boolean), cross, [])).toBeGreaterThan(0);\n});\n\nit('also reduces overlaps by center cuts alone, without reference gap or angle changes', () => {\n  const links = decode('22 13 31');\n  const result = solveCollisions(links, shapeOfStyle(STYLE_DEFAULTS, 3), {\n    range: 0,\n    adjustGaps: true,\n    gapRange: 0,\n    middleRange: 15,\n  });\n  expect(result.after).toBeLessThan(result.before);\n  expect(result.linkGaps.some((row) => row[2] > 0 || row[3] > 0)).toBe(true);\n  expect(result.linkGaps.every((row) => row[0] === null && row[1] === null)).toBe(true);\n  expect(result.turns.flat().every((value) => value === 0)).toBe(true);\n});\n\nit('bounds gap search cost for a dense 24-link drawing and returns its exact score', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const started = performance.now();\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true });\n  expect(performance.now() - started).toBeLessThan(10000);\n  expect(result.after).toBeLessThan(result.before);\n  expect(overlapCost(links, { ...shape, turns: result.turns, linkGaps: result.linkGaps })).toBeCloseTo(result.after, 8);\n}, 15000);\n\nit('keeps automatic cuts within the final fitted half-length after reference gaps change', () => {\n  const links = Array.from({ length: 24 }, (_, i) => [((i + 1) % 24) + 1, ((i + 12) % 24) + 1]);\n  const shape = shapeOfStyle(STYLE_DEFAULTS, links.length);\n  const result = solveCollisions(links, shape, { range: 0, adjustGaps: true, gapRange: 1, middleRange: 15 });\n  expect(result.after).toBeLessThan(result.before);\n  const fitted = { ...shape, turns: result.turns, linkGaps: result.linkGaps };\n  glyphCurves(links, fitted).forEach((curve, i) => {\n    curve.segments.forEach((segment, k) => {\n      let length = 0;\n      let previous = segment[0];\n      for (let j = 1; j <= 1024; j++) {\n        const point = bezier(segment, j / 1024);\n        length += Math.hypot(point[0] - previous[0], point[1] - previous[1]);\n        previous = point;\n      }\n      expect(result.linkGaps[i]?.[k + 2] ?? 0).toBeLessThanOrEqual(length * 0.3 + 0.001);\n    });\n  });\n  expect(overlapCost(links, fitted)).toBeCloseTo(result.after, 8);\n}, 15000);\nsrc/links/geometry-19.test.js:21:  it('sets source/target gaps independently, including self loops', () => {\nsrc/pages/network-23.test.jsx:16:it('edits independent gaps, resets inheritance and preserves gaps when removing a link', () => {\nsrc/pages/network-23.test.jsx:27:  expect(new URLSearchParams(window.location.search).get('gaps')).toBe('0.25 ~ ~ ~,~ ~ ~ 4');\nsrc/pages/network-23.test.jsx:32:  expect(new URLSearchParams(window.location.search).has('gaps')).toBe(false);\nsrc/pages/network.test.jsx:126:  it('edits the links one by one: references, colours, turns, adding and removing', () => {\nsrc/pages/network.test.jsx:137:    expect(new URLSearchParams(search()).get('turns')).toBe('0 0,0 30');\nsrc/pages/network.test.jsx:141:    expect(new URLSearchParams(search()).get('turns')).toBe('0 30');\nsrc/pages/network.test.jsx:169:    fireEvent.click(screen.getByRole('button', { name: 'Apply turns and gaps to links' }));\nsrc/pages/network.test.jsx:170:    expect(new URLSearchParams(search()).get('turns')).toMatch(/-?\\d+ -?\\d+/);\nsrc/pages/network.test.jsx:172:    fireEvent.click(screen.getByRole('button', { name: 'Clear all turns' }));\nsrc/pages/network.test.jsx:173:    expect(new URLSearchParams(search()).get('turns')).toBeNull();\nsrc/links/network.test.js:32:  styleToParams,\nsrc/links/network.test.js:124:      turns: '30 -400,abc',\nsrc/links/network.test.js:132:    expect(style.turns).toBe('30 -180');\nsrc/links/network.test.js:138:    expect(styleToParams(STYLE_DEFAULTS).toString()).toBe('');\nsrc/links/network.test.js:139:    const style = normalizeStyle({ card: false, bgColor: '#000000', end: 'dot', turns: '15 -30' });\nsrc/links/network.test.js:140:    const params = styleToParams(style);\nsrc/links/network.test.js:141:    expect(Object.fromEntries(params)).toEqual({ end: 'dot', turns: '15 -30' });\nsrc/links/network.test.js:146:  it('gives each link a colour and turns', () => {\nsrc/links/network.test.js:160:    expect(turned.turns).toBe('10 20,0 -45');\nsrc/links/network.test.js:166:    expect(withTurns(STYLE_DEFAULTS, [[0, 0]]).turns).toBe('');\nsrc/links/network.test.js:171:      ]).turns,\nsrc/links/network.test.js:178:  it('offers both a card and a plain black background, and keeps the hand-made turns', () => {\nsrc/links/network.test.js:180:    const turned = normalizeStyle({ turns: '10 20', strokeWidth: 5 });\nsrc/links/network.test.js:182:    expect(black).toMatchObject({ card: false, background: 'solid', bgColor: '#000000', turns: '10 20' });\nsrc/links/network.test.js:236:  it('turns the ends of the links so that their lines cross and touch less', () => {\nsrc/links/network.test.js:241:    expect(result.turns).toHaveLength(3);\nsrc/links/network.test.js:243:    // The turns found draw the same improved picture.\nsrc/links/network.test.js:244:    const turned = shapeOfStyle(withTurns(STYLE_DEFAULTS, result.turns), 3);\nsrc/links/network.test.js:255:  it('keeps solved turns editable and preserves the preview when they are applied', () => {\nsrc/links/network.test.js:258:      const style = normalizeStyle({ turns: '180 180,-180 180,170 -170' });\nsrc/links/network.test.js:262:        result.turns.flat().every((angle) => Math.abs(angle) <= 180),\nsrc/links/network.test.js:265:      const applied = shapeOfStyle(withTurns(style, result.turns), network.length);\n      const number = typeof value === 'number' ? value : Number(value);\n      return Number.isFinite(number) && value !== '' && value !== null ? clamp(number, field.min, field.max) : field.d;\n    }\n    case 'toggle':\n      if (typeof value === 'boolean') return value;\n      return value === 'true' || value === '1' ? true : value === 'false' || value === '0' ? false : field.d;\n    case 'select':\n      return field.options.some((o) => o.value === value) ? value : field.d;\n    case 'color':\n      return HEX.test(value) ? value.toLowerCase() : field.d;\n    case 'text':\n      return typeof value === 'string' ? value.slice(0, field.max) : field.d;\n    default:\n      return normalizeList(field.key, value);\n  }\n}\n\n/** A complete, valid style: every option of `raw` checked, the rest the defaults. */\nexport function normalizeStyle(raw = {}) {\n  return Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, normalizeValue(field, raw?.[field.key])]));\n}\n\n/** The options that differ from the defaults as query parameters. */\nexport function styleToParams(style) {\n  const params = new URLSearchParams();\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (style[key] !== STYLE_DEFAULTS[key]) params.set(key, String(style[key]));\n  });\n  return params;\n}\n\n/** A style read from query parameters (unknown or invalid values are left out). */\nexport function styleFromParams(params) {\n  const raw = {};\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i];\n    return (PALETTES[style.palette] || COLORS)[i];\n  });\n}\n\n/** The [source, target] turns of each of `n` links, in degrees. */\nexport function linkTurns(style, n) {\n  const turns = style.turns ? style.turns.split(',').map((pair) => pair.split(' ').map(Number)) : [];\n  return Array.from({ length: n }, (_, i) => turns[i] || [0, 0]);\n}\n\n/** A style with the turns of each link set to `turns` ([[source, target], …]). */\nexport const withTurns = (style, turns) =>\n  normalizeStyle({ ...style, turns: turns.map((pair) => pair.join(' ')).join(',') });\n\n/** A style where link `i` has its own colour `value` (the other links keep the colours they had). */\nexport function withColor(style, n, i, value) {\n  const colors = linkColors(style, Math.max(n, MAX_LINKS));\n  colors[i] = value;\n  return normalizeStyle({ ...style, palette: 'custom', colors: colors.join(',') });\n}\n\n/** The shape options of glyph.js taken from a style. */\nexport function shapeOfStyle(style, n, extraTurns = null) {\n  const turns = linkTurns(style, n).map((pair, i) =>\n    extraTurns ? [pair[0] + extraTurns[i][0], pair[1] + extraTurns[i][1]] : pair,\n  );\n  return Object.fromEntries([\n    ...Object.keys(SHAPE)\n      .filter((key) => key !== 'turns')\n      .map((key) => [key, style[key]]),\n    ['turns', turns],\n  ]);\n}\n\n/**\n * Looks to start from. A look changes only the options it names and keeps the\n * per-link turns, so a picture can be restyled without losing its hand work.\n * \"Do we need a card at all?\" (issue #17): both are here, the card of the\n * gallery and a plain black background with only the links.\n */\nexport const LOOKS = [\n  { id: 'card', label: { en: 'Card (as in the gallery)', ru: 'Карточка (как в галерее)' }, values: {} },\n  {\n    id: 'black',\n    label: { en: 'Plain black', ru: 'Просто чёрный' },\n    values: { card: false, background: 'solid', bgColor: '#000000' },\n  },\n  {\n    id: 'transparent',\n    label: { en: 'Transparent', ru: 'Прозрачный' },\n    values: { card: false, background: 'transparent' },\n  },\n  {\n    id: 'paper',\n    label: { en: 'Paper', ru: 'Бумага' },\n    values: { card: false, background: 'solid', bgColor: '#f8fafc', palette: 'print', captionColor: '#334155' },\n  },\n  {\n    id: 'blueprint',\n    label: { en: 'Blueprint', ru: 'Чертёж' },\n    values: {\n      background: 'solid',\n      bgColor: '#0b3d91',\n      card: true,\n      cardColor: '#0b3d91',\n      cardOpacity: 1,\n      borderStyle: 'dashed',\n      borderColor: '#93c5fd',\n      radius: 0,\n      palette: 'mono',\n      monoColor: '#e0f2fe',\n      strokeWidth: 1.6,\n      middle: 'dot',\n      captionColor: '#bfdbfe',\n    },\n  },\n  {\n    id: 'neon',\n    label: { en: 'Neon', ru: 'Неон' },\n    values: {\n      background: 'radial',\n      bgColor: '#1a0533',\n      bgColor2: '#020008',\n      card: true,\n      cardColor: '#05010d',\n      cardOpacity: 0.6,\n      borderColor: '#ff00e6',\n      border: 0.8,\n      palette: 'neon',\n      glow: 3,\n      strokeWidth: 2.8,\n    },\n  },\n  {\n    id: 'social',\n    label: { en: 'Social card 1200 × 630', ru: 'Карточка для соцсетей 1200 × 630' },\n    values: { width: 1200, height: 630, caption: 'theory', captionSize: 5 },\n  },\n];\n\n/** `style` with look `id` applied. */\nexport function applyLook(style, id) {\n  const look = LOOKS.find((l) => l.id === id);\n  if (!look) return style;\n  const keep = { turns: style.turns, solve: style.solve, solveRange: style.solveRange, solveStep: style.solveStep };\n  const size = look.values.width ? {} : { width: style.width, height: style.height, quality: style.quality };\n  return normalizeStyle({ ...STYLE_DEFAULTS, ...size, ...look.values, ...keep });\n}\n\n/** Image sizes for the usual places a picture is shared to. */\nexport const SIZES = [\n  { label: '512 × 512', width: 512, height: 512 },\n  { label: '1024 × 1024', width: 1024, height: 1024 },\n  { label: '2048 × 2048', width: 2048, height: 2048 },\n  { label: 'Instagram 1080 × 1080', width: 1080, height: 1080 },\n  { label: 'Open Graph 1200 × 630', width: 1200, height: 630 },\n  { label: 'X 1600 × 900', width: 1600, height: 900 },\n  { label: 'Stories 1080 × 1920', width: 1080, height: 1920 },\n];\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i % COLORS.length];\n    const palette = PALETTES[style.palette] || COLORS;\n    return palette[i % palette.length];\n  });\n}\n\n/** The [source, target] turns of each of `n` links, in degrees. */\nexport function linkTurns(style, n) {\n  const turns = style.turns ? style.turns.split(',').map((pair) => pair.split(' ').map(Number)) : [];\n  return Array.from({ length: n }, (_, i) => turns[i] || [0, 0]);\n}\n\n/** A style with the turns of each link set to `turns` ([[source, target], …]). */\nexport const withTurns = (style, turns) =>\n  normalizeStyle({ ...style, turns: turns.map((pair) => pair.join(' ')).join(',') });\n\n/** A style where link `i` has its own colour `value` (the other links keep the colours they had). */\nexport function withColor(style, n, i, value) {\n  const colors = linkColors(style, Math.max(n, COLORS.length));\n  colors[i] = value;\n  return normalizeStyle({ ...style, palette: 'custom', colors: colors.join(',') });\n}\n\n/** The shape options of glyph.js taken from a style. */\nexport function shapeOfStyle(style, n, extraTurns = null) {\n  const turns = linkTurns(style, n).map((pair, i) =>\n    extraTurns ? [pair[0] + extraTurns[i][0], pair[1] + extraTurns[i][1]] : pair,\n  );\n  return Object.fromEntries([\n    ...Object.keys(SHAPE)\n      .filter((key) => key !== 'turns')\n      .map((key) => [key, style[key]]),\n    ['turns', turns],\n    ['strokeWidth', style.strokeWidth],\n  ]);\n}\n\n/**\n * Looks to start from. A look changes only the options it names and keeps the\n * per-link turns, so a picture can be restyled without losing its hand work.\n * \"Do we need a card at all?\" (issue #17): both are here, the card of the\n * gallery and a plain black background with only the links.\n */\nexport const LOOKS = [\n  {\n    id: 'card',\n    label: { en: 'Card (as in the gallery)', ru: 'Карточка (как в галерее)' },\n    values: {\n      ...SHAPE,\n      startGap: SHAPE.gap,\n      endGap: SHAPE.gap,\n      gap: SHAPE.gap,\n      strokeWidth: 2.4,\n      linejoin: 'round',\n      palette: 'site',\n      colors: '',\n      card: true,\n      bgColor: '#070b14',\n      placement: 'circle',\n    },\n  },\n  {\n    id: 'black',\n    label: { en: 'Plain black', ru: 'Просто чёрный' },\n    values: { card: false, background: 'solid', bgColor: '#000000' },\n  },\n  {\n    id: 'transparent',\n    label: { en: 'Transparent', ru: 'Прозрачный' },\n    values: { card: false, background: 'transparent' },\n  },\n  {\n    id: 'paper',\n    label: { en: 'Paper', ru: 'Бумага' },\n    values: { card: false, background: 'solid', bgColor: '#f8fafc', palette: 'print', captionColor: '#334155' },\n  },\n  {\n    id: 'blueprint',\n    label: { en: 'Blueprint', ru: 'Чертёж' },\n    values: {\n      background: 'solid',\n      bgColor: '#0b3d91',\n      card: true,\n      cardColor: '#0b3d91',\n      cardOpacity: 1,\n      borderStyle: 'dashed',\n      borderColor: '#93c5fd',\n      radius: 0,\n      palette: 'mono',\n      monoColor: '#e0f2fe',\n      strokeWidth: 1.6,\n      middle: 'dot',\n      captionColor: '#bfdbfe',\n    },\n  },\n  {\n    id: 'neon',\n    label: { en: 'Neon', ru: 'Неон' },\n    values: {\n      background: 'radial',\n      bgColor: '#1a0533',\n      bgColor2: '#020008',\n      card: true,\n      cardColor: '#05010d',\n      cardOpacity: 0.6,\n      borderColor: '#ff00e6',\n      border: 0.8,\n      palette: 'neon',\n      glow: 3,\n      strokeWidth: 2.8,\n    },\n  },\n  {\n    id: 'social',\n    label: { en: 'Social card 1200 × 630', ru: 'Карточка для соцсетей 1200 × 630' },\n    values: { width: 1200, height: 630, caption: 'theory', captionSize: 5 },\n  },\n];\n\n/** `style` with look `id` applied. */\nexport function applyLook(style, id) {\n  const look = LOOKS.find((l) => l.id === id);\n  if (!look) return style;\n  const keep = {\n    notation: style.notation,\n    turns: style.turns,\n    solve: style.solve,\n    solveRange: style.solveRange,\n    solveStep: style.solveStep,\n  };\n  const size = look.values.width ? {} : { width: style.width, height: style.height, quality: style.quality };\n  return normalizeStyle({ ...STYLE_DEFAULTS, ...size, ...look.values, ...keep });\n}\n\n/** Image sizes for the usual places a picture is shared to. */\nexport const SIZES = [\n  { label: '512 × 512', width: 512, height: 512 },\n  { label: '1024 × 1024', width: 1024, height: 1024 },\n  { label: '2048 × 2048', width: 2048, height: 2048 },\n  { label: 'Instagram 1080 × 1080', width: 1080, height: 1080 },\n  { label: 'Open Graph 1200 × 630', width: 1200, height: 630 },\n  { label: 'X 1600 × 900', width: 1600, height: 900 },\n  { label: 'Stories 1080 × 1920', width: 1080, height: 1920 },\n];\n","exit_code":0,"status":"completed"}}
