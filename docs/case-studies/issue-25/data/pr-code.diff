+      const r = second.a;
+      const s = second.b;
+      const crosses = intersects(p, q, r, s);
+      const distance = crosses
+        ? 0
+        : Math.sqrt(
+            Math.min(
+              pointDistance2(p, r, s),
+              pointDistance2(q, r, s),
+              pointDistance2(r, p, q),
+              pointDistance2(s, p, q),
+            ),
+          );
