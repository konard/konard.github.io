+import { afterEach, expect, it, vi } from 'vitest';
+import { watchPanelVisibility } from './panelVisibility';
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  document.body.replaceChildren();
+});
+it('bounds live panels, observes appended lists and cleans up removed panels', async () => {
+  let enter;
+  const observer = { observe: vi.fn(), unobserve: vi.fn(), disconnect: vi.fn() };
+  vi.stubGlobal(
+    'IntersectionObserver',
+    vi.fn(function (callback, options) {
+      enter = callback;
+      expect(options.rootMargin).toBe('200px 0px');
+      return observer;
+    }),
+  );
+  const root = document.createElement('main');
+  root.innerHTML = '<ul class="symbols__grid"><li>card</li></ul><article class="post">post</article>';
+  document.body.append(root);
+  const cleanup = watchPanelVisibility(root);
+  const card = root.querySelector('li');
+  const post = root.querySelector('.post');
+  expect(observer.observe).toHaveBeenCalledTimes(2);
+  expect(root.dataset.panelVisibility).toBe('on');
+  enter([
+    { target: card, isIntersecting: true },
+    { target: post, isIntersecting: false },
+  ]);
+  expect(card.dataset.inViewport).toBe('true');
+  expect(post.dataset.inViewport).toBeUndefined();
+  const repo = document.createElement('article');
+  repo.className = 'repo';
+  root.append(repo);
+  await Promise.resolve();
+  expect(observer.observe).toHaveBeenCalledWith(repo);
+  card.remove();
+  await Promise.resolve();
+  expect(observer.unobserve).toHaveBeenCalledWith(card);
+  enter([{ target: post, isIntersecting: true }]);
+  cleanup();
+  expect(observer.disconnect).toHaveBeenCalledOnce();
+  expect(root.dataset.panelVisibility).toBeUndefined();
+  expect(post.dataset.inViewport).toBeUndefined();
+});
+it('preserves the original presentation if IntersectionObserver is unavailable', () => {
+  vi.stubGlobal('IntersectionObserver', undefined);
+  const root = document.createElement('main');
+  watchPanelVisibility(root)();
+  expect(root.dataset.panelVisibility).toBeUndefined();
+});
diff --git a/src/links/collision-gap-cache.js b/src/links/collision-gap-cache.js
new file mode 100644
index 0000000..e4f3e5f
--- /dev/null
+++ b/src/links/collision-gap-cache.js
@@ -0,0 +1,63 @@
+// Changing one gap normally affects only that link's pair scores. A reference
+// gap can also change the fitted scale: then every existing image-unit middle
+// cut must be rescored. Keep that uncommon case exact as well.
+import { pairCost, visiblePolyline } from './collisions';
+import { curveTransform } from './glyph';
+
+export class GapScoreCache {
+  constructor(curves, shape) {
+    this.curves = curves;
+    this.shape = shape;
+    this.middles = curves.map((curve) => curve.middle.at);
+    Object.assign(this, this.fullState(curveTransform(curves, shape).scale));
+  }
+
+  fullState(scale) {
+    const lines = this.curves.map((curve, i) => visiblePolyline(curve, this.shape, i, scale));
+    const pairs = lines.map(() => Array(lines.length).fill(0));
+    let total = 0;
+    for (let i = 0; i < lines.length; i++)
+      for (let j = i + 1; j < lines.length; j++) {
+        pairs[i][j] = pairs[j][i] = pairCost(lines[i], lines[j], this.middles);
+        total += pairs[i][j];
+      }
+    return { scale, lines, pairs, total };
+  }
+
+  measure(i, curve) {
+    const previous = this.curves[i];
+    this.curves[i] = curve;
+    const scale = curve === previous ? this.scale : curveTransform(this.curves, this.shape).scale;
+    const cuts = this.curves.some(
+      (_, j) =>
+        (this.shape.linkGaps[j]?.[2] ?? this.shape.middleGapStart) > 0 ||
+        (this.shape.linkGaps[j]?.[3] ?? this.shape.middleGapEnd) > 0,
+    );
+    let state;
+    if (scale !== this.scale && cuts) state = this.fullState(scale);
+    else {
+      const line = visiblePolyline(curve, this.shape, i, scale);
+      const pairRow = this.lines.map((other, j) => (i === j ? 0 : pairCost(line, other, this.middles)));
+      const sum = (values) => values.reduce((a, b) => a + b, 0);
+      state = { scale, line, pairRow, total: this.total - sum(this.pairs[i]) + sum(pairRow) };
+    }
+    this.curves[i] = previous;
+    return { ...state, i, curve };
+  }
+
+  accept(state) {
+    const { i, curve, scale, total } = state;
+    this.curves[i] = curve;
+    this.scale = scale;
+    this.total = total;
+    if (state.lines) {
+      this.lines = state.lines;
+      this.pairs = state.pairs;
+    } else {
+      this.lines[i] = state.line;
+      state.pairRow.forEach((cost, j) => {
+        this.pairs[i][j] = this.pairs[j][i] = cost;
+      });
+    }
+  }
+}
diff --git a/src/links/collision-gaps.js b/src/links/collision-gaps.js
new file mode 100644
index 0000000..094014f
--- /dev/null
+++ b/src/links/collision-gaps.js
@@ -0,0 +1,80 @@
+// A second coordinate-descent stage: try modest gaps after turning the ends.
+// Score the exact visible curves and penalize extra cuts so the solver cannot
+// "solve" a diagram by erasing it. Manual gaps remain the starting point.
+import { overlapCost } from './collisions';
+import { GapScoreCache } from './collision-gap-cache';
+import { GAP_FIELDS } from './gaps';
+import { bezier, layout, layoutCurves, linkCurve } from './glyph';
+
+export function adjustCollisionGaps(links, base, result, { gapRange, middleRange, passes }) {
+  gapRange = Math.min(1, Math.max(0, Number(gapRange) || 0));
+  middleRange = Math.min(15, Math.max(0, Number(middleRange) || 0));
+  const rows = links.map((_, i) => GAP_FIELDS.map((_, k) => base.linkGaps[i]?.[k] ?? null));
+  const initial = rows.map((row) => row.map((v, k) => v ?? base[GAP_FIELDS[k].key] ?? base.gap));
+  const currentShape = () => ({ ...base, turns: result.turns, linkGaps: rows });
+  const places = layout(links.length, base, links);
+  const cache = new GapScoreCache(layoutCurves(links, currentShape()), currentShape());
+  const turningCost = result.after - cache.total;
+  const halfLength = (i, k) => {
+    const segment = cache.curves[i].segments[k];
+    let length = 0;
+    let previous = segment[0];
+    for (let j = 1; j <= 64; j++) {
+      const point = bezier(segment, j / 64);
+      length += Math.hypot(point[0] - previous[0], point[1] - previous[1]);
+      previous = point;
+    }
+    return length * cache.scale;
+  };
+  const penalty = () =>
+    rows.reduce(
+      (sum, row, i) =>
+        sum + row.reduce((s, v, k) => s + Math.abs((v ?? initial[i][k]) - initial[i][k]) * (k < 2 ? 0.1 : 0.025), 0),
+      0,
+    );
+  let bestScore = result.after;
+  for (let pass = 0; pass < Math.min(passes, 2); pass++) {
+    let improved = false;
+    for (let i = 0; i < links.length; i++)
+      for (let k = 0; k < 4; k++) {
+        if (k < 2 && links[i][k] === 0) continue;
+        const kept = rows[i][k];
+        const range = k < 2 ? gapRange : middleRange;
+        if (!range) continue;
+        // Never shorten an existing manual cut just to satisfy the automatic
+        // cap. New cuts may consume at most 30% of either half of the line.
+        const max = k < 2 ? 1 : Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));
+        let best = kept;
+        let bestState;
+        for (const fraction of [-1, -0.5, 0.5, 1]) {
+          const value = Math.round(Math.max(0, Math.min(max, initial[i][k] + range * fraction)) * 1000) / 1000;
+          if (value === (kept ?? initial[i][k])) continue;
+          rows[i][k] = value;
+          const curve = k < 2 ? linkCurve(links, i, places, currentShape()) : cache.curves[i];
+          const candidate = cache.measure(i, curve);
+          const score = turningCost + candidate.total + penalty();
+          if (score < bestScore - 1e-9) {
+            bestScore = score;
+            best = value;
+            bestState = candidate;
+          }
+        }
+        rows[i][k] = best;
+        if (bestState) {
+          cache.accept(bestState);
+          improved = true;
+        }
+      }
+    if (!improved) break;
+  }
+  // Later reference-gap changes can shorten earlier halves or their fitted
+  // scale. Enforce the cut budget against the final geometry as well.
+  rows.forEach((row, i) => {
+    for (let k = 2; k < 4; k++) {
+      const max = Math.max(initial[i][k], Math.min(30, halfLength(i, k - 2) * 0.3));
+      if (row[k] > max) row[k] = Math.floor(max * 1000) / 1000;
+    }
+  });
+  const after = overlapCost(links, currentShape());
+  return after <= result.after ? { ...result, linkGaps: rows, after } : result;
+}
