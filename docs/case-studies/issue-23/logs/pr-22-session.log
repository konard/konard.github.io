.3\",\n    \"@vitejs/plugin-react\": \"^6.1.2\",\n    \"eslint\": \"^10.13.0\",\n    \"eslint-plugin-react-hooks\": \"^7.1.1\",\n    \"eslint-plugin-react-refresh\": \"^0.5.7\",\n    \"globals\": \"^17.13.0\",\n    \"husky\": \"^9.1.7\",\n    \"js-yaml\": \"^4.3.2\",\n    \"jsdom\": \"^30.1.3\",\n    \"lint-staged\": \"^17.6.0\",\n    \"playwright\": \"1.63.0\",\n    \"prettier\": \"^3.9.10\",\n    \"secretlint\": \"^13.0.7\",\n    \"vite\": \"^8.3.4\",\n    \"vitest\": \"^5.0.5\"\n  },\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22\"\n  },\n  \"lint-staged\": {\n    \"*.{js,jsx,cjs,mjs}\": [\n      \"eslint --fix --max-warnings=0 --no-warn-ignored\",\n      \"prettier --write\"\n    ],\n    \"*.{css,md,html,json,yml,yaml}\": [\n      \"prettier --write\"\n    ]\n  }\n}\nname: Deploy to GitHub Pages\n\non:\n  push:\n    branches:\n      - main\n    paths-ignore:\n      - 'docs/**'\n      - 'dev/**'\n  pull_request:\n    branches:\n      - main\n  workflow_dispatch:\n\n# Least-privilege default; only the deploy job may publish to Pages.\npermissions:\n  contents: read\n\n# Cancel superseded pull request runs, but never a deploy on main.\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\n# actions/checkout runs `git init` before any step can configure Git; this\n# silences its \"default branch name\" hint.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # Lint the workflows themselves (actionlint also runs shellcheck on run: blocks).\n  lint-workflows:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Run actionlint\n        uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          args: -color\n\n  # Fast checks run before the tests and the build.\n  checks:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check file size limits\n        run: npm run check:file-size\n\n      - name: Check for secrets\n        run: npm run check:secrets\n\n      - name: Audit dependencies\n        run: npm audit --audit-level=moderate\n\n  test:\n    needs: [lint-workflows, checks, network-browsers]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n\n    steps:\n      # On pull requests this is the merge result with main, not the branch head.\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Run tests\n        run: npm run test:ci\n\n      - name: Build the React app\n        run: npm run build\n\n      # Issue #11: every CV (position × style × language) is printed to PDF by\n      # headless Chromium and checked: at most 2 pages for a position, 1 page\n      # for the compact style, and a text layer an ATS can read.\n      - name: Install Chromium for the CV PDFs\n        run: npx playwright install --with-deps chromium\n\n      - name: Print the CV PDFs\n        run: npm run build:cv\n\n      # GitHub Pages is set to deploy from GitHub Actions, so the site is\n      # published from this artifact, not from a branch or the docs/ folder.\n      # Pull requests upload it too, so a broken artifact fails before merge.\n      - name: Upload the build as the Pages artifact\n        uses: actions/upload-pages-artifact@v5\n        with:\n          path: build/\n          include-hidden-files: true\n\n  network-browsers:\n    needs: [lint-workflows, checks]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    strategy:\n      fail-fast: false\n      matrix:\n        engine: [chromium, firefox, webkit]\n    env:\n      ENGINE: ${{ matrix.engine }}\n      CAPTURE_DIR: browser-results/screenshots\n      RESULT_DIR: browser-results/data\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Build the editor\n        run: npm run build\n\n      - name: Install the browser\n        # package.json pins 1.63.0: 1.64.x's Linux WebKit stalls on glass panels.\n        # https://github.com/microsoft/playwright/issues/43426\n        run: npx playwright install --with-deps \"$ENGINE\"\n\n      - name: Verify existing editor features and image downloads\n        run: npm run test:network:browser\n\n      - name: Verify history, self loops, layouts, clipboard and mobile editing\n        run: npm run test:network:issue19\n\n      - name: Verify editor geometry, source colors and shared settings\n        run: npm run test:network:issue21\n\n      - name: Preserve browser evidence\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: network-${{ matrix.engine }}\n          path: browser-results/\n          if-no-files-found: warn\n\n  deploy:\n    needs: test\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    permissions:\n      contents: read\n      pages: write\n      id-token: [REDACTED]    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v5\n\n      # A green deploy must mean the site is really there (issue #5).\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n          sparse-checkout: scripts\n\n      - name: Verify the deployed site\n        run: bash scripts/check-deployed-site.sh \"$PAGE_URL\"\n        env:\n          PAGE_URL: ${{ steps.deployment.outputs.page_url }}\n// Browser regression checks for issue #17. Uses the built site; starts Vite\n// preview unless BASE is set. ENGINE=chromium|firefox|webkit, CAPTURE_DIR=...\n/* global document, window, getComputedStyle, Image */\nimport assert from 'node:assert/strict';\nimport { mkdir, readFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\n\nconst engine = process.env.ENGINE || 'chromium';\nconst output = process.env.CAPTURE_DIR;\nconst downloads = process.env.DOWNLOAD_DIR || '/tmp/network-downloads';\nawait mkdir(downloads, { recursive: true });\nif (output) await mkdir(output, { recursive: true });\nconst server = process.env.BASE ? null : await preview({ preview: { port: 4175, strictPort: true } });\nconst base = process.env.BASE || 'http://localhost:4175';\nlet browser;\nconst errors = [];\nconst shot = async (page, name, locator = null) => {\n  if (output) await (locator || page).screenshot({ path: join(output, `${name}.png`) });\n};\nconst codeOf = (page) => new URL(page.url()).searchParams.get('code');\nconst codeIs = async (page, code) => {\n  await page.waitForURL((url) => url.searchParams.get('code') === code);\n  assert.equal(codeOf(page), code);\n};\nconst svgOf = (page) => page.locator('.network__preview').innerHTML();\nconst noOverflow = async (page) => {\n  const excess = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);\n  assert(excess <= 1, `page overflows by ${excess}px at ${JSON.stringify(page.viewportSize())}`);\n};\n\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  const context = await browser.newContext({\n    viewport: { width: 1440, height: 1000 },\n    colorScheme: 'dark',\n    reducedMotion: 'reduce',\n  });\n  await context.addInitScript(() => {\n    if (!window.localStorage.getItem('theme')) window.localStorage.setItem('theme', 'dark');\n    if (!window.localStorage.getItem('lang')) window.localStorage.setItem('lang', 'en');\n  });\n  const page = await context.newPage();\n  page.setDefaultTimeout(10000);\n  page.on('pageerror', (error) => errors.push(error.message));\n\n  await page.goto(`${base}/art/#symbols`);\n  const card = page.locator('.symbols__grid li').first();\n  const galleryCode = new URL(await card.locator('.symbols__card').getAttribute('href'), base).searchParams.get('code');\n  const icon = card.locator('.symbols__share');\n  await page.mouse.move(0, 0);\n  assert.equal(await icon.evaluate((node) => getComputedStyle(node).opacity), '0');\n  await card.hover();\n  await page.waitForFunction(() => getComputedStyle(document.querySelector('.symbols__share')).opacity === '1');\n  await shot(page, 'gallery-hover');\n  await icon.click();\n  await page.waitForURL('**/network/**');\n  await codeIs(page, galleryCode);\n  assert.equal(new URL(page.url()).hash, '#share');\n  await page.waitForFunction(() => document.getElementById('share').getBoundingClientRect().top < window.innerHeight);\n  await page.goto(`${base}/art/#symbols`);\n  await page.locator('.symbols__card').first().focus();\n  assert.equal(\n    await page\n      .locator('.symbols__card')\n      .first()\n      .evaluate((node) => node === document.activeElement),\n    true,\n  );\n  await page.locator('.symbols__card').first().click();\n  await page.waitForURL('**/network/**');\n  await codeIs(page, galleryCode);\n\n  console.log(`${engine}: gallery hover, focus and navigation passed`);\n\n  await page.goto(`${base}/network/?code=221331`);\n  assert.equal(await page.getByLabel('N-ary number', { exact: true }).inputValue(), '221331₄');\n  await page.getByLabel('N-ary number', { exact: true }).fill('0120₃');\n  assert.equal(await page.getByLabel('Links notation', { exact: true }).inputValue(), '(1: 0 1) (2: 2 0)');\n  await page.getByLabel('Links notation', { exact: true }).fill('(1: 1 1) (2: 2)');\n  assert.equal(await page.getByLabel('Links notation', { exact: true }).getAttribute('aria-invalid'), 'true');\n  await codeIs(page, '0120');\n  await page.getByLabel('Math notation (the links theory)').fill('λ = {1 ↦ (1, 1), 2 ↦ (2, 2), 3 ↦ (1, 2)}');\n  await codeIs(page, '112212');\n  await page.getByLabel('The same number in decimal').fill('0');\n  await codeIs(page, '000000');\n  console.log(`${engine}: notation editing and invalid input passed`);\n\n  await page.goto(`${base}/network/?code=221331`);\n  await shot(page, 'network-desktop');\n  await page.locator('#style-angles').scrollIntoViewIfNeeded();\n  const box = await page.locator('.network__preview').boundingBox();\n  assert(box.y >= 0 && box.y + box.height <= 1001, 'preview must stay visible beside style controls');\n  await shot(page, 'after-style-preview');\n  const before = await svgOf(page);\n  await page.getByLabel('Angles of the ends', { exact: true }).selectOption('fixed');\n  await page.getByLabel('Leaving angle', { exact: true }).focus();\n  await page.keyboard.press('ArrowRight');\n  assert.notEqual(await svgOf(page), before);\n  await page.getByLabel('Start of a link', { exact: true }).selectOption('circle');\n  await page.getByLabel('End of a link', { exact: true }).selectOption('triangle');\n  await page.getByLabel('Link 1: turn of the target, °').fill('30');\n  await page.waitForURL((url) => url.searchParams.get('turns')?.includes('30'));\n  assert(new URL(page.url()).searchParams.get('turns').includes('30'));\n  await page.getByRole('button', { name: 'Plain black', exact: true }).click();\n  assert((await svgOf(page)).includes('fill=\"#000000\"'));\n  await shot(page, 'plain-black', page.locator('.network__preview'));\n  await page.getByRole('button', { name: 'Transparent', exact: true }).click();\n  assert(!(await svgOf(page)).includes('<rect'));\n  await shot(page, 'transparent', page.locator('.network__preview'));\n  await page.getByRole('button', { name: 'Card (as in the gallery)', exact: true }).click();\n  await page.getByRole('combobox', { name: 'Border', exact: true }).selectOption('double');\n  assert((await svgOf(page)).includes('stroke-width=\"0.6\"'));\n  await page.getByRole('combobox', { name: 'Background', exact: true }).selectOption('linear');\n  assert((await svgOf(page)).includes('<linearGradient'));\n  console.log(`${engine}: live preview and SVG styling passed`);\n\n  await page.goto(`${base}/network/?code=221331`);\n  await shot(page, 'collisions-before', page.locator('.network__preview'));\n  await page.getByLabel('Reduce overlaps automatically', { exact: true }).check();\n  const score = await page.locator('.network__score').textContent();\n  const [from, to] = score.match(/[\\d.]+/g).map(Number);\n  assert(to < from, `solver should improve the tangled example: ${score}`);\n  await shot(page, 'collisions-after', page.locator('.network__preview'));\n  const solvedSvg = await svgOf(page);\n  await page.getByRole('button', { name: 'Write the turns into the table of links', exact: true }).click();\n  assert.equal(await svgOf(page), solvedSvg, 'applying turns must preserve the preview');\n  console.log(`${engine}: overlap reduction and applied turns passed`);\n\n  await page.getByRole('button', { name: 'Social card 1200 × 630', exact: true }).click();\n  await page.getByLabel('Theory notation', { exact: true }).selectOption('R');\n  const shared = await page.getByLabel('Link to this picture').inputValue();\n  const sharedSvg = await svgOf(page);\n  const fresh = await browser.newContext({ reducedMotion: 'reduce' });\n  const receiving = await fresh.newPage();\n  await receiving.goto(shared);\n  assert.equal(await svgOf(receiving), sharedSvg, 'a fresh browser must render exactly the shared SVG');\n  await fresh.close();\n  console.log(`${engine}: shared URL renders the same SVG in a fresh browser`);\n\n  // Test actual downloaded files: MIME signatures, dimensions, alpha and contents.\n  await page.getByRole('button', { name: 'Transparent', exact: true }).click();\n  await page.locator('#share').scrollIntoViewIfNeeded();\n  await shot(page, 'sharing');\n  for (const [label, ext] of [\n    ['SVG', 'svg'],\n    ['PNG', 'png'],\n    ['JPEG', 'jpg'],\n    ['WebP', 'webp'],\n    ['.lino', 'lino'],\n  ]) {\n    const waiting = page.waitForEvent('download');\n    await page.getByRole('button', { name: `⤓ ${label}`, exact: true }).click();\n    const download = await waiting;\n    assert.equal(await download.failure(), null);\n    assert.equal(download.suggestedFilename(), `links-network-22-13-31.${ext}`);\n    const path = join(downloads, `${engine}-${download.suggestedFilename()}`);\n    await download.saveAs(path);\n    const bytes = await readFile(path);\n// Focused real-browser regressions for #19. ENGINE selects one browser at a time.\n/* global window, document, HTMLInputElement */\nimport assert from 'node:assert/strict';\nimport { mkdir, readFile, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\n\nconst engine = process.env.ENGINE || 'chromium';\nconst output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-19/screenshots';\nconst resultDir = process.env.RESULT_DIR || 'docs/case-studies/issue-19/data';\nawait mkdir(output, { recursive: true });\nawait mkdir(resultDir, { recursive: true });\nconst server = process.env.BASE ? null : await preview({ preview: { port: 4177, strictPort: true } });\nconst base = process.env.BASE || 'http://localhost:4177';\nlet browser;\nconst errors = [];\nconst results = { engine, date: new Date().toISOString(), checks: [] };\nconst passed = (name) => {\n  results.checks.push(name);\n  console.log(`${engine}: ${name}`);\n};\nconst svgOf = (page) => page.locator('.network__preview').innerHTML();\nconst shot = (page, name, element = null) =>\n  (element || page).screenshot({ path: join(output, `${engine}-${name}.png`) });\nconst init = () => {\n  localStorage.setItem('lang', 'en');\n  localStorage.setItem('theme', 'dark');\n  const original = window.history.replaceState.bind(window.history);\n  window.__historyWrites = [];\n  window.history.replaceState = (...args) => {\n    window.__historyWrites.push(args[2]);\n    if (window.__rejectHistory) throw new DOMException('injected Safari history quota', 'SecurityError');\n    return original(...args);\n  };\n};\nconst change = async (page, key, value) => {\n  const field = page.locator(`#style-${key}`);\n  await field.evaluate((node, next) => {\n    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(node, next);\n    node.dispatchEvent(new Event('input', { bubbles: true }));\n  }, value);\n};\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  const context = await browser.newContext({\n    viewport: { width: 1440, height: 1000 },\n    reducedMotion: 'reduce',\n    colorScheme: 'dark',\n  });\n  await context.addInitScript(init);\n  const page = await context.newPage();\n  page.setDefaultTimeout(15000);\n  page.on('pageerror', (error) => errors.push(error.message));\n  await page.goto(`${base}/network/?code=1122`);\n  await page.locator('.network__preview svg').waitFor();\n  await shot(page, 'after-loops');\n  for (const [key, value] of [\n    ['sourceAngle', 55],\n    ['targetAngle', 65],\n    ['tension', 0.7],\n    ['bulge', 65],\n  ]) {\n    const before = await svgOf(page);\n    await change(page, key, value);\n    assert.notEqual(await svgOf(page), before, `${key} must affect self loops`);\n  }\n  passed('self-loop leaving/entering angles, curvature and bend');\n\n  await page.waitForTimeout(500);\n  await page.evaluate(() => {\n    window.__historyWrites = [];\n  });\n  const slider = page.locator('#style-targetAngle');\n  await slider.dispatchEvent('pointerdown');\n  for (let i = 1; i <= 120; i++) {\n    await change(page, 'targetAngle', i % 80);\n  }\n  await page.waitForTimeout(600);\n  assert.equal(await page.evaluate(() => window.__historyWrites.length), 0, 'no URL writes during a held slider');\n  await slider.dispatchEvent('pointerup');\n  await page.waitForTimeout(100);\n  await slider.dispatchEvent('pointerdown');\n  await change(page, 'targetAngle', 67);\n  await slider.dispatchEvent('pointerup');\n  await page.waitForURL((url) => url.searchParams.get('targetAngle') === '67');\n  assert.equal(await page.evaluate(() => window.__historyWrites.length), 1, 'short releases coalesce');\n  await page.evaluate(() => {\n    window.__rejectHistory = true;\n  });\n  await change(page, 'targetAngle', 68);\n  await page.waitForTimeout(500);\n  assert.equal(await page.locator('.network__preview svg').count(), 1, 'history failure must leave editor alive');\n  await shot(page, 'after-history-error');\n  await page.evaluate(() => {\n    window.__rejectHistory = false;\n  });\n  await page.waitForURL((url) => url.searchParams.get('targetAngle') === '68');\n  passed('120-event drag, repeated releases, history SecurityError and retry');\n\n  await page.getByLabel('Middle of a link', { exact: true }).selectOption('circle');\n  await change(page, 'middleSize', 10);\n  await change(page, 'middleGapStart', 5);\n  await change(page, 'middleGapEnd', 5);\n  await change(page, 'startOffset', 3);\n  await change(page, 'endOffset', 4);\n  await shot(page, 'ring-and-offsets', page.locator('.network__preview'));\n  const paths = await page\n    .locator('.network__preview svg g[stroke] > path:first-child')\n    .evaluateAll((nodes) => nodes.map((n) => n.getAttribute('d')));\n  assert(paths.every((d) => (d.match(/M/g) || []).length === 2));\n  const shared = await page.getByLabel('Link to this picture').inputValue();\n  const drawing = await svgOf(page);\n  await page.goto(shared);\n  assert.equal(await svgOf(page), drawing, 'new settings survive sharing and reload');\n  passed('independent marker offsets and ring cuts survive URL round trip');\n\n  const links = Array.from({ length: 17 }, (_, i) => `(${i + 1}: ${i + 1} ${((i + 1) % 17) + 1})`).join(' ');\n  await page.getByLabel('Links notation', { exact: true }).fill(links);\n  await page.waitForURL((url) => url.searchParams.get('code')?.includes(';'));\n","exit_code":0,"status":"completed"}}
