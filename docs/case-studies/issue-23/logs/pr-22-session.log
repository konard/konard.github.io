f value === 'string' ? value.slice(0, field.max) : field.d;\n    default:\n      return normalizeList(field.key, value);\n  }\n}\n\n/** A complete, valid style: every option of `raw` checked, the rest the defaults. */\nexport function normalizeStyle(raw = {}) {\n  // Bookmarks from issue #17 used one gap for both references.\n  if (raw?.gap !== undefined) raw = { startGap: raw.gap, endGap: raw.gap, ...raw };\n  return Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, normalizeValue(field, raw?.[field.key])]));\n}\n\n/** The options that differ from the defaults as query parameters. */\nexport function styleToParams(style) {\n  const params = new URLSearchParams();\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (style[key] !== STYLE_DEFAULTS[key]) params.set(key, String(style[key]));\n  });\n  return params;\n}\n\n/** A style read from query parameters (unknown or invalid values are left out). */\nexport function styleFromParams(params) {\n  const raw = {};\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i % COLORS.length];\n    const palette = PALETTES[style.palette] || COLORS;\n// A link's middle is a particle; its references are springs to other middles.\n// 0 has no particle and a self-reference reserves loop space instead of a spring.\nimport { forceCenter, forceCollide, forceLink, forceManyBody, forceSimulation } from 'd3-force';\n\nconst RAD = Math.PI / 180;\nconst rotate = ([x, y], a) => [x * Math.cos(a) - y * Math.sin(a), x * Math.sin(a) + y * Math.cos(a)];\nconst golden = Math.PI * (3 - Math.sqrt(5));\n\nfunction circle(n, spread, rotation) {\n  if (n === 1) return [{ at: [0, 0], out: rotate([0, -1], rotation * RAD) }];\n  const radius = (spread * 0.5) / Math.sin(Math.PI / n);\n  const start = (n === 2 ? Math.PI : n === 4 ? (-3 * Math.PI) / 4 : -Math.PI / 2) + rotation * RAD;\n  return Array.from({ length: n }, (_, i) => {\n    const out = [Math.cos(start + (2 * Math.PI * i) / n), Math.sin(start + (2 * Math.PI * i) / n)];\n    return { at: out.map((v) => v * radius), out };\n  });\n}\n\nfunction square(n, columns) {\n  const cols = Math.max(1, Math.min(n, Math.round(columns) || Math.ceil(Math.sqrt(n))));\n  return Array.from({ length: n }, (_, i) => [i % cols, Math.floor(i / cols)]);\n}\n\nfunction hex(n) {\n  const points = [[0, 0]];\n  const steps = [\n    [1, 0],\n    [0, 1],\n    [-1, 1],\n    [-1, 0],\n    [0, -1],\n    [1, -1],\n  ];\n  for (let radius = 1; points.length < n; radius++) {\n    let q = 0;\n    let r = -radius;\n    for (const [dq, dr] of steps) {\n      for (let k = 0; k < radius && points.length < n; k++) {\n        points.push([q + r / 2, (r * Math.sqrt(3)) / 2]);\n        q += dq;\n        r += dr;\n      }\n    }\n  }\n  return points.slice(0, n);\n}\n\nconst dice = [\n  [],\n  [[0, 0]],\n  [\n    [-0.5, -0.5],\n    [0.5, 0.5],\n  ],\n  [\n    [-0.5, -0.5],\n    [0, 0],\n    [0.5, 0.5],\n  ],\n  [\n    [-0.5, -0.5],\n    [0.5, -0.5],\n    [-0.5, 0.5],\n    [0.5, 0.5],\n  ],\n  [\n    [-0.5, -0.5],\n    [0.5, -0.5],\n    [0, 0],\n    [-0.5, 0.5],\n    [0.5, 0.5],\n  ],\n  [\n    [-0.5, -1],\n    [0.5, -1],\n    [-0.5, 0],\n    [0.5, 0],\n    [-0.5, 1],\n    [0.5, 1],\n  ],\n];\nfunction card(n) {\n  if (n <= 3) return Array.from({ length: n }, (_, i) => [0, i - (n - 1) / 2]);\n  const pairs = Math.floor(n / 2);\n  const points = Array.from({ length: pairs }, (_, i) => [\n    [-0.7, i - (pairs - 1) / 2],\n    [0.7, i - (pairs - 1) / 2],\n  ]).flat();\n  if (n % 2) points.push([0, 0]);\n  return points;\n}\nfunction tiled(n, capacity, pattern) {\n  const tiles = Math.ceil(n / capacity);\n  const cols = Math.ceil(Math.sqrt(tiles));\n  return Array.from({ length: tiles }, (_, i) =>\n    pattern(Math.min(capacity, n - i * capacity)).map(([x, y]) => [x + (i % cols) * 4, y + Math.floor(i / cols) * 6]),\n  ).flat();\n}\n\nlet lastPhysical = null;\nfunction physical(n, links, options) {\n  // Solver candidates change endpoint angles, not the particles or springs.\n  const key = JSON.stringify([n, links, options.forceDistance, options.forceCharge, options.forceCollision]);\n  if (lastPhysical?.key === key) return lastPhysical.points;\n  const nodes = Array.from({ length: n }, (_, i) => ({\n    id: i,\n    x: Math.sqrt(i + 0.5) * Math.cos(i * golden),\n    y: Math.sqrt(i + 0.5) * Math.sin(i * golden),\n  }));\n  const springs = [];\n  (links || []).forEach((pair, i) =>\n    pair.forEach((ref) => {\n      if (ref && ref !== i + 1) springs.push({ source: i, target: ref - 1 });\n    }),\n  );\n  const simulation = forceSimulation(nodes)\n    .stop()\n    .force('center', forceCenter())\n    .force('charge', forceManyBody().strength(-options.forceCharge))\n    .force(\n      'references',\n      forceLink(springs)\n        .id((node) => node.id)\n        .distance(options.forceDistance)\n        .strength(0.3),\n    )\n    .force(\n      'loops',\n      forceCollide((node) => {\n        const self = (links?.[node.id] || []).filter((ref) => ref === node.id + 1).length;\n        return options.forceCollision * (1 + self * 0.4);\n      }).iterations(2),\n    );\n  // Static, deterministic output: no animation timer or random layout on reload.\n  simulation.tick(180);\n  const points = nodes.map(({ x, y }) => [x, y]);\n  lastPhysical = { key, points };\n  return points;\n}\n\n/** Space-filling strategies accept any finite number of links; circle stays automatic for 1–4. */\nexport function placeLinks(n, raw = {}, links = null) {\n  if (!Number.isSafeInteger(n) || n < 1) return [];\n  const options = {\n    placement: 'circle',\n    spread: 1,\n    rotation: 0,\n    layoutAspect: 1,\n    columns: 0,\n    forceDistance: 1,\n    forceCharge: 0.6,\n    forceCollision: 0.6,\n    ...raw,\n  };\n  const kind = options.placement === 'auto' ? (n <= 4 ? 'circle' : 'hex') : options.placement;\n  if (kind === 'circle')\n    return circle(n, options.spread, options.rotation).map((p) => ({\n      ...p,\n      at: [p.at[0] * options.layoutAspect, p.at[1]],\n    }));\n  let points;\n  if (kind === 'square') points = square(n, options.columns);\n  else if (kind === 'hex') points = hex(n);\n  else if (kind === 'dice') points = tiled(n, 6, (count) => dice[count]);\n  else if (kind === 'cards') points = tiled(n, 10, card);\n  else if (kind === 'force') points = physical(n, links, options);\n  else\n    points = Array.from({ length: n }, (_, i) => [\n      Math.sqrt(i) * Math.cos(i * golden),\n      Math.sqrt(i) * Math.sin(i * golden),\n    ]);\n  const center = points.reduce((a, p) => [a[0] + p[0] / n, a[1] + p[1] / n], [0, 0]);\n  return points.map((p, i) => {\n    const at = rotate(\n      [(p[0] - center[0]) * options.spread * options.layoutAspect, (p[1] - center[1]) * options.spread],\n      options.rotation * RAD,\n    );\n    const length = Math.hypot(...at);\n    const out = length > 1e-9 ? at.map((v) => v / length) : rotate([0, -1], i * golden + options.rotation * RAD);\n    return { at, out };\n  });\n}\nimport { describe, expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { overlapCost, pairCost, solveCollisions } from './collisions';\nimport {\n  addLink,\n  check,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseCode,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  removeLink,\n  setReference,\n  theoryNotation,\n} from './edit';\nimport { fileName, shareTargets } from './export';\nimport { glyphSvg } from './glyph';\nimport { captionOf, escapeXml, networkSvg } from './render';\nimport {\n  LOOKS,\n  STYLE_DEFAULTS,\n  applyLook,\n  linkColors,\n  linkTurns,\n  normalizeStyle,\n  shapeOfStyle,\n  styleFromParams,\n  styleToParams,\n  withColor,\n  withTurns,\n} from './style';\n\nconst links = decode('01 20');\n\ndescribe('notations of the editor (issue #17)', () => {\n  it('writes one network in every notation', () => {\n    expect(theoryNotation(links)).toBe('λ = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n    expect(theoryNotation(links, 'R')).toBe('N² = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n    expect(numberNotation(links)).toBe('0120₃');\n    // 0·27 + 1·9 + 2·3 + 0 = 15.\n    expect(decimalOf(links)).toBe('15');\n    expect(linksText(links)).toBe('(1: 0 1) (2: 2 0)');\n  });\n\n  it('reads back what it writes, in every notation', () => {\n    expect(parseMath(theoryNotation(links)).links).toEqual(links);\n    expect(parseMath(theoryNotation(links, 'R')).links).toEqual(links);\n    expect(parseMath('01₃ 20₃').links).toEqual(links);\n    expect(parseMath('{(0, 1), (2, 0)}').links).toEqual(links);\n    expect(parseMath('1 -> (0 1), 2 -> (2 0)').links).toEqual(links);\n    expect(parseNumber('0120₃').links).toEqual(links);\n    expect(parseNumber('0120_3').links).toEqual(links);\n    expect(parseNumber('0120').links).toEqual(links);\n    expect(parseIndex('15', 2).links).toEqual(links);\n    expect(parseLinks('(1: 0 1) (2: 2 0)').links).toEqual(links);\n    expect(parseLinks('(2: 2 0)\\n(1: 0 1)').links).toEqual(links);\n    expect(parseLinks('(0 1) (2 0)').links).toEqual(links);\n    expect(parseCode('0120')).toBe('01 20');\n    expect(parseCode('01-20')).toBe('01 20');\n  });\n\n  it('explains what is wrong in English and Russian', () => {\n    expect(parseNumber('012').error.en).toMatch(/even/);\n    expect(parseNumber('0120₄').error.en).toBe('A network of 2 links is written in base 3, not 4.');\n    expect(parseNumber('0120₄').error.ru).toBe('Сеть из 2 связей записывается в системе с основанием 3, а не 4.');\n    expect(parseNumber('0130').error.en).toBe('A link refers to 3, but there are only the links 0…2.');\n    expect(parseIndex('81', 2).error.en).toBe('Write a whole number from 0 to 80.');\n    expect(parseLinks('(1: 0 1) (0 2)').error.en).toBe('Name either every link or none.');\n    expect(parseLinks('(1: 0 1) (1: 0 2)').error.en).toMatch(/each once/);\n    expect(parseMath('hello').error).toBeTruthy();\n    expect(check([]).error.en).toMatch(/at least one/);\n    expect(check([[0]]).error).toBeTruthy();\n    expect(check(Array.from({ length: 10 }, () => [0, 0])).links).toHaveLength(10);\n    expect(parseCode('0130')).toBeNull();\n    expect(parseCode('<script>')).toBeNull();\n  });\n\n  it('counts networks of up to 9 links exactly', () => {\n    expect(countOf(2)).toBe(81n);\n    expect(countOf(9)).toBe(10n ** 18n);\n    const nine = Array.from({ length: 9 }, () => [9, 9]);\n    expect(decimalOf(nine)).toBe(String(10n ** 18n - 1n));\n    expect(parseIndex(String(10n ** 18n - 1n), 9).links).toEqual(nine);\n  });\n\n  it('rejects malformed notation instead of silently discarding part of the network', () => {\n    ['(1: 0 1) (2: 2)', '(1: 0 1) trailing', '((1: 0 1))'].forEach((text) => {\n      expect(parseLinks(text).error, text).toBeTruthy();\n    });\n    ['01₄ 20₄', '01₃ 20₄', '013 203', '01oops 20', 'λ = {1 ↦ (0, 1), 2 ↦ (2)}'].forEach((text) => {\n      expect(parseMath(text).error, text).toBeTruthy();\n    });\n  });\n\n  it('adds, removes and rewires links keeping the network consistent', () => {\n    expect(addLink(links)).toEqual([...links, [0, 0]]);\n    expect(addLink(Array.from({ length: 9 }, () => [0, 0]))).toHaveLength(10);\n    // Removing link 1: references to it become 0, link 2 becomes link 1.\n    expect(removeLink(links, 1)).toEqual([[1, 0]]);\n    expect(removeLink(decode('11 22 12'), 2)).toEqual([\n      [1, 1],\n      [1, 0],\n    ]);\n    expect(removeLink([[1, 1]], 1)).toEqual([[1, 1]]);\n    expect(setReference(links, 1, 1, 1)).toEqual([\n      [0, 1],\n      [2, 1],\n    ]);\n  });\n});\n\ndescribe('style of the picture (issue #17)', () => {\n  it('checks every option, so a shared link cannot break the picture', () => {\n    const style = normalizeStyle({\n      strokeWidth: 999,\n      bgColor: 'red;\"/><script>',\n      start: 'nonsense',\n      card: 'false',\n      captionText: 'x'.repeat(200),\n      turns: '30 -400,abc',\n      colors: '#FF0000,#00ff00',\n    });\n    expect(style.strokeWidth).toBe(10);\n    expect(style.bgColor).toBe(STYLE_DEFAULTS.bgColor);\n    expect(style.start).toBe(STYLE_DEFAULTS.start);\n    expect(style.card).toBe(false);\n    expect(style.captionText).toHaveLength(80);\n    expect(style.turns).toBe('30 -180');\n    expect(style.colors).toBe('#ff0000,#00ff00');\n    expect(normalizeStyle({ colors: '#ff0000,blue' }).colors).toBe('');\n  });\n\n  it('keeps only the options that differ from the defaults in the address', () => {\n    expect(styleToParams(STYLE_DEFAULTS).toString()).toBe('');\n    const style = normalizeStyle({ card: false, bgColor: '#000000', end: 'dot', turns: '15 -30' });\n    const params = styleToParams(style);\n    expect(Object.fromEntries(params)).toEqual({ end: 'dot', turns: '15 -30' });\n    expect(styleFromParams(new URLSearchParams(params.toString()))).toEqual(style);\n    expect(styleFromParams(new URLSearchParams('strokeWidth=abc&unknown=1'))).toEqual(STYLE_DEFAULTS);\n  });\n\n  it('gives each link a colour and turns', () => {\n    expect(linkColors(STYLE_DEFAULTS, 2)).toHaveLength(2);\n    expect(linkColors(normalizeStyle({ palette: 'mono', monoColor: '#123456' }), 3)).toEqual([\n      '#123456',\n      '#123456',\n      '#123456',\n    ]);\n    const own = withColor(STYLE_DEFAULTS, 2, 1, '#abcdef');\n    expect(own.palette).toBe('custom');\n    expect(linkColors(own, 2)).toEqual([linkColors(STYLE_DEFAULTS, 1)[0], '#abcdef']);\n    const turned = withTurns(STYLE_DEFAULTS, [\n      [10, 20],\n      [0, -45],\n    ]);\n    expect(turned.turns).toBe('10 20,0 -45');\n    expect(linkTurns(turned, 3)).toEqual([\n      [10, 20],\n      [0, -45],\n      [0, 0],\n    ]);\n    expect(withTurns(STYLE_DEFAULTS, [[0, 0]]).turns).toBe('');\n    expect(\n      shapeOfStyle(turned, 2, [\n        [5, 5],\n        [0, 0],\n      ]).turns,\n    ).toEqual([\n      [15, 25],\n      [0, -45],\n    ]);\n  });\n\n  it('offers both a card and a plain black background, and keeps the hand-made turns', () => {\n    expect(LOOKS.map((look) => look.id)).toEqual(expect.arrayContaining(['card', 'black', 'transparent']));\n    const turned = normalizeStyle({ turns: '10 20', strokeWidth: 5 });\n    const black = applyLook(turned, 'black');\n    expect(black).toMatchObject({ card: false, background: 'solid', bgColor: '#000000', turns: '10 20' });\n    expect(black.strokeWidth).toBe(STYLE_DEFAULTS.strokeWidth);\n    expect(applyLook(turned, 'card').card).toBe(true);\n    expect(applyLook(turned, 'social')).toMatchObject({ width: 1200, height: 630, caption: 'theory' });\n  });\n});\n\ndescribe('picture of a network (issue #17)', () => {\n  it('is a standalone SVG of the chosen size with the links of the gallery', () => {\n    const svg = networkSvg(links, applyLook(STYLE_DEFAULTS, 'card'));\n    expect(svg.startsWith('<svg xmlns=\"http://www.w3.org/2000/svg\"')).toBe(true);\n    expect(svg).toContain('width=\"2048\" height=\"2048\"');\n    expect(svg).toContain('aria-label=\"Links network 01₃ 20₃\"');\n    // The card preset preserves the gallery; the lines are the same curves as the symbols.\n    expect(svg).toContain(STYLE_DEFAULTS.cardColor);\n    const symbol = glyphSvg(links);\n    const line = symbol.match(/ d=\"(M[^M\"]+)/)[1];\n    expect(svg).toContain(line);\n  });\n\n  it('draws a transparent background, no card and a wide image on request', () => {\n    const svg = networkSvg(links, { background: 'transparent', card: false, width: 1200, height: 630 });\n    expect(svg).toContain('viewBox=\"0 0 190.48 100\"');\n    expect(svg).not.toContain(STYLE_DEFAULTS.bgColor);\n    expect(svg).not.toContain(STYLE_DEFAULTS.cardColor);\n    expect(networkSvg(links, { background: 'linear' })).toContain('<linearGradient');\n    expect(networkSvg(links, { background: 'radial' })).toContain('<radialGradient');\n    expect(networkSvg(links, { card: true, borderStyle: 'dashed' })).toContain('stroke-dasharray');\n    expect(networkSvg(links, { glow: 2 })).toContain('feGaussianBlur');\n  });\n\n  it('escapes the caption, so a shared link cannot put markup into the picture', () => {\n    expect(escapeXml(`<a href=\"x\">'&'</a>`)).toBe('&lt;a href=&quot;x&quot;&gt;&apos;&amp;&apos;&lt;/a&gt;');\n    const svg = networkSvg(links, { caption: 'custom', captionText: '<script>alert(1)</script>' });\n    expect(svg).not.toContain('<script>');\n    expect(svg).toContain('&lt;script&gt;');\n    expect(captionOf(links, normalizeStyle({ caption: 'number' }))).toBe('0120₃ = 15');\n    expect(captionOf(links, normalizeStyle({ caption: 'pairs' }))).toBe('01₃ 20₃');\n    expect(captionOf(links, normalizeStyle({ caption: 'theory' }), 'R')).toBe('N² = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n  });\n});\n\ndescribe('fewer overlaps of lines (experimental, issue #17)', () => {\n  it('counts the same crossings regardless of link ordering', () => {\n    const a = [\n      [0, 0],\n      [1, 0],\n    ];\n    const b = [\n      [0.5, -1],\n      [0.5, 1],\n    ];\n    expect(pairCost(a, b, [[0, 0]])).toBe(pairCost(b, a, [[0, 0]]));\n  });\n  it('turns the ends of the links so that their lines cross and touch less', () => {\n    const tangled = decode('22 13 31');\n    const result = solveCollisions(tangled, shapeOfStyle(STYLE_DEFAULTS, 3));\n    expect(result.before).toBe(overlapCost(tangled, shapeOfStyle(STYLE_DEFAULTS, 3)));\n    expect(result.after).toBeLessThan(result.before);\n    expect(result.turns).toHaveLength(3);\n    expect(result.delta).toHaveLength(3);\n    // The turns found draw the same improved picture.\n    const turned = shapeOfStyle(withTurns(STYLE_DEFAULTS, result.turns), 3);\n    expect(overlapCost(tangled, turned)).toBeCloseTo(result.after, 6);\n  });\n\n  it('never makes a picture worse', () => {\n    ['11', '01 20', '11 22 12', '12 21'].forEach((code) => {\n      const result = solveCollisions(decode(code), shapeOfStyle(STYLE_DEFAULTS, code.split(' ').length));\n      expect(result.after).toBeLessThanOrEqual(result.before);\n    });\n  });\n\n  it('keeps solved turns editable and preserves the preview when they are applied', () => {\n    for (const code of ['22 13 31', '23 31 12', '12 21']) {\n      const network = decode(code);\n      const style = normalizeStyle({ turns: '180 180,-180 180,170 -170' });\n      const result = solveCollisions(network, shapeOfStyle(style, network.length));\n      expect(result.after, code).toBeLessThanOrEqual(result.before);\n      expect(\n        result.turns.flat().every((angle) => Math.abs(angle) <= 180),\n        code,\n      ).toBe(true);\n      const applied = shapeOfStyle(withTurns(style, result.turns), network.length);\n      expect(overlapCost(network, applied), code).toBeCloseTo(result.after, 6);\n    }\n  });\n});\n\ndescribe('saving and sharing (issue #17)', () => {\n  it('names the files by the network and links to the share dialogs', () => {\n    expect(fileName('01 20', 'png')).toBe('links-network-01-20.png');\n    const targets = shareTargets('https://konard.github.io/network/?code=0120', 'Links network 01₃ 20₃');\n    expect(targets.map((target) => target.id)).toEqual(expect.arrayContaining(['x', 'telegram', 'vk', 'facebook']));\n    targets\n      .filter((target) => target.id !== 'email')\n      .forEach((target) => {\n        expect(target.href).toMatch(/^https:\\/\\//);\n      });\n    expect(targets.find((target) => target.id === 'telegram').href).toContain(\n      encodeURIComponent('https://konard.github.io/network/?code=0120'),\n    );\n  });\n});\nimport {\n  baseOf,\n  canonical,\n  classCount,\n  codeAt,\n  decode,\n  indexOf,\n  isReal,\n  linksNotation,\n  mathNotation,\n  networkCount,\n  randomCode,\n  relabel,\n  representatives,\n} from './configurations';\nimport { bezier, COLORS, glyphCurves, glyphPaths, glyphSvg, SIZE } from './glyph';\n\nconst all = (n) => Array.from({ length: networkCount(n) }, (_, i) => codeAt(n, i));\nconst near = (a, b, eps = 1e-6) => Math.hypot(a[0] - b[0], a[1] - b[1]) < eps;\n\ndescribe('networks with the zero link (issue #9)', () => {\n  test('N real links are written in base N + 1, so there are (N + 1)^(2N) networks', () => {\n    expect([1, 2, 3, 4].map(baseOf)).toEqual([2, 3, 4, 5]);\n    expect([1, 2, 3, 4].map(networkCount)).toEqual([4, 81, 4096, 390625]);\n  });\n\n  test('one real link has exactly the four networks of the issue: 00, 10, 01, 11', () => {\n    expect(all(1)).toEqual(['00', '01', '10', '11']);\n    expect(linksNotation('00')).toEqual(['(1: 0 0)']);\n    expect(linksNotation('10')).toEqual(['(1: 1 0)']);\n    expect(mathNotation('10')).toBe('10₂');\n    expect(mathNotation('11')).toBe('11₂');\n  });\n\n  test('two links run from 00₃ 00₃ to 22₃ 22₃, three from 00₄ 00₄ 00₄ to 33₄ 33₄ 33₄', () => {\n    expect([codeAt(2, 0), codeAt(2, 80)].map(mathNotation)).toEqual(['00₃ 00₃', '22₃ 22₃']);\n    expect([codeAt(3, 0), codeAt(3, 4095)].map(mathNotation)).toEqual(['00₄ 00₄ 00₄', '33₄ 33₄ 33₄']);\n    expect(mathNotation(codeAt(4, 390624))).toBe('44₅ 44₅ 44₅ 44₅');\n    expect(linksNotation('01 20')).toEqual(['(1: 0 1)', '(2: 2 0)']);\n  });\n\n  test('codes and positions are inverse to each other and every code is distinct', () => {\n    [1, 2, 3].forEach((n) => {\n      const codes = all(n);\n      expect(new Set(codes).size).toBe(codes.length);\n      codes.forEach((code, i) => expect(indexOf(code)).toBe(i));\n    });\n  });\n\n  test('renaming keeps 0 fixed and the classes match Burnside counting', () => {\n    expect(\n      relabel(\n        [\n          [0, 2],\n          [1, 0],\n        ],\n        [1, 0],\n      ),\n    ).toEqual([\n      [2, 0],\n      [0, 1],\n    ]);\n    expect(canonical(decode('11 02'))).toBe('01 22');\n    expect([1, 2, 3, 4].map(classCount)).toEqual([4, 45, 720, 16900]);\n    expect([1, 2, 3].map((n) => representatives(n).length)).toEqual([4, 45, 720]);\n  });\n\n  test('random networks are valid codes of 1–4 links', () => {\n    let seed = 7;\n    const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;\n    for (let k = 0; k < 200; k++) {\n      const code = randomCode(random);\n      const n = code.split(' ').length;\n      expect(n).toBeGreaterThanOrEqual(1);\n      expect(n).toBeLessThanOrEqual(4);\n      expect(codeAt(n, indexOf(code))).toBe(code);\n    }\n  });\n});\n\ndescribe('networks with only real references (issue #13)', () => {\n  const real = { real: true };\n\n  test('exclude every network that refers to 0, keeping links that refer to each other or themselves', () => {\n    expect([1, 2, 3, 4].map((n) => networkCount(n, real))).toEqual([1, 16, 729, 65536]);\n    for (const n of [1, 2, 3]) {\n      const codes = Array.from({ length: networkCount(n, real) }, (_, i) => codeAt(n, i, real));\n      expect(codes).toEqual(all(n).filter(isReal));\n      codes.forEach((code, i) => expect(indexOf(code, real)).toBe(i));\n    }\n    expect(codeAt(1, 0, real)).toBe('11');\n    expect(codeAt(2, 0, real)).toBe('11 11');\n    expect(codeAt(2, 15, real)).toBe('22 22');\n    expect(codeAt(4, 65535, real)).toBe('44 44 44 44');\n  });\n\n  test('count their renaming classes with Burnside’s lemma', () => {\n    expect([1, 2, 3, 4].map((n) => classCount(n, real))).toEqual([1, 10, 129, 2836]);\n    for (const n of [1, 2, 3, 4]) {\n      expect(representatives(n, real)).toHaveLength(classCount(n, real));\n      expect(representatives(n, real).every(isReal)).toBe(true);\n    }\n    // Brute force: the distinct canonical codes of all real networks of 3 links.\n    const classes = new Set(\n      all(3)\n        .filter(isReal)\n        .map((code) => canonical(decode(code))),\n    );\n    expect(classes.size).toBe(129);\n  });\n\n  test('random networks with only real references never refer to 0', () => {\n    let seed = 11;\n    const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;\n    for (let k = 0; k < 200; k++) expect(isReal(randomCode(random, undefined, real))).toBe(true);\n  });\n\n  test('the default still includes references to 0', () => {\n    expect(networkCount(2)).toBe(81);\n    expect(codeAt(2, 0)).toBe('00 00');\n    expect(classCount(2)).toBe(45);\n  });\n});\n\ndescribe('network symbols (issue #9 link visuals)', () => {\n  const sample = [...all(1), ...all(2), ...all(3), ...representatives(4).filter((_, i) => i % 7 === 0)];\n\n  test('every network is drawable and stays inside the box', () => {\n    const outside = [];\n    sample.forEach((code) => {\n      glyphCurves(decode(code)).forEach(({ segments }) =>\n        segments.forEach((seg) => {\n          for (let k = 0; k <= 32; k++) {\n            const [x, y] = bezier(seg, k / 32);\n            if (!(x >= 0 && x <= SIZE && y >= 0 && y <= SIZE)) outside.push(code);\n          }\n        }),\n      );\n    });\n    expect(outside).toEqual([]);\n  });\n\n  test('every link is one unbroken line with matching tangents in its middle, in its own colour', () => {\n    sample.forEach((code) => {\n      const curves = glyphCurves(decode(code));\n      curves.forEach(({ segments: [first, second] }) => {\n        // The two halves meet in the middle of the link…\n        expect(near(first[3], second[0])).toBe(true);\n        // …and continue in the same direction, so there is no corner or gap.\n        const inDir = [first[3][0] - first[2][0], first[3][1] - first[2][1]];\n        const outDir = [second[1][0] - second[0][0], second[1][1] - second[0][1]];\n        const cross = inDir[0] * outDir[1] - inDir[1] * outDir[0];\n        expect(Math.abs(cross) / Math.hypot(...inDir) / Math.hypot(...outDir)).toBeLessThan(1e-9);\n        expect(inDir[0] * outDir[0] + inDir[1] * outDir[1]).toBeGreaterThan(0);\n      });\n      const paths = glyphPaths(decode(code));\n      paths.forEach(({ d }) => expect(d.match(/M/g).length).toBe(3)); // line, bar, arrow\n      expect(paths.map((p) => p.color)).toEqual(COLORS.slice(0, paths.length));\n    });\n  });\n\n  test('ends touch the middles they refer to, references to 0 stay free', () => {\n    sample.forEach((code) => {\n      const links = decode(code);\n      const curves = glyphCurves(links);\n      const middles = curves.map((c) => c.segments[1][0]);\n      const span = SIZE;\n      links.forEach(([s, t], i) => {\n        const ends = [\n          [s, curves[i].start.at],\n          [t, curves[i].end.at],\n        ];\n        ends.forEach(([ref, at]) => {\n          const distances = middles.map((m) => Math.hypot(at[0] - m[0], at[1] - m[1]));\n          if (ref === 0) expect(Math.min(...distances)).toBeGreaterThan(span * 0.08);\n          else expect(distances[ref - 1]).toBeLessThan(span * 0.06);\n        });\n      });\n    });\n  });\n\n  test('(1: 1 1) is a point-symmetric figure eight around its middle', () => {\n    const [{ segments }] = glyphCurves(decode('11'));\n    const middle = segments[0][3];\n    const mirror = ([x, y]) => [2 * middle[0] - x, 2 * middle[1] - y];\n    const [first, second] = segments;\n    [...first].reverse().forEach((p, k) => expect(near(mirror(p), second[k], 1e-6)).toBe(true));\n  });\n\n  test('a double self-reference inside a network stays symmetric too', () => {\n    ['11 01', '00 22 10', '00 01 33 30'].forEach((code) => {\n      const links = decode(code);\n      const i = links.findIndex(([s, t], k) => s === k + 1 && t === k + 1);\n      const { segments } = glyphCurves(links)[i];\n      const middle = segments[0][3];\n      const mirror = ([x, y]) => [2 * middle[0] - x, 2 * middle[1] - y];\n      [...segments[0]].reverse().forEach((p, k) => expect(near(mirror(p), segments[1][k], 1e-6)).toBe(true));\n    });\n  });\n\n  test('different networks of the same size are drawn differently', () => {\n    [1, 2, 3].forEach((n) => {\n      const drawings = all(n).map((code) => glyphSvg(decode(code)));\n      expect(new Set(drawings).size).toBe(drawings.length);\n    });\n  });\n\n  test('arbitrary finite link counts fit into a symbol', () => {\n    expect(() => glyphPaths([])).toThrow(RangeError);\n    expect(glyphPaths(decode('00 00 00 00 00')).length).toBeGreaterThan(0);\n    expect(() => glyphPaths(Array.from({ length: 9 }, () => [0, 0]))).not.toThrow();\n    expect(glyphPaths(Array.from({ length: 100 }, () => [0, 0]))).toHaveLength(100);\n  });\n});\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.symbols__formula dd {\n  margin: 0 0 0.35rem;\n}\n\n.symbols__legend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem 1rem;\n  font-size: 0.85rem;\n}\n\n/* The legend colours are inline styles (the dark-theme link colours of glyph.js). */\n.symbols__legend span:nth-child(1) {\n  color: var(--link-1) !important;\n}\n\n.symbols__legend span:nth-child(2) {\n  color: var(--link-2) !important;\n}\n\n.symbols__legend span:nth-child(3) {\n  color: var(--link-3) !important;\n}\n\n.symbols__legend span:nth-child(4) {\n  color: var(--link-4) !important;\n}\n\n.symbols__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n  gap: 0.4rem;\n  margin: 0 0 1rem;\n  padding: 0;\n  list-style: none;\n}\n\n.symbols__grid li {\n  position: relative;\n  display: grid;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: rgb(var(--panel-rgb) / calc(0.8 * var(--glass-level, 0.4)));\n  color: var(--accent);\n}\n\n.symbols__grid li:hover,\n.symbols__grid li:focus-within {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n/* The whole card opens the page of the network (issue #17). */\n.symbols__card {\n  display: grid;\n  justify-items: center;\n  padding: 0.3rem 0.2rem 0.4rem;\n  border-radius: inherit;\n  color: inherit;\n  text-decoration: none;\n}\n\n.symbols__card:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.symbols__card svg {\n  width: 64px;\n  height: 64px;\n}\n\n/* The share icon appears on hover (and on keyboard focus, so it can be reached without a mouse). */\n.symbols__share {\n  position: absolute;\n  top: 0.2rem;\n  right: 0.2rem;\n  display: grid;\n  place-items: center;\n  width: 1.6rem;\n  height: 1.6rem;\n  border: 1px solid var(--border);\n  border-radius: 50%;\n  background: rgb(var(--panel-rgb) / 0.85);\n  color: var(--accent);\n  opacity: 0;\n  transition: opacity 0.15s ease;\n}\n\n.symbols__grid li:hover .symbols__share,\n.symbols__share:focus-visible {\n  opacity: 1;\n}\n\n.symbols__share:hover,\n.symbols__share:focus-visible {\n  border-color: var(--accent);\n  color: var(--text);\n}\n\n.symbols__grid span {\n  font-size: 0.6rem;\n  color: var(--muted);\n  white-space: nowrap;\n}\n\n/* ---------- Blog ---------- */\n  color: var(--text);\n  font-family: var(--font);\n  font-size: 16px;\n  line-height: 1.55;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\na {\n  color: var(--accent);\n  text-decoration: none;\n}\n\na:hover {\n  text-decoration: underline;\n}\n\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\"\"\"Bound Linux browser probes by descendant RSS, cgroup usage and wall time.\n\nUsage: python3 experiments/issue-19-memory-guard.py node experiments/...\nOnly the launched process tree is terminated; unrelated workspace processes stay alive.\n\"\"\"\n\nimport json\nimport os\nfrom pathlib import Path\nimport signal\nimport subprocess\nimport sys\nimport time\n\n\ndef processes():\n    result = {}\n    for directory in Path('/proc').glob('[0-9]*'):\n        try:\n            fields = (directory / 'stat').read_text().rsplit(')', 1)[1].split()\n            result[int(directory.name)] = (int(fields[1]), int(fields[21]) * os.sysconf('SC_PAGE_SIZE'))\n        except (OSError, ValueError, IndexError):\n            pass\n    return result\n\n\ndef memory():\n    return int(Path('/sys/fs/cgroup/memory.curr