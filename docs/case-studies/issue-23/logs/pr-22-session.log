[2026-10-25T10:27:47.535Z] [STDOUT] {"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"cat >> src/links/geometry-21.test.js <<'EOF'\n\ndescribe('editor symmetry and compatibility', () => {\n  it('keeps four free links related by exact quarter turns, including after fitting', async () => {\n    const { glyphCurves } = await import('./glyph');\n    const curves = glyphCurves(decode('00 00 00 00'), shape({}, 4));\n    for (let i = 0; i < 4; i++) {\n      curves[i].segments.forEach((segment, k) => segment.forEach((p, j) => {\n        near(curves[(i + 1) % 4].segments[k][j], [100 - p[1], p[0]]);\n      }));\n    }\n  });\n\n  it('makes the source bar exactly centered and perpendicular to its tangent', async () => {\n    const { glyphCurves, glyphParts } = await import('./glyph');\n    const options = shape({ bulge: 0 });\n    const [curve] = glyphCurves([[0, 0]], options);\n    const [parts] = glyphParts([[0, 0]], options);\n    const [x1, y1, x2, y2] = parts.start.d.match(/-?\\\\d+(?:\\\\.\\\\d+)?/g).map(Number);\n    const center = [(x1 + x2) / 2, (y1 + y2) / 2];\n    near(center, [curve.start.at[0] + options.startOffset, curve.start.at[1]]);\n    expect(x1).toBe(x2);\n    expect(y1 - center[1]).toBe(center[1] - y2);\n    expect(Math.hypot(x1 - x2, y1 - y2)).toBe(2 * options.startSize);\n  });\n\n  it('honors colors stored by links shared when custom was the default', () => {\n    const style = styleFromParams(new URLSearchParams('colors=%23ff2600,%2300f900'));\n    expect(style.palette).toBe('custom');\n    expect(linkColors(style, 2)).toEqual(['#ff2600', '#00f900']);\n  });\n\n  it('keeps all small editor configurations finite and continuous', () => {\n    for (const n of [1, 2, 3]) {\n      for (let i = 0; i < networkCount(n); i++) {\n        const curves = layoutCurves(decode(codeAt(n, i)), shape({}, n));\n        for (const { segments: [a, b] } of curves) {\n          expect(a.flat().concat(b.flat()).every(Number.isFinite)).toBe(true);\n          near(a[3], b[0]);\n          const incoming = [a[3][0] - a[2][0], a[3][1] - a[2][1]];\n          const outgoing = [b[1][0] - b[0][0], b[1][1] - b[0][1]];\n          expect(Math.abs(incoming[0] * outgoing[1] - incoming[1] * outgoing[0])).toBeLessThan(1e-10);\n          expect(incoming[0] * outgoing[0] + incoming[1] * outgoing[1]).toBeGreaterThan(0);\n        }\n      }\n    }\n  });\n});\nEOF\ncat > src/pages/network-21.test.jsx <<'EOF'\nimport { act, render, screen, within } from '@testing-library/react';\nimport { afterEach, expect, it } from 'vitest';\nimport NetworkGallery from '../components/NetworkGallery';\nimport { NetworkExample } from '../components/MetaTheory';\nimport { setTheme } from '../i18n/prefs';\n\nafterEach(() => act(() => setTheme('dark', { save: false })));\n\nit('updates both gallery links and theory examples when their displayed theme changes', () => {\n  act(() => setTheme('dark', { save: false }));\n  render(<><NetworkGallery initial={1} /><NetworkExample example={{ code: '11 22 12' }} /></>);\n  const card = () => within(screen.getByRole('list', { name: 'Networks of 1 link' })).getAllByRole('link')[0];\n  expect(card()).toHaveAttribute('href', '/network/?code=00');\n  act(() => setTheme('light', { save: false }));\n  expect(card()).toHaveAttribute('href', '/network/?code=00&palette=print');\n  expect(screen.getByRole('link', { name: 'Share 00₂' })).toHaveAttribute('href', '/network/?code=00&palette=print#share');\n  expect(screen.getByRole('link', { name: 'Edit and share this network' })).toHaveAttribute('href', '/network/?code=112212&palette=print');\n  act(() => setTheme('dark', { save: false }));\n  expect(card()).toHaveAttribute('href', '/network/?code=00');\n});\nEOF\npython3 - <<'PY'\nimport json\np='package.json'\ns=json.load(open(p)); s['scripts']['test:network:issue21']='node experiments/issue-21-browser.mjs'\nopen(p,'w').write(json.dumps(s,indent=2)+'\\\\n')\np='.github/workflows/github-pages.yml'\ns=open(p).read().replace('      - name: Preserve browser evidence', '      - name: Verify editor geometry, source colors and shared settings\\\\n        run: npm run test:network:issue21\\\\n\\\\n      - name: Preserve browser evidence')\nopen(p,'w').write(s)\nPY\nnpx prettier --write src/links/{style,style-geometry,geometry-21.test}.js src/pages/network-21.test.jsx experiments/issue-21-*.mjs package.json .github/workflows/github-pages.yml > docs/case-studies/issue-21/logs/format.log 2>&1\nnpm run check > docs/case-studies/issue-21/logs/check.log 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}
