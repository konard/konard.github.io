en. Every value comes through normalizeStyle, and the\n// caption is escaped, so a shared link cannot put markup into the picture.\nimport { mathNotation, encode } from './configurations';\nimport { linksText, numberNotation, decimalOf, theoryNotation } from './edit';\nimport { SIZE, glyphParts } from './glyph';\nimport { linkColors, normalizeStyle, shapeOfStyle } from './style';\n\nconst FONTS = {\n  mono: \"ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace\",\n  sans: \"system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif\",\n  serif: \"Georgia, 'Times New Roman', serif\",\n};\n// Average width of a character relative to the font size, to fit long captions.\nconst WIDTH = { mono: 0.6, sans: 0.55, serif: 0.52 };\n\nexport const escapeXml = (text) =>\n  String(text).replace(\n    /[&<>\"']/g,\n    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&apos;' })[c],\n  );\n\nconst num = (x) => +x.toFixed(2);\n\n/** Dash pattern of the lines, relative to their width. Zero-length dots need round or square caps. */\nfunction dashArray(dash, width, cap) {\n  const dot = cap === 'butt' ? width : 0.01;\n  const pattern = {\n    dashed: [3, 2],\n    dotted: [dot / width, 2],\n    dashdot: [4, 1.6, dot / width, 1.6],\n    long: [8, 3],\n  }[dash];\n  return pattern ? pattern.map((k) => num(k * width)).join(' ') : null;\n}\n\n/** The caption of a network in the chosen notation. */\nexport function captionOf(links, style, notation = 'L') {\n  switch (style.caption) {\n    case 'theory':\n      return theoryNotation(links, notation);\n    case 'pairs':\n      return mathNotation(encode(links));\n    case 'number':\n      return `${numberNotation(links)} = ${decimalOf(links)}`;\n    case 'links':\n      return linksText(links);\n    case 'custom':\n      return style.captionText;\n    default:\n      return '';\n  }\n}\n\n/** The background and the card, in a viewBox of `w` × `h`. */\nfunction backdrop(style, w, h, defs) {\n  const parts = [];\n  if (style.background === 'solid') parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"${style.bgColor}\"/>`);\n  else if (style.background === 'linear') {\n    const a = (style.bgAngle * Math.PI) / 180;\n    const [dx, dy] = [Math.cos(a) / 2, Math.sin(a) / 2];\n    defs.push(\n      `<linearGradient id=\"bg\" x1=\"${num(0.5 - dx)}\" y1=\"${num(0.5 - dy)}\" x2=\"${num(0.5 + dx)}\" y2=\"${num(0.5 + dy)}\">` +\n        `<stop offset=\"0\" stop-color=\"${style.bgColor}\"/><stop offset=\"1\" stop-color=\"${style.bgColor2}\"/></linearGradient>`,\n    );\n    parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"url(#bg)\"/>`);\n  } else if (style.background === 'radial') {\n    defs.push(\n      `<radialGradient id=\"bg\" cx=\"0.5\" cy=\"0.5\" r=\"0.75\">` +\n        `<stop offset=\"0\" stop-color=\"${style.bgColor}\"/><stop offset=\"1\" stop-color=\"${style.bgColor2}\"/></radialGradient>`,\n    );\n    parts.push(`<rect width=\"${num(w)}\" height=\"${num(h)}\" fill=\"url(#bg)\"/>`);\n  }\n  if (style.card) {\n    const inset = style.inset;\n    const [cw, ch] = [Math.max(w - 2 * inset, 1), Math.max(h - 2 * inset, 1)];\n    const r = Math.min(style.radius, cw / 2, ch / 2);\n    const rect = (d, extra) =>\n      `<rect x=\"${num(inset + d)}\" y=\"${num(inset + d)}\" width=\"${num(Math.max(cw - 2 * d, 0))}\" ` +\n      `height=\"${num(Math.max(ch - 2 * d, 0))}\" rx=\"${num(Math.max(r - d, 0))}\" ${extra}/>`;\n    parts.push(rect(0, `fill=\"${style.cardColor}\" fill-opacity=\"${style.cardOpacity}\"`));\n    if (style.borderStyle !== 'none') {\n      const b = style.border;\n      const stroke = `fill=\"none\" stroke=\"${style.borderColor}\" stroke-width=\"${num(b)}\"`;\n      const dash = {\n        dashed: ` stroke-dasharray=\"${num(b * 4)} ${num(b * 3)}\"`,\n        dotted: ` stroke-dasharray=\"0.01 ${num(b * 2.5)}\" stroke-linecap=\"round\"`,\n      }[style.borderStyle];\n      parts.push(rect(b / 2, stroke + (dash || '')));\n      if (style.borderStyle === 'double') parts.push(rect(b * 2.5, stroke));\n    }\n  }\n  return parts.join('');\n}\n\n/**\n * The SVG document of network `links` in `style` (any partial or untrusted\n * style; it is normalized). `notation` is 'L' or 'R' for the caption in math\n * notation, `extraTurns` the turns found by the solver of overlaps.\n */\nexport function networkSvg(links, rawStyle = {}, { notation = null, extraTurns = null, title = '' } = {}) {\n  const style = normalizeStyle(rawStyle);\n  const n = links.length;\n  const short = Math.min(style.width, style.height);\n  // The shorter side of the picture is SIZE units long, so the symbol keeps its size in any proportions.\n  const [w, h] = [(SIZE * style.width) / short, (SIZE * style.height) / short];\n  const defs = [];\n  const back = backdrop(style, w, h, defs);\n  const caption = captionOf(links, style, notation || style.notation);\n  const edge = style.card ? style.inset : 0;\n  const room = caption ? style.captionSize * 2.2 : 0;\n  const side = Math.max(SIZE - room - 2 * edge, 10);\n  const [x, y] = [(w - side) / 2, edge + (h - 2 * edge - room - side) / 2];\n\n  const colors = linkColors(style, n);\n  const parts = glyphParts(links, shapeOfStyle(style, n, extraTurns));\n  const dash = dashArray(style.dash, style.strokeWidth, style.linecap);\n  const lines = parts\n    .map(({ line, start, end, middle }, i) => {\n      const shapes = [start, end, middle]\n        .filter((m) => m.d)\n        .map((m) => `<path d=\"${m.d}\"${m.fill ? ` fill=\"${colors[i]}\"` : ''}/>`)\n        .join('');\n      return `<g stroke=\"${colors[i]}\"><path d=\"${line}\"${dash ? ` stroke-dasharray=\"${dash}\"` : ''}/>${shapes}</g>`;\n    })\n    .join('');\n  if (style.glow > 0)\n    defs.push(\n      `<filter id=\"glow\" x=\"-25%\" y=\"-25%\" width=\"150%\" height=\"150%\"><feGaussianBlur stdDeviation=\"${num(style.glow * 0.5)}\" result=\"b\"/>` +\n        `<feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>`,\n    );\n\n  let text = '';\n  if (caption) {\n    const size = style.captionSize;\n    const width = w - 2 * edge - size * 2;\n    const estimate = caption.length * size * WIDTH[style.captionFont];\n    const fit = estimate > width ? ` textLength=\"${num(width)}\" lengthAdjust=\"spacingAndGlyphs\"` : '';\n    text =\n      `<text x=\"${num(w / 2)}\" y=\"${num(h - edge - room / 2 + size * 0.35)}\" text-anchor=\"middle\" ` +\n      `font-family=\"${escapeXml(FONTS[style.captionFont])}\" font-size=\"${num(size)}\" fill=\"${style.captionColor}\"${fit}>` +\n      `${escapeXml(caption)}</text>`;\n  }\nimport { useState } from 'react';\nimport { formatValue } from '../settings/fields';\nimport { LOOKS, SIZES, STYLE_DEFAULTS, STYLE_SECTIONS, applyLook, normalizeStyle } from '../links/style';\nimport { geometryAvailable } from '../links/style-geometry';\nimport { useLang } from '../i18n/prefs';\n\nconst SAVED_KEY = 'network.styles';\nconst MAX_SAVED = 12;\n\n/** The styles saved in this browser: [{ name, style }]. */\nexport function readSaved() {\n  try {\n    const list = JSON.parse(localStorage.getItem(SAVED_KEY) || '[]');\n    return Array.isArray(list)\n      ? list\n          .filter((item) => item && typeof item.name === 'string')\n          .slice(0, MAX_SAVED)\n          .map((item) => ({ name: item.name.slice(0, 40), style: normalizeStyle(item.style) }))\n      : [];\n  } catch {\n    return [];\n  }\n}\n\nfunction writeSaved(list) {\n  try {\n    localStorage.setItem(SAVED_KEY, JSON.stringify(list));\n  } catch {\n    // Private mode or a full storage: the list lives until the page is closed.\n  }\n}\n\n/** One option of the picture, in the same rows as the settings page (label | control | value | reset). */\nfunction Control({ field, value, onChange }) {\n  const { t } = useLang();\n  const id = `style-${field.key}`;\n  const changed = value !== STYLE_DEFAULTS[field.key];\n  let input;\n  let shown = null;\n  if (field.type === 'range') {\n    input = (\n      <input\n        id={id}\n        type=\"range\"\n        min={field.min}\n        max={field.max}\n        step={field.step}\n        value={value}\n        onChange={(event) => onChange(Number(event.target.value))}\n      />\n    );\n    shown = formatValue(field, value);\n  } else if (field.type === 'toggle') {\n    input = <input id={id} type=\"checkbox\" checked={value} onChange={(event) => onChange(event.target.checked)} />;\n  } else if (field.type === 'color') {\n    input = <input id={id} type=\"color\" value={value} onChange={(event) => onChange(event.target.value)} />;\n    shown = value;\n  } else if (field.type === 'text') {\n    input = (\n      <input\n        id={id}\n        type=\"text\"\n        maxLength={field.max}\n        value={value}\n        onChange={(event) => onChange(event.target.value)}\n      />\n    );\n  } else {\n    input = (\n      <select id={id} value={value} onChange={(event) => onChange(event.target.value)}>\n        {field.options.map((option) => (\n          <option key={option.value} value={option.value}>\n            {t(option.label)}\n          </option>\n        ))}\n      </select>\n    );\n  }\n  return (\n    <li className={`setting setting--${field.type === 'text' ? 'select' : field.type}${changed ? ' is-changed' : ''}`}>\n      <label htmlFor={id}>{t(field.label)}</label>\n      <span className=\"setting__input\">{input}</span>\n      {shown !== null && (\n        <output htmlFor={id} className=\"setting__value mono\">\n          {shown}\n        </output>\n      )}\n      <button\n        type=\"button\"\n        className=\"setting__reset\"\n        onClick={() => onChange(STYLE_DEFAULTS[field.key])}\n        disabled={!changed}\n        title={t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}\n        aria-label={`${t({ en: 'Back to the default', ru: 'Вернуть по умолчанию' })}: ${t(field.label)}`}\n      >\n        ↺\n      </button>\n      {field.hint && <small className=\"setting__hint\">{t(field.hint)}</small>}\n    </li>\n  );\n}\n\n/** Ready looks, the usual image sizes and the styles saved in this browser. */\nexport function Looks({ style, onStyle }) {\n  const { t } = useLang();\n  const [saved, setSaved] = useState(readSaved);\n  const [name, setName] = useState('');\n  const size = SIZES.findIndex((s) => s.width === style.width && s.height === style.height);\n  const save = () => {\n    const label = name.trim() || `${t({ en: 'Style', ru: 'Стиль' })} ${saved.length + 1}`;\n    const next = [{ name: label.slice(0, 40), style }, ...saved.filter((item) => item.name !== label)].slice(\n      0,\n      MAX_SAVED,\n    );\n    setSaved(next);\n    writeSaved(next);\n    setName('');\n  };\n  const remove = (label) => {\n    const next = saved.filter((item) => item.name !== label);\n    setSaved(next);\n    writeSaved(next);\n  };\n  return (\n    <div className=\"looks\">\n      <div className=\"looks__row\" role=\"group\" aria-label={t({ en: 'Looks', ru: 'Оформления' })}>\n        {LOOKS.map((look) => (\n          <button\n            key={look.id}\n            type=\"button\"\n            className=\"button button--small\"\n            onClick={() => onStyle(applyLook(style, look.id))}\n          >\n            {t(look.label)}\n          </button>\n        ))}\n      </div>\n      <label className=\"looks__size\">\n        {t({ en: 'Image size', ru: 'Размер изображения' })}{' '}\n        <select\nimport { act, fireEvent, render, screen, within } from '@testing-library/react';\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';\nimport NetworkGallery, { networkHref } from '../components/NetworkGallery';\nimport { NetworkExample } from '../components/MetaTheory';\nimport { decode } from '../links/configurations';\nimport { STYLE_DEFAULTS, normalizeStyle } from '../links/style';\nimport { setSettings } from '../settings/store';\nimport NetworkPage, { DEFAULT_CODE, networkQuery, readNetwork } from './NetworkPage';\nimport { randomLinks, stepped } from './NetworkEditor';\n\nconst go = (url = '/') => window.history.replaceState(null, '', url);\nbeforeEach(() => vi.useFakeTimers());\nconst search = () => {\n  act(() => vi.advanceTimersByTime(450));\n  return window.location.search;\n};\nafterEach(() => {\n  vi.useRealTimers();\n  go('/');\n  localStorage.clear();\n});\n\nconst field = (name) => screen.getByLabelText(name);\nconst preview = () => document.querySelector('.network__preview');\n\ndescribe('gallery cards open the page of their network (issue #17)', () => {\n  it('links each card to /network/ and has a share icon that only the hover shows', () => {\n    render(<NetworkGallery initial={1} />);\n    const list = screen.getByRole('list', { name: 'Networks of 1 link' });\n    const first = list.firstChild;\n    expect(within(first).getAllByRole('link')[0]).toHaveAttribute('href', '/network/?code=00');\n    const share = within(first).getByRole('link', { name: 'Share 00₂' });\n    expect(share).toHaveAttribute('href', '/network/?code=00#share');\n    expect(share.className).toBe('symbols__share');\n    // The icon has no text and no paths: the card still reads as its notation only.\n    expect(first.textContent).toBe('00₂');\n    expect(share.querySelectorAll('path')).toHaveLength(0);\n    expect(networkHref('01 20')).toBe('/network/?code=0120');\n  });\n\n  it('links the example of the theory to its page', () => {\n    render(<NetworkExample example={{ code: '11 22 12' }} />);\n    expect(screen.getByRole('link', { name: 'Edit and share this network' })).toHaveAttribute(\n      'href',\n      '/network/?code=112212',\n    );\n  });\n});\n\ndescribe('the address keeps the network and its picture (issue #17)', () => {\n  it('reads and writes the code and the changed options', () => {\n    expect(readNetwork('').links).toEqual(decode(DEFAULT_CODE));\n    expect(readNetwork('?code=0130').links).toEqual(decode(DEFAULT_CODE));\n    const { links, style } = readNetwork('?code=0120&card=false&end=dot');\n    expect(links).toEqual(decode('01 20'));\n    expect(style).toEqual(normalizeStyle({ card: false, end: 'dot' }));\n    expect(networkQuery(links, style)).toBe('?code=0120&end=dot');\n    expect(networkQuery(links, STYLE_DEFAULTS)).toBe('?code=0120');\n  });\n\n  it('steps through the networks and draws random ones of the same size', () => {\n    expect(stepped(decode('22 22'), 1)).toEqual(decode('00 00'));\n    expect(stepped(decode('00 00'), -1)).toEqual(decode('22 22'));\n    expect(stepped(decode('01 20'), 1)).toEqual(decode('01 21'));\n    expect(randomLinks(3, () => 0.99)).toEqual(decode('33 33 33'));\n  });\n});\n\ndescribe('NetworkPage (issue #17)', () => {\n  it('preserves an explicit page language in the address and shared link after editing', () => {\n    go('/network/?code=0120&lang=ru');\n    render(<NetworkPage />);\n    expect(new URLSearchParams(search()).get('lang')).toBe('ru');\n    fireEvent.change(field('N-ary number'), { target: { value: '1122' } });\n    expect(search()).toBe('?code=1122&lang=ru');\n    expect(field('Link to this picture')).toHaveValue(`${window.location.origin}/network/?code=1122&lang=ru`);\n  });\n\n  it('opens the shared theory notation regardless of the receiving browser settings', () => {\n    setSettings({ 'theory.notation': 'L' }, { save: false });\n    go('/network/?code=0120&caption=theory&notation=R');\n    render(<NetworkPage />);\n    expect(preview().textContent).toContain('N² =');\n    expect(field('Math notation (the links theory)')).toHaveValue('N² = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n    expect(new URLSearchParams(search()).get('notation')).toBe('R');\n  });\n\n  it('opens the network of the address and shows it in every notation', () => {\n    go('/network/?code=0120');\n    render(<NetworkPage />);\nimport { describe, expect, it } from 'vitest';\nimport { decode } from './configurations';\nimport { overlapCost, pairCost, solveCollisions } from './collisions';\nimport {\n  addLink,\n  check,\n  countOf,\n  decimalOf,\n  linksText,\n  numberNotation,\n  parseCode,\n  parseIndex,\n  parseLinks,\n  parseMath,\n  parseNumber,\n  removeLink,\n  setReference,\n  theoryNotation,\n} from './edit';\nimport { fileName, shareTargets } from './export';\nimport { glyphSvg } from './glyph';\nimport { captionOf, escapeXml, networkSvg } from './render';\nimport {\n  LOOKS,\n  STYLE_DEFAULTS,\n  applyLook,\n  linkColors,\n  linkTurns,\n  normalizeStyle,\n  shapeOfStyle,\n  styleFromParams,\n  styleToParams,\n  withColor,\n  withTurns,\n} from './style';\n\nconst links = decode('01 20');\n\ndescribe('notations of the editor (issue #17)', () => {\n  it('writes one network in every notation', () => {\n    expect(theoryNotation(links)).toBe('λ = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n    expect(theoryNotation(links, 'R')).toBe('N² = {1 ↦ (0, 1), 2 ↦ (2, 0)}');\n    expect(numberNotation(links)).toBe('0120₃');\n    // 0·27 + 1·9 + 2·3 + 0 = 15.\n    expect(decimalOf(links)).toBe('15');\n    expect(linksText(links)).toBe('(1: 0 1) (2: 2 0)');\n  });\n\n  it('reads back what it writes, in every notation', () => {\n    expect(parseMath(theoryNotation(links)).links).toEqual(links);\n    expect(parseMath(theoryNotation(links, 'R')).links).toEqual(links);\n    expect(parseMath('01₃ 20₃').links).toEqual(links);\n    expect(parseMath('{(0, 1), (2, 0)}').links).toEqual(links);\n    expect(parseMath('1 -> (0 1), 2 -> (2 0)').links).toEqual(links);\n    expect(parseNumber('0120₃').links).toEqual(links);\n    expect(parseNumber('0120_3').links).toEqual(links);\n    expect(parseNumber('0120').links).toEqual(links);\n    expect(parseIndex('15', 2).links).toEqual(links);\n    expect(parseLinks('(1: 0 1) (2: 2 0)').links).toEqual(links);\n    expect(parseLinks('(2: 2 0)\\n(1: 0 1)').links).toEqual(links);\n    expect(parseLinks('(0 1) (2 0)').links).toEqual(links);\n    expect(parseCode('0120')).toBe('01 20');\n    expect(parseCode('01-20')).toBe('01 20');\n  });\n\n  it('explains what is