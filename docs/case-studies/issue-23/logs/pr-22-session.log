 3, 0.05, 'Horizontal layout scale', 'Масштаб размещения по горизонтали'),\n      field('columns', 0, 30, 1, 'Grid columns (0 = automatic)', 'Столбцы сетки (0 = авто)', {\n        when: (s) => s.placement === 'square',\n      }),\n      ...[\n        ['forceDistance', 'Spring length', 'Длина пружины'],\n        ['forceCharge', 'Repulsion', 'Отталкивание'],\n        ['forceCollision', 'Space for links and loops', 'Пространство связей и петель'],\n      ].map(([key, en, ru]) =>\n        range(key, SHAPE[key], 0.2, 3, 0.05, { en, ru }, { when: (s) => s.placement === 'force' }),\n      ),\n    ],\n  },\n  {\n    id: 'shape',\n    title: { en: 'Shape of the links', ru: 'Форма связей' },\n    fields: [\n      select(\n        'angles',\n        EDITOR_SHAPE.angles,\n        [\n          option('mirror', 'Mirror the middle (as in the gallery)', 'Отражение середины (как в галерее)'),\n          option('fixed', 'Fixed angles', 'Заданные углы'),\n        ],\n        { en: 'Angles of the ends', ru: 'Углы концов' },\n      ),\n      field('sourceAngle', -90, 90, 1, 'Leaving angle', 'Угол выхода', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      field('targetAngle', -90, 90, 1, 'Entering angle', 'Угол входа', {\n        ...degrees,\n        when: (s) => s.angles === 'fixed',\n      }),\n      toggle('lens', SHAPE.lens, {\n        en: 'Two references to one link make a lens',\n        ru: 'Две ссылки на одну связь образуют линзу',\n      }),\n      field('tension', 0, 1, 0.01, 'Curvature', 'Изгиб', { unit: '%' }),\n      field('bulge', 0, 90, 1, 'Bend of a single reference', 'Отклонение одиночной ссылки', {\n        ...degrees,\n        hint: {\n          en: 'Also turns the middle tangent of free links and self-reference loops.',\n          ru: 'Также поворачивает касательную середины свободных связей и петель.',\n        },\n      }),\n      field('startGap', 0, 0.4, 0.01, 'Gap at the source reference', 'Зазор у начальной ссылки'),\n      field('endGap', 0, 0.4, 0.01, 'Gap at the target reference', 'Зазор у конечной ссылки'),\n      field('free', 0.2, 3, 0.05, 'Length of a free end', 'Длина свободного конца', { unit: '×' }),\n      field('loop', 0.3, 2.5, 0.05, 'Size of a loop', 'Размер петли', { unit: '×' }),\n      field('spread', 0.5, 2.5, 0.05, 'Distance between links', 'Расстояние между связями', { unit: '×' }),\n      field('rotation', 0, 359, 1, 'Rotation', 'Поворот', degrees),\n      field('padding', 0, 40, 1, 'Margin', 'Поля', { unit: '%' }),\n    ],\n  },\n  {\n    id: 'ends',\n    title: { en: 'Start, end and middle', ru: 'Начало, конец и середина' },\n    fields: [\n      ...['start', 'end', 'middle'].flatMap((key, i) => {\n        const en = ['start', 'end', 'middle'][i];\n        const ru = ['начала', 'конца', 'середины'][i];\n        const shown = (s) => s[key] !== 'none';\n        return [\n          select(\n            key,\n            EDITOR_SHAPE[key],\n            MARKERS.map((m) => option(m, ...names[m])),\n            {\n              en: `${['Start', 'End', 'Middle'][i]} of a link`,\n              ru: ['Начало связи', 'Конец связи', 'Середина связи'][i],\n            },\n          ),\n          field(`${key}Size`, 0.5, 15, 0.1, `Size of the ${en}`, `Размер ${ru}`, { when: shown }),\n          field(`${key}Angle`, 5, 85, 1, `Angle of the ${en}`, `Угол ${ru}`, {\n            ...degrees,\n            when: (s) => ['arrow', 'triangle', 'tail'].includes(s[key]),\n          }),\n          field(`${key}Offset`, -20, 20, 0.1, `Offset of the ${en}`, `Сдвиг ${ru}`, {\n            when: shown,\n            hint: {\n              en: 'Along the tangent; positive moves an endpoint marker into the line. Units: 1/100 of the symbol.',\n              ru: 'Вдоль касательной; положительное значение смещает концевой маркер внутрь линии. Единица — 1/100 символа.',\n            },\n          }),\n          field(`${key}Across`, -20, 20, 0.1, `Sideways offset of the ${en}`, `Поперечный сдвиг ${ru}`, {\n            when: shown,\n          }),\n          field(`${key}Rotation`, -180, 180, 1, `Rotation of the ${en}`, `Поворот ${ru}`, {\n            ...degrees,\n            when: (s) => !['none', 'circle', 'dot'].includes(s[key]),\n          }),\n        ];\n      }),\n      field('middleGapStart', 0, 15, 0.1, 'Cut before the middle', 'Разрыв перед серединой', {\n        hint: {\n          en: 'Optional: for a ring, try half its size on each side. Zero keeps the line continuous.',\n          ru: 'Необязательно: для кольца попробуйте половину его размера с каждой стороны. Ноль оставляет линию непрерывной.',\n        },\n      }),\n      field('middleGapEnd', 0, 15, 0.1, 'Cut after the middle', 'Разрыв после середины'),\n    ],\n  },\n];\n\n/** Whether a geometry option can affect this network. Field-specific style conditions are separate. */\nexport function geometryAvailable(key, style, links) {\n  if (!links) return true;\n  const other = (ref, i) => ref !== 0 && ref !== i + 1;\n  const any = (predicate) => links.some(predicate);\n  switch (key) {\n    case 'angles':\n    case 'tension':\n      return any(([s, t]) => s || t);\n    case 'sourceAngle':\n    case 'startGap':\n      return any(([s]) => s !== 0);\n    case 'targetAngle':\n    case 'endGap':\n      return any(([, t]) => t !== 0);\n    case 'lens':\n      return style.angles === 'mirror' && any(([s, t], i) => s === t && other(s, i));\n    case 'bulge':\n      return any(([s, t], i) => !(other(s, i) && other(t, i)));\n    case 'free':\n      return any(([s, t]) => s === 0 || t === 0);\n    case 'loop':\n      return any(([s, t], i) => s === i + 1 || t === i + 1);\n    case 'forceDistance':\n      return any(([s, t], i) => other(s, i) || other(t, i));\n    case 'spread':\n    case 'placement':\n    case 'layoutAspect':\n    case 'columns':\n    case 'forceCharge':\n    case 'forceCollision':\n      return links.length > 1;\n    default:\n      return true;\n  }\n}\n// Every option of the picture of a network in the editor of /network/\n// (issue #17): the shape of the links (the angle at which a link leaves its\n// source and enters its target, its start, end and middle), the lines, the\n// colours, the background, the card around the symbol, a caption, the size of\n// the exported image and the experimental solver of overlaps.\n//\n// The fields reuse the helpers of the settings page (src/settings/fields.js).\n// A style is a flat object; `normalizeStyle` checks every value (it may come\n// from a shared link), and `styleToParams` / `styleFromParams` keep only the\n// values that differ from the defaults in the query string, so a shared link\n// opens exactly the picture that was shared.\nimport { color, option, range, select, toggle } from '../settings/fields';\nimport { COLORS, SHAPE } from './glyph';\nimport { GEOMETRY_SECTIONS } from './style-geometry';\n\n/** Link colours: the site's, and a few more sets of nine. */\nexport const PALETTES = {\n  site: COLORS,\n  neon: ['#00f0ff', '#ff00e6', '#faff00', '#00ff85', '#ff6b00', '#8a5cff', '#ff2d55', '#00b3ff', '#c6ff00'],\n  pastel: ['#93c5fd', '#c4b5fd', '#f9a8d4', '#fde68a', '#a7f3d0', '#fed7aa', '#bae6fd', '#fecaca', '#d9f99d'],\n  warm: ['#f97316', '#ef4444', '#eab308', '#f43f5e', '#fb923c', '#facc15', '#dc2626', '#fbbf24', '#e11d48'],\n  cold: ['#06b6d4', '#3b82f6', '#8b5cf6', '#14b8a6', '#0ea5e9', '#6366f1', '#22d3ee', '#a78bfa', '#2dd4bf'],\n  // The light-theme link colours of src/index.css, for light backgrounds.\n  print: ['#0e7490', '#9333ea', '#db2777', '#b45309', '#047857', '#c2410c', '#1d4ed8', '#b91c1c', '#4d7c0f'],\n};\n\n/** Sections of the editor; each field is one option of the style. */\nexport const STYLE_SECTIONS = [\n  ...GEOMETRY_SECTIONS,\n  {\n    id: 'lines',\n    title: { en: 'Lines and colours', ru: 'Линии и цвета' },\n    fields: [\n      range('strokeWidth', 1.3, 0.5, 10, 0.1, { en: 'Line width', ru: 'Толщина линий' }),\n      select(\n        'dash',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('dashdot', 'Dash and dot', 'Штрих-пунктир'),\n          option('long', 'Long dashes', 'Длинные штрихи'),\n        ],\n        { en: 'Line style', ru: 'Стиль линий' },\n      ),\n      select(\n        'linecap',\n        'round',\n        [\n          option('round', 'Round', 'Круглые'),\n          option('butt', 'Flat', 'Плоские'),\n          option('square', 'Square', 'Квадратные'),\n        ],\n        { en: 'Line ends', ru: 'Концы линий' },\n      ),\n      select(\n        'linejoin',\n        'miter',\n        [\n          option('round', 'Round', 'Скруглённые'),\n          option('miter', 'Sharp', 'Острые'),\n          option('bevel', 'Bevelled', 'Срезанные'),\n        ],\n        { en: 'Corners', ru: 'Углы' },\n      ),\n      range('opacity', 1, 0.1, 1, 0.05, { en: 'Opacity', ru: 'Непрозрачность' }, { unit: '%' }),\n      range('glow', 0, 0, 12, 0.5, { en: 'Glow', ru: 'Свечение' }),\n      select(\n        'palette',\n        'custom',\n        [\n          option('site', 'Site', 'Как на сайте'),\n          option('neon', 'Neon', 'Неон'),\n          option('pastel', 'Pastel', 'Пастель'),\n          option('warm', 'Warm', 'Тёплые'),\n          option('cold', 'Cold', 'Холодные'),\n          option('print', 'For light backgrounds', 'Для светлого фона'),\n          option('mono', 'One colour', 'Один цвет'),\n          option('custom', 'Own colour of each link', 'Свой цвет каждой связи'),\n        ],\n        { en: 'Colours of the links', ru: 'Цвета связей' },\n      ),\n      color(\n        'monoColor',\n        '#e6edf7',\n        { en: 'Colour of the links', ru: 'Цвет связей' },\n        {\n          when: (s) => s.palette === 'mono',\n        },\n      ),\n    ],\n  },\n  {\n    id: 'background',\n    title: { en: 'Background and card', ru: 'Фон и карточка' },\n    fields: [\n      select(\n        'background',\n        'solid',\n        [\n          option('transparent', 'Transparent', 'Прозрачный'),\n          option('solid', 'One colour', 'Один цвет'),\n          option('linear', 'Linear gradient', 'Линейный градиент'),\n          option('radial', 'Radial gradient', 'Радиальный градиент'),\n        ],\n        { en: 'Background', ru: 'Фон' },\n      ),\n      color(\n        'bgColor',\n        '#000000',\n        { en: 'Background colour', ru: 'Цвет фона' },\n        {\n          when: (s) => s.background !== 'transparent',\n        },\n      ),\n      color(\n        'bgColor2',\n        '#1e1b4b',\n        { en: 'Second colour', ru: 'Второй цвет' },\n        {\n          when: (s) => s.background === 'linear' || s.background === 'radial',\n        },\n      ),\n      range(\n        'bgAngle',\n        135,\n        0,\n        359,\n        1,\n        { en: 'Gradient angle', ru: 'Угол градиента' },\n        {\n          unit: '°',\n          when: (s) => s.background === 'linear',\n        },\n      ),\n      toggle('card', false, { en: 'Card around the symbol', ru: 'Карточка вокруг символа' }),\n      color('cardColor', '#0d1220', { en: 'Card colour', ru: 'Цвет карточки' }, { when: (s) => s.card }),\n      range(\n        'cardOpacity',\n        0.8,\n        0,\n        1,\n        0.05,\n        { en: 'Card opacity', ru: 'Непрозрачность карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n      select(\n        'borderStyle',\n        'solid',\n        [\n          option('solid', 'Solid', 'Сплошная'),\n          option('dashed', 'Dashed', 'Штрихи'),\n          option('dotted', 'Dotted', 'Точки'),\n          option('double', 'Double', 'Двойная'),\n          option('none', 'No border', 'Без рамки'),\n        ],\n        { en: 'Border', ru: 'Рамка' },\n        { when: (s) => s.card },\n      ),\n      range(\n        'border',\n        0.6,\n        0.1,\n        6,\n        0.1,\n        { en: 'Border width', ru: 'Толщина рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      color(\n        'borderColor',\n        '#2b3b57',\n        { en: 'Border colour', ru: 'Цвет рамки' },\n        {\n          when: (s) => s.card && s.borderStyle !== 'none',\n        },\n      ),\n      range(\n        'radius',\n        10,\n        0,\n        50,\n        1,\n        { en: 'Corner radius', ru: 'Скругление углов' },\n        { unit: '%', when: (s) => s.card },\n      ),\n      range(\n        'inset',\n        3,\n        0,\n        30,\n        0.5,\n        { en: 'Space around the card', ru: 'Отступ вокруг карточки' },\n        {\n          unit: '%',\n          when: (s) => s.card,\n        },\n      ),\n    ],\n  },\n  {\n    id: 'caption',\n    title: { en: 'Caption', ru: 'Подпись' },\n    fields: [\n      select('notation', 'L', [option('L', 'L → L²'), option('R', 'R → R²')], {\n        en: 'Theory notation',\n        ru: 'Нотация теории',\n      }),\n      select(\n        'caption',\n        'none',\n        [\n          option('none', 'None', 'Нет'),\n          option('theory', 'Math notation', 'Математическая нотация'),\n          option('pairs', 'Pairs with the base', 'Пары с основанием'),\n          option('number', 'N-ary number', 'N-ричное число'),\n          option('links', 'Links notation', 'Нотация связей'),\n          option('custom', 'Own text', 'Свой текст'),\n        ],\n        { en: 'Caption', ru: 'Подпись' },\n      ),\n      {\n        key: 'captionText',\n        type: 'text',\n        d: '',\n        max: 80,\n        label: { en: 'Text', ru: 'Текст' },\n        when: (s) => s.caption === 'custom',\n      },\n      color(\n        'captionColor',\n        '#7d8aa3',\n        { en: 'Caption colour', ru: 'Цвет подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      range(\n        'captionSize',\n        6,\n        3,\n        14,\n        0.5,\n        { en: 'Caption size', ru: 'Размер подписи' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n      select(\n        'captionFont',\n        'mono',\n        [\n          option('mono', 'Monospace', 'Моноширинный'),\n          option('sans', 'Sans serif', 'Без засечек'),\n          option('serif', 'Serif', 'С засечками'),\n        ],\n        { en: 'Font', ru: 'Шрифт' },\n        { when: (s) => s.caption !== 'none' },\n      ),\n    ],\n  },\n  {\n    id: 'image',\n    title: { en: 'Image size', ru: 'Размер изображения' },\n    fields: [\n      range('width', 2048, 64, 4096, 1, { en: 'Width', ru: 'Ширина' }, { unit: 'px' }),\n      range('height', 2048, 64, 4096, 1, { en: 'Height', ru: 'Высота' }, { unit: 'px' }),\n      range('quality', 0.92, 0.5, 1, 0.01, { en: 'JPEG and WebP quality', ru: 'Качество JPEG и WebP' }, { unit: '%' }),\n    ],\n  },\n  {\n    id: 'experimental',\n    title: { en: 'Experimental: fewer overlaps', ru: 'Эксперимент: меньше наложений' },\n    lead: {\n      en: 'Turns the ends of the links, so each link leaves and enters at an angle that overlaps the other links less. The turns are added to the turns of each link in the table of links.',\n      ru: 'Поворачивает концы связей, чтобы каждая связь выходила и входила под углом, при котором она меньше накладывается на другие. Повороты прибавляются к поворотам каждой связи в таблице связей.',\n    },\n    fields: [\n      toggle('solve', false, { en: 'Reduce overlaps automatically', ru: 'Уменьшать наложения автоматически' }),\n      range('solveRange', 60, 10, 120, 5, { en: 'Largest turn', ru: 'Наибольший поворот' }, { unit: '°' }),\n      range('solveStep', 15, 5, 30, 5, { en: 'Turn step', ru: 'Шаг поворота' }, { unit: '°' }),\n    ],\n  },\n];\n\n/** The options kept per link: its colour (with the own colours) and the turns of its ends. */\nconst PER_LINK = [\n  { key: 'colors', type: 'list', d: '#ff2600,#00f900,#fffb00,#0433ff,#34d399,#fb923c,#60a5fa,#f87171,#a3e635' },\n  { key: 'gap', type: 'range', d: 0.08, min: 0, max: 0.4 },\n  { key: 'turns', type: 'list', d: '' },\n];\n\nexport const STYLE_FIELDS = [...STYLE_SECTIONS.flatMap((section) => section.fields), ...PER_LINK];\nexport const STYLE_DEFAULTS = Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, field.d]));\n\nconst HEX = /^#[0-9a-f]{6}$/i;\nconst clamp = (value, min, max) => Math.min(max, Math.max(min, value));\n\n/** A per-link list \"a,b,c\" of colours, or of turns \"source target\". */\nfunction normalizeList(key, value) {\n  const items = String(value ?? '').split(',');\n  if (key === 'colors')\n    return items.every((c) => HEX.test(c.trim())) ? items.map((c) => c.trim().toLowerCase()).join(',') : '';\n  const turns = items.map((item) =>\n    item\n      .trim()\n      .split(/\\s+/)\n      .slice(0, 2)\n      .map((a) => clamp(Math.round(Number(a)) || 0, -180, 180)),\n  );\n  // Links after the last turned one need no entry: they are not turned.\n  while (turns.length && turns[turns.length - 1].every((a) => a === 0)) turns.pop();\n  return turns.map((pair) => `${pair[0]} ${pair[1] ?? 0}`).join(',');\n}\n\n/** One value of a style checked against its field: the default if it is not valid. */\nfunction normalizeValue(field, value) {\n  if (value === undefined) return field.d;\n  switch (field.type) {\n    case 'range': {\n      const number = typeof value === 'number' ? value : Number(value);\n      return Number.isFinite(number) && value !== '' && value !== null ? clamp(number, field.min, field.max) : field.d;\n    }\n    case 'toggle':\n      if (typeof value === 'boolean') return value;\n      return value === 'true' || value === '1' ? true : value === 'false' || value === '0' ? false : field.d;\n    case 'select':\n      return field.options.some((o) => o.value === value) ? value : field.d;\n    case 'color':\n      return HEX.test(value) ? value.toLowerCase() : field.d;\n    case 'text':\n      return typeof value === 'string' ? value.slice(0, field.max) : field.d;\n    default:\n      return normalizeList(field.key, value);\n  }\n}\n\n/** A complete, valid style: every option of `raw` checked, the rest the defaults. */\nexport function normalizeStyle(raw = {}) {\n  // Bookmarks from issue #17 used one gap for both references.\n  if (raw?.gap !== undefined) raw = { startGap: raw.gap, endGap: raw.gap, ...raw };\n  return Object.fromEntries(STYLE_FIELDS.map((field) => [field.key, normalizeValue(field, raw?.[field.key])]));\n}\n\n/** The options that differ from the defaults as query parameters. */\nexport function styleToParams(style) {\n  const params = new URLSearchParams();\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (style[key] !== STYLE_DEFAULTS[key]) params.set(key, String(style[key]));\n  });\n  return params;\n}\n\n/** A style read from query parameters (unknown or invalid values are left out). */\nexport function styleFromParams(params) {\n  const raw = {};\n  STYLE_FIELDS.forEach(({ key }) => {\n    if (params.has(key)) raw[key] = params.get(key);\n  });\n  return normalizeStyle(raw);\n}\n\n/** The colour of each of `n` links in a style. */\nexport function linkColors(style, n) {\n  const own = style.colors ? style.colors.split(',') : [];\n  return Array.from({ length: n }, (_, i) => {\n    if (style.palette === 'mono') return style.monoColor;\n    if (style.palette === 'custom') return own[i] || COLORS[i % COLORS.length];\n    const palette = PALETTES[style.palette] || COLORS;\n    return palette[i % palette.length];\n  });\n}\n\n/** The [source, target] turns of each of `n` links, in degrees. */\nexport function linkTurns(style, n) {\n  const turns = style.turns ? style.turns.split(',').map((pair) => pair.split(' ').map(Number)) : [];\n  return Array.from({ length: n }, (_, i) => turns[i] || [0, 0]);\n}\n\n/** A style with the turns of each link set to `turns` ([[source, target], …]). */\nexport const withTurns = (style, turns) =>\n  normalizeStyle({ ...style, turns: turns.map((pair) => pair.join(' ')).join(',') });\n\n/** A style where link `i` has its own colour `value` (the other links keep the colours they had). */\nexport function withColor(style, n, i, value) {\n  const colors = linkColors(style, Math.max(n, COLORS.length));\n  colors[i] = value;\n  return normalizeStyle({ ...style, palette: 'custom', colors: colors.join(',') });\n}\n\n/** The shape options of glyph.js taken from a style. */\nexport function shapeOfStyle(style, n, extraTurns = null) {\n  const turns = linkTurns(style, n).map((pair, i) =>\n    extraTurns ? [pair[0] + extraTurns[i][0], pair[1] + extraTurns[i][1]] : pair,\n  );\n  return Object.fromEntries([\n    ...Object.keys(SHAPE)\n      .filter((key) => key !== 'turns')\n      .map((key) => [key, style[key]]),\n    ['turns', turns],\n    ['strokeWidth', style.strokeWidth],\n  ]);\n}\n\n/**\n * Looks to start from. A look changes only the options it names and keeps the\n * per-link turns, so a picture can be restyled without losing its hand work.\n * \"Do we need a card at all?\" (issue #17): both are here, the card of the\n * gallery and a plain black background with only the links.\n */\nexport const LOOKS = [\n  {\n    id: 'card',\n    label: { en: 'Card (as in the gallery)', ru: 'Карточка (как в галерее)' },\n    values: {\n      ...SHAPE,\n      startGap: SHAPE.gap,\n      endGap: SHAPE.gap,\n      gap: SHAPE.gap,\n      strokeWidth: 2.4,\n      linejoin: 'round',\n      palette: 'site',\n      colors: '',\n      card: true,\n      bgColor: '#070b14',\n      placement: 'circle',\n    },\n  },\n  {\n    id: 'black',\n    label: { en: 'Plain black', ru: 'Просто чёрный' },\n    values: { card: false, background: 'solid', bgColor: '#000000' },\n  },\n  {\n    id: 'transparent',\n    label: { en: 'Transparent', ru: 'Прозрачный' },\n    values: { card: false, background: 'transparent' },\n  },\n  {\n    id: 'paper',\n    label: { en: 'Paper', ru: 'Бумага' },\n    values: { card: false, background: 'solid', bgColor: '#f8fafc', palette: 'print', captionColor: '#334155' },\n  },\n  {\n    id: 'blueprint',\n    label: { en: 'Blueprint', ru: 'Чертёж' },\n    values: {\n      background: 'solid',\n      bgColor: '#0b3d91',\n      card: true,\n      cardColor: '#0b3d91',\n      cardOpacity: 1,\n      borderStyle: 'dashed',\n      borderColor: '#93c5fd',\n      radius: 0,\n      palette: 'mono',\n      monoColor: '#e0f2fe',\n      strokeWidth: 1.6,\n      middle: 'dot',\n      captionColor: '#bfdbfe',\n    },\n  },\n  {\n    id: 'neon',\n    label: { en: 'Neon', ru: 'Неон' },\n    values: {\n      background: 'radial',\n      bgColor: '#1a0533',\n      bgColor2: '#020008',\n      card: true,\n      cardColor: '#05010d',\n      cardOpacity: 0.6,\n      borderColor: '#ff00e6',\n      border: 0.8,\n      palette: 'neon',\n      glow: 3,\n      strokeWidth: 2.8,\n    },\n  },\n  {\n    id: 'social',\n    label: { en: 'Social card 1200 × 630', ru: 'Карточка для соцсетей 1200 × 630' },\n    values: { width: 1200, height: 630, caption: 'theory', captionSize: 5 },\n  },\n];\n\n/** `style` with look `id` applied. */\nexport function applyLook(style, id) {\n  const look = LOOKS.find((l) => l.id === id);\n  if (!look) return style;\n  const keep = {\n    notation: style.notation,\n    turns: style.turns,\n    solve: style.solve,\n    solveRange: style.solveRange,\n    solveStep: style.solveStep,\n  };\n  const size = look.values.width ? {} : { width: style.width, height: style.height, quality: style.quality };\n  return normalizeStyle({ ...STYLE_DEFAULTS, ...size, ...look.values, ...keep });\n}\n\n/** Image sizes for the usual places a picture is shared to. */\nexport const SIZES = [\n  { label: '512 × 512', width: 512, height: 512 },\n  { label: '1024 × 1024', width: 1024, height: 1024 },\n  { label: '2048 × 2048', width: 2048, height: 2048 },\n  { label: 'Instagram 1080 × 1080', width: 1080, height: 1080 },\n  { label: 'Open Graph 1200 × 630', width: 1200, height: 630 },\n  { label: 'X 1600 × 900', width: 1600, height: 900 },\n  { label: 'Stories 1080 × 1920', width: 1080, height: 1920 },\n];\n// Draws a finite network of doublet links as one symbol, after the blueprint of\n// github.com/konard/links-visuals: every link is ONE continuous curve in its\n// own colour. It starts with a bar at its source, passes through its own\n// middle and ends with an arrow at its target; optional middle cuts are off\n// by default. Other links refer to a link by touching its middle. A reference\n// to 0 (nothing) is a free end, a reference to the link itself is a loop that\n// returns to its own middle, so (1: 1 1) is a symmetric figure eight (∞).\n//\n// Geometry is computed in layout units (neighbouring middles are 1 apart),\n// every curve is a chain of cubic Bézier segments that share tangents where\n// they meet, and the finished drawing is scaled into a SIZE × SIZE box.\n//\n// Every number of the drawing is a `shape` option (issue #17), so the editor\n// of /network/ can change the angle at which a link comes to another link,\n// the shapes of its start, end and middle, and turn each end on its own. The\n// defaults in SHAPE draw exactly the symbols of the gallery and the rain.\n\nimport { trimCurve } from './curve-tools';\nimport { placeLinks } from './placement';\n\nexport const SIZE = 100;\nexport const STROKE = 2.4;\n/** Gallery colours; the editor cycles this palette beyond nine links. */\nexport const COLORS = [\n  '#22d3ee',\n  '#c084fc',\n  '#f472b6',\n  '#facc15',\n  '#34d399',\n  '#fb923c',\n  '#60a5fa',\n  '#f87171',\n  '#a3e635',\n];\n\nconst SCALE = 60; // SIZE units per layout unit, unless the drawing must shrink\nconst LONE = { free: 0.9, loop: 1.25 }; // a single link has the box to itself\nconst FREE = 0.42; // length of a free end (a reference to nothing)\nconst LOOP = 0.8; // size of a self-reference loop\n\n/** Shapes of the start, the end and the middle of a link (`marker`). */\nexport const MARKERS = ['bar', 'arrow', 'triangle', 'tail', 'dot', 'circle', 'square', 'diamond', 'none'];\n\n/**\n * The options of the drawing and their defaults. Lengths are in layout units\n * (neighbouring middles are 1 apart) unless they say SIZE units, angles in degrees.\n */\nexport const SHAPE = {\n  placement: 'circle',\n  layoutAspect: 1,\n  columns: 0,\n  forceDistance: 1,\n  forceCharge: 0.6,\n  forceCollision: 0.6,\n  rotation: 0, // turns the whole layout\n  spread: 1, // distance between the middles, relative to the lengths of free ends and loops\n  padding: 9, // free margin around the drawing, in SIZE units\n  tension: 0.38, // how far a reference bends out, relative to the distance it spans\n  bulge: 20, // how much a lone reference bends aside\n  gap: 0.07, // ends stop this far from the middle they touch\n  startGap: null, // independent reference gaps; null keeps the legacy shared gap\n  endGap: null,\n  middleGapStart: 0, // optional cuts on either side of this link's own middle, SIZE units\n  middleGapEnd: 0,\n  free: 1, // length of a free end (a reference to nothing), × the default\n  loop: 1, // size of a self-reference loop, × the default\n  lens: true, // a link that refers twice to the same link meets it at 45° (a lens)\n  angles: 'mirror', // 'mirror': ends mirror the middle across the chord; 'fixed': sourceAngle / targetAngle\n  sourceAngle: 30, // with 'fixed': the angle between a link leaving its source and the chord\n  targetAngle: 30, // with 'fixed': the angle between a link entering its target and the chord\n  start: 'bar',\n  startSize: 3.6, // SIZE units: the half-length of the bar\n  startAngle: 28,\n  end: 'arrow',\n  endSize: 5.5, // SIZE units: the length of the arrow head arms\n  endAngle: 28,\n  middle: 'none',\n  middleSize: 2.2,\n  middleAngle: 30,\n  startOffset: 0, // marker displacement along the tangent, in SIZE units (positive is inward)\n  endOffset: 0,\n  middleOffset: 0,\n  startAcross: 0, // displacement across the tangent, in SIZE units\n  endAcross: 0,\n  middleAcross: 0,\n  startRotation: 0, // marker rotation independent of the line, in degrees\n  endRotation: 0,\n  middleRotation: 0,\n  turns: [], // [source, target] turn of each link's ends in degrees, set by hand or by solveCollisions\n};\n\nconst RAD = Math.PI / 180;\n\nconst add = (a, b) => [a[0] + b[0], a[1] + b[1]];\nconst sub = (a, b) => [a[0] - b[0], a[1] - b[1]];\nconst mul = (a, k) => [a[0] * k, a[1] * k];\nconst dot = (a, b) => a[0] * b[0] + a[1] * b[1];\nconst length = (a) => Math.hypot(a[0], a[1]);\nconst unit = (a) => mul(a, 1 / length(a));\nconst rotate = (a, angle) => {\n  const c = Math.cos(angle);\n  const s = Math.sin(angle);\n  return [a[0] * c - a[1] * s, a[0] * s + a[1] * c];\n};\n/** Mirrors the tangent `d` across the chord direction `c`. */\nconst reflect = (d, c) => sub(mul(c, 2 * dot(d, c)), d);\n\n/**\n * A link that refers twice to the same other link is a lens: its ends meet\n * the other middle at 45° instead of sideways, so two links that refer to\n * each other twice cross instead of drawing the same oval.\n */\nconst lens = (dir, chord, twice) => (twice ? unit(add(dir, chord)) : dir);\n\n/** Middles of the links (layout units) and the outward direction of each. */\nexport const layout = (n, options = {}, links = null) => placeLinks(n, options, links);\n\n/** Picks the side ±perp(d) whose loop, with axis between side and `away`, points outward. */\nfunction side(d, away, out) {\n  const left = rotate(d, Math.PI / 2);\n  const right = mul(left, -1);\n  return dot(add(left, away), out) >= dot(add(right, away), out) ? left : right;\n}\n\n/**\n * The direction of an end that meets another middle along `chord`: the mirror\n * of the middle direction, or with fixed angles the chord turned by `angle`\n * to the same side as the mirror.\n */\nfunction approach(d, chord, twice, angle, o) {\n  const mirror = lens(reflect(d, chord), chord, twice && o.lens);\n  if (o.angles !== 'fixed') return mirror;\n  const side = chord[0] * mirror[1] - chord[1] * mirror[0] < 0 ? -1 : 1;\n  return rotate(chord, side * angle * RAD