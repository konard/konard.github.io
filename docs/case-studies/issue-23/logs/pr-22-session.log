[2026-10-25T10:22:31.667Z] [STDOUT] {"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cat > docs/case-studies/issue-21/PLAN.md <<'EOF'\n# Issue 21 implementation checklist\n\n- [x] Read issue, all issue/PR comments and reviews; check required sub-issues (none).\n- [x] Verify prepared branch and clean initial state; archive issue, PR and related PR metadata.\n- [x] Download and validate supplied images; inspect every visible setting and compare with URLs.\n- [ ] Trace editor geometry, gallery navigation, palette selection, markers and style URL round trips.\n- [ ] Research primary documentation and similar geometry libraries; archive relevant evidence and timeline.\n- [ ] Add minimal failing regression tests before fixing geometry, colors and hover behavior; capture before screenshots.\n- [ ] Implement editor-only symmetric defaults and meaningful bend behavior while preserving gallery/rain geometry and all existing editing features.\n- [ ] Verify supplied URL settings and controls in both directions, including exports and fresh shared-link reloads.\n- [ ] Add strict symmetry, gallery-isolation and navigation consistency regressions; retain reusable browser experiments.\n- [ ] Run local checks, all unit tests and production build sequentially within container memory limits; save logs.\n- [ ] Verify final UI in real browsers with screenshots; add automated browser checks to CI. Playwright MCP is not exposed, so use the repository's Playwright framework.\n- [ ] Complete case study: requirements/evidence mapping, timeline, root causes, solutions, library review, limitations and diagnostic instructions.\n- [ ] Commit useful atomic changes after checks; merge latest main if needed; push only prepared branch.\n- [ ] Update PR 22 title/body with reproduction, tests, before/after screenshots and Fixes #21.\n- [ ] Read full PR diff, verify no features removed, inspect fresh CI by timestamp/SHA, download logs/artifacts, fix any failures.\n- [ ] Confirm latest CI passes, clean working tree, consistent code/tests/docs, and mark PR 22 ready without merging.\nEOF\ncat src/components/Glyph.jsx src/components/NetworkGallery.jsx src/pages/NetworkPage.jsx\"","aggregated_output":"import { decode } from '../links/configurations';\nimport { glyphPaths, SIZE, STROKE } from '../links/glyph';\n\n/**\n * One network of links drawn inline in the links-visuals style: every link is\n * one continuous line in its own colour. `code` is a network code such as\n * '00 11' (link 1 = (1: 0 0), link 2 = (2: 1 1)); 0 is the zero link.\n */\nexport default function Glyph({ code, size = 48, title = null, className = 'glyph' }) {\n  return (\n    <svg\n      className={className}\n      viewBox={`0 0 ${SIZE} ${SIZE}`}\n      width={size}\n      height={size}\n      role={title ? 'img' : undefined}\n      aria-label={title || undefined}\n      aria-hidden={title ? undefined : 'true'}\n    >\n      <g fill=\"none\" strokeWidth={STROKE} strokeLinecap=\"round\" strokeLinejoin=\"round\">\n        {glyphPaths(decode(code)).map(({ d, color }, i) => (\n          <path key={i} d={d} stroke={color} data-link={i + 1} />\n        ))}\n      </g>\n    </svg>\n  );\n}\nimport { useMemo, useState } from 'react';\nimport {\n  classCount,\n  codeAt,\n  linksNotation,\n  mathNotation,\n  networkCount,\n  representatives,\n} from '../links/configurations';\nimport { COLORS } from '../links/glyph';\nimport { useLang } from '../i18n/prefs';\nimport { plural } from '../i18n/plural';\nimport { formatNumber } from './format';\nimport Glyph from './Glyph';\n\nconst SIZES = [1, 2, 3, 4];\nconst PAGE = 243;\nconst SUPERSCRIPTS = '⁰¹²³⁴⁵⁶⁷⁸⁹';\nconst superscript = (k) =>\n  String(k)\n    .split('')\n    .map((d) => SUPERSCRIPTS[d])\n    .join('');\n/** The page of one network (issue #17): /network/?code=0120. */\nexport const networkHref = (code) => `/network/?code=${code.replace(/ /g, '')}`;\n\n/** Three joined circles: drawn with circles and lines only, so the symbols stay the only paths of a card. */\nfunction ShareIcon() {\n  return (\n    <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\">\n      <g fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\">\n        <line x1=\"8.6\" y1=\"10.7\" x2=\"15.4\" y2=\"6.6\" />\n        <line x1=\"8.6\" y1=\"13.3\" x2=\"15.4\" y2=\"17.4\" />\n        <circle cx=\"18\" cy=\"5\" r=\"3\" />\n        <circle cx=\"6\" cy=\"12\" r=\"3\" />\n        <circle cx=\"18\" cy=\"19\" r=\"3\" />\n      </g>\n    </svg>\n  );\n}\nconst LINKS = { en: ['link', 'links'], ru: ['связь', 'связи', 'связей'] };\n// \"of N links\": Russian needs the genitive after «из».\nconst OF_LINKS = { en: ['link', 'links'], ru: ['связи', 'связей', 'связей'] };\nconst REAL_LINKS = { en: ['real link', 'real links'], ru: ['настоящая связь', 'настоящие связи', 'настоящих связей'] };\nconst NETWORKS = { en: ['network', 'networks'], ru: ['сеть', 'сети', 'сетей'] };\nconst DIGITS = { en: ['digit', 'digits'], ru: ['цифра', 'цифры', 'цифр'] };\nconst CLASSES = { en: ['class', 'classes'], ru: ['класс', 'класса', 'классов'] };\n\n/**\n * Every network of 1–4 links: all (N + 1)^(2N) codes in counting order, or\n * one network per renaming class. Symbols are drawn inline and shown page by\n * page, so even the 390,625 networks of 4 links never have to be enumerated.\n * \"Only real references\" (issue #13, off by default) leaves out every network\n * that refers to 0, so links refer only to each other or to themselves: N^(2N).\n */\nexport default function NetworkGallery({ initial = 2 }) {\n  const [n, setN] = useState(initial);\n  const [classes, setClasses] = useState(false);\n  const [real, setReal] = useState(false);\n  const [shown, setShown] = useState(PAGE);\n  const { lang, t } = useLang();\n  const number = (v) => formatNumber(v, lang);\n  const words = (k, forms) => plural(k, lang, forms);\n  const only = { real };\n  const total = classes ? classCount(n, { real }) : networkCount(n, { real });\n  const codes = useMemo(\n    () =>\n      classes\n        ? representatives(n, { real }).slice(0, shown)\n        : Array.from({ length: Math.min(shown, total) }, (_, i) => codeAt(n, i, { real })),\n    [n, classes, real, shown, total],\n  );\n  const choose = (k, c, r = real) => {\n    setN(k);\n    setClasses(c);\n    setReal(r);\n    setShown(PAGE);\n  };\n  const first = codeAt(n, 0, only);\n  const last = codeAt(n, networkCount(n, only) - 1, only);\n\n  return (\n    <div className=\"symbols\">\n      <p className=\"section__lead\">\n        {t({\n          en: 'Each symbol is one network of links, and each link is one unbroken line in its own colour: a bar marks its source, an arrow its target, and its middle is the point other links refer to. Link 0 (0: 0 0) is “nothing”: it always exists and is never drawn, so a reference to 0 is a free end, and a link that refers to itself twice is a figure eight. These networks are also the alphabet of the rain in the background.',\n          ru: 'Каждый символ — одна сеть связей, а каждая связь — одна непрерывная линия своего цвета: черта отмечает её начало, стрелка — конец, а середина — точку, на которую ссылаются другие связи. Связь 0 (0: 0 0) — это «ничто»: она существует всегда и никогда не рисуется, поэтому ссылка на 0 — это свободный конец, а связь, которая дважды ссылается на себя, — восьмёрка. Эти сети — ещё и алфавит дождя на фоне.',\n        })}\n      </p>\n      <div className=\"symbols__tabs\" role=\"group\" aria-label={t({ en: 'Number of links', ru: 'Количество связей' })}>\n        {SIZES.map((k) => (\n          <button key={k} type=\"button\" className=\"button\" aria-pressed={k === n} onClick={() => choose(k, classes)}>\n            {k} {words(k, LINKS)} <span className=\"mono\">{number(networkCount(k, only))}</span>\n          </button>\n        ))}\n        <button type=\"button\" className=\"button\" aria-pressed={classes} onClick={() => choose(n, !classes)}>\n          {t({ en: 'One per renaming', ru: 'Без переименований' })}{' '}\n          <span className=\"mono\">{number(classCount(n, only))}</span>\n        </button>\n        <button type=\"button\" className=\"button\" aria-pressed={real} onClick={() => choose(n, classes, !real)}>\n          {t({ en: 'Show only real references', ru: 'Только настоящие ссылки' })}{' '}\n          <span className=\"mono\">\n            {number(classes ? classCount(n, { real: true }) : networkCount(n, { real: true }))}\n          </span>\n        </button>\n      </div>\n\n      <dl className=\"symbols__formula\">\n        <dt>{t({ en: 'math notation', ru: 'математическая нотация' })}</dt>\n        <dd className=\"mono\">\n          {mathNotation(first)} … {mathNotation(last)} → {real ? n : n + 1}\n          {superscript(2 * n)} = {number(networkCount(n, only))} {words(networkCount(n, only), NETWORKS)}\n        </dd>\n        <dt>{t({ en: 'links notation', ru: 'нотация связей' })}</dt>\n        <dd className=\"mono\">\n          {linksNotation(first).join(' ')} … {linksNotation(last).join(' ')}\n        </dd>\n        <dd className=\"muted\">\n          {t({\n            en: `${n} ${words(n, REAL_LINKS)} after the zero link 0: every link is written as its source and target, so a network is ${2 * n} ${words(2 * n, DIGITS)} in base ${n + 1}.`,\n            ru: `${n} ${words(n, REAL_LINKS)} после нулевой связи 0: каждая связь записывается своим началом и концом, поэтому сеть — это ${2 * n} ${words(2 * n, DIGITS)} в системе счисления с основанием ${n + 1}.`,\n          })}\n          {real &&\n            t({\n              en: ` Only real references: networks that refer to 0 are left out, so every link refers to real links (each other or itself) and each digit is one of 1…${n}, ${n}${superscript(2 * n)} = ${number(networkCount(n, only))} ${words(networkCount(n, only), NETWORKS)}.`,\n              ru: ` Только настоящие ссылки: сети со ссылками на 0 не показаны, каждая связь ссылается на настоящие связи (друг на друга или на себя), и каждая цифра — одна из 1…${n}, ${n}${superscript(2 * n)} = ${number(networkCount(n, only))} ${words(networkCount(n, only), NETWORKS)}.`,\n            })}\n          {classes &&\n            t({\n              en: ` ${number(classCount(n, only))} ${words(classCount(n, only), CLASSES)} remain when networks that only rename the links are counted once (Burnside’s lemma).`,\n              ru: ` Если сети, которые отличаются только переименованием связей, считать один раз, остаётся ${number(classCount(n, only))} ${words(classCount(n, only), CLASSES)} (лемма Бёрнсайда).`,\n            })}\n        </dd>\n        <dd className=\"symbols__legend\">\n          {COLORS.slice(0, n).map((color, i) => (\n            <span key={color} style={{ color }}>\n              ━ {t({ en: 'link', ru: 'связь' })} {i + 1}\n            </span>\n          ))}\n        </dd>\n      </dl>\n\n      <ul\n        className=\"symbols__grid\"\n        aria-label={`${classes ? t({ en: 'Renaming classes', ru: 'Классы переименований' }) : t({ en: 'Networks', ru: 'Сети' })} ${t({ en: 'of', ru: 'из' })} ${n} ${words(n, OF_LINKS)}`}\n      >\n        {codes.map((code) => (\n          <li key={code} title={linksNotation(code).join(' ')}>\n            <a className=\"symbols__card\" href={networkHref(code)}>\n              <Glyph code={code} size={64} />\n              <span className=\"mono\">{mathNotation(code)}</span>\n            </a>\n            <a\n              className=\"symbols__share\"\n              href={`${networkHref(code)}#share`}\n              aria-label={`${t({ en: 'Share', ru: 'Поделиться' })} ${mathNotation(code)}`}\n              title={t({ en: 'Edit, download and share', ru: 'Изменить, скачать и поделиться' })}\n            >\n              <ShareIcon />\n            </a>\n          </li>\n        ))}\n      </ul>\n      {total > shown && (\n        <button type=\"button\" className=\"button\" onClick={() => setShown(shown + PAGE * 2)}>\n          {t({\n            en: `Show more (${number(total - shown)} left)`,\n            ru: `Показать ещё (осталось ${number(total - shown)})`,\n          })}\n        </button>\n      )}\n    </div>\n  );\n}\nimport { useEffect, useMemo, useState } from 'react';\nimport './settings.css';\nimport './network.css';\nimport Layout from '../components/Layout';\nimport { decode, encode, mathNotation } from '../links/configurations';\nimport { solveCollisions } from '../links/collisions';\nimport { parseCode, removeLink, theoryNotation } from '../links/edit';\nimport { networkSvg } from '../links/render';\nimport {\n  linkColors,\n  linkTurns,\n  normalizeStyle,\n  shapeOfStyle,\n  styleFromParams,\n  styleToParams,\n  withColor,\n  withTurns,\n} from '../links/style';\nimport { LANGS, useLang } from '../i18n/prefs';\nimport { LinksTable, Notations, randomLinks, stepped } from './NetworkEditor';\nimport NetworkShare from './NetworkShare';\nimport { Looks, StyleSections } from './NetworkStyle';\nimport { useNetworkHistory } from './useNetworkHistory';\n\n/** The network of the theory's example: two points and the link between them. */\nexport const DEFAULT_CODE = '11 22 12';\n\nconst SECTIONS = [\n  ['notations', { en: 'Notations', ru: 'Нотации' }],\n  ['links', { en: 'Links', ru: 'Связи' }],\n  ['style', { en: 'Style', ru: 'Оформление' }],\n  ['share', { en: 'Share', ru: 'Поделиться' }],\n];\n\n/** The network and the style of the picture in a query string (?code=112212&end=dot…). */\nexport function readNetwork(search) {\n  const params = new URLSearchParams(search);\n  const code = parseCode(params.get('code') || '') || DEFAULT_CODE;\n  return { links: decode(code), style: styleFromParams(params) };\n}\n\n/** \"?code=112212&…\": non-default image options and the explicit page language, if present. */\nexport function networkQuery(links, style, lang = null) {\n  const params = styleToParams(style);\n  if (LANGS.includes(lang)) params.set('lang', lang);\n  return `?code=${encode(links).replace(/ /g, '')}${params.size ? `&${params}` : ''}`;\n}\n\n/** The page of one network (issue #17): view it, edit it in every notation, style its picture and share it. */\nexport default function NetworkPage() {\n  const { t } = useLang();\n  const [initial] = useState(() => readNetwork(window.location.search));\n  const [links, setLinks] = useState(initial.links);\n  const [style, setStyleState] = useState(initial.style);\n  const notation = style.notation;\n  const setStyle = (next) => setStyleState(normalizeStyle(next));\n  const n = links.length;\n  const code = encode(links);\n  const query = networkQuery(links, style, new URLSearchParams(window.location.search).get('lang'));\n\n  useNetworkHistory(query);\n  // The share icon of a gallery card opens /network/?code=…#share: the section is drawn after load.\n  useEffect(() => {\n    const target = window.location.hash && document.getElementById(window.location.hash.slice(1));\n    target?.scrollIntoView?.();\n  }, []);\n\n  const shape = shapeOfStyle(style, n);\n  const shapeKey = JSON.stringify([code, shape, style.solveRange, style.solveStep]);\n  // The experimental solver of overlaps; it runs only when it is switched on or asked for.\n  const solved = useMemo(\n    () => (style.solve ? solveCollisions(links, shape, { range: style.solveRange, step: style.solveStep }) : null),\n    // shapeKey stands for links, shape and the options of the solver.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n    [shapeKey, style.solve],\n  );\n  const svg = useMemo(\n    () => networkSvg(links, style, { notation, extraTurns: solved?.delta }),\n    [links, style, notation, solved],\n  );\n  const colors = linkColors(style, n);\n  const turns = linkTurns(style, n);\n\n  const changeLinks = (next) => setLinks(next);\n  const remove = (k) => {\n    const keep = (list) => list.filter((_, i) => i !== k - 1);\n    setLinks(removeLink(links, k));\n    let next = withTurns(style, keep(linkTurns(style, n)));\n    if (style.palette === 'custom') next = { ...next, colors: keep(linkColors(style, n)).join(',') };\n    setStyle(next);\n  };\n  const turn = (i, end, value) =>\n    setStyle(\n      withTurns(\n        style,\n        turns.map((pair, k) => (k === i ? pair.map((a, e) => (e === end ? value : a)) : pair)),\n      ),\n    );\n  const applySolved = () => {\n    const found = solveCollisions(links, shape, { range: style.solveRange, step: style.solveStep });\n    setStyle({ ...withTurns(style, found.turns), solve: false });\n  };\n\n  const url = `${window.location.origin}/network/${query}`;\n  const text = `${t({ en: 'Links network', ru: 'Сеть связей' })} ${mathNotation(code)}: ${theoryNotation(links, notation)}`;\n\n  return (\n    <Layout page=\"network\" sections={SECTIONS}>\n      <section className=\"section network\" id=\"top\">\n        <h1 className=\"section__title\">\n          {t({ en: 'Links network', ru: 'Сеть связей' })}{' '}\n          <span className=\"mono network__code\">{mathNotation(code)}</span>\n        </h1>\n        <p className=\"section__lead\">\n          {t({\n            en: 'One network of doublet links: change it in any notation or link by link, change every detail of its picture and save or share it. The address of the page keeps everything, so a link opens exactly this picture.',\n            ru: 'Одна сеть дуплетных связей: меняйте её в любой нотации или по одной связи, меняйте каждую деталь её картинки, сохраняйте и делитесь. Адрес страницы хранит всё, поэтому ссылка открывает ровно эту картинку.',\n          })}{' '}\n          <a href=\"/art/#symbols\">{t({ en: 'All networks of 1–4 links', ru: 'Все сети из 1–4 связей' })}</a>\n        </p>\n        <div className=\"network__layout\">\n          <figure className=\"network__view\">\n            <div\n              className={`network__preview${style.background === 'transparent' ? ' is-transparent' : ''}`}\n              style={{ aspectRatio: `${style.width} / ${style.height}` }}\n              // The SVG names itself (role img, aria-label). It is built from normalized\n              // options only and its caption is escaped (src/links/render.js).\n              dangerouslySetInnerHTML={{ __html: svg }}\n            />\n            <figcaption className=\"mono\">\n              {theoryNotation(links, notation)}\n              {solved && (\n                <span className=\"network__score\">\n                  {' · '}\n                  {t({ en: 'overlaps', ru: 'наложения' })} {solved.before.toFixed(1)} → {solved.after.toFixed(1)}\n                </span>\n              )}\n            </figcaption>\n          </figure>\n          <div className=\"network__panels\">\n            <section id=\"notations\" className=\"network__panel\" aria-labelledby=\"notations-title\">\n              <h2 id=\"notations-title\">{t({ en: 'Notations', ru: 'Нотации' })}</h2>\n              <Notations links={links} notation={notation} onLinks={changeLinks} />\n            </section>\n            <section id=\"links\" className=\"network__panel\" aria-labelledby=\"links-title\">\n              <h2 id=\"links-title\">{t({ en: 'Links', ru: 'Связи' })}</h2>\n              <LinksTable\n                links={links}\n                colors={colors}\n                turns={turns}\n                onLinks={changeLinks}\n                onRemove={remove}\n                onColor={(i, value) => setStyle(withColor(style, n, i, value))}\n                onTurn={turn}\n                onStep={(step) => setLinks(stepped(links, step))}\n                onRandom={() => setLinks(randomLinks(n))}\n              />\n            </section>\n            <section className=\"network__panel\" id=\"style\" aria-labelledby=\"style-title\">\n              <h2 id=\"style-title\">{t({ en: 'Style of the picture', ru: 'Оформление картинки' })}</h2>\n              <p className=\"network__lead\">\n                {t({\n                  en: 'Start from a look and change any detail. A card like in the gallery, or no card at all and only the lines on a black or transparent background: both are here.',\n                  ru: 'Начните с готового оформления и меняйте любую деталь. Карточка как в галерее или без карточки, только линии на чёрном или прозрачном фоне: есть и то, и другое.',\n                })}\n              </p>\n              <Looks style={style} onStyle={setStyle} />\n              <div className=\"network__styles\">\n                <StyleSections links={links} style={style} onStyle={setStyle}>\n                  <div className=\"network__actions\">\n                    <button type=\"button\" className=\"button button--small\" onClick={applySolved}>\n                      {t({ en: 'Write the turns into the table of links', ru: 'Записать повороты в таблицу связей' })}\n                    </button>\n                    <button\n                      type=\"button\"\n                      className=\"button button--small\"\n                      disabled={!style.turns}\n                      onClick={() => setStyle({ ...style, turns: '' })}\n                    >\n                      {t({ en: 'Clear all turns', ru: 'Убрать все повороты' })}\n                    </button>\n                  </div>\n                </StyleSections>\n              </div>\n            </section>\n            <section id=\"share\" className=\"network__panel\" aria-labelledby=\"share-title\">\n              <h2 id=\"share-title\">{t({ en: 'Save and share', ru: 'Сохранить и поделиться' })}</h2>\n              <NetworkShare code={code} links={links} svg={svg} style={style} url={url} text={text} />\n            </section>\n          </div>\n        </div>\n      </section>\n    </Layout>\n  );\n}\n","exit_code":0,"status":"completed"}}
