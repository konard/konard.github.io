[2026-10-25T10:32:51.255Z] [STDOUT] {"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc 'cat /tmp/issue-21-implementation.diff'","aggregated_output":"diff --git a/.github/workflows/github-pages.yml b/.github/workflows/github-pages.yml\nindex 208d0e4..dea1f51 100644\n--- a/.github/workflows/github-pages.yml\n+++ b/.github/workflows/github-pages.yml\n@@ -166,6 +166,9 @@ jobs:\n       - name: Verify history, self loops, layouts, clipboard and mobile editing\n         run: npm run test:network:issue19\n \n+      - name: Verify editor geometry, source colors and shared settings\n+        run: npm run test:network:issue21\n+\n       - name: Preserve browser evidence\n         if: always()\n         uses: actions/upload-artifact@v7\ndiff --git a/docs/case-studies/issue-21/data/gallery-baseline.json b/docs/case-studies/issue-21/data/gallery-baseline.json\nnew file mode 100644\nindex 0000000..eb37567\n--- /dev/null\n+++ b/docs/case-studies/issue-21/data/gallery-baseline.json\n@@ -0,0 +1,18 @@\n+{\n+  \"1\": {\n+    \"count\": 4,\n+    \"sha256\": \"a4d24826de08127e34e3c7a1b2d370d69f20459bf864e2ff75b46a297b9295a0\"\n+  },\n+  \"2\": {\n+    \"count\": 81,\n+    \"sha256\": \"2efb555e74ceaa60e5563a84d3d9d9aba2cd404d85b9aae6737d8fad7d8b51b0\"\n+  },\n+  \"3\": {\n+    \"count\": 4096,\n+    \"sha256\": \"4a065a992995869e352389e63633668be2967a03b9e1a7e9ce9f4d95d8ee0e71\"\n+  },\n+  \"4\": {\n+    \"count\": 512,\n+    \"sha256\": \"fac996dc039d805d0154c17deeb8b5996cfc0e98c9824b16a5a85b5f7bfa7702\"\n+  }\n+}\ndiff --git a/docs/case-studies/issue-21/data/issue-21.json b/docs/case-studies/issue-21/data/issue-21.json\nnew file mode 100644\nindex 0000000..6b02f79\n--- /dev/null\n+++ b/docs/case-studies/issue-21/data/issue-21.json\n@@ -0,0 +1 @@\n+{\"url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21\",\"repository_url\":\"https://api.github.com/repos/konard/konard.github.io\",\"labels_url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21/labels{/name}\",\"comments_url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21/comments\",\"events_url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21/events\",\"html_url\":\"https://github.com/konard/konard.github.io/issues/21\",\"id\":6023342918,\"node_id\":\"I_kwDON1sLX88AAAABZwTrRg\",\"number\":21,\"title\":\"Defaults are still not perfect enough\",\"user\":{\"login\":\"konard\",\"id\":1431904,\"node_id\":\"MDQ6VXNlcjE0MzE5MDQ=\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/1431904?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/konard\",\"html_url\":\"https://github.com/konard\",\"followers_url\":\"https://api.github.com/users/konard/followers\",\"following_url\":\"https://api.github.com/users/konard/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/konard/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/konard/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/konard/subscriptions\",\"organizations_url\":\"https://api.github.com/users/konard/orgs\",\"repos_url\":\"https://api.github.com/users/konard/repos\",\"events_url\":\"https://api.github.com/users/konard/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/konard/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"labels\":[{\"id\":8113453895,\"node_id\":\"LA_kwDON1sLX88AAAAB45l7Rw\",\"url\":\"https://api.github.com/repos/konard/konard.github.io/labels/bug\",\"name\":\"bug\",\"color\":\"d73a4a\",\"default\":true,\"description\":\"Something isn't working\",\"archived_at\":null,\"archived_by\":null},{\"id\":8113453898,\"node_id\":\"LA_kwDON1sLX88AAAAB45l7Sg\",\"url\":\"https://api.github.com/repos/konard/konard.github.io/labels/documentation\",\"name\":\"documentation\",\"color\":\"0075ca\",\"default\":true,\"description\":\"Improvements or additions to documentation\",\"archived_at\":null,\"archived_by\":null},{\"id\":8113453904,\"node_id\":\"LA_kwDON1sLX88AAAAB45l7UA\",\"url\":\"https://api.github.com/repos/konard/konard.github.io/labels/enhancement\",\"name\":\"enhancement\",\"color\":\"a2eeef\",\"default\":true,\"description\":\"New feature or request\",\"archived_at\":null,\"archived_by\":null}],\"state\":\"open\",\"locked\":false,\"assignees\":[],\"milestone\":null,\"comments\":0,\"created_at\":\"2026-10-25T10:17:32Z\",\"updated_at\":\"2026-10-25T10:19:08Z\",\"closed_at\":null,\"assignee\":null,\"author_association\":\"OWNER\",\"active_lock_reason\":null,\"sub_issues_summary\":{\"total\":0,\"completed\":0,\"percent_completed\":0},\"issue_dependencies_summary\":{\"blocked_by\":0,\"total_blocked_by\":0,\"blocking\":0,\"total_blocking\":0},\"body\":\"See these screenshots carefully:\\n<img width=\\\"1824\\\" height=\\\"1112\\\" alt=\\\"Image\\\" src=\\\"https://github.com/user-attachments/assets/769b3d28-36ff-4d4b-abe2-4faa97d0e756\\\" />\\n\\nhttps://konard.github.io/network/?code=1122&sourceAngle=24&targetAngle=40&tension=0.4&bulge=25&startGap=0.09&startOffset=2.9\\n\\n<img width=\\\"1824\\\" height=\\\"1112\\\" alt=\\\"Image\\\" src=\\\"https://github.com/user-attachments/assets/10a189a9-0ff5-4bf6-9227-7a0aa09b2cfc\\\" />\\n\\nhttps://konard.github.io/network/?code=00000000&bulge=19&padding=10&startOffset=2.5\\n\\nWe also need to double check that all settings on screenshots perfectly match resulting links and vice versa.\\n\\nI want when clicked on links networks configurations across the website, we have default geometry closer to these examples. For some reason our bend setting is not universal, and is more of rotation than bend. Meaning it is not possible to have single setting at the moment, that looks perfectly all the time, and I want to by default in all configurations that it looks perfectly and close to how we show in list of all links networks configurations.\\n\\nStart of the link should now have cross-like shape as per configuration. We should have strict tests that the shape looks perfectly symmetrical when possible.\\n\\nAnd also colors must be the same as in the links network configuration clicked at other places of the website. Also we should not do underscore on hover when we browser links network configuration. So no surprises for the user. It should get as close visual to what he clicked as possible.\\n\\nIn this pull request please focus on updating geometry only affecting the editor of single network after sharing, as it is critical not to break all other geometry drawings, across the website.\\n\\nWe need to download all logs and data related about the issue to this repository, make sure we compile that data to `./docs/case-studies/issue-{id}` folder, and use it to do deep case study analysis (also make sure to search online for additional facts and data), in which we will reconstruct timeline/sequence of events, list of each and all requirements from the issue, find root causes of the each problem, and propose possible solutions and solution plans for each requirement (we should also check known existing components/libraries, that solve similar problem or can help in solutions).\\n\\nIf there is not enough data to find actual root cause, add debug output and verbose mode if not present, that will allow us to find root cause on next iteration.\\n\\nIf issue related to any other repository/project, where we can report issues on GitHub, please do so. Each issue must contain reproducible examples, workarounds and suggestions for fix the issue in code. Also double check to fully apply requirements to entire codebase, so if we have issue in multiple places, it should be fixed in all them.\\n\\nPlease plan and execute everything in this single pull request, you have unlimited time and context, as context auto-compacts and you can continue indefinitely, until it is each and every requirement fully addressed, and everything is totally done.\",\"closed_by\":null,\"reactions\":{\"url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"timeline_url\":\"https://api.github.com/repos/konard/konard.github.io/issues/21/timeline\",\"performed_via_github_app\":null,\"state_reason\":null,\"pinned_comment\":null}\n\\ No newline at end of file\ndiff --git a/experiments/issue-21-baseline.mjs b/experiments/issue-21-baseline.mjs\nnew file mode 100644\nindex 0000000..187e728\n--- /dev/null\n+++ b/experiments/issue-21-baseline.mjs\n@@ -0,0 +1,20 @@\n+// Preserve gallery/rain geometry independently of editor changes.\n+import { createHash } from 'node:crypto';\n+import { writeFileSync } from 'node:fs';\n+import { createServer } from 'vite';\n+const server = await createServer({ server: { middlewareMode: true } });\n+const { codeAt, decode, networkCount } = await server.ssrLoadModule('/src/links/configurations.js');\n+const { glyphSvg } = await server.ssrLoadModule('/src/links/glyph.js');\n+const hashes = {};\n+for (const n of [1, 2, 3, 4]) {\n+  const hash = createHash('sha256');\n+  const count = n < 4 ? networkCount(n) : 512;\n+  for (let i = 0; i < count; i++) {\n+    const index = n < 4 ? i : Math.floor((i * (networkCount(n) - 1)) / (count - 1));\n+    hash.update(glyphSvg(decode(codeAt(n, index))));\n+  }\n+  hashes[n] = { count, sha256: hash.digest('hex') };\n+}\n+writeFileSync('docs/case-studies/issue-21/data/gallery-baseline.json', JSON.stringify(hashes, null, 2) + '\\n');\n+\n+await server.close();\ndiff --git a/experiments/issue-21-browser.mjs b/experiments/issue-21-browser.mjs\nnew file mode 100644\nindex 0000000..2ba1ad6\n--- /dev/null\n+++ b/experiments/issue-21-browser.mjs\n@@ -0,0 +1,154 @@\n+// Editor-only geometry, colors, controls, exports and navigation evidence for #21.\n+/* global window, document, getComputedStyle, HTMLInputElement */\n+import assert from 'node:assert/strict';\n+import { mkdir, readFile, writeFile } from 'node:fs/promises';\n+import { join } from 'node:path';\n+import { chromium, firefox, webkit } from 'playwright';\n+import { preview } from 'vite';\n+\n+const engine = process.env.ENGINE || 'chromium';\n+const before = process.env.BEFORE === '1';\n+const output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-21/screenshots';\n+const resultDir = process.env.RESULT_DIR || 'docs/case-studies/issue-21/data';\n+await mkdir(output, { recursive: true });\n+await mkdir(resultDir, { recursive: true });\n+const server = process.env.BASE ? null : await preview({ preview: { port: 4179, strictPort: true } });\n+const base = process.env.BASE || 'http://localhost:4179';\n+const results = { engine, before, date: new Date().toISOString(), checks: [], errors: [] };\n+const passed = (name) => {\n+  results.checks.push(name);\n+  console.log(`${engine}: ${name}`);\n+};\n+const shot = (page, name, element = null) =>\n+  (element || page).screenshot({ path: join(output, `${engine}-${before ? 'before' : 'after'}-${name}.png`) });\n+const drawing = (page) => page.locator('.network__preview').innerHTML();\n+const change = (page, key, value) =>\n+  page.locator(`#style-${key}`).evaluate((node, next) => {\n+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(node, next);\n+    node.dispatchEvent(new Event('input', { bubbles: true }));\n+  }, value);\n+let browser;\n+try {\n+  browser = await { chromium, firefox, webkit }[engine].launch();\n+  results.version = browser.version();\n+  const context = await browser.newContext({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n+  await context.addInitScript(() => {\n+    if (!localStorage.getItem('theme')) localStorage.setItem('theme', 'dark');\n+    localStorage.setItem('lang', 'en');\n+    // Keep screenshots deterministic and memory use low; this changes no glyphs or editor controls.\n+    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n+  });\n+  const page = await context.newPage();\n+  page.setDefaultTimeout(15000);\n+  page.on('pageerror', (error) => results.errors.push(error.message));\n+\n+  const issue = JSON.parse(await readFile('docs/case-studies/issue-21/data/issue-21.json', 'utf8'));\n+  const urls = [...issue.body.matchAll(/https:\\/\\/konard.github.io\\/network\\/\\?[^\\s]+/g)].map((m) => new URL(m[0]));\n+  for (const [i, url] of urls.entries()) {\n+    await page.goto(base + url.pathname + url.search);\n+    await page.locator('.network__preview svg').waitFor();\n+    // Inspect every explicit setting through its actual control (defaults can be omitted in canonical URLs).\n+    for (const [key, value] of url.searchParams) {\n+      if (key !== 'code') assert.equal(await page.locator(`#style-${key}`).inputValue(), value, key);\n+    }\n+    await page.locator('#style-bulge').scrollIntoViewIfNeeded();\n+    await shot(page, `supplied-${i + 1}`);\n+    await shot(page, `supplied-${i + 1}-symbol`, page.locator('.network__preview'));\n+    const svg = await drawing(page);\n+    const shared = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n+    await page.goto(shared);\n+    assert.equal(await drawing(page), svg);\n+    if (!before) {\n+      for (const [key, value] of [\n+        ['bulge', 37],\n+        ['startOffset', 3.1],\n+        ['padding', 12],\n+      ]) {\n+        await change(page, key, value);\n+      }\n+      const edited = await drawing(page);\n+      await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n+      assert.equal(await drawing(page), edited, 'edited controls must recreate exact SVG');\n+      assert.equal(await page.locator('#style-bulge').inputValue(), '37');\n+    }\n+  }\n+  passed('both supplied URLs: explicit settings, controls, share and reload');\n+\n+  for (const code of ['1122', '00000000', '112212', '221331', '1221']) {\n+    await page.goto(`${base}/network/?code=${code}`);\n+    await page.locator('.network__preview svg').waitFor();\n+    assert(!/NaN|Infinity|undefined/.test(await drawing(page)));\n+    await shot(page, `default-${code}`, page.locator('.network__preview'));\n+  }\n+  passed('five representative default editor configurations');\n+\n+  for (const theme of ['dark', 'light']) {\n+    await page.goto(`${base}/art/#symbols`);\n+    // Select via persistent preference and reload, so this also covers direct entry with saved themes.\n+    await page.evaluate((value) => localStorage.setItem('theme', value), theme);\n+    await page.reload();\n+    const card = page.locator('.symbols__card').first();\n+    await card.hover();\n+    const decoration = await card.evaluate((node) => getComputedStyle(node).textDecorationLine);\n+    await shot(page, `gallery-${theme}`, page.locator('.symbols__grid li').first());\n+    const colors = await card\n+      .locator('[data-link]')\n+      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n+    if (!before) assert.equal(decoration, 'none');\n+    await card.click();\n+    await page.waitForURL('**/network/**');\n+    const actual = await page\n+      .locator('.network__preview g[stroke] > path:first-child')\n+      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n+    if (!before) assert.deepEqual(actual, colors, `${theme} gallery colors must match editor`);\n+    results[`${theme}Colors`] = { gallery: colors, editor: actual, decoration };\n+  }\n+  passed('gallery hover and navigation preserve dark/light link colors');\n+\n+  if (!before) {\n+    await page.goto(`${base}/research/`);\n+    await page.evaluate(() => localStorage.setItem('theme', 'light'));\n+    await page.reload();\n+    const example = page.locator('.theory__example').first();\n+    const expected = await example\n+      .locator('[data-link]')\n+      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n+    await example.locator('.theory__edit').click();\n+    await page.waitForURL('**/network/**');\n+    const actual = await page\n+      .locator('.network__preview g[stroke] > path:first-child')\n+      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n+    assert.deepEqual(actual, expected);\n+    passed('theory example navigation also preserves light-theme colors');\n+\n+    await page.goto(`${base}/network/?code=1122`);\n+    const svg = await drawing(page);\n+    const download = page.waitForEvent('download');\n+    await page.getByRole('button', { name: '⤓ SVG', exact: true }).click();\n+    const file = await download;\n+    assert.equal(await file.failure(), null);\n+    const exported = await readFile(await file.path(), 'utf8');\n+    const parsed = await page.evaluate((text) => {\n+      const container = document.createElement('div');\n+      container.innerHTML = text;\n+      return container.innerHTML;\n+    }, exported);\n+    assert.equal(parsed, svg);\n+    passed('exported SVG equals preview');\n+\n+    await page.setViewportSize({ width: 390, height: 844 });\n+    await page.goto(`${base}/network/?code=1122`);\n+    await shot(page, 'mobile', page.locator('.network__preview'));\n+    assert(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1));\n+    passed('mobile preview fits viewport');\n+  }\n+  assert.deepEqual(results.errors, []);\n+  await context.close();\n+} finally {\n+  await writeFile(\n+    join(resultDir, `${engine}-${before ? 'before' : 'after'}.json`),\n+    JSON.stringify(results, null, 2) + '\\n',\n+  );\n+  await browser?.close();\n+  if (server) await new Promise((resolve) => server.httpServer.close(resolve));\n+}\ndiff --git a/package.json b/package.json\nindex f1f15ce..9f68ae9 100644\n--- a/package.json\n+++ b/package.json\n@@ -28,7 +28,8 @@\n     \"build:frames\": \"node scripts/build-frames-css.mjs\",\n     \"check:secrets\": \"[REDACTED]\\\"**/*\\\" --secretlintignore .pr…re\",\n     \"prepare\": \"husky\",\n-    \"build:cv\": \"node scripts/build-cv-pdf.mjs\"\n+    \"build:cv\": \"node scripts/build-cv-pdf.mjs\",\n+    \"test:network:issue21\": \"node experiments/issue-21-browser.mjs\"\n   },\n   \"homepage\": \"https://konard.github.io\",\n   \"devDependencies\": {\ndiff --git a/src/components/MetaTheory.jsx b/src/components/MetaTheory.jsx\nindex 70625b4..a433bcb 100644\n--- a/src/components/MetaTheory.jsx\n+++ b/src/components/MetaTheory.jsx\n@@ -1,6 +1,6 @@\n import { useState } from 'react';\n import { linksNotation, mathNotation, randomCode } from '../links/configurations';\n-import { tr, useLang } from '../i18n/prefs';\n+import { tr, useLang, useResolvedTheme } from '../i18n/prefs';\n import { useNotation } from '../links/notation';\n import { plural } from '../i18n/plural';\n import Glyph from './Glyph';\n@@ -19,6 +19,7 @@ const LANGUAGE_NAMES = {\n  * shows a random network of 1–4 links (`random` is injectable for tests).\n  */\n export function NetworkExample({ example, random = Math.random }) {\n+  const theme = useResolvedTheme();\n   const [code, setCode] = useState(example.code);\n   const size = code.split(' ').length;\n   const isExample = code === example.code;\n@@ -57,7 +58,7 @@ export function NetworkExample({ example, random = Math.random }) {\n           en: `Every link is (index: source target), 0 is nothing; the math notation writes the same sources and targets as digits in base ${size + 1}. Click the symbol for another random network.`,\n           ru: `Каждая связь — это (индекс: начало конец), 0 означает «ничего»; математическая нотация записывает те же начала и концы цифрами в системе счисления с основанием ${size + 1}. Нажмите на символ, чтобы увидеть другую случайную сеть.`,\n         })}{' '}\n-        <a className=\"theory__edit\" href={networkHref(code)}>\n+        <a className=\"theory__edit\" href={networkHref(code, theme)}>\n           {t({ en: 'Edit and share this network', ru: 'Изменить эту сеть и поделиться ею' })}\n       