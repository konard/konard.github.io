[2026-10-25T10:30:03.121Z] [STDOUT] {"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"git diff --check && git status --short && sed -n '1,240p' src/links/geometry-21.test.js && sed -n '1,65p' src/pages/network-21.test.jsx && sed -n '1,210p' experiments/issue-21-browser.mjs\"","aggregated_output":" M .github/workflows/github-pages.yml\n M package.json\n M src/components/MetaTheory.jsx\n M src/components/NetworkGallery.jsx\n M src/i18n/prefs.js\n M src/links/glyph.js\n M src/links/mechanics-19.test.js\n M src/links/style-geometry.js\n M src/links/style.js\n M src/pages/pages.css\n?? docs/case-studies/issue-21/\n?? experiments/issue-21-baseline.mjs\n?? experiments/issue-21-browser.mjs\n?? src/links/geometry-21.test.js\n?? src/pages/network-21.test.jsx\nimport { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { describe, expect, it } from 'vitest';\nimport { codeAt, decode, networkCount } from './configurations';\nimport { COLORS, bezier, glyphSvg, layoutCurves } from './glyph';\nimport { STYLE_DEFAULTS, linkColors, normalizeStyle, shapeOfStyle, styleFromParams, styleToParams } from './style';\n\nconst shape = (raw = {}, n = 1) => shapeOfStyle(normalizeStyle(raw), n);\nconst near = (a, b) => expect(Math.hypot(a[0] - b[0], a[1] - b[1])).toBeLessThan(1e-10);\nconst symmetric = ({ segments: [first, second], middle }) => {\n  for (let k = 0; k <= 32; k++) {\n    const p = bezier(first, 1 - k / 32);\n    near(bezier(second, k / 32), [2 * middle.at[0] - p[0], 2 * middle.at[1] - p[1]]);\n  }\n};\n\ndescribe('balanced editor geometry (issue #21)', () => {\n  it('makes equal self-reference ends point-symmetric for all equal angles and bends', () => {\n    for (const angle of [-60, 0, 24, 30, 60]) {\n      for (const bulge of [0, 19, 20, 25, 45, 90]) {\n        const links = decode('11 22');\n        for (const curve of layoutCurves(links, shape({ sourceAngle: angle, targetAngle: angle, bulge }, 2))) {\n          symmetric(curve);\n        }\n      }\n    }\n  });\n\n  it('changes curvature without moving free/loop anchors or rotating the whole symbol', () => {\n    for (const links of [decode('00'), decode('11'), decode('00 00 00 00'), decode('11 22')]) {\n      const a = layoutCurves(links, shape({ bulge: 10 }, links.length));\n      const b = layoutCurves(links, shape({ bulge: 60 }, links.length));\n      expect(b).not.toEqual(a);\n      a.forEach((curve, i) => {\n        near(b[i].start.at, curve.start.at);\n        near(b[i].end.at, curve.end.at);\n        near(b[i].middle.at, curve.middle.at);\n        symmetric(curve);\n        symmetric(b[i]);\n      });\n    }\n  });\n\n  it('starts with a centered cross made by a bar intersecting the line', () => {\n    expect(STYLE_DEFAULTS.start).toBe('bar');\n    expect(STYLE_DEFAULTS.startOffset).toBe(STYLE_DEFAULTS.startSize);\n    expect(STYLE_DEFAULTS.startAcross).toBe(0);\n    expect(STYLE_DEFAULTS.startRotation).toBe(0);\n  });\n\n  it('uses gallery colors until the user explicitly changes them', () => {\n    expect(linkColors(STYLE_DEFAULTS, 4)).toEqual(COLORS.slice(0, 4));\n    expect(linkColors(normalizeStyle({ palette: 'custom', colors: '#ff2600,#00f900' }), 2)).toEqual([\n      '#ff2600',\n      '#00f900',\n    ]);\n  });\n\n  it('keeps every explicit supplied setting through query serialization in both directions', () => {\n    for (const query of [\n      'sourceAngle=24&targetAngle=40&tension=0.4&bulge=25&startGap=0.09&startOffset=2.9',\n      'bulge=19&padding=10&startOffset=2.5',\n    ]) {\n      const params = new URLSearchParams(query);\n      const style = styleFromParams(params);\n      for (const [key, value] of params) expect(style[key]).toBe(Number(value));\n      expect(styleFromParams(styleToParams(style))).toEqual(style);\n    }\n  });\n\n  it('preserves the gallery and rain SVG byte for byte', () => {\n    const baseline = JSON.parse(readFileSync('docs/case-studies/issue-21/data/gallery-baseline.json'));\n    for (const n of [1, 2, 3, 4]) {\n      const hash = createHash('sha256');\n      for (let i = 0; i < baseline[n].count; i++) {\n        const index = n < 4 ? i : Math.floor((i * (networkCount(n) - 1)) / (baseline[n].count - 1));\n        hash.update(glyphSvg(decode(codeAt(n, index))));\n      }\n      expect(hash.digest('hex')).toBe(baseline[n].sha256);\n    }\n  });\n});\n\ndescribe('editor symmetry and compatibility', () => {\n  it('keeps four free links related by exact quarter turns, including after fitting', async () => {\n    const { glyphCurves } = await import('./glyph');\n    const curves = glyphCurves(decode('00 00 00 00'), shape({}, 4));\n    for (let i = 0; i < 4; i++) {\n      curves[i].segments.forEach((segment, k) =>\n        segment.forEach((p, j) => {\n          near(curves[(i + 1) % 4].segments[k][j], [100 - p[1], p[0]]);\n        }),\n      );\n    }\n  });\n\n  it('makes the source bar exactly centered and perpendicular to its tangent', async () => {\n    const { glyphCurves, glyphParts } = await import('./glyph');\n    const options = shape({ bulge: 0 });\n    const [curve] = glyphCurves([[0, 0]], options);\n    const [parts] = glyphParts([[0, 0]], options);\n    const [x1, y1, x2, y2] = parts.start.d.match(/-?\\d+(?:\\.\\d+)?/g).map(Number);\n    const center = [(x1 + x2) / 2, (y1 + y2) / 2];\n    near(center, [curve.start.at[0] + options.startOffset, curve.start.at[1]]);\n    expect(x1).toBe(x2);\n    expect(y1 - center[1]).toBe(center[1] - y2);\n    expect(Math.hypot(x1 - x2, y1 - y2)).toBe(2 * options.startSize);\n  });\n\n  it('honors colors stored by links shared when custom was the default', () => {\n    const style = styleFromParams(new URLSearchParams('colors=%23ff2600,%2300f900'));\n    expect(style.palette).toBe('custom');\n    expect(linkColors(style, 2)).toEqual(['#ff2600', '#00f900']);\n  });\n\n  it('keeps all small editor configurations finite and continuous', () => {\n    for (const n of [1, 2, 3]) {\n      for (let i = 0; i < networkCount(n); i++) {\n        const curves = layoutCurves(decode(codeAt(n, i)), shape({}, n));\n        for (const {\n          segments: [a, b],\n        } of curves) {\n          expect(a.flat().concat(b.flat()).every(Number.isFinite)).toBe(true);\n          near(a[3], b[0]);\n          const incoming = [a[3][0] - a[2][0], a[3][1] - a[2][1]];\n          const outgoing = [b[1][0] - b[0][0], b[1][1] - b[0][1]];\n          expect(Math.abs(incoming[0] * outgoing[1] - incoming[1] * outgoing[0])).toBeLessThan(1e-10);\n          expect(incoming[0] * outgoing[0] + incoming[1] * outgoing[1]).toBeGreaterThan(0);\n        }\n      }\n    }\n  });\n});\nimport { act, render, screen, within } from '@testing-library/react';\nimport { afterEach, expect, it } from 'vitest';\nimport NetworkGallery from '../components/NetworkGallery';\nimport { NetworkExample } from '../components/MetaTheory';\nimport { setTheme } from '../i18n/prefs';\n\nafterEach(() => act(() => setTheme('dark', { save: false })));\n\nit('updates both gallery links and theory examples when their displayed theme changes', () => {\n  act(() => setTheme('dark', { save: false }));\n  render(\n    <>\n      <NetworkGallery initial={1} />\n      <NetworkExample example={{ code: '11 22 12' }} />\n    </>,\n  );\n  const card = () => within(screen.getByRole('list', { name: 'Networks of 1 link' })).getAllByRole('link')[0];\n  expect(card()).toHaveAttribute('href', '/network/?code=00');\n  act(() => setTheme('light', { save: false }));\n  expect(card()).toHaveAttribute('href', '/network/?code=00&palette=print');\n  expect(screen.getByRole('link', { name: 'Share 00₂' })).toHaveAttribute(\n    'href',\n    '/network/?code=00&palette=print#share',\n  );\n  expect(screen.getByRole('link', { name: 'Edit and share this network' })).toHaveAttribute(\n    'href',\n    '/network/?code=112212&palette=print',\n  );\n  act(() => setTheme('dark', { save: false }));\n  expect(card()).toHaveAttribute('href', '/network/?code=00');\n});\n// Editor-only geometry, colors, controls, exports and navigation evidence for #21.\n/* global window, document, getComputedStyle, HTMLInputElement */\nimport assert from 'node:assert/strict';\nimport { mkdir, readFile, writeFile } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { chromium, firefox, webkit } from 'playwright';\nimport { preview } from 'vite';\n\nconst engine = process.env.ENGINE || 'chromium';\nconst before = process.env.BEFORE === '1';\nconst output = process.env.CAPTURE_DIR || 'docs/case-studies/issue-21/screenshots';\nconst resultDir = process.env.RESULT_DIR || 'docs/case-studies/issue-21/data';\nawait mkdir(output, { recursive: true });\nawait mkdir(resultDir, { recursive: true });\nconst server = process.env.BASE ? null : await preview({ preview: { port: 4179, strictPort: true } });\nconst base = process.env.BASE || 'http://localhost:4179';\nconst results = { engine, before, date: new Date().toISOString(), checks: [], errors: [] };\nconst passed = (name) => {\n  results.checks.push(name);\n  console.log(`${engine}: ${name}`);\n};\nconst shot = (page, name, element = null) =>\n  (element || page).screenshot({ path: join(output, `${engine}-${before ? 'before' : 'after'}-${name}.png`) });\nconst drawing = (page) => page.locator('.network__preview').innerHTML();\nconst change = (page, key, value) =>\n  page.locator(`#style-${key}`).evaluate((node, next) => {\n    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(node, next);\n    node.dispatchEvent(new Event('input', { bubbles: true }));\n  }, value);\nlet browser;\ntry {\n  browser = await { chromium, firefox, webkit }[engine].launch();\n  results.version = browser.version();\n  const context = await browser.newContext({ viewport: { width: 1440, height: 1000 }, reducedMotion: 'reduce' });\n  await context.addInitScript(() => {\n    if (!localStorage.getItem('theme')) localStorage.setItem('theme', 'dark');\n    localStorage.setItem('lang', 'en');\n    // Keep screenshots deterministic and memory use low; this changes no glyphs or editor controls.\n    localStorage.setItem('settings', JSON.stringify({ 'motion.mode': 'off' }));\n  });\n  const page = await context.newPage();\n  page.setDefaultTimeout(15000);\n  page.on('pageerror', (error) => results.errors.push(error.message));\n\n  const issue = JSON.parse(await readFile('docs/case-studies/issue-21/data/issue-21.json', 'utf8'));\n  const urls = [...issue.body.matchAll(/https:\\/\\/konard.github.io\\/network\\/\\?[^\\s]+/g)].map((m) => new URL(m[0]));\n  for (const [i, url] of urls.entries()) {\n    await page.goto(base + url.pathname + url.search);\n    await page.locator('.network__preview svg').waitFor();\n    // Inspect every explicit setting through its actual control (defaults can be omitted in canonical URLs).\n    for (const [key, value] of url.searchParams) {\n      if (key !== 'code') assert.equal(await page.locator(`#style-${key}`).inputValue(), value, key);\n    }\n    await page.locator('#style-bulge').scrollIntoViewIfNeeded();\n    await shot(page, `supplied-${i + 1}`);\n    await shot(page, `supplied-${i + 1}-symbol`, page.locator('.network__preview'));\n    const svg = await drawing(page);\n    const shared = await page.getByLabel('Link to this picture', { exact: true }).inputValue();\n    await page.goto(shared);\n    assert.equal(await drawing(page), svg);\n    if (!before) {\n      for (const [key, value] of [\n        ['bulge', 37],\n        ['startOffset', 3.1],\n        ['padding', 12],\n      ]) {\n        await change(page, key, value);\n      }\n      const edited = await drawing(page);\n      await page.goto(await page.getByLabel('Link to this picture', { exact: true }).inputValue());\n      assert.equal(await drawing(page), edited, 'edited controls must recreate exact SVG');\n      assert.equal(await page.locator('#style-bulge').inputValue(), '37');\n    }\n  }\n  passed('both supplied URLs: explicit settings, controls, share and reload');\n\n  for (const code of ['1122', '00000000', '112212', '221331', '1221']) {\n    await page.goto(`${base}/network/?code=${code}`);\n    await page.locator('.network__preview svg').waitFor();\n    assert(!/NaN|Infinity|undefined/.test(await drawing(page)));\n    await shot(page, `default-${code}`, page.locator('.network__preview'));\n  }\n  passed('five representative default editor configurations');\n\n  for (const theme of ['dark', 'light']) {\n    await page.goto(`${base}/art/#symbols`);\n    // Select via persistent preference and reload, so this also covers direct entry with saved themes.\n    await page.evaluate((value) => localStorage.setItem('theme', value), theme);\n    await page.reload();\n    const card = page.locator('.symbols__card').first();\n    await card.hover();\n    const decoration = await card.evaluate((node) => getComputedStyle(node).textDecorationLine);\n    await shot(page, `gallery-${theme}`, page.locator('.symbols__grid li').first());\n    const colors = await card\n      .locator('[data-link]')\n      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n    if (!before) assert.equal(decoration, 'none');\n    await card.click();\n    await page.waitForURL('**/network/**');\n    const actual = await page\n      .locator('.network__preview g[stroke] > path:first-child')\n      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n    if (!before) assert.deepEqual(actual, colors, `${theme} gallery colors must match editor`);\n    results[`${theme}Colors`] = { gallery: colors, editor: actual, decoration };\n  }\n  passed('gallery hover and navigation preserve dark/light link colors');\n\n  if (!before) {\n    await page.goto(`${base}/research/`);\n    await page.evaluate(() => localStorage.setItem('theme', 'light'));\n    await page.reload();\n    const example = page.locator('.theory__example').first();\n    const expected = await example\n      .locator('[data-link]')\n      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n    await example.locator('.theory__edit').click();\n    await page.waitForURL('**/network/**');\n    const actual = await page\n      .locator('.network__preview g[stroke] > path:first-child')\n      .evaluateAll((nodes) => nodes.map((node) => getComputedStyle(node).stroke));\n    assert.deepEqual(actual, expected);\n    passed('theory example navigation also preserves light-theme colors');\n\n    await page.goto(`${base}/network/?code=1122`);\n    const svg = await drawing(page);\n    const download = page.waitForEvent('download');\n    await page.getByRole('button', { name: '⤓ SVG', exact: true }).click();\n    const file = await download;\n    assert.equal(await file.failure(), null);\n    const exported = await readFile(await file.path(), 'utf8');\n    const parsed = await page.evaluate((text) => {\n      const container = document.createElement('div');\n      container.innerHTML = text;\n      return container.innerHTML;\n    }, exported);\n    assert.equal(parsed, svg);\n    passed('exported SVG equals preview');\n\n    await page.setViewportSize({ width: 390, height: 844 });\n    await page.goto(`${base}/network/?code=1122`);\n    await shot(page, 'mobile', page.locator('.network__preview'));\n    assert(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1));\n    passed('mobile preview fits viewport');\n  }\n  assert.deepEqual(results.errors, []);\n  await context.close();\n} finally {\n  await writeFile(\n    join(resultDir, `${engine}-${before ? 'before' : 'after'}.json`),\n    JSON.stringify(results, null, 2) + '\\n',\n  );\n  await browser?.close();\n  if (server) await new Promise((resolve) => server.httpServer.close(resolve));\n}\n","exit_code":0,"status":"completed"}}
