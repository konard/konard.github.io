sed/webkit-mobile-100-links.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-square.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-force.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-cards.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-after-history-error.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-supplied-2.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-supplied-1.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-spiral.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-hex.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-after-loops.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-ring-and-offsets.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-dice.png\ndocs/case-studies/issue-19/screenshots/webkit-stable-focused/webkit-layout-circle.png\ndocs/case-studies/issue-19/screenshots/firefox-mobile-100-links.png\ndocs/case-studies/issue-19/screenshots/chromium-layout-hex.png\ndocs/case-studies/issue-19/screenshots/firefox-ring-and-offsets.png\ndocs/case-studies/issue-19/screenshots/firefox-after-loops.png\ndocs/case-studies/issue-19/screenshots/webkit-ring-and-offsets.png\ndocs/case-studies/issue-19/screenshots/firefox-after-history-error.png\ndocs/case-studies/issue-19/screenshots/before-history-error.png\npublic/robots.txt\npublic/logo192.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/collisions-after.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/network-desktop.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/collisions-before.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/plain-black.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/gallery-hover.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/after-style-preview.png\ndocs/case-studies/issue-19/screenshots/webkit-stable/transparent.png\n{\n  \"name\": \"konard.github.io\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"dependencies\": {\n    \"@fontsource/chakra-petch\": \"^5.3.0\",\n    \"@fontsource/electrolize\": \"^5.3.0\",\n    \"@fontsource/orbitron\": \"^5.3.0\",\n    \"@fontsource/share-tech-mono\": \"^5.3.0\",\n    \"d3-force\": \"^3.0.0\",\n    \"react\": \"^19.0.0\",\n    \"react-dom\": \"^19.0.0\"\n  },\n  \"scripts\": {\n    \"start\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest\",\n    \"test:ci\": \"vitest run\",\n    \"test:network:browser\": \"node experiments/network-e2e.mjs\",\n    \"test:network:issue19\": \"node experiments/issue-19-browser.mjs\",\n    \"lint\": \"eslint . --max-warnings=0\",\n    \"format\": \"prettier --write .\",\n    \"format:check\": \"prettier --check .\",\n    \"check:file-size\": \"bash scripts/check-file-line-limits.sh\",\n    \"check\": \"npm run lint && npm run format:check && npm run check:file-size && npm run check:secrets\",\n    \"build:data\": \"node scripts/build-data.cjs\",\n    \"build:frames\": \"node scripts/build-frames-css.mjs\",\n    \"check:secrets\": \"[REDACTED]\\\"**/*\\\" --secretlintignore .pr…re\",\n    \"prepare\": \"husky\",\n    \"build:cv\": \"node scripts/build-cv-pdf.mjs\"\n  },\n  \"homepage\": \"https://konard.github.io\",\n  \"devDependencies\": {\n    \"@eslint/js\": \"^10.0.1\",\n    \"@secretlint/secretlint-rule-preset-recommend\": \"^13.0.7\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\",\n    \"@vitejs/plugin-react\": \"^6.1.2\",\n    \"eslint\": \"^10.13.0\",\n    \"eslint-plugin-react-hooks\": \"^7.1.1\",\n    \"eslint-plugin-react-refresh\": \"^0.5.7\",\n    \"globals\": \"^17.13.0\",\n    \"husky\": \"^9.1.7\",\n    \"js-yaml\": \"^4.3.2\",\n    \"jsdom\": \"^30.1.3\",\n    \"lint-staged\": \"^17.6.0\",\n    \"playwright\": \"1.63.0\",\n    \"prettier\": \"^3.9.10\",\n    \"secretlint\": \"^13.0.7\",\n    \"vite\": \"^8.3.4\",\n    \"vitest\": \"^5.0.5\"\n  },\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=22\"\n  },\n  \"lint-staged\": {\n    \"*.{js,jsx,cjs,mjs}\": [\n      \"eslint --fix --max-warnings=0 --no-warn-ignored\",\n      \"prettier --write\"\n    ],\n    \"*.{css,md,html,json,yml,yaml}\": [\n      \"prettier --write\"\n    ]\n  }\n}\nname: Deploy to GitHub Pages\n\non:\n  push:\n    branches:\n      - main\n    paths-ignore:\n      - 'docs/**'\n      - 'dev/**'\n  pull_request:\n    branches:\n      - main\n  workflow_dispatch:\n\n# Least-privilege default; only the deploy job may publish to Pages.\npermissions:\n  contents: read\n\n# Cancel superseded pull request runs, but never a deploy on main.\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\n# actions/checkout runs `git init` before any step can configure Git; this\n# silences its \"default branch name\" hint.\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n\njobs:\n  # Lint the workflows themselves (actionlint also runs shellcheck on run: blocks).\n  lint-workflows:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Run actionlint\n        uses: docker://rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 # v1.7.12\n        with:\n          args: -color\n\n  # Fast checks run before the tests and the build.\n  checks:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 10\n\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Check formatting\n        run: npm run format:check\n\n      - name: Check file size limits\n        run: npm run check:file-size\n\n      - name: Check for secrets\n        run: npm run check:secrets\n\n      - name: Audit dependencies\n        run: npm audit --audit-level=moderate\n\n  test:\n    needs: [lint-workflows, checks, network-browsers]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n\n    steps:\n      # On pull requests this is the merge result with main, not the branch head.\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Run tests\n        run: npm run test:ci\n\n      - name: Build the React app\n        run: npm run build\n\n      # Issue #11: every CV (position × style × language) is printed to PDF by\n      # headless Chromium and checked: at most 2 pages for a position, 1 page\n      # for the compact style, and a text layer an ATS can read.\n      - name: Install Chromium for the CV PDFs\n        run: npx playwright install --with-deps chromium\n\n      - name: Print the CV PDFs\n        run: npm run build:cv\n\n      # GitHub Pages is set to deploy from GitHub Actions, so the site is\n      # published from this artifact, not from a branch or the docs/ folder.\n      # Pull requests upload it too, so a broken artifact fails before merge.\n      - name: Upload the build as the Pages artifact\n        uses: actions/upload-pages-artifact@v5\n        with:\n          path: build/\n          include-hidden-files: true\n\n  network-browsers:\n    needs: [lint-workflows, checks]\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    strategy:\n      fail-fast: false\n      matrix:\n        engine: [chromium, firefox, webkit]\n    env:\n      ENGINE: ${{ matrix.engine }}\n      CAPTURE_DIR: browser-results/screenshots\n      RESULT_DIR: browser-results/data\n    steps:\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Build the editor\n        run: npm run build\n\n      - name: Install the browser\n        # package.json pins 1.63.0: 1.64.x's Linux WebKit stalls on glass panels.\n        # https://github.com/microsoft/playwright/issues/43426\n        run: npx playwright install --with-deps \"$ENGINE\"\n\n      - name: Verify existing editor features and image downloads\n        run: npm run test:network:browser\n\n      - name: Verify history, self loops, layouts, clipboard and mobile editing\n        run: npm run test:network:issue19\n\n      - name: Preserve browser evidence\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: network-${{ matrix.engine }}\n          path: browser-results/\n          if-no-files-found: warn\n\n  deploy:\n    needs: test\n    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'\n    runs-on: ubuntu-24.04\n    timeout-minutes: 15\n    permissions:\n      contents: read\n      pages: write\n      id-token: [REDACTED]    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@v5\n\n      # A green deploy must mean the site is really there (issue #5).\n      - name: Checkout source\n        uses: actions/checkout@v6\n        with:\n          persist-credentials: false\n          sparse-checkout: scripts\n\n      - name: Verify the deployed site\n        run: bash scripts/check-deployed-site.sh \"$PAGE_URL\"\n        env:\n          PAGE_URL: ${{ steps.deployment.outputs.page_url }}\n","exit_code":0,"status":"completed"}}
