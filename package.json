{
  "name": "konard.github.io",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/electrolize": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "d3-force": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:network:browser": "node experiments/network-e2e.mjs",
    "test:network:issue19": "node experiments/issue-19-browser.mjs",
    "lint": "eslint --config eslint.config.js . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "bash scripts/check-file-line-limits.sh",
    "check": "npm run lint && npm run format:check && npm run check:file-size && npm run check:secrets",
    "build:data": "node scripts/build-data.cjs",
    "build:frames": "node scripts/build-frames-css.mjs",
    "check:secrets": "secretlint \"**/*\" --secretlintignore .prettierignore",
    "prepare": "husky",
    "build:cv": "node scripts/build-cv-pdf.mjs",
    "test:network:issue21": "node experiments/issue-21-browser.mjs",
    "test:network:issue23": "node experiments/issue-23-browser.mjs",
    "test:network:issue25": "node experiments/issue-25-browser.mjs",
    "test:network:issue27": "node experiments/issue-27-browser.mjs",
    "test:network:issue29": "node experiments/issue-29-browser.mjs",
    "test:indicators:browser": "node experiments/issue-33-browser.mjs",
    "test:network:issue35": "node experiments/issue-35-browser.mjs",
    "test:network:issue37": "node experiments/issue-37-browser.mjs",
    "test:ui:issue39": "node experiments/issue-39-browser.mjs && node experiments/issue-39-visual-review.mjs",
    "test:network:issue41": "node experiments/issue-41-browser.mjs",
    "test:network:issue43": "node experiments/issue-43-browser.mjs && node experiments/issue-43-solver-browser.mjs",
    "test:ui:issue45": "node experiments/issue-45-browser.mjs"
  },
  "homepage": "https://konard.github.io",
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "parse5": "8.0.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": [
      "eslint --config eslint.config.js --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,md,html,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "archiver-utils": {
      "glob": "^14.0.3"
    }
  }
}
