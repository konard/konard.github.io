{
  "name": "konard.github.io",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "prestart": "npm run build:glyphs",
    "start": "vite",
    "prebuild": "npm run build:glyphs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:file-size": "bash scripts/check-file-line-limits.sh",
    "check": "npm run lint && npm run format:check && npm run check:file-size && npm run check:secrets",
    "build:data": "node scripts/build-data.cjs",
    "build:glyphs": "node scripts/build-glyphs.mjs",
    "check:secrets": "secretlint \"**/*\" --secretlintignore .prettierignore",
    "prepare": "husky"
  },
  "homepage": "https://konard.github.io",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,md,html,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
